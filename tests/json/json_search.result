DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);
INSERT INTO t1 VALUES
  (1, '{"a": "apple", "b": "banana", "nested": {"k": "apricot"}}'),
  (2, '["apple", "berry", "cherry"]');
# ---- JSON_SEARCH one — first matching path ----   zeta #1063
# MySQL: "$.a"
SELECT JSON_SEARCH(j, 'one', 'apple') AS p FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_SEARCH
# ---- JSON_SEARCH all — JSON array of all matching paths ----   zeta #1063
# MySQL: ["$.a", "$.nested.k"] (LIKE wildcard matches both `ap%`)
SELECT JSON_SEARCH(j, 'all', 'ap%') AS p FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_SEARCH
# ---- JSON_SEARCH — array element match ----   zeta #1063
# MySQL: "$[0]"
SELECT JSON_SEARCH(j, 'one', 'apple') AS p FROM t1 WHERE i = 2;
ERROR 1105: execution error: unknown function: JSON_SEARCH
# ---- JSON_VALID — well-formed JSON string returns 1 ----   zeta #1063
# MySQL: 1
SELECT JSON_VALID('{"a": 1}') AS v;
ERROR 1105: execution error: unknown function: JSON_VALID
# ---- JSON_VALID — malformed string returns 0 ----   zeta #1063
# MySQL: 0
SELECT JSON_VALID('{not json}') AS v;
ERROR 1105: execution error: unknown function: JSON_VALID
# ---- JSON_VALID — NULL passes through as NULL ----   zeta #1063
# MySQL: NULL (function is NULL-preserving)
SELECT JSON_VALID(NULL) AS v;
ERROR 1105: execution error: unknown function: JSON_VALID
DROP TABLE t1;
