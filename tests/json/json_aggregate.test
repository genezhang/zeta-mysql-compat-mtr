# ----------------------------------------------------------------------
# Inspired by MySQL 8.0 source:
#   mysql-test/suite/json/inc/json_functions.inc
#   https://github.com/mysql/mysql-server/blob/mysql-8.0.46/mysql-test/suite/json/inc/json_functions.inc
#
# Probes two distinct JSON surfaces:
#   1. Aggregates: JSON_ARRAYAGG, JSON_OBJECTAGG — the GROUP BY
#      builders apps use to roll up rows into a JSON document
#      (e.g., "all line items for this order as a JSON array").
#   2. String escaping: JSON_QUOTE, JSON_UNQUOTE — produce/consume
#      JSON string literals (escape quotes/backslashes/control chars
#      on the way in, unwrap them on the way out).
#
# Both pairs are extremely common in MySQL apps. Zeta has Postgres-
# flavored `JSONB_AGG` and `JSONB_OBJECT_AGG` aggregates but no
# MySQL aliases, and no equivalent for JSON_QUOTE/JSON_UNQUOTE.
#
# Adaptation notes (per UPSTREAM.md rule 2; grep `zeta-adapt:` for hits):
#   # zeta-adapt: not a line-for-line copy; surface probe written to
#     fit the M0 runner. Upstream coverage is in json_functions.inc
#     intermixed with directives the runner does not support.
#   # zeta-adapt: aggregates' MySQL-canonical key ordering would
#     diverge from zeta even after aliases land (see zeta #1062);
#     when divergence surfaces in JSON_OBJECTAGG, `--sorted_result`
#     can keep the .result stable.
#   # zeta-adapt: All four slices of zeta #1063 covered here are now
#     FIXED — JSON_ARRAYAGG / JSON_OBJECTAGG via the alias work,
#     JSON_QUOTE / JSON_UNQUOTE via the text-escaping slice. The
#     .result pins actual values for all four.
# ----------------------------------------------------------------------

DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, grp INT, val TEXT);
INSERT INTO t1 VALUES
  (1, 1, 'apple'),
  (2, 1, 'banana'),
  (3, 2, 'cherry'),
  (4, 2, 'date');

--echo # ---- JSON_ARRAYAGG — roll rows of a group into a JSON array ----   zeta #1063 FIXED
--echo # MySQL / zeta: per-group ["apple","banana"] / ["cherry","date"]
--echo # Use `ORDER BY i` inside the aggregate so element order is
--echo # deterministic regardless of row-read order. (`--sorted_result`
--echo # only sorts result *rows*, not array contents — Copilot caught
--echo # the bug in the original revision of this test.)
SELECT grp, JSON_ARRAYAGG(val ORDER BY i) AS arr FROM t1 GROUP BY grp ORDER BY grp;

--echo # ---- JSON_OBJECTAGG — roll k,v rows into a JSON object ----   zeta #1063 + #1068 FIXED
--echo # MySQL / zeta: {"1":"apple","2":"banana","3":"cherry","4":"date"}
--echo # zeta canonicalizes JSON object keys deterministically — see
--echo # #1062 (alphabetical now, not MySQL's length-then-alpha; the
--echo # all-1-char-keys case here happens to produce the same order
--echo # for both schemes, so this assertion is stable on either side
--echo # of #1062 landing).
SELECT JSON_OBJECTAGG(i, val) AS obj FROM t1;

--echo # ---- JSON_QUOTE — escape a string for JSON ----   zeta #1063 FIXED
--echo # MySQL / zeta: returns "hello \"world\"" (with surrounding double quotes)
SELECT JSON_QUOTE('hello "world"') AS q;

--echo # ---- JSON_UNQUOTE — strip the surrounding quotes from a JSON string ----   zeta #1063 FIXED
--echo # MySQL / zeta: returns "hello" (without surrounding quotes)
SELECT JSON_UNQUOTE('"hello"') AS u;

DROP TABLE t1;
