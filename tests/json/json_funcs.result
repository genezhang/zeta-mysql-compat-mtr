DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);
INSERT INTO t1 VALUES
  (1, '{"a": 1, "b": "two", "c": [3, 4]}'),
  (2, '[10, 20, 30]'),
  (3, '"hello"'),
  (4, 'null'),
  (5, 'true'),
  (6, '42'),
  (7, '3.14');
# ---- JSON_TYPE ----   zeta #1063 FIXED
# MySQL: uppercase scalar tag. zeta covers the seven types its
# JsonbType carries (OBJECT/ARRAY/STRING/NULL/BOOLEAN/INTEGER/
# DOUBLE). MySQL's binary-format-only tags (BLOB/DATE/TIME/
# DATETIME/TIMESTAMP/DECIMAL/OPAQUE) are out of scope.
#
# Known divergence (pinned in zeta integration tests, not here):
# values like `1.0` / `1e0` / `0.0` are stored as Integer by
# JsonbValue::from_decimal, so JSON_TYPE returns INTEGER for
# them rather than DOUBLE. Driven by the storage encoder, not
# the alias.
SELECT i, JSON_TYPE(j) AS t FROM t1 ORDER BY i;
i	t
1	OBJECT
2	ARRAY
3	STRING
4	NULL
5	BOOLEAN
6	INTEGER
7	DOUBLE
# ---- JSON_OBJECT(k,v[,k,v]...) ----   zeta #1063 FIXED
# MySQL / zeta: builds a JSON object literal. zeta canonicalizes
# keys alphabetically (#1062) — `a` precedes `b` either way.
SELECT JSON_OBJECT('a', 1, 'b', 'two') AS o;
o
{"a":1,"b":"two"}
# ---- JSON_ARRAY(v1[,v2]...) ----   zeta #1063 FIXED
# MySQL / zeta: [1, "two", null, true]
SELECT JSON_ARRAY(1, 'two', NULL, true) AS a;
a
[1,"two",null,true]
# ---- JSON_EXTRACT(json, path[, path...]) ----   zeta #1063 FIXED
# MySQL / zeta: $.-rooted JSON path; single match returns the
# value, multi-match returns a JSON array. Path parser shared
# with `->` (zeta #1064).
SELECT JSON_EXTRACT(j, '$.a') AS a FROM t1 WHERE i = 1;
a
1
SELECT JSON_EXTRACT(j, '$.a', '$.b') AS ab FROM t1 WHERE i = 1;
ab
[1,"two"]
# ---- `->` operator with MySQL `$.<key>` path syntax ----   zeta #1064 FIXED
# MySQL / zeta: shorthand for JSON_EXTRACT → 1
SELECT j->'$.a' AS a FROM t1 WHERE i = 1;
a
1
# ---- `->>` operator with MySQL `$.<key>` path syntax ----   zeta #1064 FIXED
# MySQL / zeta: shorthand for JSON_UNQUOTE(JSON_EXTRACT(...)) → two
SELECT j->>'$.b' AS b FROM t1 WHERE i = 1;
b
two
# Same `->` operator with a bare key (PG shape) — currently
# the only form zeta resolves correctly.
SELECT j->'a' AS a_bare FROM t1 WHERE i = 1;
a_bare
1
DROP TABLE t1;
