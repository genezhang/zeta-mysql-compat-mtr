DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);
INSERT INTO t1 VALUES
  (1, '{"a": 1, "b": "two", "c": [3, 4]}'),
  (2, '[10, 20, 30]'),
  (3, '"hello"'),
  (4, 'null'),
  (5, 'true');
# ---- JSON_TYPE ----   zeta #1063
# MySQL: scalar tag ("OBJECT","ARRAY","STRING","NULL","BOOLEAN", etc.)
SELECT i, JSON_TYPE(j) AS t FROM t1 ORDER BY i;
ERROR 1105: execution error: unknown function: JSON_TYPE
# ---- JSON_OBJECT(k,v[,k,v]...) ----   zeta #1063
# MySQL: builds a JSON object literal.
SELECT JSON_OBJECT('a', 1, 'b', 'two') AS o;
ERROR 1105: execution error: unknown function: JSON_OBJECT
# ---- JSON_ARRAY(v1[,v2]...) ----   zeta #1063
SELECT JSON_ARRAY(1, 'two', NULL, true) AS a;
ERROR 1105: execution error: unknown function: JSON_ARRAY
# ---- JSON_EXTRACT(json, path[, path...]) ----   zeta #1063
# MySQL: extracts via $.-rooted JSON path.
SELECT JSON_EXTRACT(j, '$.a') AS a FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_EXTRACT
# ---- `->` operator with MySQL `$.<key>` path syntax ----   zeta #1064 FIXED
# MySQL / zeta: shorthand for JSON_EXTRACT → 1
SELECT j->'$.a' AS a FROM t1 WHERE i = 1;
a
1
# ---- `->>` operator with MySQL `$.<key>` path syntax ----   zeta #1064 FIXED
# MySQL / zeta: shorthand for JSON_UNQUOTE(JSON_EXTRACT(...)) → two
SELECT j->>'$.b' AS b FROM t1 WHERE i = 1;
b
two
# Same `->` operator with a bare key (PG shape) — currently
# the only form zeta resolves correctly.
SELECT j->'a' AS a_bare FROM t1 WHERE i = 1;
a_bare
1
DROP TABLE t1;
