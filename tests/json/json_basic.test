# ----------------------------------------------------------------------
# Adapted (subset) from MySQL 8.0 source:
#   mysql-test/suite/json/inc/json_insert.inc
#   https://github.com/mysql/mysql-server/blob/mysql-8.0.46/mysql-test/suite/json/inc/json_insert.inc
#
# Adaptation notes (per UPSTREAM.md rule 2; grep `zeta-adapt:` for hits):
#   # zeta-adapt: trimmed to the core "CREATE table with JSON column,
#     INSERT, SELECT" surface. Prepared-statement, charset/collation, and
#     geometry slices are deferred to follow-up tests.
#   # zeta-adapt: removed MySQL-specific options (`CHARSET utf8mb4`);
#     zeta defaults match the test's expectations.
#   # zeta-adapt: dropped `--error ER_INVALID_JSON_TEXT` cases — zeta's
#     MySQL shim error-code mapping for malformed JSON literals is a
#     separate gap to characterize before pinning expectations.
#   # zeta-adapt: object key ordering is MySQL-canonical (length-then-
#     alphabetical) as of zeta #1062 — shorter keys first, ties broken
#     alphabetically. Matches MySQL 8.0 (and PostgreSQL jsonb). The
#     remaining cosmetic difference vs MySQL is spacing: zeta emits
#     compact `{"k":"v"}` where MySQL inserts a space after `:`/`,`.
# ----------------------------------------------------------------------

--echo # Verify CREATE TABLE with a JSON column.
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);

--echo # Insert a mix of JSON shapes: object, array, scalar, null literal.
INSERT INTO t1 VALUES (1, '{"a": 2}');
INSERT INTO t1 VALUES (2, '[1, 2, 3]');
INSERT INTO t1 VALUES (3, '"scalar string"');
INSERT INTO t1 VALUES (4, 'true');
INSERT INTO t1 VALUES (5, 'false');
INSERT INTO t1 VALUES (6, 'null');
INSERT INTO t1 VALUES (7, '-1');
INSERT INTO t1 VALUES (8, '3.14');
INSERT INTO t1 VALUES (9, '{}');
INSERT INTO t1 VALUES (10, '[]');

--echo # SQL NULL — distinct from the JSON null literal in row 6.
INSERT INTO t1 VALUES (11, NULL);

--echo # Read back, ordered by the integer key for stable output.
SELECT i, j FROM t1 ORDER BY i;

--echo # Nested object with mixed value types.
INSERT INTO t1 VALUES (12, '{"a":"b", "c":"d", "ab":"abc", "bc": ["x", "y"]}');
SELECT j FROM t1 WHERE i = 12;

--echo # Count by JSON-null vs SQL-null to confirm they are distinct rows.
SELECT COUNT(*) AS total FROM t1;
SELECT COUNT(*) AS with_json_null FROM t1 WHERE i = 6;
SELECT COUNT(*) AS with_sql_null FROM t1 WHERE j IS NULL;

DROP TABLE t1;
