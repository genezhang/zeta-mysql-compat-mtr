DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);
INSERT INTO t1 VALUES
  (1, '{"a": 1, "b": [10, 20, 30], "c": {"nested": true}}'),
  (2, '[1, 2, [3, 4, [5]]]'),
  (3, '{"x": "y"}');
# ---- JSON_KEYS — top-level keys as a JSON array ----   zeta #1063
# MySQL: ["a", "b", "c"]
SELECT JSON_KEYS(j) AS k FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_KEYS
# ---- JSON_LENGTH — count top-level elements ----   zeta #1063
# MySQL: 3 for the object, 3 for the array (top-level count).
SELECT JSON_LENGTH(j) AS len FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_LENGTH
# ---- JSON_DEPTH — max nesting depth ----   zeta #1063
# MySQL: 3 for row 1 (root -> b/c -> nested), 4 for row 2.
SELECT JSON_DEPTH(j) AS d FROM t1 WHERE i = 2;
ERROR 1105: execution error: unknown function: JSON_DEPTH
# ---- JSON_CONTAINS — does haystack contain needle? ----   zeta #1063
# MySQL: 1 (true) when {"a":1} is contained in row 1.
SELECT JSON_CONTAINS(j, '{"a": 1}') AS yes FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_CONTAINS
# ---- JSON_CONTAINS_PATH — does any/all path resolve? ----   zeta #1063
# MySQL: 1 when "one" of the listed paths resolves.
SELECT JSON_CONTAINS_PATH(j, 'one', '$.a', '$.missing') AS yes FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_CONTAINS_PATH
# ---- JSON_OVERLAPS — any element in common ----   zeta #1063
# MySQL 8.0.17+: 1 when any element of two arrays / any key+val
# of two objects matches.
SELECT JSON_OVERLAPS(j, '[2, 3]') AS yes FROM t1 WHERE i = 2;
ERROR 1105: execution error: unknown function: JSON_OVERLAPS
DROP TABLE t1;
