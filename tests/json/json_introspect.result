DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);
INSERT INTO t1 VALUES
  (1, '{"a": 1, "b": [10, 20, 30], "c": {"nested": true}}'),
  (2, '[1, 2, [3, 4, [5]]]'),
  (3, '{"x": "y"}');
# ---- JSON_KEYS — top-level keys as a JSON array ----   IMPLEMENTED
# MySQL: ["a", "b", "c"] (insertion order).
# zeta:  ["a", "b", "c"] (alphabetic — happens to coincide here).
SELECT JSON_KEYS(j) AS k FROM t1 WHERE i = 1;
k
["a","b","c"]
# Sort-divergence probe: input keys NOT in alphabetic order.
# MySQL would return ["z","a","m"]; zeta sorts alphabetically.
SELECT JSON_KEYS('{"z":1,"a":2,"m":3}') AS sorted_keys;
sorted_keys
["a","m","z"]
# ---- JSON_LENGTH — count top-level elements ----   IMPLEMENTED
# MySQL / zeta: 3 for the object, 3 for the array (top-level count).
SELECT JSON_LENGTH(j) AS len FROM t1 WHERE i = 1;
len
3
SELECT JSON_LENGTH(j) AS len FROM t1 WHERE i = 2;
len
3
# ---- JSON_DEPTH — max nesting depth ----   IMPLEMENTED
# MySQL / zeta: 3 for row 1 (root -> c -> bool, max over
# siblings); 4 for row 2 (root -> arr -> arr -> scalar).
SELECT JSON_DEPTH(j) AS d FROM t1 WHERE i = 1;
d
3
SELECT JSON_DEPTH(j) AS d FROM t1 WHERE i = 2;
d
4
# ---- JSON_CONTAINS — does haystack contain needle? ----   IMPLEMENTED
# MySQL / zeta: 1 (true) when {"a":1} is contained in row 1.
SELECT JSON_CONTAINS(j, '{"a": 1}') AS yes FROM t1 WHERE i = 1;
yes
1
# ---- JSON_CONTAINS_PATH — does any/all path resolve? ----   GAP (untracked)
# MySQL: 1 when "one" of the listed paths resolves.
# zeta:  errors `unknown function: JSON_CONTAINS_PATH`. The
# other 5 introspection functions landed; this one is the
# lone holdout. No tracking issue cited yet.
SELECT JSON_CONTAINS_PATH(j, 'one', '$.a', '$.missing') AS yes FROM t1 WHERE i = 1;
ERROR 1105: execution error: unknown function: JSON_CONTAINS_PATH
# ---- JSON_OVERLAPS — any element in common ----   IMPLEMENTED
# MySQL 8.0.17+ / zeta: 1 when any element of two arrays /
# any key+val of two objects matches.
SELECT JSON_OVERLAPS(j, '[2, 3]') AS yes FROM t1 WHERE i = 2;
yes
1
DROP TABLE t1;
