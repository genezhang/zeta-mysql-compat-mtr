DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (i INT PRIMARY KEY, j JSON);
INSERT INTO t1 VALUES
  (1, '[{"name": "apple", "qty": 3}, {"name": "banana", "qty": 7}]'),
  (2, '[{"name": "cherry", "qty": 5}]');
# ---- JSON_TABLE simple shape ----   zeta #1065 stage 1
# rows: (1,"apple",3) (1,"banana",7) (2,"cherry",5) — one row
# per array element, joined laterally against t1.
SELECT t1.i, jt.name, jt.qty
FROM t1,
     JSON_TABLE(
       t1.j,
       '$[*]' COLUMNS (
         name VARCHAR(20) PATH '$.name',
         qty  INT         PATH '$.qty'
       )
     ) AS jt
ORDER BY t1.i, jt.name;
i	name	qty
1	apple	3
1	banana	7
2	cherry	5
# ---- FOR ORDINALITY ----   zeta #1065 stage 2a
# rn is a 1-based row counter within each lateral expansion,
# restarting per outer row: i=1 -> (1,apple),(2,banana); i=2 -> (1,cherry).
# rows: (1,1,"apple") (1,2,"banana") (2,1,"cherry").
SELECT t1.i, jt.rn, jt.name
FROM t1,
     JSON_TABLE(
       t1.j,
       '$[*]' COLUMNS (
         rn   FOR ORDINALITY,
         name VARCHAR(20) PATH '$.name'
       )
     ) AS jt
ORDER BY t1.i, jt.rn;
i	rn	name
1	1	apple
1	2	banana
2	1	cherry
DROP TABLE t1;
# ---- NESTED PATH ----   zeta #1065 stage 2b
# Parent id repeats per child; an empty/missing nested array still
# emits one parent row with the nested column NULL (outer-join).
# rows: (1,10) (1,20) (2,NULL).
SELECT id, cid
FROM JSON_TABLE(
       '[{"id":1,"ch":[{"c":10},{"c":20}]},{"id":2,"ch":[]}]',
       '$[*]' COLUMNS (
         id  INT PATH '$.id',
         NESTED PATH '$.ch[*]' COLUMNS (cid INT PATH '$.c')
       )
     ) AS jt
ORDER BY id, cid;
id	cid
1	10
1	20
2	NULL
