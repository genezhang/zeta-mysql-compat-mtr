=== Functions zeta already supports ===
# CURRENT_DATE — works as both with and without parens in MySQL/PG.
# Pin the year-month-day shape; ignore the specific date since
# it changes daily.
SELECT LENGTH(CAST(CURRENT_DATE() AS TEXT)) AS date_str_len;
date_str_len
10
# CURRENT_TIME — zeta returns microseconds (HH:MM:SS.NNNNNN);
# MySQL returns HH:MM:SS by default. Pin via SUBSTRING for the
# HH:MM: prefix that both engines share.
SELECT SUBSTRING(CAST(CURRENT_TIME() AS TEXT), 1, 6) LIKE '__:__:' AS shape_ok;
shape_ok
1
# NOW — same microsecond divergence as CURRENT_TIME.
SELECT SUBSTRING(CAST(NOW() AS TEXT), 1, 10) LIKE '____-__-__' AS shape_ok;
shape_ok
1
=== Date arithmetic ===
# DATE_ADD / DATE_SUB / ADDDATE / SUBDATE — zeta #1105 FIXED.
# Parser auto-wraps string literals in CAST(... AS DATE) so
# MySQL apps can write DATE_ADD('2024-03-15', INTERVAL 7 DAY)
# without an explicit ::date cast. Result is Timestamp
# (Date+Interval) for the INTERVAL form and Date for the
# ADDDATE/SUBDATE Int form.
SELECT DATE_ADD('2024-03-15', INTERVAL '7' DAY) AS v;
v
2024-03-22 00:00:00
SELECT DATE_SUB('2024-03-15', INTERVAL '7' DAY) AS v;
v
2024-03-08 00:00:00
SELECT ADDDATE('2024-03-15', 7) AS v;
v
2024-03-22
SELECT SUBDATE('2024-03-15', INTERVAL '7' DAY) AS v;
v
2024-03-08 00:00:00
SELECT SUBDATE('2024-03-15', 7) AS v;
v
2024-03-08
# Datetime literal: parser detects time component and casts
# to TIMESTAMP instead of DATE so parse_date doesn't reject
# the time portion.
SELECT DATE_ADD('2024-03-15 12:00:00', INTERVAL '1' HOUR) AS v;
v
2024-03-15 13:00:00
# DATEDIFF — works directly on string dates (no cast needed).
SELECT DATEDIFF('2024-03-15','2024-03-01') AS v;
v
14
=== Component extraction (PG-flavored only) ===
# zeta provides EXTRACT and TO_CHAR (PG syntax). MySQL apps
# typically call YEAR(d) / MONTH(d) / DAY(d) — those are
# missing in zeta (probed below).
SELECT EXTRACT(YEAR FROM '2024-03-15'::date) AS year;
year
2024
SELECT EXTRACT(MONTH FROM '2024-03-15'::date) AS month;
month
3
SELECT EXTRACT(DAY FROM '2024-03-15'::date) AS day;
day
15
SELECT TO_CHAR('2024-03-15'::date, 'YYYY-MM-DD') AS formatted;
formatted
2024-03-15
=== MySQL aliases for already-supported functions ===
# Pure renames — one match arm each.
# Slice 1 of zeta #1086 — FIXED. Pin via shape-only checks
# since the exact wall-clock value isn't deterministic.
SELECT LENGTH(CAST(CURDATE() AS TEXT)) AS date_str_len;
date_str_len
10
SELECT SUBSTRING(CAST(CURTIME() AS TEXT), 1, 6) LIKE '__:__:' AS shape_ok;
shape_ok
1
SELECT SUBSTRING(CAST(SYSDATE() AS TEXT), 1, 10) LIKE '____-__-__' AS shape_ok;
shape_ok
1
=== MySQL-only direct accessor functions ===
# Slice 2 of zeta #1086 — FIXED. These delegate through
# the existing EXTRACT path with string-literal auto-
# coercion (MySQL apps don't write `::date` casts).
# 2024-03-15 is a Friday.
# MySQL DAYOFWEEK: Sunday=1..Sat=7 → Friday=6
# MySQL WEEKDAY:   Monday=0..Sun=6 → Friday=4
# KNOWN DIVERGENCE: WEEK(d) uses ISO/PG week numbering
# (Mon-start, week 1 contains Jan 4). MySQL default mode 0
# is Sun-start with different boundary rules — for
# 2024-03-15 MySQL mode 0 returns 10, zeta/PG returns 11.
# Pinning the zeta-side value to surface the divergence;
# add a `mode` arg + mode 0 algorithm in a follow-up.
SELECT YEAR('2024-03-15') AS v;
v
2024
SELECT MONTH('2024-03-15') AS v;
v
3
SELECT DAY('2024-03-15') AS v;
v
15
SELECT HOUR('14:30:45') AS v;
v
14
SELECT MINUTE('14:30:45') AS v;
v
30
SELECT SECOND('14:30:45') AS v;
v
45
SELECT DAYOFWEEK('2024-03-15') AS v;
v
6
SELECT DAYOFMONTH('2024-03-15') AS v;
v
15
SELECT DAYOFYEAR('2024-03-15') AS v;
v
75
SELECT WEEKDAY('2024-03-15') AS v;
v
4
SELECT WEEK('2024-03-15') AS v;
v
11
SELECT QUARTER('2024-03-15') AS v;
v
1
=== MySQL-only formatting / conversion ===
# DATE_FORMAT / STR_TO_DATE — MySQL %-format DSL. zeta
# #1093 Phase 1 — FIXED with 13 common directives covering
# ~80% of usage (%Y %y %m %d %H %i %S %T %a %b %W %M %%).
# Phase 2 (remaining 19 directives + lc_time_names) is
# tracked as a follow-up in #1093.
SELECT DATE_FORMAT('2024-03-15', '%Y-%m-%d') AS v;
v
2024-03-15
SELECT DATE_FORMAT('2024-03-15 14:30:45', '%Y-%m-%d %T') AS v;
v
2024-03-15 14:30:45
SELECT DATE_FORMAT('2024-03-15', '%W, %M %d, %Y') AS v;
v
Friday, March 15, 2024
# STR_TO_DATE always returns Timestamp (midnight for date-only
# formats) so the runtime value matches the advertised column
# type. See #1094 review.
SELECT STR_TO_DATE('2024-03-15', '%Y-%m-%d') AS v;
v
2024-03-15 00:00:00
SELECT STR_TO_DATE('2024-03-15 14:30:45', '%Y-%m-%d %T') AS v;
v
2024-03-15 14:30:45
# Epoch conversions. Slice 3c of zeta #1086 — FIXED.
# UNIX_TIMESTAMP() is wall-clock; pin exact 10-digit shape
# so a unit regression (ms = 13 digits, µs = 16) is caught
# rather than passing the length check. 10-digit epoch is
# stable from 2001-09-09 (epoch 1_000_000_000) through
# 2286-11-20 (epoch 9_999_999_999).
SELECT LENGTH(CAST(UNIX_TIMESTAMP() AS TEXT)) = 10 AS shape_ok;
shape_ok
1
# UNIX_TIMESTAMP(d) — fixed-date conversion.
SELECT UNIX_TIMESTAMP('2024-03-15') AS v;
v
1710460800
# FROM_UNIXTIME — inverse round-trip.
SELECT FROM_UNIXTIME(1700000000) AS v;
v
2023-11-14 22:13:20
# Day/month names. Slice 3a of zeta #1086 — FIXED.
SELECT DAYNAME('2024-03-15') AS v;
v
Friday
SELECT MONTHNAME('2024-03-15') AS v;
v
March
# LAST_DAY — end-of-month accessor. Slice 3c of #1086 — FIXED.
SELECT LAST_DAY('2024-02-15') AS v;
v
2024-02-29
# TIMESTAMPDIFF — configurable-unit diff. The unit is a bare
# identifier, not a string — zeta's parser reads it as a
# column reference (errno 1054), so this is BOTH a missing
# function and a parser-grammar gap. MySQL apps would need
# parser support before the function arm helps.
SELECT TIMESTAMPDIFF(DAY, '2024-03-01', '2024-03-15') AS v;
ERROR 1054: column not found: DAY
# TIMEDIFF — signed duration. Slice 3c of #1086 + the
# Interval→TIME MySQL wire encoder from zeta #1096. The
# earlier KNOWN DIVERGENCE (debug-rendered Interval wire
# shape) is now CLOSED — the encoder folds days into hours
# and emits MySQL TIME (`[-]HH:MM:SS[.ffffff]`).
SELECT TIMEDIFF('14:30:45', '12:15:30') AS v;
v
02:15:15
# Negative diff.
SELECT TIMEDIFF('12:00:00', '14:00:00') AS v;
v
-02:00:00
# Sub-second precision.
SELECT TIMEDIFF('2024-03-15 14:30:45', '2024-03-15 12:15:30.123456') AS v;
v
02:15:14.876544
