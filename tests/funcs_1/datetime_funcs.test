# ----------------------------------------------------------------------
# Inspired by MySQL 8.0 source:
#   mysql-test/suite/funcs_1/t/  (functional test suite for built-in
#   date/time functions)
#
# Independently authored probe of the most-used MySQL date/time
# function surface. Same M0 runner conventions as
# tests/funcs_1/string_funcs.test.
#
# Adaptation notes (per UPSTREAM.md rule 2; grep `zeta-adapt:` for hits):
#   # zeta-adapt: not a line-for-line copy of any MySQL .test file.
#     Probe selected by MySQL/PG divergence — the MySQL accessor
#     names (YEAR, MONTH, DAY...) and the format-string family
#     (DATE_FORMAT, STR_TO_DATE) that MySQL apps lean on most.
#   # zeta-adapt: pinned to zeta's *current* behavior. For absent
#     functions we pin `--error 1105`; for functions that exist
#     but need explicit casts we pin the working-with-cast form
#     and note the divergence.
#   # zeta-adapt: filed gap: zeta #1086 — MySQL date/time function
#     aliases & missing functions. Spec lays out 4 fix slices:
#     (1) CURDATE/CURTIME/SYSDATE renames, (2) direct accessor
#     functions (YEAR/MONTH/DAY/...) delegating to EXTRACT,
#     (3) DATE_FORMAT/STR_TO_DATE %-format DSL plus DAY/MONTHNAME,
#     (4) epoch + TIMESTAMPDIFF (the last needs parser work for
#     bare-identifier unit args).
# ----------------------------------------------------------------------

--echo === Functions zeta already supports ===

--echo # CURRENT_DATE — works as both with and without parens in MySQL/PG.
--echo # Pin the year-month-day shape; ignore the specific date since
--echo # it changes daily.
SELECT LENGTH(CAST(CURRENT_DATE() AS TEXT)) AS date_str_len;

--echo # CURRENT_TIME — zeta returns microseconds (HH:MM:SS.NNNNNN);
--echo # MySQL returns HH:MM:SS by default. Pin via SUBSTRING for the
--echo # HH:MM: prefix that both engines share.
SELECT SUBSTRING(CAST(CURRENT_TIME() AS TEXT), 1, 6) LIKE '__:__:' AS shape_ok;

--echo # NOW — same microsecond divergence as CURRENT_TIME.
SELECT SUBSTRING(CAST(NOW() AS TEXT), 1, 10) LIKE '____-__-__' AS shape_ok;

--echo === Date arithmetic (works, requires explicit cast) ===

--echo # DATE_ADD — implementation present but parser doesn't auto-
--echo # coerce string-literal dates. With `::date` it works.
--echo # MySQL would accept DATE_ADD('2024-03-15', INTERVAL 7 DAY).
SELECT DATE_ADD('2024-03-15'::date, INTERVAL '7' DAY) AS v;
SELECT DATE_SUB('2024-03-15'::date, INTERVAL '7' DAY) AS v;
SELECT ADDDATE('2024-03-15'::date, 7) AS v;

--echo # DATEDIFF — works directly on string dates (no cast needed).
SELECT DATEDIFF('2024-03-15','2024-03-01') AS v;

--echo === Component extraction (PG-flavored only) ===
--echo # zeta provides EXTRACT and TO_CHAR (PG syntax). MySQL apps
--echo # typically call YEAR(d) / MONTH(d) / DAY(d) — those are
--echo # missing in zeta (probed below).
SELECT EXTRACT(YEAR FROM '2024-03-15'::date) AS year;
SELECT EXTRACT(MONTH FROM '2024-03-15'::date) AS month;
SELECT EXTRACT(DAY FROM '2024-03-15'::date) AS day;
SELECT TO_CHAR('2024-03-15'::date, 'YYYY-MM-DD') AS formatted;

--echo === MySQL aliases for already-supported functions ===
--echo # Pure renames — one match arm each.
--echo # Slice 1 of zeta #1086 — FIXED. Pin via shape-only checks
--echo # since the exact wall-clock value isn't deterministic.

SELECT LENGTH(CAST(CURDATE() AS TEXT)) AS date_str_len;
SELECT SUBSTRING(CAST(CURTIME() AS TEXT), 1, 6) LIKE '__:__:' AS shape_ok;
SELECT SUBSTRING(CAST(SYSDATE() AS TEXT), 1, 10) LIKE '____-__-__' AS shape_ok;

--echo === MySQL-only direct accessor functions ===
--echo # Slice 2 of zeta #1086 — FIXED. These delegate through
--echo # the existing EXTRACT path with string-literal auto-
--echo # coercion (MySQL apps don't write `::date` casts).
--echo # 2024-03-15 is a Friday.
--echo # MySQL DAYOFWEEK: Sunday=1..Sat=7 → Friday=6
--echo # MySQL WEEKDAY:   Monday=0..Sun=6 → Friday=4
--echo # KNOWN DIVERGENCE: WEEK(d) uses ISO/PG week numbering
--echo # (Mon-start, week 1 contains Jan 4). MySQL default mode 0
--echo # is Sun-start with different boundary rules — for
--echo # 2024-03-15 MySQL mode 0 returns 10, zeta/PG returns 11.
--echo # Pinning the zeta-side value to surface the divergence;
--echo # add a `mode` arg + mode 0 algorithm in a follow-up.

SELECT YEAR('2024-03-15') AS v;
SELECT MONTH('2024-03-15') AS v;
SELECT DAY('2024-03-15') AS v;
SELECT HOUR('14:30:45') AS v;
SELECT MINUTE('14:30:45') AS v;
SELECT SECOND('14:30:45') AS v;
SELECT DAYOFWEEK('2024-03-15') AS v;
SELECT DAYOFMONTH('2024-03-15') AS v;
SELECT DAYOFYEAR('2024-03-15') AS v;
SELECT WEEKDAY('2024-03-15') AS v;
SELECT WEEK('2024-03-15') AS v;
SELECT QUARTER('2024-03-15') AS v;

--echo === MySQL-only formatting / conversion ===

--echo # DATE_FORMAT / STR_TO_DATE — MySQL %-format DSL. No PG
--echo # equivalent (PG uses TO_CHAR / TO_DATE with different syntax).
--error 1105
SELECT DATE_FORMAT('2024-03-15', '%Y-%m-%d') AS v;
--error 1105
SELECT STR_TO_DATE('2024-03-15', '%Y-%m-%d') AS v;

--echo # Epoch conversions. Slice 3c of zeta #1086 — FIXED.
--echo # UNIX_TIMESTAMP() is wall-clock; pin shape (>= 10 digit
--echo # epoch is good through year 2286).
SELECT LENGTH(CAST(UNIX_TIMESTAMP() AS TEXT)) >= 10 AS shape_ok;
--echo # UNIX_TIMESTAMP(d) — fixed-date conversion.
SELECT UNIX_TIMESTAMP('2024-03-15') AS v;
--echo # FROM_UNIXTIME — inverse round-trip.
SELECT FROM_UNIXTIME(1700000000) AS v;

--echo # Day/month names. Slice 3a of zeta #1086 — FIXED.
SELECT DAYNAME('2024-03-15') AS v;
SELECT MONTHNAME('2024-03-15') AS v;

--echo # LAST_DAY — end-of-month accessor. Slice 3c of #1086 — FIXED.
SELECT LAST_DAY('2024-02-15') AS v;

--echo # TIMESTAMPDIFF — configurable-unit diff. The unit is a bare
--echo # identifier, not a string — zeta's parser reads it as a
--echo # column reference (errno 1054), so this is BOTH a missing
--echo # function and a parser-grammar gap. MySQL apps would need
--echo # parser support before the function arm helps.
--error 1054
SELECT TIMESTAMPDIFF(DAY, '2024-03-01', '2024-03-15') AS v;

--echo # TIMEDIFF — signed duration. Slice 3c of #1086 — function
--echo # exists, but the MySQL shim has no encoder for Interval, so
--echo # the wire format is currently zeta's debug-rendered
--echo # `Interval { months: ..., days: ..., microseconds: ... }`.
--echo # MySQL would emit `02:15:15`. Tracking shim-side formatting
--echo # as a separate follow-up; pin current output to surface
--echo # regressions. KNOWN DIVERGENCE.
SELECT TIMEDIFF('14:30:45', '12:15:30') AS v;
