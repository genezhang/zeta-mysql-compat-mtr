=== Setup ===
CREATE TABLE customers (
  id INTEGER PRIMARY KEY,
  email TEXT NOT NULL,
  name VARCHAR(100)
);
CREATE UNIQUE INDEX customers_email_uk ON customers(email);
CREATE INDEX customers_name_idx ON customers(name);
CREATE TABLE orders (
  id INTEGER PRIMARY KEY,
  customer_id INTEGER NOT NULL,
  FOREIGN KEY (customer_id) REFERENCES customers(id)
);
=== Supported: information_schema.schemata ===
# MySQL tools call this at connection setup. zeta returns
# `test` (current DB) and `zeta` (default), pinning shape.
SELECT schema_name FROM information_schema.schemata WHERE schema_name='test';
SCHEMA_NAME
test
=== Supported: information_schema.tables ===
# Probe filters by table_schema (the conventional WHERE).
SELECT table_name FROM information_schema.tables WHERE table_schema='test' ORDER BY table_name;
TABLE_NAME
customers
orders
=== Supported: information_schema.columns ===
# Column metadata for `customers` — pin column_name +
# data_type + key + nullable since they're what every
# ORM autoload reads.
SELECT column_name, data_type, is_nullable, column_key FROM information_schema.columns WHERE table_schema='test' AND table_name='customers' ORDER BY ordinal_position;
COLUMN_NAME	DATA_TYPE	IS_NULLABLE	COLUMN_KEY
id	int	NO	PRI
email	text	NO	UNI
name	varchar	YES	MUL
=== Supported: information_schema.statistics ===
# Index metadata for `customers` — pin PRIMARY +
# secondary indexes with their cardinality info.
SELECT index_name, seq_in_index, column_name, non_unique FROM information_schema.statistics WHERE table_schema='test' AND table_name='customers' ORDER BY index_name, seq_in_index;
INDEX_NAME	SEQ_IN_INDEX	COLUMN_NAME	NON_UNIQUE
PRIMARY	1	id	0
customers_email_uk	1	email	0
customers_name_idx	1	name	1
=== Supported: information_schema.key_column_usage (#1100 Phase 1) ===
# MySQL apps query this to discover foreign keys. zeta now
# emits one row per PK / UK / FK column. FK rows carry
# REFERENCED_TABLE_NAME / REFERENCED_COLUMN_NAME and the
# POSITION_IN_UNIQUE_CONSTRAINT of the referenced column in
# the parent's PK/UK (NULL for PK / UK rows themselves).
# KNOWN DIVERGENCE: FK constraint_name is the fully-qualified
# internal name (`test.public.orders_customer_id_fkey`); MySQL
# would emit the bare auto-generated name.
SELECT constraint_name, table_name, column_name, ordinal_position, position_in_unique_constraint, referenced_table_name, referenced_column_name FROM information_schema.key_column_usage WHERE table_schema='test' ORDER BY table_name, constraint_name, ordinal_position;
CONSTRAINT_NAME	TABLE_NAME	COLUMN_NAME	ORDINAL_POSITION	POSITION_IN_UNIQUE_CONSTRAINT	REFERENCED_TABLE_NAME	REFERENCED_COLUMN_NAME
PRIMARY	customers	id	1	NULL	NULL	NULL
customers_email_uk	customers	email	1	NULL	NULL	NULL
PRIMARY	orders	id	1	NULL	NULL	NULL
test.public.orders_customer_id_fkey	orders	customer_id	1	1	customers	id
=== Supported: information_schema.table_constraints (#1100 Phase 1) ===
# Schema-migration tooling (Liquibase, Flyway) reads this to
# find PRIMARY KEY / UNIQUE / FOREIGN KEY constraint names.
SELECT constraint_name, table_name, constraint_type FROM information_schema.table_constraints WHERE table_schema='test' ORDER BY table_name, constraint_type, constraint_name;
CONSTRAINT_NAME	TABLE_NAME	CONSTRAINT_TYPE
PRIMARY	customers	PRIMARY KEY
customers_email_uk	customers	UNIQUE
PRIMARY	orders	PRIMARY KEY
test.public.orders_customer_id_fkey	orders	FOREIGN KEY
=== Supported: information_schema.referential_constraints (#1100 Phase 1) ===
# MySQL apps cross-reference this with KEY_COLUMN_USAGE to get
# UPDATE_RULE / DELETE_RULE for foreign keys.
# UNIQUE_CONSTRAINT_NAME resolves to "PRIMARY" when the FK
# targets the parent PK; to the matching unique-index name
# otherwise; NULL when the parent isn't resolvable.
# KNOWN DIVERGENCE: default referential action when none was
# specified is NO ACTION (matches MySQL/SQL-standard); zeta
# parses MySQL's omitted-clause shape the same way.
SELECT constraint_name, table_name, referenced_table_name, unique_constraint_name, update_rule, delete_rule FROM information_schema.referential_constraints WHERE constraint_schema='test';
CONSTRAINT_NAME	TABLE_NAME	REFERENCED_TABLE_NAME	UNIQUE_CONSTRAINT_NAME	UPDATE_RULE	DELETE_RULE
test.public.orders_customer_id_fkey	orders	customers	PRIMARY	NO ACTION	NO ACTION
=== Supported: information_schema.views (#1100 Phase 1) ===
# VIEWS now exposes definition / check_option / is_updatable.
# Probe the empty case first, then create a view and probe again.
SELECT table_name, is_updatable FROM information_schema.views WHERE table_schema='test';
CREATE VIEW customer_emails AS SELECT id, email FROM customers;
SELECT table_name, view_definition, check_option, is_updatable FROM information_schema.views WHERE table_schema='test';
TABLE_NAME	VIEW_DEFINITION	CHECK_OPTION	IS_UPDATABLE
customer_emails	SELECT id, email FROM customers	NONE	NO
=== Supported: information_schema.character_sets (#1100 Phase 2) ===
# Connection-time probe by many MySQL drivers. zeta advertises
# utf8mb4 via lookup_system_variable; the directory now exposes
# the same single row.
# KNOWN DIVERGENCE: only utf8mb4 is exposed; latin1 / ascii /
# binary etc. are not — zeta runs utf8mb4-only.
SELECT * FROM information_schema.character_sets WHERE character_set_name='utf8mb4';
CHARACTER_SET_NAME	DEFAULT_COLLATE_NAME	DESCRIPTION	MAXLEN
utf8mb4	utf8mb4_general_ci	UTF-8 Unicode	4
# Probe a non-existent charset — empty result confirms the
# filter works (the row above isn't always returned).
SELECT * FROM information_schema.character_sets WHERE character_set_name='latin1';
=== Supported: information_schema.collations (#1100 Phase 2) ===
# Common ORM probe. zeta exposes a single utf8mb4_general_ci
# collation (id=45, matches MySQL's well-known assignment).
# KNOWN DIVERGENCE: only utf8mb4_general_ci is exposed; the
# other utf8mb4 collations (utf8mb4_unicode_ci, utf8mb4_bin)
# are not.
SELECT * FROM information_schema.collations WHERE collation_name='utf8mb4_general_ci';
COLLATION_NAME	CHARACTER_SET_NAME	ID	IS_DEFAULT	IS_COMPILED	SORTLEN
utf8mb4_general_ci	utf8mb4	45	Yes	Yes	1
=== Supported: information_schema.engines (#1100 Phase 2) ===
# MySQL `SHOW ENGINES` / engine-introspection tooling. zeta
# presents itself as InnoDB-compatible (matches the
# default_storage_engine sysvar). Transactions / XA /
# savepoints all advertised as supported.
SELECT * FROM information_schema.engines;
ENGINE	SUPPORT	COMMENT	TRANSACTIONS	XA	SAVEPOINTS
InnoDB	DEFAULT	Supports transactions, row-level locking, and foreign keys	YES	YES	YES
=== Supported: information_schema.routines (#1100 Phase 3) ===
# PROCEDURE / FUNCTION metadata. zeta only has trigger functions
# (no stored procedures / general user functions with typed
# parameters), so they surface as ROUTINE_TYPE='FUNCTION' with
# DATA_TYPE='trigger'. The shim scopes them to the connection's
# current database so `WHERE routine_schema = DATABASE()` works.
CREATE FUNCTION audit_fn() RETURNS trigger AS 'BEGIN RETURN NEW; END' LANGUAGE plpgsql;
SELECT ROUTINE_SCHEMA, ROUTINE_NAME, ROUTINE_TYPE, DATA_TYPE,
       ROUTINE_BODY, EXTERNAL_LANGUAGE, SECURITY_TYPE
  FROM information_schema.routines WHERE routine_schema='test';
ROUTINE_SCHEMA	ROUTINE_NAME	ROUTINE_TYPE	DATA_TYPE	ROUTINE_BODY	EXTERNAL_LANGUAGE	SECURITY_TYPE
test	audit_fn	FUNCTION	trigger	SQL	SQL	DEFINER
=== Supported: information_schema.parameters (#1100 Phase 3) ===
# zeta has no stored procedures or general user functions with
# typed parameters, so PARAMETERS is always empty — but the
# documented 8-column header is emitted so introspection tools
# see "view exists, no rows" instead of "view missing".
#
# Load-bearing probe: project ORDINAL_POSITION + PARAMETER_NAME.
# Both are Phase 3-only columns (not in the pre-Phase-3 catch-all
# stub's 4-col TABLE_CATALOG/TABLE_SCHEMA/TABLE_NAME/CONSTRAINT_NAME
# header), so the old stub would error 1054 here. Empty rowset
# plus successful projection is the actual assertion.
SELECT ORDINAL_POSITION, PARAMETER_NAME FROM information_schema.parameters WHERE specific_schema='test';
=== Function-call projection gap ===
# zeta's info_schema query parser does not accept COUNT(*)
# (or any function-call / expression projection) in any
# info_schema view. ORMs / migration tools that issue
# `SELECT COUNT(*) FROM information_schema.tables` to size
# a connection pool will get errno 1235 instead of a row.
# Note: errno 1235 (ER_NOT_SUPPORTED_YET) rather than 1054.
SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='test';
ERROR 1235: information_schema queries with function call or expression are not yet supported by zeta's MySQL wire shim
