# ----------------------------------------------------------------------
# Inspired by MySQL 8.0 source:
#   mysql-test/suite/funcs_1/t/ (information_schema coverage —
#   independently authored probe of the views MySQL apps and
#   ORMs lean on most).
#
# Adaptation notes (per UPSTREAM.md rule 2; grep `zeta-adapt:` for hits):
#   # zeta-adapt: not a line-for-line copy of any MySQL .test file.
#     Probe selected from the views MySQL tools and ORMs hit at
#     connection setup (SCHEMATA / TABLES / COLUMNS / STATISTICS)
#     plus the schema-introspection views (KEY_COLUMN_USAGE,
#     TABLE_CONSTRAINTS, REFERENTIAL_CONSTRAINTS, VIEWS) that
#     Liquibase / Flyway / SQLAlchemy autoload use.
#   # zeta-adapt: pinned to zeta's *current* behavior. Supported
#     views get the actual returned rows; unsupported views still
#     get a "returns 0 rows / 0 cols" pin so the divergence is visible.
#   # zeta-adapt: zeta #1100 Phase 1 — FIXED: KEY_COLUMN_USAGE /
#     TABLE_CONSTRAINTS / REFERENTIAL_CONSTRAINTS / VIEWS now return
#     real rows. Phase 2 (character_sets / collations / engines)
#     and Phase 3 (routines) tracked as follow-ups in #1100.
#   # zeta-adapt: KNOWN DIVERGENCE — FK constraint names are stored
#     with the fully-qualified internal prefix (`test.public.<name>`).
#     MySQL stores them bare. The output is pinned to zeta's current
#     spelling; matches how zeta also names indexes for SHOW INDEX.
# ----------------------------------------------------------------------

--echo === Setup ===

CREATE TABLE customers (
  id INTEGER PRIMARY KEY,
  email TEXT NOT NULL,
  name VARCHAR(100)
);
CREATE UNIQUE INDEX customers_email_uk ON customers(email);
CREATE INDEX customers_name_idx ON customers(name);

CREATE TABLE orders (
  id INTEGER PRIMARY KEY,
  customer_id INTEGER NOT NULL,
  FOREIGN KEY (customer_id) REFERENCES customers(id)
);

--echo === Supported: information_schema.schemata ===
--echo # MySQL tools call this at connection setup. zeta returns
--echo # `test` (current DB) and `zeta` (default), pinning shape.

SELECT schema_name FROM information_schema.schemata WHERE schema_name='test';

--echo === Supported: information_schema.tables ===
--echo # Probe filters by table_schema (the conventional WHERE).

SELECT table_name FROM information_schema.tables WHERE table_schema='test' ORDER BY table_name;

--echo === Supported: information_schema.columns ===
--echo # Column metadata for `customers` — pin column_name +
--echo # data_type + key + nullable since they're what every
--echo # ORM autoload reads.

SELECT column_name, data_type, is_nullable, column_key FROM information_schema.columns WHERE table_schema='test' AND table_name='customers' ORDER BY ordinal_position;

--echo === Supported: information_schema.statistics ===
--echo # Index metadata for `customers` — pin PRIMARY +
--echo # secondary indexes with their cardinality info.

SELECT index_name, seq_in_index, column_name, non_unique FROM information_schema.statistics WHERE table_schema='test' AND table_name='customers' ORDER BY index_name, seq_in_index;

--echo === Supported: information_schema.key_column_usage (#1100 Phase 1) ===
--echo # MySQL apps query this to discover foreign keys. zeta now
--echo # emits one row per PK / UK / FK column. FK rows carry
--echo # REFERENCED_TABLE_NAME / REFERENCED_COLUMN_NAME and the
--echo # POSITION_IN_UNIQUE_CONSTRAINT of the referenced column in
--echo # the parent's PK/UK (NULL for PK / UK rows themselves).
--echo # KNOWN DIVERGENCE: FK constraint_name is the fully-qualified
--echo # internal name (`test.public.orders_customer_id_fkey`); MySQL
--echo # would emit the bare auto-generated name.

SELECT constraint_name, table_name, column_name, ordinal_position, position_in_unique_constraint, referenced_table_name, referenced_column_name FROM information_schema.key_column_usage WHERE table_schema='test' ORDER BY table_name, constraint_name, ordinal_position;

--echo === Supported: information_schema.table_constraints (#1100 Phase 1) ===
--echo # Schema-migration tooling (Liquibase, Flyway) reads this to
--echo # find PRIMARY KEY / UNIQUE / FOREIGN KEY constraint names.

SELECT constraint_name, table_name, constraint_type FROM information_schema.table_constraints WHERE table_schema='test' ORDER BY table_name, constraint_type, constraint_name;

--echo === Supported: information_schema.referential_constraints (#1100 Phase 1) ===
--echo # MySQL apps cross-reference this with KEY_COLUMN_USAGE to get
--echo # UPDATE_RULE / DELETE_RULE for foreign keys.
--echo # UNIQUE_CONSTRAINT_NAME resolves to "PRIMARY" when the FK
--echo # targets the parent PK; to the matching unique-index name
--echo # otherwise; NULL when the parent isn't resolvable.
--echo # KNOWN DIVERGENCE: default referential action when none was
--echo # specified is NO ACTION (matches MySQL/SQL-standard); zeta
--echo # parses MySQL's omitted-clause shape the same way.

SELECT constraint_name, table_name, referenced_table_name, unique_constraint_name, update_rule, delete_rule FROM information_schema.referential_constraints WHERE constraint_schema='test';

--echo === Supported: information_schema.views (#1100 Phase 1) ===
--echo # VIEWS now exposes definition / check_option / is_updatable.
--echo # Probe the empty case first, then create a view and probe again.

SELECT table_name, is_updatable FROM information_schema.views WHERE table_schema='test';

CREATE VIEW customer_emails AS SELECT id, email FROM customers;

SELECT table_name, view_definition, check_option, is_updatable FROM information_schema.views WHERE table_schema='test';

--echo === Unsupported: information_schema.character_sets ===
--echo # Connection-time probe by many MySQL drivers. KNOWN
--echo # DIVERGENCE — character_set is hardcoded to utf8mb4 in
--echo # the wire shim but the directory isn't exposed.
--echo # Tracked as zeta #1100 Phase 2.

SELECT * FROM information_schema.character_sets WHERE character_set_name='utf8mb4';

--echo === Unsupported: information_schema.collations ===
--echo # Common ORM probe. KNOWN DIVERGENCE. Tracked as #1100 Phase 2.

SELECT * FROM information_schema.collations WHERE collation_name='utf8mb4_general_ci';

--echo === Unsupported: information_schema.engines ===
--echo # MySQL `SHOW ENGINES` / engine-introspection tooling.
--echo # KNOWN DIVERGENCE. Tracked as #1100 Phase 2.

SELECT * FROM information_schema.engines;

--echo === Unsupported: information_schema.routines ===
--echo # PROCEDURE / FUNCTION metadata. KNOWN DIVERGENCE.
--echo # Tracked as #1100 Phase 3.

SELECT * FROM information_schema.routines WHERE routine_schema='test';

--echo === Function-call projection gap ===
--echo # zeta's info_schema query parser does not accept COUNT(*)
--echo # (or any function-call / expression projection) in any
--echo # info_schema view. ORMs / migration tools that issue
--echo # `SELECT COUNT(*) FROM information_schema.tables` to size
--echo # a connection pool will get errno 1235 instead of a row.
--echo # Note: errno 1235 (ER_NOT_SUPPORTED_YET) rather than 1054.

--error 1235
SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='test';
