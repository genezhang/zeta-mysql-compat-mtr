# Independently authored SEQUENCE smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test (MySQL has no CREATE SEQUENCE; this is PG
# surface); pins zeta's SEQUENCE / NEXTVAL / CURRVAL /
# SETVAL surface and the SERIAL alias.
#
# Adaptation notes:
#   # zeta-adapt: CREATE SEQUENCE <name> — supported. Defaults
#     to START 1, INCREMENT 1.
#   # zeta-adapt: CREATE SEQUENCE … START WITH <n> — supported.
#   # zeta-adapt: CREATE SEQUENCE … INCREMENT BY <n> —
#     supported.
#   # zeta-adapt: CREATE SEQUENCE … INCREMENT BY -<n> —
#     supported (descending sequences).
#   # zeta-adapt: CREATE SEQUENCE … MINVALUE / MAXVALUE —
#     parsed; MAXVALUE enforced for ascending sequences
#     (NEXTVAL errors 1105 "reached maximum value"). See
#     gaps for MINVALUE and CYCLE.
#   # zeta-adapt: NEXTVAL(<text>) — supported. Returns BIGINT.
#   # zeta-adapt: CURRVAL(<text>) — supported. Returns the
#     last NEXTVAL value in this session. Errors 1105
#     "currval … is not yet defined in this session" if
#     NEXTVAL has not been called.
#   # zeta-adapt: SETVAL(<text>, <n>) (2-arg) — supported.
#     Returns the set value; subsequent NEXTVAL returns n+1.
#   # zeta-adapt: NEXTVAL on an unknown sequence — errors
#     1105 "sequence … does not exist".
#   # zeta-adapt: SERIAL (= INT SEQUENCE-backed column) —
#     supported. INSERT without the column auto-fills 1, 2,
#     3, ….
#   # zeta-adapt: DROP SEQUENCE / DROP SEQUENCE IF EXISTS —
#     supported. The IF EXISTS form is a no-op on a missing
#     sequence (no error).
#   # zeta-adapt: KNOWN GAP — CREATE SEQUENCE … CYCLE is
#     parsed but NOT honoured. After NEXTVAL hits MAXVALUE,
#     the next call errors 1105 "reached maximum value"
#     instead of cycling back to the start.
#   # zeta-adapt: KNOWN GAP — MINVALUE is NOT enforced for
#     descending sequences. NEXTVAL silently continues past
#     MINVALUE rather than erroring (the MAXVALUE side is
#     enforced; the floor side is not).
#   # zeta-adapt: KNOWN GAP — `column DEFAULT NEXTVAL('seq')`
#     errors 1105 "internal error: key codec error: type
#     mismatch … expected Int64, got String" on INSERT.
#     NEXTVAL evidently is bound as a text-returning function
#     when placed in a DEFAULT clause. Substitute: declare
#     the column as SERIAL / BIGSERIAL, or pass NEXTVAL
#     explicitly in each INSERT's VALUES list.
#   # zeta-adapt: KNOWN GAP — ALTER SEQUENCE errors 1064
#     "Expected: one of VIEW or TYPE or TABLE or INDEX …,
#     found: SEQUENCE". To change increment / start / bounds,
#     DROP and re-CREATE the sequence.
#   # zeta-adapt: KNOWN GAP — LASTVAL() errors 1105 "unknown
#     function: LASTVAL". Use CURRVAL('<name>') instead (the
#     name-bound variant).
#   # zeta-adapt: KNOWN GAP — 3-arg SETVAL(name, n,
#     is_called) is parsed and returns n, but the
#     `is_called` flag is IGNORED — the next NEXTVAL always
#     returns n+1, never n. To preseed so that the next
#     NEXTVAL returns n, set the value to n-1 with the 2-arg
#     form.

--echo === CREATE SEQUENCE (defaults) + NEXTVAL + CURRVAL ===

DROP SEQUENCE IF EXISTS s_basic;
CREATE SEQUENCE s_basic;
SELECT NEXTVAL('s_basic') AS v1, NEXTVAL('s_basic') AS v2, NEXTVAL('s_basic') AS v3;
SELECT CURRVAL('s_basic') AS c;
DROP SEQUENCE s_basic;

--echo === CREATE SEQUENCE START WITH <n> ===

DROP SEQUENCE IF EXISTS s_start;
CREATE SEQUENCE s_start START WITH 100;
SELECT NEXTVAL('s_start') AS v1, NEXTVAL('s_start') AS v2;
DROP SEQUENCE s_start;

--echo === CREATE SEQUENCE START WITH + INCREMENT BY ===

DROP SEQUENCE IF EXISTS s_inc;
CREATE SEQUENCE s_inc START WITH 10 INCREMENT BY 5;
SELECT NEXTVAL('s_inc') AS v1, NEXTVAL('s_inc') AS v2, NEXTVAL('s_inc') AS v3;
DROP SEQUENCE s_inc;

--echo === Descending sequence (negative INCREMENT) ===

DROP SEQUENCE IF EXISTS s_neg;
CREATE SEQUENCE s_neg START WITH 100 INCREMENT BY -10;
SELECT NEXTVAL('s_neg') AS v1, NEXTVAL('s_neg') AS v2, NEXTVAL('s_neg') AS v3;
DROP SEQUENCE s_neg;

--echo === MAXVALUE enforced for ascending sequence ===
--echo # After NEXTVAL hits MAXVALUE, the next call errors 1105.

DROP SEQUENCE IF EXISTS s_maxv;
CREATE SEQUENCE s_maxv START WITH 5 MINVALUE 5 MAXVALUE 7;
SELECT NEXTVAL('s_maxv') AS v1, NEXTVAL('s_maxv') AS v2, NEXTVAL('s_maxv') AS v3;
--error 1105
SELECT NEXTVAL('s_maxv') AS overflow;
DROP SEQUENCE s_maxv;

--echo === SETVAL (2-arg) + subsequent NEXTVAL ===

DROP SEQUENCE IF EXISTS s_setval;
CREATE SEQUENCE s_setval;
SELECT SETVAL('s_setval', 50) AS s;
SELECT NEXTVAL('s_setval') AS v;
DROP SEQUENCE s_setval;

--echo === CURRVAL before any NEXTVAL — errno 1105 ===

DROP SEQUENCE IF EXISTS s_cv0;
CREATE SEQUENCE s_cv0;
--error 1105
SELECT CURRVAL('s_cv0') AS c;
DROP SEQUENCE s_cv0;

--echo === NEXTVAL on missing sequence — errno 1105 ===

DROP SEQUENCE IF EXISTS s_missing;
--error 1105
SELECT NEXTVAL('s_missing') AS v;

--echo === SERIAL — auto-increment column ===

DROP TABLE IF EXISTS t_ser;
CREATE TABLE t_ser (id SERIAL PRIMARY KEY, name TEXT);
INSERT INTO t_ser (name) VALUES ('a'), ('b'), ('c');
SELECT id, name FROM t_ser ORDER BY id;
DROP TABLE t_ser;

--echo === DROP SEQUENCE IF EXISTS — no-op on missing ===

DROP SEQUENCE IF EXISTS s_no_such;
DROP SEQUENCE IF EXISTS s_no_such;

--echo === KNOWN GAP: CYCLE parsed but not honoured — errno 1105 ===
--echo # Substitute: DROP + re-CREATE, or wrap NEXTVAL in
--echo # ((NEXTVAL(x) - 1) % range) + lo.

DROP SEQUENCE IF EXISTS s_cycle;
CREATE SEQUENCE s_cycle START WITH 1 MAXVALUE 3 CYCLE;
SELECT NEXTVAL('s_cycle') AS v1, NEXTVAL('s_cycle') AS v2, NEXTVAL('s_cycle') AS v3;
--error 1105
SELECT NEXTVAL('s_cycle') AS should_cycle_back_to_1;
DROP SEQUENCE s_cycle;

--echo === KNOWN GAP: MINVALUE not enforced for descending ===
--echo # NEXTVAL silently continues past MINVALUE. Compare
--echo # with the ascending MAXVALUE case above which errors.

DROP SEQUENCE IF EXISTS s_minneg;
CREATE SEQUENCE s_minneg START WITH 0 INCREMENT BY -1 MINVALUE -3;
SELECT NEXTVAL('s_minneg') AS v1, NEXTVAL('s_minneg') AS v2, NEXTVAL('s_minneg') AS v3, NEXTVAL('s_minneg') AS v4;
SELECT NEXTVAL('s_minneg') AS past_minvalue;
DROP SEQUENCE s_minneg;

--echo === KNOWN GAP: column DEFAULT NEXTVAL — errno 1105 (type) ===
--echo # "type mismatch … expected Int64, got String" — NEXTVAL
--echo # in a DEFAULT clause is bound as a text-returning
--echo # function. Substitute: SERIAL/BIGSERIAL, or pass
--echo # NEXTVAL in each INSERT's VALUES list.

DROP TABLE IF EXISTS t_dflt;
DROP SEQUENCE IF EXISTS s_dflt;
CREATE SEQUENCE s_dflt START WITH 100;
CREATE TABLE t_dflt (id BIGINT DEFAULT NEXTVAL('s_dflt') PRIMARY KEY, name TEXT);
--error 1105
INSERT INTO t_dflt (name) VALUES ('x');
DROP TABLE t_dflt;
DROP SEQUENCE s_dflt;

--echo === KNOWN GAP: ALTER SEQUENCE — errno 1064 ===
--echo # Substitute: DROP + re-CREATE.

DROP SEQUENCE IF EXISTS s_alt;
CREATE SEQUENCE s_alt START WITH 1;
--error 1064
ALTER SEQUENCE s_alt INCREMENT BY 10;
DROP SEQUENCE s_alt;

--echo === KNOWN GAP: LASTVAL() — errno 1105 ===
--echo # Substitute: CURRVAL('<name>').

DROP SEQUENCE IF EXISTS s_lv;
CREATE SEQUENCE s_lv;
SELECT NEXTVAL('s_lv') AS n;
--error 1105
SELECT LASTVAL() AS l;
DROP SEQUENCE s_lv;
