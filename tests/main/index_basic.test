# Independently authored INDEX smoke test for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's mysql-test/t/index.test;
# pins zeta's behavior across common MySQL index shapes.
#
# Adaptation notes:
#   # zeta-adapt: CREATE INDEX <name> ON <tbl>(<col>) — supported
#     for single and multi-column BTree indexes. Default is non-
#     unique; UNIQUE keyword enables uniqueness enforcement.
#   # zeta-adapt: CREATE INDEX IF NOT EXISTS — KNOWN DIVERGENCE.
#     The `IF NOT EXISTS` clause is currently NOT honored: a
#     second CREATE on the same index name errors with 1105 just
#     like the no-IF-NOT-EXISTS form. MySQL silently no-ops.
#     Pinned below; covers the same code path as the duplicate-
#     CREATE divergence (same 1105 + same message format).
#   # zeta-adapt: DROP INDEX <name> ON <tbl> — supported.
#   # zeta-adapt: unique-violation errno is 1062 (MySQL standard),
#     with message wrapping "duplicate key value violates unique
#     constraint" and the index name.
#   # zeta-adapt: SHOW INDEX FROM <tbl> — supported. Emits 6
#     columns: Table, Non_unique, Key_name, Seq_in_index,
#     Column_name, Index_type. MySQL's canonical row has more
#     columns (Sub_part, Packed, Null, Comment, Visible, ...);
#     they aren't pinned here.
#   # zeta-adapt: information_schema.STATISTICS — supported with
#     at least TABLE_NAME, INDEX_NAME, COLUMN_NAME.
#   # zeta-adapt: KNOWN DIVERGENCE — duplicate CREATE INDEX (no
#     IF NOT EXISTS) errors with 1105 ("schema mismatch ... index
#     'X' already exists"). MySQL uses 1061 ("Duplicate key name").
#     Pinned below; alignment would help error-catch logic.

--echo === Setup ===

DROP TABLE IF EXISTS u;
CREATE TABLE u (id INT PRIMARY KEY, email VARCHAR(40), name VARCHAR(20), age INT);

--echo === CREATE INDEX (non-unique) ===

CREATE INDEX idx_name ON u(name);

--echo === CREATE UNIQUE INDEX + uniqueness enforcement ===

CREATE UNIQUE INDEX idx_email ON u(email);
INSERT INTO u VALUES (1, 'a@x', 'alice', 30), (2, 'b@x', 'bob', 25);
SELECT id, email FROM u ORDER BY id;

--echo === Duplicate unique value — errno 1062 ===

--error 1062
INSERT INTO u VALUES (3, 'a@x', 'alice2', 28);

--echo === DROP INDEX ===

DROP INDEX idx_name ON u;

--echo === CREATE INDEX IF NOT EXISTS — first call creates ===
--echo # KNOWN DIVERGENCE (NOT pinned with --error): MySQL
--echo # treats a second CREATE INDEX IF NOT EXISTS on the same
--echo # name as a silent no-op; zeta errors with 1105. The
--echo # equivalent CREATE INDEX without IF NOT EXISTS also
--echo # errors with 1105 (MySQL uses 1061). Both error messages
--echo # contain the internal table_id which varies with suite
--echo # run order — not pinned to avoid brittleness.

CREATE INDEX IF NOT EXISTS idx_age ON u(age);

--echo === Multi-column CREATE INDEX ===

DROP TABLE IF EXISTS mc;
CREATE TABLE mc (id INT PRIMARY KEY, a INT, b INT);
CREATE INDEX idx_ab ON mc(a, b);

--echo === SHOW INDEX FROM u — 6-column shape ===

--sorted_result
SHOW INDEX FROM u;

--echo === SHOW INDEX FROM mc — multi-column index has one row per column ===

--sorted_result
SHOW INDEX FROM mc;

--echo === information_schema.STATISTICS metadata ===
--echo # zeta does not currently honor ORDER BY on
--echo # information_schema.STATISTICS rows; --sorted_result
--echo # lex-sorts client-side to keep the assertion stable.

--sorted_result
SELECT TABLE_NAME, INDEX_NAME, COLUMN_NAME
  FROM information_schema.STATISTICS
  WHERE TABLE_NAME IN ('u', 'mc');

--echo === Cleanup ===

DROP TABLE u;
DROP TABLE mc;
