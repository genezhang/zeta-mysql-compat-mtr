# Independently authored ENUM_FIRST / ENUM_LAST / ENUM_RANGE
# smoke for the GPL MTR-format runner. NOT copied or adapted
# from MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - ENUM_FIRST / ENUM_LAST / ENUM_RANGE — NONE (zero
#     compat-mtr coverage). PG enum-introspection functions.
#   - enum_type_basic_extra.test covers CREATE TYPE ... AS
#     ENUM, ordering, comparison, but NOT the introspection
#     functions.
#
# This slice pins:
#   - ENUM_FIRST(NULL::enum_type) returns the first label.
#   - ENUM_LAST(NULL::enum_type) returns the last label.
#   - ENUM_RANGE(NULL::enum_type) returns an Array of all
#     labels in declaration order (renders as Rust Debug
#     over MySQL wire — same shim leak pattern as PR #343).
#   - All three accept the PG idiom `NULL::type_name` to
#     pass the enum-type identity (no actual value needed).
#   - Unknown type name → 1105 'requires an enum type, but
#     "<name>" is not an enum'.
#   - Non-enum type (e.g. INT) → same 1105 message.
#   - Arity (0, 2 args) → 1105 'requires exactly 1 argument'.
#
# Big-picture finding:
#   The arg position is consumed for TYPE INFERENCE ONLY —
#   the actual Value is irrelevant (always NULL in idiomatic
#   use). The impl resolves the enum type from the AST cast
#   target, not from the runtime value. So `NULL::mood` and
#   any other expression of mood type would work; the value
#   itself is discarded.
#
#   Unknown vs non-enum types share ONE error message:
#   '<fn>() requires an enum type, but "<type_name>" is not
#   an enum'. The impl deliberately conflates "unknown type"
#   and "known non-enum type" (lib.rs:55634-55639) to avoid
#   leaking distinguishable type-existence info (per impl
#   comment).
#
#   ENUM_RANGE returns Value::Array of Enum elements. Over
#   the MySQL wire, this renders as Rust Debug format
#   (`Array { element_type: Enum { ... }, elements: [...] }`)
#   because the value_to_mysql shim at zeta-mysqlwire/src/
#   shim.rs:327 has no Array arm — same server-side wire
#   leak documented in PR #343.
#
# Adaptation notes:
#   # zeta-adapt: ENUM_FIRST/LAST/RANGE take a typed-NULL
#     arg (PG idiom: NULL::enum_type_name).
#   # zeta-adapt: Unknown OR non-enum type → 1105 with
#     ONE shared message — '<fn>() requires an enum type,
#     but "<name>" is not an enum'. Deliberate (privacy).
#   # zeta-adapt: ENUM_RANGE wire-renders as Rust Debug
#     Array (server-side shim leak).

--echo === Setup: create an enum type with 3 labels in declaration order ===

CREATE TYPE mood_ehb AS ENUM ('sad', 'ok', 'happy');

--echo === ENUM_FIRST returns first label ===

SELECT ENUM_FIRST(NULL::mood_ehb)                             AS first_label;

--echo === ENUM_LAST returns last label ===

SELECT ENUM_LAST(NULL::mood_ehb)                              AS last_label;

--echo === ENUM_RANGE returns Array of all labels (declaration order) ===

# Wire-renders as Rust Debug format — see PR #343 for the
# shim-leak background.
SELECT ENUM_RANGE(NULL::mood_ehb)                             AS all_labels;

--echo === Equality of ENUM_FIRST/LAST results against label strings ===

# Cast the Enum result back to TEXT so it compares against
# the literal string.
SELECT CAST(ENUM_FIRST(NULL::mood_ehb) AS TEXT) = 'sad'       AS first_eq_sad;
SELECT CAST(ENUM_LAST(NULL::mood_ehb)  AS TEXT) = 'happy'     AS last_eq_happy;

--echo === Error: unknown type name → 1105 ===

--error 1105
SELECT ENUM_FIRST(NULL::nonexistent_type);
--error 1105
SELECT ENUM_LAST(NULL::nonexistent_type);
--error 1105
SELECT ENUM_RANGE(NULL::nonexistent_type);

--echo === Error: known non-enum type (INT) → SAME 1105 message ===

# Deliberate conflation with unknown-type error per impl
# comment at lib.rs:55634-55639.
--error 1105
SELECT ENUM_FIRST(NULL::INT);
--error 1105
SELECT ENUM_LAST(NULL::INT);

--echo === Error: arity (0, 2 args) → 1105 ===

--error 1105
SELECT ENUM_FIRST();
--error 1105
SELECT ENUM_LAST();
--error 1105
SELECT ENUM_RANGE();
--error 1105
SELECT ENUM_FIRST(NULL::mood_ehb, NULL::mood_ehb);

--echo === Empty enum: ENUM_FIRST/LAST → NULL, ENUM_RANGE → empty Array ===

# An empty enum is parser-accepted (enum_type_basic_extra:116).
# Asymmetry pinned: ENUM_FIRST/LAST return NULL when labels
# is empty (lib.rs:55666 / 55677), but ENUM_RANGE returns a
# NON-NULL empty Array (lib.rs:55679-55694 — map over empty
# labels yields empty elements, wrapped in Value::Array).
CREATE TYPE empty_ehb AS ENUM ();
SELECT ENUM_FIRST(NULL::empty_ehb)                            AS empty_first_null;
SELECT ENUM_LAST(NULL::empty_ehb)                             AS empty_last_null;
SELECT ENUM_FIRST(NULL::empty_ehb) IS NULL                    AS empty_first_pred;
SELECT ENUM_LAST(NULL::empty_ehb)  IS NULL                    AS empty_last_pred;
# ENUM_RANGE returns a non-NULL Array even for empty labels.
SELECT ENUM_RANGE(NULL::empty_ehb)                            AS empty_range_array;
SELECT ENUM_RANGE(NULL::empty_ehb) IS NULL                    AS empty_range_NOT_null;
DROP TYPE empty_ehb;

--echo === Cleanup ===

DROP TYPE mood_ehb;
