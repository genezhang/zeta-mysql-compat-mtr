=== MySQL DATE_ADD / DATE_SUB ===
SELECT DATE_ADD(DATE '2024-01-01', INTERVAL 7 DAY) AS d_plus_7;
d_plus_7
2024-01-08 00:00:00
SELECT DATE_SUB(DATE '2024-01-08', INTERVAL 7 DAY) AS d_minus_7;
d_minus_7
2024-01-01 00:00:00
=== MySQL DATEDIFF / TIMESTAMPDIFF ===
SELECT DATEDIFF(DATE '2024-05-19', DATE '2024-05-10') AS dd;
dd
9
SELECT TIMESTAMPDIFF(DAY,   DATE '2024-05-10', DATE '2024-05-19') AS d_unit;
d_unit
9
SELECT TIMESTAMPDIFF(HOUR,  TIMESTAMP '2024-05-19 10:00:00', TIMESTAMP '2024-05-19 14:00:00') AS h_unit;
h_unit
4
SELECT TIMESTAMPDIFF(MONTH, DATE '2024-01-15', DATE '2024-05-19') AS m_unit;
m_unit
4
=== PG DATE_PART (alias for EXTRACT) ===
SELECT DATE_PART('year', DATE '2024-05-19') AS y;
y
2024
SELECT DATE_PART('month', TIMESTAMP '2024-05-19 14:30:45') AS m;
m
5
=== MySQL day/month name family ===
SELECT DAYOFWEEK(DATE '2024-05-19') AS dow, DAYOFMONTH(DATE '2024-05-19') AS dom, DAYOFYEAR(DATE '2024-05-19') AS doy;
dow	dom	doy
1	19	140
SELECT WEEK(DATE '2024-05-19') AS wk;
wk
20
SELECT MONTHNAME(DATE '2024-05-19') AS mn, DAYNAME(DATE '2024-05-19') AS dn;
mn	dn
May	Sunday
=== LAST_DAY of month ===
SELECT LAST_DAY(DATE '2024-02-15') AS feb_end;
feb_end
2024-02-29
=== ADDDATE / SUBDATE — integer-day form ===
SELECT ADDDATE(DATE '2024-01-01', 7) AS plus;
plus
2024-01-08
SELECT SUBDATE(DATE '2024-01-08', 7) AS minus;
minus
2024-01-01
=== Multi-component INTERVAL ===
SELECT INTERVAL '1 year 2 months' AS yr_mo;
yr_mo
1 year 2 mons
SELECT INTERVAL '1 day 12 hours' AS day_hr;
day_hr
36:00:00
SELECT INTERVAL '1:30:45' HOUR_SECOND;
HOUR_SECOND
01:30:45
=== INTERVAL addition ===
SELECT INTERVAL 1 YEAR + INTERVAL 2 MONTH AS yr_plus_mo;
yr_plus_mo
1 year 2 mons
=== FROM_UNIXTIME / UNIX_TIMESTAMP ===
SELECT FROM_UNIXTIME(1700000000) AS from_ts;
from_ts
2023-11-14 22:13:20
SELECT UNIX_TIMESTAMP(TIMESTAMP '2023-11-14 22:13:20') AS to_epoch;
to_epoch
1700000000
=== CURDATE() — same-call equality (deterministic by day) ===
SELECT CURDATE() = CURDATE() AS same_day;
same_day
1
=== NOW() / CURRENT_TIMESTAMP — relational only (non-deterministic) ===
SELECT NOW() > TIMESTAMP '2020-01-01 00:00:00' AS in_future;
in_future
1
=== KNOWN DIVERGENCE: DATE_ADD on DATE returns TIMESTAMP, not DATE ===
SELECT DATE_ADD(DATE '2024-01-01', INTERVAL 1 DAY) AS d_returns_ts;
d_returns_ts
2024-01-02 00:00:00
=== FIXED: ADDTIME (TIME, TIME) now supported ===
SELECT ADDTIME(TIME '10:00:00', TIME '01:30:00') AS r;
r
11:30:00
=== FIXED: SUBTIME (TIME, TIME) now supported ===
SELECT SUBTIME(TIME '14:30:00', TIME '01:30:00') AS r;
r
13:00:00
=== MAKETIME (MySQL) — works ===
SELECT MAKETIME(14, 30, 45) AS t;
t
14:30:45
=== MAKE_DATE / MAKE_TIME (PG spelling) — work ===
SELECT MAKE_DATE(2024, 5, 19) AS d, MAKE_TIME(14, 30, 45) AS t;
d	t
2024-05-19	14:30:45
=== MAKEDATE (MySQL day-of-year form) — supported ===
SELECT MAKEDATE(2024, 140) AS d;
d
2024-05-19
SELECT MAKEDATE(2024, 367) AS rollover;
rollover
2025-01-01
SELECT MAKEDATE(2024, 0) AS d_zero;
d_zero
NULL
=== KNOWN GAP: INTERVAL n MICROSECOND — errno 1064 ===
SELECT INTERVAL 1 MICROSECOND;
ERROR 1064: SQL parse error: unsupported interval field: MICROSECOND
=== KNOWN GAP: INTERVAL n QUARTER — errno 1064 ===
SELECT INTERVAL 1 QUARTER;
ERROR 1064: SQL parse error: unsupported interval field: QUARTER
=== KNOWN GAP: INTERVAL n DECADE — errno 1064 ===
SELECT INTERVAL 1 DECADE;
ERROR 1064: SQL parse error: unsupported interval field: DECADE
=== KNOWN GAP: INTERVAL n CENTURY — errno 1064 ===
SELECT INTERVAL 1 CENTURY;
ERROR 1064: SQL parse error: unsupported interval field: CENTURY
