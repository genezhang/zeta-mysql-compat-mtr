=== Boolean operator precedence — NOT > AND > OR ===
SELECT TRUE OR FALSE AND FALSE AS p1;
p1
1
SELECT NOT TRUE OR TRUE AS p2;
p2
1
SELECT FALSE AND NOT FALSE AS p3;
p3
0
=== Parens override precedence ===
SELECT (TRUE OR FALSE) AND FALSE AS expl;
expl
0
SELECT TRUE AND (TRUE OR FALSE) AS expl2;
expl2
1
=== 3VL AND truth table ===
SELECT TRUE AND NULL AS tan, FALSE AND NULL AS fan, NULL AND TRUE AS nta, NULL AND FALSE AS nfa;
tan	fan	nta	nfa
NULL	0	NULL	0
=== 3VL OR truth table ===
SELECT TRUE OR NULL AS ton, FALSE OR NULL AS fon, NULL OR TRUE AS nto, NULL OR FALSE AS nfo;
ton	fon	nto	nfo
1	NULL	1	NULL
=== NOT — NULL propagates, TRUE/FALSE flip ===
SELECT NOT NULL AS not_nl, NOT TRUE AS not_t, NOT FALSE AS not_f;
not_nl	not_t	not_f
NULL	0	1
=== TRUE / FALSE literals (case-insensitive) ===
SELECT TRUE AS up_t, FALSE AS up_f, true AS lo_t, false AS lo_f;
up_t	up_f	lo_t	lo_f
1	0	1	0
=== String → BOOLEAN cast ===
SELECT 'true'::BOOLEAN AS s_true, 'false'::BOOLEAN AS s_false, 't'::BOOLEAN AS s_t, 'yes'::BOOLEAN AS s_yes;
s_true	s_false	s_t	s_yes
1	0	1	1
=== IS UNKNOWN / IS NOT UNKNOWN ===
SELECT TRUE IS UNKNOWN AS t_u, NULL IS UNKNOWN AS n_u, FALSE IS UNKNOWN AS f_u;
t_u	n_u	f_u
0	1	0
=== CASE WHEN <bool literal or comparison> ===
SELECT CASE WHEN TRUE THEN 1 ELSE 0 END AS r_lit, CASE WHEN 1 < 2 THEN 'yes' ELSE 'no' END AS r_cmp;
r_lit	r_cmp
1	yes
=== KNOWN DIVERGENCE: 1 = TRUE and 0 = FALSE both return FALSE ===
# MySQL would coerce INT to BOOL for equality; zeta keeps the
# types distinct and the comparison silently resolves to FALSE.
SELECT 1 = TRUE AS one_eq_t, 0 = FALSE AS zero_eq_f;
one_eq_t	zero_eq_f
0	0
=== KNOWN DIVERGENCE: 1 AND 0 returns NULL (MySQL: 0) ===
SELECT 1 AND 0 AS and_int;
and_int
NULL
=== KNOWN DIVERGENCE: WHERE on INT col — errno 1105 ===
DROP TABLE IF EXISTS bi;
CREATE TABLE bi (id INT, n INT);
INSERT INTO bi VALUES (1, 0), (2, 1), (3, 10);
SELECT id, n FROM bi WHERE n;
ERROR 1105: execution error: predicate did not evaluate to boolean
=== KNOWN GAP: BOOL + INT arithmetic — errno 1105 ===
SELECT TRUE + 1;
ERROR 1105: execution error: arithmetic op requires numbers
=== KNOWN GAP: XOR infix operator — errno 1064 ===
SELECT TRUE XOR FALSE;
ERROR 1064: SQL parse error: unsupported binary operator: XOR
DROP TABLE bi;
