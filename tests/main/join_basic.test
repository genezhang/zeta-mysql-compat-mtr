# Independently authored JOIN smoke test for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's mysql-test/t/join*.test;
# pins zeta's behavior across the JOIN shapes ORMs and query
# generators emit.
#
# Adaptation notes:
#   # zeta-adapt: INNER JOIN ... ON — supported (standard).
#   # zeta-adapt: LEFT JOIN / RIGHT JOIN / FULL OUTER JOIN — all
#     supported. RIGHT preserves the right side; FULL preserves both.
#   # zeta-adapt: CROSS JOIN — supported, no ON clause.
#   # zeta-adapt: comma-join (legacy MySQL) — supported. Treated as
#     CROSS JOIN; the WHERE clause carries the join predicate.
#   # zeta-adapt: USING (col) — supported. Produces a single merged
#     column for `col` (one row per matching pair), matching MySQL +
#     PG semantics for the join condition.
#   # zeta-adapt: KNOWN DIVERGENCE — USING(col) column-naming. zeta
#     advertises the merged column with table prefixes (e.g.
#     `e1.cid, e1.x, e2.y`) instead of MySQL's plain `cid, x, y`.
#     Tracked separately; doesn't affect query semantics. Asserted
#     below as observed.
#   # zeta-adapt: NATURAL JOIN — join predicate is inferred from the
#     common columns BUT the projection is NOT deduplicated. zeta
#     returns both `e1.cid` and `e2.cid`; MySQL would return a single
#     `cid`. Documented + asserted below.
#   # zeta-adapt: self-join (same table aliased twice) — supported.
#   # zeta-adapt: multi-table JOIN chain (A JOIN B ON ... JOIN C ON ...)
#     — supported.
#   # zeta-adapt: ON with composite condition (AND / extra predicates)
#     — supported.
#   # zeta-adapt: outer-join + WHERE filter on the outer side promotes
#     to inner-style filter — supported (standard SQL).
#   # zeta-adapt: STRAIGHT_JOIN — supported (FIXED via zeta #1133).
#     Treated as a synonym for INNER JOIN; the MySQL optimizer hint
#     is non-binding here since zeta's planner doesn't honor any join
#     hints. Pinned below as a positive assertion.
#   # zeta-adapt: INNER JOIN without ON — supported (FIXED via zeta
#     #1135). Bare INNER JOIN with no ON/USING/NATURAL constraint is
#     now treated as CROSS JOIN (cartesian product), matching MySQL.
#     Pinned below as a positive assertion.

--echo === Setup ===

DROP TABLE IF EXISTS emp;
CREATE TABLE emp (id INT PRIMARY KEY, name VARCHAR(10), dept_id INT);
INSERT INTO emp VALUES (1, 'alice', 10), (2, 'bob', 10), (3, 'carol', 20), (4, 'dan', NULL);

DROP TABLE IF EXISTS dept;
CREATE TABLE dept (id INT PRIMARY KEY, name VARCHAR(10));
INSERT INTO dept VALUES (10, 'eng'), (20, 'sales'), (30, 'ops');

DROP TABLE IF EXISTS sales;
CREATE TABLE sales (id INT PRIMARY KEY, emp_id INT, amt INT);
INSERT INTO sales VALUES (1, 1, 500), (2, 2, 300), (3, 3, 200);

--echo === INNER JOIN — matched rows only ===

SELECT e.name AS emp, d.name AS dept
  FROM emp e INNER JOIN dept d ON e.dept_id = d.id
  ORDER BY emp;

--echo === LEFT JOIN — preserves left side (NULL right when unmatched) ===

SELECT e.name AS emp, d.name AS dept
  FROM emp e LEFT JOIN dept d ON e.dept_id = d.id
  ORDER BY emp;

--echo === RIGHT JOIN — preserves right side ===

SELECT e.name AS emp, d.name AS dept
  FROM emp e RIGHT JOIN dept d ON e.dept_id = d.id
  ORDER BY dept, emp;

--echo === FULL OUTER JOIN — preserves both sides ===

--sorted_result
SELECT e.name AS emp, d.name AS dept
  FROM emp e FULL OUTER JOIN dept d ON e.dept_id = d.id;

--echo === CROSS JOIN — cartesian product, no ON ===

--sorted_result
SELECT e.name AS emp, d.name AS dept
  FROM emp e CROSS JOIN dept d;

--echo === Comma-join (legacy MySQL syntax) — predicate in WHERE ===

SELECT e.name AS emp, d.name AS dept
  FROM emp e, dept d
  WHERE e.dept_id = d.id
  ORDER BY emp;

--echo === USING (col) — collapses common column ===
--echo # KNOWN DIVERGENCE: zeta column-names the merged column with
--echo # table prefixes (e1.cid etc.); MySQL emits plain names.

DROP TABLE IF EXISTS e1;
DROP TABLE IF EXISTS e2;
CREATE TABLE e1 (cid INT, x INT);
INSERT INTO e1 VALUES (1, 100), (2, 200);
CREATE TABLE e2 (cid INT, y VARCHAR(5));
INSERT INTO e2 VALUES (1, 'a'), (2, 'b');
SELECT * FROM e1 JOIN e2 USING (cid) ORDER BY cid;

--echo === NATURAL JOIN — KNOWN DIVERGENCE (no projection dedup) ===
--echo # MySQL collapses the common column; zeta returns it from
--echo # both sides. Predicate inference still matches on `cid`,
--echo # so the row count is correct (one per matching pair).

SELECT * FROM e1 NATURAL JOIN e2 ORDER BY e1.cid;

--echo === Multi-table JOIN chain — A JOIN B JOIN C ===

SELECT e.name AS emp, d.name AS dept, s.amt
  FROM emp e
  JOIN dept d ON e.dept_id = d.id
  JOIN sales s ON s.emp_id = e.id
  ORDER BY emp;

--echo === Anti-join via LEFT JOIN + IS NULL ===
--echo # Returns employees with no matching dept (classic outer-anti pattern).

SELECT e.name AS emp
  FROM emp e LEFT JOIN dept d ON e.dept_id = d.id
  WHERE d.id IS NULL
  ORDER BY emp;

--echo === Self-join — same table aliased twice ===

DROP TABLE IF EXISTS mgr;
CREATE TABLE mgr (id INT PRIMARY KEY, name VARCHAR(10), boss_id INT);
INSERT INTO mgr VALUES (1, 'alice', NULL), (2, 'bob', 1), (3, 'carol', 1), (4, 'dan', 2);
SELECT m.name AS emp, b.name AS boss
  FROM mgr m LEFT JOIN mgr b ON m.boss_id = b.id
  ORDER BY emp;

--echo === ON with composite predicate (AND) ===

SELECT e.name AS emp, s.amt
  FROM emp e JOIN sales s ON s.emp_id = e.id AND s.amt > 250
  ORDER BY emp;

--echo === STRAIGHT_JOIN — FIXED via zeta #1133 ===
--echo # MySQL optimizer hint; zeta accepts and treats as INNER JOIN.

SELECT e.name AS emp, d.name AS dept
  FROM emp e STRAIGHT_JOIN dept d ON e.dept_id = d.id
  ORDER BY emp;

--echo === INNER JOIN without ON — FIXED via zeta #1135 ===
--echo # zeta now treats bare INNER JOIN as CROSS JOIN (matches
--echo # MySQL). 4 emp rows × 3 dept rows = 12 rows.

--sorted_result
SELECT e.name AS emp, d.name AS dept FROM emp e INNER JOIN dept d;

--echo === Cleanup ===

DROP TABLE mgr;
DROP TABLE sales;
DROP TABLE dept;
DROP TABLE emp;
DROP TABLE e1;
DROP TABLE e2;
