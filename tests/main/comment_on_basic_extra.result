=== Setup ===
DROP TABLE IF EXISTS ct;
CREATE TABLE ct (id INT PRIMARY KEY, n INT);
INSERT INTO ct VALUES (1, 10);
=== COMMENT ON TABLE ... IS '...' — parsed, silent no-op ===
COMMENT ON TABLE ct IS 'my table';
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'COMMENT ON TABLE ct IS 'my table'' at line 1
=== COMMENT ON COLUMN ...col IS '...' ===
COMMENT ON COLUMN ct.n IS 'numeric column';
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'COMMENT ON COLUMN ct.n IS 'numeric column'' at line 1
=== COMMENT ON SCHEMA public IS '...' ===
COMMENT ON SCHEMA public IS 'public schema';
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'COMMENT ON SCHEMA public IS 'public schema'' at line 1
=== COMMENT ON ... IS NULL — parsed, no error ===
COMMENT ON TABLE ct IS NULL;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'COMMENT ON TABLE ct IS NULL' at line 1
=== KNOWN DIVERGENCE: info_schema.tables.table_comment stays empty ===
SELECT table_name, table_comment
  FROM information_schema.tables
  WHERE table_name = 'ct';
TABLE_NAME	TABLE_COMMENT
ct	
=== KNOWN DIVERGENCE: info_schema.columns.column_comment stays empty ===
SELECT column_name, column_comment
  FROM information_schema.columns
  WHERE table_name = 'ct'
  ORDER BY ordinal_position;
COLUMN_NAME	COLUMN_COMMENT
id	
n	
DROP TABLE ct;
=== MySQL inline: column COMMENT '...' / table COMMENT='...' — parsed ===
DROP TABLE IF EXISTS mct;
CREATE TABLE mct (
  id INT PRIMARY KEY COMMENT 'pk col',
  n  INT             COMMENT 'a number'
) COMMENT='my mysql table';
=== SHOW CREATE TABLE strips the COMMENT clauses ===
SHOW CREATE TABLE mct;
Table	Create Table
mct	CREATE TABLE `mct` (
  `id` int NOT NULL COMMENT 'pk col',
  `n` int DEFAULT NULL COMMENT 'a number',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='my mysql table'
=== MySQL inline COMMENTs also don't reach info_schema ===
SELECT table_name, table_comment FROM information_schema.tables WHERE table_name = 'mct';
TABLE_NAME	TABLE_COMMENT
mct	my mysql table
SELECT column_name, column_comment FROM information_schema.columns WHERE table_name = 'mct' ORDER BY ordinal_position;
COLUMN_NAME	COLUMN_COMMENT
id	pk col
n	a number
DROP TABLE mct;
