=== Multi-col index with mixed ASC/DESC ===
DROP TABLE IF EXISTS imc;
CREATE TABLE imc (id INT PRIMARY KEY, a INT, b INT);
CREATE INDEX imc_ab ON imc (a ASC, b DESC);
SHOW INDEX FROM imc;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
imc	0	PRIMARY	1	id	A	<masked>	<masked>	NULL		BTREE			YES	NULL
imc	1	imc_ab	1	a	A	<masked>	<masked>	NULL	YES	BTREE			YES	NULL
imc	1	imc_ab	2	b	D	<masked>	<masked>	NULL	YES	BTREE			YES	NULL
