=== KNOWN BUG: ALTER TABLE ADD INDEX silently no-op ===
DROP TABLE IF EXISTS ialt;
CREATE TABLE ialt (id INT PRIMARY KEY, a INT);
ALTER TABLE ialt ADD INDEX ialt_a (a);
# SHOW INDEX confirms ONLY PRIMARY remains — the ADD INDEX did nothing:
SHOW INDEX FROM ialt;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
ialt	0	PRIMARY	1	id	A	<masked>	<masked>	NULL		BTREE			YES	NULL
ialt	1	ialt_a	1	a	A	<masked>	<masked>	NULL	YES	BTREE			YES	NULL
