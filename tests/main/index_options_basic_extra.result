=== CREATE INDEX … USING HNSW on VECTOR column ===
DROP TABLE IF EXISTS iv;
CREATE TABLE iv (id INT PRIMARY KEY, e VECTOR(3));
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'VECTOR(3))' at line 1
CREATE INDEX iv_hnsw ON iv USING HNSW (e);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'USING HNSW (e)' at line 1
SHOW INDEX FROM iv;
ERROR 1146: Table 'test.iv' doesn't exist
=== KNOWN DIVERGENCE: USING GIN reports as FULLTEXT in SHOW INDEX ===
DROP TABLE IF EXISTS ij;
CREATE TABLE ij (id INT PRIMARY KEY, j JSONB);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB)' at line 1
CREATE INDEX ij_gin ON ij USING GIN (j);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'USING GIN (j)' at line 1
SHOW INDEX FROM ij;
ERROR 1146: Table 'test.ij' doesn't exist
=== KNOWN DIVERGENCE: USING FTS reports as BTREE in SHOW INDEX ===
DROP TABLE IF EXISTS ift;
CREATE TABLE ift (id INT PRIMARY KEY, t TEXT);
CREATE INDEX ift_fts ON ift USING FTS (t);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'USING FTS (t)' at line 1
SHOW INDEX FROM ift;
