=== ALTER TABLE … DROP INDEX (MySQL spelling) ===
DROP TABLE IF EXISTS idr;
CREATE TABLE idr (id INT PRIMARY KEY, a INT);
CREATE INDEX idr_a ON idr (a);
ALTER TABLE idr DROP INDEX idr_a;
SHOW INDEX FROM idr;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
idr	0	PRIMARY	1	id	A	<masked>	<masked>	NULL		BTREE			YES	NULL
=== Duplicate index name → errno 1061 ===
DROP TABLE IF EXISTS idup;
CREATE TABLE idup (id INT PRIMARY KEY, a INT);
CREATE INDEX idup_a ON idup (a);
CREATE INDEX idup_a ON idup (a);
ERROR 1061: Duplicate key name 'idup_a'
=== KNOWN BUG: CREATE INDEX IF NOT EXISTS does NOT suppress 1061 ===
CREATE INDEX IF NOT EXISTS idup_a ON idup (a);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'IF NOT EXISTS idup_a ON idup (a)' at line 1
