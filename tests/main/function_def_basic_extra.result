=== CREATE FUNCTION (SQL) — parses + catalogs silently ===
DROP FUNCTION IF EXISTS sqlfn;
CREATE FUNCTION sqlfn(x INT) RETURNS INT AS $body$ SELECT x + 1 $body$ LANGUAGE SQL;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '$body$ SELECT x + 1 $body$ LANGUAGE SQL' at line 1
=== KNOWN GAP: invocation of user function — errno 1105 ===
# The CREATE just above succeeded, but the SELECT
# below errors "unknown function" — user functions
# are catalogued but not dispatched.
SELECT sqlfn(5) AS r;
ERROR 1305: FUNCTION test.sqlfn does not exist
=== DROP FUNCTION (catalog cleanup works) ===
DROP FUNCTION sqlfn;
ERROR 1305: FUNCTION test.sqlfn does not exist
