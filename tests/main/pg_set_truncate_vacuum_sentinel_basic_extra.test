# Independently authored SET TIME ZONE / SET CONSTRAINTS
# / SET SESSION AUTHORIZATION / TRUNCATE CONTINUE+RESTART
# IDENTITY / VACUUM FREEZE sentinel slice for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - SET TIME ZONE, SET CONSTRAINTS, SET SESSION
#     AUTHORIZATION: ZERO prior coverage.
#   - RESET TIME ZONE / RESET SESSION AUTHORIZATION:
#     ZERO prior coverage.
#   - TRUNCATE ... CONTINUE / RESTART IDENTITY: ZERO
#     prior coverage. (delete_basic_extra + delete_
#     options_basic_extra cover TRUNCATE CASCADE,
#     not CONTINUE/RESTART IDENTITY.)
#   - VACUUM FREEZE / VACUUM (options...) form: ZERO
#     prior coverage. (vacuum_analyze_basic_extra
#     covers bare VACUUM and VACUUM ANALYZE only.)
#
# Pre-existing shape patterns acknowledged:
#   - Generic SET-as-no-op compat shim — documented at
#     zeta-parser/src/ast.rs:117 "SET variable = value
#     (accepted as no-op for client compatibility)".
#     ALL SET variants route through this handler.
#   - "Expected: end of statement, found: <KW>" — well-
#     established sqlparser pattern; multiple priors.
#
# This slice pins:
#
#   INTENTIONAL COMPAT NO-OP — SET TIME ZONE (5 forms):
#     - 'UTC' / 'America/Los_Angeles' / INTERVAL form /
#       LOCAL / DEFAULT
#     - All silently succeed via zeta-parser/src/ast.rs:
#       117 generic SET no-op. NOT a bug — apps porting
#       PG code that does SET TIME ZONE for session-tz
#       management will see no-error but no actual TZ
#       change. (Combined with TIMESTAMPTZ silent TZ-
#       truncation per PR #398, apps need to do all
#       TZ math application-side.)
#
#   INTENTIONAL COMPAT NO-OP — SET CONSTRAINTS (3 forms):
#     - SET CONSTRAINTS ALL DEFERRED / IMMEDIATE / by
#       name DEFERRED — all silent success via same
#       generic SET no-op path. Apps that rely on
#       deferred constraint checking will silently get
#       eager checking instead. (Zeta has no deferred-
#       constraint surface.)
#
#   INTENTIONAL COMPAT NO-OP — SET SESSION AUTHORIZATION:
#     - 'alice' / DEFAULT — silent success via same path.
#     - But RESET SESSION AUTHORIZATION ERRORS — see
#       below. The RESET form is NOT in the generic
#       compat-shim.
#
#   PARSE-REJECTED — RESET TIME ZONE / RESET SESSION
#   AUTHORIZATION:
#     - "Expected: end of statement, found: ZONE at col
#       12" — sqlparser parses RESET as a statement-
#       terminator-eligible single-token thing; the
#       trailing ZONE / AUTHORIZATION isn't accepted.
#     - Asymmetric with SET (which succeeds silently).
#       The SET no-op shim doesn't cover RESET.
#
#   SUPPORTED — TRUNCATE ... CONTINUE IDENTITY /
#   RESTART IDENTITY (3 forms):
#     - TRUNCATE t CONTINUE IDENTITY: subsequent
#       INSERT continues from highest prior id+1 (in
#       probe, after rows 1/2/3 truncated CONTINUE,
#       next INSERT gets id=4).
#     - TRUNCATE t RESTART IDENTITY: subsequent INSERT
#       restarts from 1.
#     - TRUNCATE TABLE t CONTINUE IDENTITY CASCADE:
#       silent success — CASCADE clause accepted but
#       no cascading to dependent tables verified
#       (no FK-bearing tables in test).
#     - Both behaviors verified end-to-end against
#       SERIAL column.
#
#   PARSE-REJECTED — VACUUM FREEZE variants (3 forms):
#     - VACUUM FREEZE t / VACUUM FULL FREEZE t →
#       "Expected: end of statement, found: t_cont"
#       — the FREEZE option doesn't accept a table
#       name after it. Bare `VACUUM` and `VACUUM
#       ANALYZE` work (per vacuum_analyze_basic_extra),
#       but FREEZE variants are unsupported.
#     - VACUUM (FREEZE, ANALYZE) t → "Expected: end
#       of statement, found: (" — the PG paren-
#       option form isn't recognized at all.
#
# Big-picture finding:
#
#   Session-management SET statements are deliberate
#   compat no-ops — apps relying on the side-effects
#   (TZ change, deferred constraints, role switch)
#   will silently get the wrong behavior. Combined
#   with TIMESTAMPTZ silent-truncation (PR #398) this
#   means apps must NEVER rely on zeta-side time-zone
#   handling.
#
#   TRUNCATE CONTINUE/RESTART IDENTITY are genuinely
#   supported — a positive finding.
#
#   VACUUM FREEZE and paren-option forms are unreachable
#   beyond bare VACUUM / VACUUM ANALYZE.
#
# Adaptation notes:
#   # zeta-adapt: INTENTIONAL COMPAT NO-OP — SET TIME
#     ZONE / SET CONSTRAINTS / SET SESSION
#     AUTHORIZATION all silent-success via generic SET
#     handler (ast.rs:117). NO side effect — handle
#     session TZ / deferred constraints / role switch
#     application-side.
#   # zeta-adapt: KNOWN GAP — RESET TIME ZONE / RESET
#     SESSION AUTHORIZATION error 1064 at parse time
#     (RESET shim doesn't cover the X TIME ZONE / X
#     AUTHORIZATION targets).
#   # zeta-adapt: SUPPORTED — TRUNCATE CONTINUE IDENTITY
#     and TRUNCATE RESTART IDENTITY behave per PG
#     semantics (verified by SERIAL probe).
#   # zeta-adapt: KNOWN GAP — VACUUM FREEZE (any form)
#     and VACUUM (paren options) error 1064.

--echo === INTENTIONAL COMPAT NO-OP — SET TIME ZONE (5 forms) via ast.rs:117 generic SET ===

SET TIME ZONE 'UTC';
SET TIME ZONE 'America/Los_Angeles';
SET TIME ZONE INTERVAL '+05:30' HOUR TO MINUTE;
SET TIME ZONE LOCAL;
SET TIME ZONE DEFAULT;

--echo === INTENTIONAL COMPAT NO-OP — SET CONSTRAINTS (3 forms) same path ===

SET CONSTRAINTS ALL DEFERRED;
SET CONSTRAINTS ALL IMMEDIATE;
SET CONSTRAINTS my_fk DEFERRED;

--echo === INTENTIONAL COMPAT NO-OP — SET SESSION AUTHORIZATION (2 forms) same path ===

SET SESSION AUTHORIZATION 'alice';
SET SESSION AUTHORIZATION DEFAULT;

--echo === PARSE-REJECTED — RESET TIME ZONE / RESET SESSION AUTHORIZATION (asymmetric with SET) ===

# The RESET shim doesn't cover these trailing-keyword forms.
--error 1064
RESET TIME ZONE;
--error 1064
RESET SESSION AUTHORIZATION;

--echo === SUPPORTED — TRUNCATE ... CONTINUE / RESTART IDENTITY (PG sequence-reset semantics) ===

CREATE TABLE t_cont (id SERIAL PRIMARY KEY, n INT);
INSERT INTO t_cont (n) VALUES (10), (20), (30);
SELECT id, n FROM t_cont ORDER BY id;

# CONTINUE IDENTITY: subsequent INSERT keeps sequence position.
TRUNCATE t_cont CONTINUE IDENTITY;
INSERT INTO t_cont (n) VALUES (40);
# Expect id=4 (sequence continued from prior max+1).
SELECT id, n FROM t_cont;

# RESTART IDENTITY: subsequent INSERT restarts at 1.
TRUNCATE t_cont RESTART IDENTITY;
INSERT INTO t_cont (n) VALUES (50);
# Expect id=1 (sequence reset).
SELECT id, n FROM t_cont;

# CASCADE option silently accepted (no FK-bearing tables
# in scope to verify cascading semantics).
TRUNCATE TABLE t_cont CONTINUE IDENTITY CASCADE;

--echo === PARSE-REJECTED — VACUUM FREEZE variants (3 forms) ===

# Bare `VACUUM` / `VACUUM ANALYZE` ARE supported per
# vacuum_analyze_basic_extra. FREEZE option is NOT.
--error 1064
VACUUM FREEZE t_cont;
--error 1064
VACUUM FULL FREEZE t_cont;
# Paren-option form unrecognized at col 8 (no `(`).
--error 1064
VACUUM (FREEZE, ANALYZE) t_cont;

DROP TABLE t_cont;
