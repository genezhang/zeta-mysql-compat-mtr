=== ABS / SIGN ===
SELECT ABS(-5)                  AS a;
a
5
SELECT ABS(-3.14)               AS af;
af
3.14
SELECT SIGN(-7)                 AS sn;
sn
-1
SELECT SIGN(0)                  AS sz;
sz
0
SELECT SIGN(7)                  AS sp;
sp
1
=== SQRT / POW / POWER ===
SELECT SQRT(16)                 AS s;
s
4
SELECT POW(2, 10)               AS p;
p
1024
SELECT POWER(2, 10)             AS p2;
p2
1024
=== MOD and % operator ===
SELECT MOD(10, 3)               AS m;
m
1
SELECT 10 % 3                   AS m_op;
m_op
1
=== CEIL / CEILING / FLOOR ===
SELECT CEIL(3.2)                AS c;
c
4
SELECT CEILING(3.2)             AS c2;
c2
4
SELECT FLOOR(3.8)               AS f;
f
3
=== ROUND (1-arg and 2-arg) ===
SELECT ROUND(3.567)             AS r1;
r1
4
SELECT ROUND(3.567, 2)          AS r2;
r2
3.57
=== RAND (sanity, just check > 0) ===
SELECT RAND() > 0               AS positive;
positive
1
=== EXP / LN ===
SELECT EXP(1)                   AS e;
e
2.718281828459045
SELECT LN(2.718281828)          AS ln_e;
ln_e
0.9999999998311266
=== LOG — DIVERGENCE: 1-arg is base-10 in zeta, natural in MySQL ===
# Portable substitute: use LN(x) for natural log.
SELECT LOG(100)                 AS log_zeta_base10;
log_zeta_base10
2
SELECT LOG(10, 1000)            AS log_base10_2arg;
log_base10_2arg
2.9999999999999996
=== Trig + LOG2/LOG10 + DEGREES/RADIANS + PI — FIXED via zeta #1167 ===
SELECT SIN(0)                            AS s;
s
0
SELECT COS(0)                            AS c;
c
1
SELECT TAN(0)                            AS t;
t
0
SELECT ASIN(1)                           AS asn;
asn
1.5707963267948966
SELECT ACOS(1)                           AS acs;
acs
0
SELECT ATAN(1)                           AS atn;
atn
0.7853981633974483
SELECT ATAN2(1, 1)                       AS at2;
at2
0.7853981633974483
SELECT LOG2(8)                           AS l2;
l2
3
SELECT LOG10(1000)                       AS l10;
l10
3
SELECT DEGREES(3.141592653589793)        AS deg;
deg
180
SELECT RADIANS(180)                      AS rad;
rad
3.141592653589793
SELECT PI()                              AS pi;
pi
3.141592653589793
=== TRUNCATE — FIXED via zeta #1169 ===
# Truncate toward zero to D decimal places; D < 0 → 10^|D|
# multiple. Decimal stays Decimal; integer + D >= 0 is identity.
SELECT TRUNCATE(3.567, 1)                AS t;
t
3.5
SELECT TRUNCATE(3.567, 2)                AS t;
t
3.56
SELECT TRUNCATE(-3.567, 1)               AS t_neg;
t_neg
-3.5
SELECT TRUNCATE(123.456, -2)             AS t_neg_d;
t_neg_d
100
=== CONV — FIXED via zeta #1170 ===
# Base conversion 2..36; returns string with uppercase
# letters. Negative to_base → signed output.
SELECT CONV(255, 10, 16)                 AS c;
c
FF
SELECT CONV('FF', 16, 10)                AS c;
c
255
SELECT CONV(13, 10, 2)                   AS c;
c
1101
SELECT CONV(CAST(NULL AS CHAR), 10, 16)  AS c_null;
c_null
NULL
=== CRC32 — FIXED via zeta #1168 ===
# IEEE CRC32; values cross-checked against MySQL.
SELECT CRC32('test')                     AS c;
c
3632233996
SELECT CRC32('MySQL')                    AS c2;
c2
3259397556
SELECT CRC32('')                         AS c_empty;
c_empty
0
SELECT CRC32(CAST(NULL AS CHAR))         AS c_null;
c_null
NULL
