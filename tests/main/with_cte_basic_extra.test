# Independently authored CTE-extra smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/with.test or recursive_cte.test; pins zeta's
# CTE surface NOT held by with_cte_basic (which covers simple
# WITH / column-alias list / multiple CTEs / forward
# reference / multi-reference / RECURSIVE numeric counter /
# RECURSIVE hierarchy / scalar-CTE-in-SELECT / WITH-prefixed
# DML rejection).
#
# Adaptation notes:
#   # zeta-adapt: WITH cte AS MATERIALIZED — accepted at
#     parse (silent no-op; zeta's planner doesn't honor the
#     materialization hint — CTEs are always inlined).
#   # zeta-adapt: WITH cte AS NOT MATERIALIZED — same; silent
#     no-op.
#   # zeta-adapt: CTE referenced from another CTE's FROM
#     clause — supported (forward composition).
#   # zeta-adapt: ORDER BY inside CTE — supported.
#   # zeta-adapt: RECURSIVE with UNION DISTINCT (vs UNION
#     ALL) — supported.
#   # zeta-adapt: RECURSIVE with multi-column column-alias
#     list — supported.
#   # zeta-adapt: Aggregate CTE referenced by main query —
#     supported.
#   # zeta-adapt: Infinite recursion bounded by outer LIMIT —
#     terminates correctly without running forever.

--echo === WITH cte AS MATERIALIZED — accepted (silent no-op) ===
--echo # zeta accepts the MATERIALIZED hint at parse but the
--echo # planner inlines all CTEs regardless. Documented as a
--echo # silent divergence from PG (where the hint controls
--echo # execution-plan inlining).

WITH cte AS MATERIALIZED (SELECT 1 AS v) SELECT v FROM cte;

--echo === WITH cte AS NOT MATERIALIZED — accepted (silent no-op) ===

WITH cte AS NOT MATERIALIZED (SELECT 1 AS v) SELECT v FROM cte;

--echo === CTE referenced from another CTE's FROM clause ===

WITH a AS (SELECT 1 AS x UNION ALL SELECT 2),
     b AS (SELECT x * 10 AS y FROM a)
SELECT y FROM b ORDER BY y;

--echo === ORDER BY inside CTE ===

WITH a AS (SELECT v FROM (VALUES (3), (1), (2)) AS t(v) ORDER BY v DESC)
SELECT v FROM a;

--echo === RECURSIVE with UNION DISTINCT ===

WITH RECURSIVE cnt(n) AS (
  SELECT 1
  UNION
  SELECT n + 1 FROM cnt WHERE n < 5
)
SELECT n FROM cnt ORDER BY n;

--echo === RECURSIVE with multi-column column-alias list ===

WITH RECURSIVE c(a, b) AS (
  SELECT 1, 10
  UNION ALL
  SELECT a + 1, b * 2 FROM c WHERE a < 4
)
SELECT a, b FROM c ORDER BY a;

--echo === Aggregate CTE referenced by main query ===

WITH agg AS (
  SELECT region, SUM(qty) AS total
    FROM (VALUES ('east', 10), ('west', 20), ('east', 30)) AS t(region, qty)
    GROUP BY region
)
SELECT region, total FROM agg ORDER BY region;

--echo === Infinite recursion bounded by outer LIMIT ===
--echo # `WITH RECURSIVE infinite(n)` has no terminating clause;
--echo # the outer LIMIT 5 must stop the recursion at 5 rows
--echo # rather than running forever.

WITH RECURSIVE infinite(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM infinite)
SELECT n FROM infinite LIMIT 5;
