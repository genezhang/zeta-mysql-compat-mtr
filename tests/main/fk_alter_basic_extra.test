# Independently authored FK-DDL-and-edges smoke test for
# the GPL MTR-format runner. NOT copied or adapted from
# MySQL's mysql-test/t/foreign_key.test or PG regress;
# complements fk_basic_extra by pinning the ALTER /
# DROP-CONSTRAINT / inline-REFERENCES / MATCH /
# error-pathway surface NOT covered there.
#
# Big-picture finding: zeta has a solid FK enforcement
# core with proper catalog-level error paths (FK to
# missing table → 1146, FK to non-PK column → 1105,
# DROP TABLE blocked by referencing FK → 1105). The DDL
# entrypoints are PG-flavored — `ALTER TABLE ADD/DROP
# CONSTRAINT` works, but the MySQL-flavored `ALTER TABLE
# DROP FOREIGN KEY <name>` errors 1064. Named CONSTRAINT
# clauses in CREATE TABLE work and surface in violation
# error messages. Inline column-level REFERENCES (short
# form) works. PG MATCH FULL / SIMPLE / PARTIAL clauses
# parse but are silent no-ops.
#
# Two notable divergences: (a) SHOW CREATE TABLE does NOT
# display FOREIGN KEY constraints — only the underlying
# index — so dumps lose the relational structure; ORMs
# that read SHOW CREATE to reflect the schema will see
# only the index. (b) `DROP TABLE ... CASCADE` does NOT
# actually cascade — it errors the same as plain DROP
# TABLE when a referencing FK exists. The user must DROP
# the child table or DROP the constraint first.
#
# Adaptation notes:
#   # zeta-adapt: ON DELETE NO ACTION — supported. Same
#     semantics as ON DELETE RESTRICT: parent delete errors
#     when child rows exist.
#   # zeta-adapt: ON DELETE SET DEFAULT — supported. When
#     parent deleted, child FK column resets to the column's
#     DEFAULT (which must itself reference an existing
#     parent).
#   # zeta-adapt: ALTER TABLE ADD CONSTRAINT <name> FOREIGN
#     KEY (col) REFERENCES other(col) — works. Enforced on
#     subsequent INSERTs.
#   # zeta-adapt: ALTER TABLE DROP CONSTRAINT <name> —
#     works. Subsequent INSERTs are not validated.
#   # zeta-adapt: Named `CONSTRAINT my_fk FOREIGN KEY (...)`
#     in CREATE TABLE — supported. The user-provided name
#     surfaces in the violation error message.
#   # zeta-adapt: Inline column-level `pid INT REFERENCES
#     other(id)` (short form, no CONSTRAINT/FOREIGN KEY
#     keywords) — supported. Auto-generates a constraint
#     name like `<table>_pid_fkey`.
#   # zeta-adapt: PG MATCH FULL / MATCH SIMPLE / MATCH
#     PARTIAL clauses — parse, silent no-op. zeta does not
#     differentiate matching modes.
#   # zeta-adapt: FK referencing non-existent table errors
#     1146 "table not found" at CREATE TABLE time (catalog
#     check).
#   # zeta-adapt: FK referencing non-PK column errors 1105
#     "foreign key references columns that are not the
#     primary key" at CREATE TABLE time.
#   # zeta-adapt: DROP TABLE blocked when referenced —
#     errors 1105 "cannot drop table ... referenced by
#     foreign key" until the child or constraint is
#     removed.
#   # zeta-adapt: TRUNCATE TABLE on a parent with active
#     child references errors 1105 (same FK-violation
#     path as DELETE). Substitute via DROP+CREATE if you
#     need to clear without children.
#   # zeta-adapt: KNOWN DIVERGENCE — SHOW CREATE TABLE does
#     NOT display FOREIGN KEY constraints; only the
#     auto-generated KEY (index) shows up. MySQL emits a
#     CONSTRAINT ... FOREIGN KEY ... REFERENCES line. ORMs
#     reflecting on SHOW CREATE will miss the relations.
#   # zeta-adapt: KNOWN DIVERGENCE — DROP TABLE <t> CASCADE
#     does NOT cascade through FK references — it errors
#     the same as plain DROP TABLE. PG CASCADEs DROP through
#     the FK constraint side; zeta requires explicit DROP
#     CONSTRAINT or DROP child first.
#   # zeta-adapt: KNOWN GAP — `ALTER TABLE ... DROP FOREIGN
#     KEY <name>` (MySQL spelling) errors 1064 "unsupported
#     ALTER TABLE operation". Substitute via the PG-flavored
#     `ALTER TABLE ... DROP CONSTRAINT <name>`.

--echo === Setup ===

DROP TABLE IF EXISTS fkna_c;
DROP TABLE IF EXISTS fkna_p;
CREATE TABLE fkna_p (id INT PRIMARY KEY);

--echo === ON DELETE NO ACTION — alias for RESTRICT ===

CREATE TABLE fkna_c (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fkna_p(id) ON DELETE NO ACTION);
INSERT INTO fkna_p VALUES (1);
INSERT INTO fkna_c VALUES (10, 1);
--error 1105
DELETE FROM fkna_p WHERE id = 1;

--echo === ON DELETE SET DEFAULT — child reverts to column DEFAULT ===

DROP TABLE IF EXISTS fkd_c;
DROP TABLE IF EXISTS fkd_p;
CREATE TABLE fkd_p (id INT PRIMARY KEY);
CREATE TABLE fkd_c (id INT PRIMARY KEY, pid INT DEFAULT 1,
  FOREIGN KEY (pid) REFERENCES fkd_p(id) ON DELETE SET DEFAULT);
INSERT INTO fkd_p VALUES (1), (2);
INSERT INTO fkd_c VALUES (10, 2);
DELETE FROM fkd_p WHERE id = 2;
SELECT id, pid FROM fkd_c;

--echo === ALTER TABLE ADD CONSTRAINT FOREIGN KEY — enforced after ===

DROP TABLE IF EXISTS fka_c;
DROP TABLE IF EXISTS fka_p;
CREATE TABLE fka_p (id INT PRIMARY KEY);
CREATE TABLE fka_c (id INT PRIMARY KEY, pid INT);
INSERT INTO fka_p VALUES (1);
INSERT INTO fka_c VALUES (10, 1);
ALTER TABLE fka_c ADD CONSTRAINT fka_fk FOREIGN KEY (pid) REFERENCES fka_p(id);
--error 1105
INSERT INTO fka_c VALUES (20, 99);

--echo === ALTER TABLE DROP CONSTRAINT — FK no longer enforced ===

ALTER TABLE fka_c DROP CONSTRAINT fka_fk;
INSERT INTO fka_c VALUES (30, 999);
SELECT id, pid FROM fka_c ORDER BY id;

--echo === Named CONSTRAINT FOREIGN KEY — name surfaces in error ===

DROP TABLE IF EXISTS nfk_c;
DROP TABLE IF EXISTS nfk_p;
CREATE TABLE nfk_p (id INT PRIMARY KEY);
CREATE TABLE nfk_c (id INT PRIMARY KEY, pid INT,
  CONSTRAINT my_fk FOREIGN KEY (pid) REFERENCES nfk_p(id));
INSERT INTO nfk_p VALUES (1);
--error 1105
INSERT INTO nfk_c VALUES (10, 99);

--echo === Inline column-level REFERENCES (short form) ===

DROP TABLE IF EXISTS ifk_c;
DROP TABLE IF EXISTS ifk_p;
CREATE TABLE ifk_p (id INT PRIMARY KEY);
CREATE TABLE ifk_c (id INT PRIMARY KEY, pid INT REFERENCES ifk_p(id));
INSERT INTO ifk_p VALUES (1);
INSERT INTO ifk_c VALUES (10, 1);
--error 1105
INSERT INTO ifk_c VALUES (20, 999);

--echo === PG MATCH FULL clause — parses, silent no-op ===

DROP TABLE IF EXISTS mfk_c;
DROP TABLE IF EXISTS mfk_p;
CREATE TABLE mfk_p (id INT PRIMARY KEY);
CREATE TABLE mfk_c (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES mfk_p(id) MATCH FULL);

--echo === FK to non-existent table — errno 1146 ===

DROP TABLE IF EXISTS fknope;
--error 1146
CREATE TABLE fknope (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES no_such_parent(id));

--echo === FK to non-PK column — errno 1105 ===

DROP TABLE IF EXISTS fknopk;
DROP TABLE IF EXISTS fknopkc;
CREATE TABLE fknopk (id INT);
--error 1105
CREATE TABLE fknopkc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fknopk(id));

--echo === DROP TABLE blocked when referenced — errno 1105 ===

DROP TABLE IF EXISTS dr_c;
DROP TABLE IF EXISTS dr_p;
CREATE TABLE dr_p (id INT PRIMARY KEY);
CREATE TABLE dr_c (id INT PRIMARY KEY, pid INT, FOREIGN KEY (pid) REFERENCES dr_p(id));
INSERT INTO dr_p VALUES (1);
INSERT INTO dr_c VALUES (10, 1);
--error 1105
DROP TABLE dr_p;

--echo === KNOWN DIVERGENCE: DROP TABLE CASCADE still blocked ===

--error 1105
DROP TABLE dr_p CASCADE;

--echo === KNOWN GAP: TRUNCATE parent with FK children — errno 1105 ===

--error 1105
TRUNCATE TABLE dr_p;

--echo === KNOWN DIVERGENCE: SHOW CREATE TABLE omits FK constraint ===

SHOW CREATE TABLE dr_c;

--echo === KNOWN GAP: MySQL `ALTER TABLE DROP FOREIGN KEY` — errno 1064 ===

ALTER TABLE fka_c ADD CONSTRAINT fka_fk2 FOREIGN KEY (pid) REFERENCES fka_p(id);
--error 1064
ALTER TABLE fka_c DROP FOREIGN KEY fka_fk2;

--echo === Cleanup ===

DROP TABLE dr_c;
DROP TABLE dr_p;
DROP TABLE fka_c;
DROP TABLE fka_p;
DROP TABLE fkna_c;
DROP TABLE fkna_p;
DROP TABLE fkd_c;
DROP TABLE fkd_p;
DROP TABLE nfk_c;
DROP TABLE nfk_p;
DROP TABLE ifk_c;
DROP TABLE ifk_p;
DROP TABLE mfk_c;
DROP TABLE mfk_p;
DROP TABLE fknopk;
