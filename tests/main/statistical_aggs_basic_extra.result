ERROR 1305: FUNCTION test.REGR_SXX does not exist
SELECT REGR_SYY(v, id)                                        AS syy FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_SYY does not exist
SELECT REGR_SXY(v, id)                                        AS sxy FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_SXY does not exist
=== COVAR_POP / COVAR_SAMP / CORR — y = x ===
SELECT COVAR_POP(v, id)                                       AS covp_is_2 FROM stats_pp;
ERROR 1305: FUNCTION test.COVAR_POP does not exist
SELECT COVAR_SAMP(v, id)                                      AS covs_is_2_5 FROM stats_pp;
ERROR 1305: FUNCTION test.COVAR_SAMP does not exist
SELECT CORR(v, id)                                            AS corr_is_1 FROM stats_pp;
ERROR 1305: FUNCTION test.CORR does not exist
=== Type: PERCENTILE_CONT/DISC over int-domain returns DOUBLE PRECISION ===
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY v) = 3.0   AS median_eq_3_float FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v) = 3.0   AS median_eq_3_float FROM stats_pp' at line 1
=== Two-row dataset for percentile interpolation ===
CREATE TABLE stats_pair (x DOUBLE PRECISION);
INSERT INTO stats_pair VALUES (10.0), (20.0);
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY x) AS cont_interp FROM stats_pair;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY x) AS cont_interp FROM stats_pair' at line 1
SELECT PERCENTILE_DISC(0.5) WITHIN GROUP (ORDER BY x) AS disc_pick   FROM stats_pair;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY x) AS disc_pick   FROM stats_pair' at line 1
DROP TABLE stats_pair;
=== NULL-row exclusion — rows with NULL in any arg are skipped ===
INSERT INTO stats_pp VALUES (6, NULL);
SELECT REGR_COUNT(v, id)                                      AS rc_still_5 FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_COUNT does not exist
INSERT INTO stats_pp VALUES (NULL, 99.0);
SELECT REGR_COUNT(v, id)                                      AS rc_still_5_after_null_x FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_COUNT does not exist
=== Cleanup ===
DROP TABLE stats_pp;
