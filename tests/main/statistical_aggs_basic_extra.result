=== Setup: y = x linear dataset ===
CREATE TABLE stats_pp (
  id INT,
  v  DOUBLE PRECISION
);
INSERT INTO stats_pp VALUES
  (1, 1.0), (2, 2.0), (3, 3.0), (4, 4.0), (5, 5.0);
=== PERCENTILE_CONT / PERCENTILE_DISC — WITHIN GROUP ordered-set form ===
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY v) AS median_cont FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v) AS median_cont FROM stats_pp' at line 1
SELECT PERCENTILE_DISC(0.5) WITHIN GROUP (ORDER BY v) AS median_disc FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v) AS median_disc FROM stats_pp' at line 1
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY v)
     = PERCENTILE_DISC(0.5) WITHIN GROUP (ORDER BY v)
                                                              AS cont_eq_disc_on_int_set FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v)
     = PERCENTILE_DISC(0.5) WITHIN GROUP (ORDER BY v)
             ' at line 1
SELECT PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY v) AS q1_cont FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v) AS q1_cont FROM stats_pp' at line 1
SELECT PERCENTILE_DISC(0.25) WITHIN GROUP (ORDER BY v) AS q1_disc FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v) AS q1_disc FROM stats_pp' at line 1
=== STRIKING quirks: PERCENTILE_CONT(p, v) form + aggregate-collapse bug ===
SELECT PERCENTILE_CONT(0.5, v)                                AS arg_form_returns_pct FROM stats_pp;
ERROR 1305: FUNCTION test.PERCENTILE_CONT does not exist
SELECT PERCENTILE_CONT(0.5, v) = 0.5                          AS arg_form_eq_arg FROM stats_pp;
ERROR 1305: FUNCTION test.PERCENTILE_CONT does not exist
SELECT PERCENTILE_CONT(0.5, v),
       PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY v)         FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v)         FROM stats_pp' at line 2
SELECT PERCENTILE_CONT(0.5, v)
     = PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY v)         AS bug_present_both_collapse FROM stats_pp;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(ORDER BY v)         AS bug_present_both_collapse FROM stats_pp' at line 2
=== REGR_* family — y = x linear regression (slope=1, intercept=0, R²=1) ===
SELECT REGR_COUNT(v, id)                                      AS rc FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_COUNT does not exist
SELECT REGR_AVGY(v, id)                                       AS avgy FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_AVGY does not exist
SELECT REGR_AVGX(v, id)                                       AS avgx FROM stats_pp;
ERROR 1305: FUNCTION test.REGR_AVGX does not exist
