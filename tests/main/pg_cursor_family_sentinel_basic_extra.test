# Independently authored PG cursor-family + transaction-
# abort sentinel slice for the GPL MTR-format runner. NOT
# copied or adapted from MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - DECLARE CURSOR / FETCH FROM / MOVE / CLOSE
#     statement family: ZERO prior coverage. Wide-grep
#     of tests/main/*.test for `DECLARE.*CURSOR` /
#     `FETCH FROM` / `MOVE.*IN` / `CLOSE ALL` returns
#     no hits. (The prior FETCH hits in limit_offset_
#     basic_extra are `FETCH N ROWS` from LIMIT/OFFSET,
#     a different statement-level surface.)
#   - "current transaction is aborted, commands ignored
#     until end of transaction block" 1105 fingerprint:
#     ZERO prior coverage. Wide-grep returns no hits
#     in tests/main/*.result. Genuinely new fingerprint.
#
# Pre-existing rejection shapes from prior taxonomies:
#   - Shape (c) — "unsupported statement: sqlparser::
#     ast::Statement" — see PR #371 mysql_maintenance_
#     cmds_sentinel_basic_extra:79-83.
#   - Shape (d) — "Expected: an SQL statement, found:
#     <KW>" — see PR #371 mysql_maintenance_cmds_
#     sentinel_basic_extra:84-86.
#
# This slice pins:
#
#   Shape (c) — DECLARE CURSOR / FETCH / CLOSE
#   (sqlparser parses, zeta catch-all dispatcher):
#     - DECLARE c CURSOR FOR <SELECT>
#     - DECLARE c SCROLL CURSOR FOR <SELECT>
#     - DECLARE c NO SCROLL CURSOR FOR <SELECT>
#     - DECLARE c BINARY CURSOR FOR <SELECT>
#     - DECLARE c CURSOR WITH HOLD FOR <SELECT>
#     - DECLARE c CURSOR WITHOUT HOLD FOR <SELECT>
#     - FETCH NEXT/PRIOR/2/ALL/FIRST/ABSOLUTE 2 FROM c
#     - CLOSE c / CLOSE ALL
#
#   Shape (d) — MOVE (sqlparser doesn't recognize keyword):
#     - MOVE NEXT IN c, MOVE FORWARD 2 IN c, MOVE ALL
#       IN c — "Expected: an SQL statement, found: MOVE
#       at Line: 1, Column: 1". Adds MOVE to the shape
#       (d) keyword bucket alongside HANDLER/SHUTDOWN/
#       IMPORT (from PR #371 and PR #391).
#
#   NEW FINGERPRINT — transaction-abort cascade +
#   PG-compat BUG (SAVEPOINT escape doesn't work):
#     - After ANY statement errors inside a BEGIN block,
#       all subsequent statements fail with errno 1105
#       "current transaction is aborted, commands
#       ignored until end of transaction block" until
#       COMMIT/ROLLBACK resets state. Cascade itself
#       is standard PG-style behavior.
#     - GENUINELY NEW fingerprint — by-fingerprint
#       wide-grep returns zero priors.
#     - BUG — `ROLLBACK TO SAVEPOINT sp` also gets
#       absorbed by the cascade, contrary to PG where
#       "you can roll back to a savepoint even after
#       the transaction has been aborted" (PG docs).
#       This means apps porting from PG that rely on
#       SAVEPOINT for in-transaction error recovery
#       (the canonical pattern) do NOT have a recovery
#       path in zeta — must rollback the whole txn and
#       retry. RELEASE SAVEPOINT and post-rollback-to-sp
#       statements also fail with the cascade message.
#
# Big-picture finding:
#
#   PG cursor family is essentially absent from zeta:
#   sqlparser parses DECLARE CURSOR / FETCH / CLOSE
#   into AST but zeta has no dispatcher arm (Shape (c)
#   catch-all). MOVE doesn't even reach sqlparser's
#   statement-list (Shape (d)).
#
#   The transaction-abort cascade is mostly PG-compat
#   — but the canonical PG recovery path (ROLLBACK TO
#   SAVEPOINT) is BROKEN: zeta absorbs ROLLBACK TO sp
#   into the cascade. Apps porting PG code that wraps
#   risky statements in SAVEPOINT … ROLLBACK TO sp for
#   error recovery have NO in-transaction recovery
#   path in zeta — must rollback the whole transaction
#   and retry from scratch.
#
#   For apps needing cursor-like iteration, rewrite to:
#     - LIMIT/OFFSET pagination (supported)
#     - Application-side cursor (fetch all rows, paginate
#       client-side)
#     - PG keyset pagination (WHERE id > last_id ORDER
#       BY id LIMIT n) — fully supported
#
# Adaptation notes:
#   # zeta-adapt: KNOWN GAP — PG cursor family (DECLARE
#     CURSOR, FETCH, MOVE, CLOSE) all error 1064. No
#     substitute — rewrite to LIMIT/OFFSET or keyset
#     pagination.
#   # zeta-adapt: TRANSACTION-ABORT CASCADE — any error
#     inside a BEGIN block causes all subsequent stmts
#     to error 1105 "current transaction is aborted"
#     until COMMIT/ROLLBACK. Cascade matches PG.
#   # zeta-adapt: KNOWN BUG — `ROLLBACK TO SAVEPOINT
#     sp` does NOT escape the cascade in zeta (PG
#     allows it). Apps must full-rollback and retry.

CREATE TABLE cur_t (id INT PRIMARY KEY, n INT);
INSERT INTO cur_t VALUES (1, 10), (2, 20), (3, 30);

--echo === Shape (c) — DECLARE CURSOR variants (six forms) ===

--error 1064
DECLARE c1 CURSOR FOR SELECT id, n FROM cur_t ORDER BY id;
--error 1064
DECLARE c2 SCROLL CURSOR FOR SELECT id FROM cur_t;
--error 1064
DECLARE c3 NO SCROLL CURSOR FOR SELECT id FROM cur_t;
--error 1064
DECLARE c4 BINARY CURSOR FOR SELECT id FROM cur_t;
--error 1064
DECLARE c5 CURSOR WITH HOLD FOR SELECT id FROM cur_t;
--error 1064
DECLARE c6 CURSOR WITHOUT HOLD FOR SELECT id FROM cur_t;

--echo === Shape (c) — FETCH FROM cursor (multiple direction/count forms) ===

--error 1064
FETCH NEXT FROM c;
--error 1064
FETCH 2 FROM c;
--error 1064
FETCH PRIOR FROM c;
--error 1064
FETCH ALL FROM c;
--error 1064
FETCH FIRST FROM c;
--error 1064
FETCH ABSOLUTE 2 FROM c;

--echo === Shape (d) — MOVE (sqlparser doesn't recognize keyword — adds to taxonomy bucket) ===

# DIFFERENT shape from FETCH — sqlparser doesn't have a
# MOVE statement-arm at all. Shape (d) per PR #371
# taxonomy, alongside HANDLER/SHUTDOWN/IMPORT.
--error 1064
MOVE NEXT IN c;
--error 1064
MOVE FORWARD 2 IN c;
--error 1064
MOVE ALL IN c;

--echo === Shape (c) — CLOSE cursor (and CLOSE ALL) ===

--error 1064
CLOSE c;
--error 1064
CLOSE ALL;

--echo === NEW FINGERPRINT — transaction-abort cascade ===

# After ANY error inside BEGIN, all subsequent statements
# fail with "current transaction is aborted" until
# COMMIT/ROLLBACK resets state. Genuinely new fingerprint.
BEGIN;
--error 1064
DECLARE c CURSOR FOR SELECT id FROM cur_t;
# Subsequent ordinary SELECT now errors with cascade
# message (would normally work outside an aborted txn).
--error 1105
SELECT 1;
--error 1105
SELECT id FROM cur_t WHERE id = 1;
# COMMIT resets the cascade.
COMMIT;
# Confirm cascade is gone — same SELECT works now.
SELECT 1 AS after_commit;
SELECT id FROM cur_t WHERE id = 1;

--echo === BUG — SAVEPOINT escape FAILS (ROLLBACK TO sp absorbed by cascade) ===

# PG docs: "you can roll back to a savepoint even after
# the transaction has been aborted" — but zeta absorbs
# ROLLBACK TO SAVEPOINT into the cascade. This breaks
# the canonical PG in-transaction error-recovery pattern.
BEGIN;
SAVEPOINT sp;
--error 1064
DECLARE c CURSOR FOR SELECT id FROM cur_t;
--error 1105
SELECT 1;
# THIS WOULD WORK IN PG — escapes the cascade. In zeta,
# the ROLLBACK TO itself errors with the cascade message.
--error 1105
ROLLBACK TO SAVEPOINT sp;
# Cascade STILL holds — no recovery possible.
--error 1105
SELECT 1 AS after_rollback_to_sp;
COMMIT;

DROP TABLE cur_t;
