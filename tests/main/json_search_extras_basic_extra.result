=== JSON_SEARCH on already-typed JSONB doc ===
SELECT JSON_SEARCH(CAST('{"a":"hello","b":"world"}' AS JSONB),
                   'one', 'world')                            AS typed_doc_path;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB),
                   'one', 'world')                            AS typed_d' at line 1
SELECT JSON_TYPE(JSON_SEARCH(CAST('["x","y"]' AS JSONB),
                             'one', 'x'))                     AS typed_arr_match_type;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB),
                             'one', 'x'))                     AS typed_a' at line 1
=== Wrong-type doc → ERROR ===
SELECT JSON_SEARCH(42, 'one', 'x');
ERROR 3146: Invalid data type for JSON data in argument 1 to function json_search; a JSON string or JSON type is required.
SELECT JSON_SEARCH(3.14, 'one', 'x');
ERROR 3146: Invalid data type for JSON data in argument 1 to function json_search; a JSON string or JSON type is required.
SELECT JSON_SEARCH(TRUE, 'one', 'x');
ERROR 3146: Invalid data type for JSON data in argument 1 to function json_search; a JSON string or JSON type is required.
=== Wrong-type mode → ERROR ===
SELECT JSON_SEARCH('{"a":"x"}', 42, 'x');
ERROR 3154: The oneOrAll argument to json_search may take these values: 'one' or 'all'.
=== Wrong-type search_str → ERROR ===
SELECT JSON_SEARCH('{"a":"x"}', 'one', 42);
JSON_SEARCH('{"a":"x"}', 'one', 42)
NULL
=== Wrong-type escape_char → ERROR ===
SELECT JSON_SEARCH('{"a":"x"}', 'one', 'x', 42);
ERROR 1210: Incorrect arguments to ESCAPE
=== Empty escape_char rejected (distinct from multi-char) ===
SELECT JSON_SEARCH('{"a":"x"}', 'one', 'x', '');
JSON_SEARCH('{"a":"x"}', 'one', 'x', '')
"$.a"
=== Quoted-key path emission (non-identifier key) ===
SELECT JSON_SEARCH('{"weird key":"hit"}', 'one', 'hit')       AS quoted_key_space;
quoted_key_space
"$.\"weird key\""
SELECT JSON_SEARCH('{"k\"ey":"hit"}', 'one', 'hit')           AS quoted_key_inner_dquote;
ERROR 3141: Invalid JSON text in argument 1 to function json_search: "Missing a colon after a name of object member." at position 4.
SELECT JSON_SEARCH('{"a\\b":"hit"}', 'one', 'hit')            AS quoted_key_backslash;
quoted_key_backslash
"$.\"a\\b\""
=== Bare-identifier vs must-quote key emission edge cases ===
SELECT JSON_SEARCH('{"_a":"hit"}', 'one', 'hit')              AS bare_underscore_leading;
bare_underscore_leading
"$._a"
SELECT JSON_SEARCH('{"1a":"hit"}', 'one', 'hit')              AS digit_leading_quoted;
digit_leading_quoted
"$.\"1a\""
=== Compositional path: quoted key INSIDE array ===
SELECT JSON_SEARCH('[{"weird key":"hit"}]', 'one', 'hit')     AS arr_then_quoted_key;
arr_then_quoted_key
"$[0].\"weird key\""
=== Default escape char is backslash when 4th arg omitted ===
SELECT JSON_SEARCH('{"a":"100%"}', 'one', '100\%')             AS default_escape_backslash;
default_escape_backslash
"$.a"
SELECT JSON_SEARCH('{"a":"100%"}', 'one', '100\\%') IS NULL    AS default_escape_extra_bs_no_match;
default_escape_extra_bs_no_match
0
=== Empty search string semantics ===
SELECT JSON_SEARCH('{"a":"","b":"x"}', 'one', '')             AS empty_pattern_matches_empty;
empty_pattern_matches_empty
"$.a"
SELECT JSON_SEARCH('{"a":"x","b":"y"}', 'one', '') IS NULL    AS empty_pattern_no_match;
empty_pattern_no_match
1
=== Multi-byte UTF-8 in search target ===
SELECT JSON_SEARCH('{"a":"héllo"}', 'one', 'héllo')           AS utf8_exact_match;
utf8_exact_match
"$.a"
SELECT JSON_SEARCH('{"a":"héllo"}', 'one', 'h%o')             AS utf8_wildcard_match;
utf8_wildcard_match
"$.a"
