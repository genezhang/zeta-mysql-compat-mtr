# Independently authored ROUND / TRUNCATE / CEIL / FLOOR / ABS
# smoke for the GPL MTR-format runner. NOT copied or adapted
# from MySQL's mysql-test/. Five core math functions; none had
# compat-mtr coverage yet.
#
# Big-picture finding:
#   ABS(x)          — absolute value; preserves numeric type.
#   ROUND(x[, n])   — round half-AWAY-from-zero for Decimal
#                     (NOT bankers like FORMAT does). Negative
#                     precision rounds to nearest 10^|n|.
#   TRUNCATE(x, n)  — truncate TOWARD zero to n decimal places.
#                     Always 2-arg.
#   CEIL / CEILING(x) — round up.
#   FLOOR(x)        — round down.
#
# Adaptation notes:
#   # zeta-adapt: ROUND uses MidpointAwayFromZero for Decimal
#     (matches MySQL). This DIVERGES from FORMAT (which uses
#     rust_decimal's default MidpointNearestEven aka bankers).
#     Real internal inconsistency between two rounding helpers.
#     Pinned via discriminating tie cases (2.5 → 3 here, but
#     FORMAT(2.5,0) = 2).
#   # zeta-adapt: ROUND single-arg on Int input is identity.
#   # zeta-adapt: CEIL/FLOOR on Int input is identity (no change).
#   # zeta-adapt: ABS on Decimal preserves NUMERIC type;
#     on Float64 returns Float64.
#   # zeta-adapt: Arity errors → 1105 (MySQL: 1582). Codes
#     differ, behavior (reject) matches.

--echo === ABS: basic across numeric types ===

SELECT ABS(5)                            AS pos_int;
SELECT ABS(-5)                           AS neg_int;
SELECT ABS(0)                            AS zero_int;
SELECT ABS(3.14)                         AS pos_dec;
SELECT ABS(-3.14)                        AS neg_dec;
SELECT ABS(-2147483648)                  AS neg_i32_min;

--echo === ABS: NULL + arity ===

SELECT ABS(NULL) IS NULL                 AS null_passes;
--error 1105
SELECT ABS();
--error 1105
SELECT ABS(1, 2);

--echo === ROUND: 1-arg form ===

SELECT ROUND(3.4)                        AS down;
SELECT ROUND(3.5)                        AS half_up;
SELECT ROUND(3.6)                        AS up;
SELECT ROUND(-3.5)                       AS neg_half_away;
SELECT ROUND(0.5)                        AS half_zero_pt_five;
# Integer input is identity.
SELECT ROUND(5)                          AS int_identity;

--echo === ROUND: half-away-from-zero (NOT bankers) ===

# DIVERGENCE pin vs FORMAT: ROUND uses MidpointAwayFromZero;
# FORMAT uses MidpointNearestEven (bankers). These should
# produce DIFFERENT answers on tie cases.
SELECT ROUND(2.5)                        AS tie_2_5_half_away;
SELECT FORMAT(2.5, 0)                    AS tie_2_5_bankers;
SELECT ROUND(2.5) <> FORMAT(2.5, 0)      AS round_vs_format_diverge;
# More tie cases.
SELECT ROUND(0.5)   = 1                  AS half_0_5_to_1;
SELECT ROUND(1.5)   = 2                  AS half_1_5_to_2;
SELECT ROUND(2.5)   = 3                  AS half_2_5_to_3;
SELECT ROUND(-2.5)  = -3                 AS neg_half_2_5_to_neg_3;

--echo === ROUND: 2-arg form (positive precision) ===

SELECT ROUND(3.14159, 2)                 AS pi_2dp;
SELECT ROUND(3.14159, 4)                 AS pi_4dp;
SELECT ROUND(3.999, 1)                   AS round_up_1dp;
SELECT ROUND(-1.235, 2)                  AS neg_2dp_half_away;

--echo === ROUND: negative precision (round to 10^|n|) ===

SELECT ROUND(12345.67, -1)               AS to_tens;
SELECT ROUND(12345.67, -2)               AS to_hundreds;
SELECT ROUND(12345.67, -3)               AS to_thousands;
SELECT ROUND(149.5, -1)                  AS half_neg_1dp;

--echo === ROUND: NULL + arity ===

SELECT ROUND(NULL)         IS NULL       AS null_passes;
SELECT ROUND(1.5, NULL)    IS NULL       AS null_precision;
--error 1105
SELECT ROUND();
--error 1105
SELECT ROUND(1.5, 2, 3);

--echo === TRUNCATE: positive precision ===

SELECT TRUNCATE(3.999, 0)                AS to_int;
SELECT TRUNCATE(3.999, 2)                AS to_2dp;
SELECT TRUNCATE(-3.999, 0)               AS neg_to_int;
# Difference from ROUND: TRUNCATE always toward zero.
SELECT TRUNCATE(3.5, 0)                  AS half_truncs_down;
SELECT TRUNCATE(-3.5, 0)                 AS neg_half_truncs_toward_zero;
SELECT TRUNCATE(3.5, 0)    <> ROUND(3.5) AS trunc_vs_round_diverge;

--echo === TRUNCATE: negative precision ===

SELECT TRUNCATE(12345.67, -1)            AS trunc_tens;
SELECT TRUNCATE(12345.67, -2)            AS trunc_hundreds;
SELECT TRUNCATE(-12345.67, -2)           AS trunc_neg_hundreds;

--echo === TRUNCATE: integer with non-negative precision = identity ===

SELECT TRUNCATE(42, 5)                   AS int_identity;

--echo === TRUNCATE: NULL + arity ===

SELECT TRUNCATE(NULL, 2)   IS NULL       AS null_x;
SELECT TRUNCATE(1.5, NULL) IS NULL       AS null_n;
--error 1105
SELECT TRUNCATE();
--error 1105
SELECT TRUNCATE(1.5);
--error 1105
SELECT TRUNCATE(1.5, 2, 3);

--echo === CEIL / CEILING ===

SELECT CEIL(3.1)                         AS dec_up;
SELECT CEIL(-3.1)                        AS neg_dec_toward_zero;
SELECT CEIL(3.0)                         AS exact;
SELECT CEIL(5)                           AS int_identity;
SELECT CEIL(NULL) IS NULL                AS null_passes;
# CEILING alias parity.
SELECT CEILING(3.1) = CEIL(3.1)          AS ceiling_alias;
--error 1105
SELECT CEIL();
# Note: CEIL(1, 2) does NOT error in zeta — the function-call
# arity guard fires only on EMPTY args; extra args are silently
# accepted (the impl uses match on args.len() == 1 but extras
# reach a different code path somehow). Pin the observed
# behavior so the gap is locked in for future cleanup.
SELECT CEIL(1, 2)                        AS ceil_extra_args_silent;

--echo === FLOOR ===

SELECT FLOOR(3.9)                        AS dec_down;
SELECT FLOOR(-3.1)                       AS neg_dec_away_zero;
SELECT FLOOR(3.0)                        AS exact;
SELECT FLOOR(5)                          AS int_identity;
SELECT FLOOR(NULL) IS NULL               AS null_passes;
--error 1105
SELECT FLOOR();
# Same gap as CEIL: extras silently accepted.
SELECT FLOOR(1, 2)                       AS floor_extra_args_silent;

--echo === Cross-family invariants ===

# FLOOR(x) <= ROUND(x) <= CEIL(x) for any x.
SELECT FLOOR(3.7) <= ROUND(3.7) AND ROUND(3.7) <= CEIL(3.7) AS bounds_invariant;
SELECT FLOOR(-3.7) <= ROUND(-3.7) AND ROUND(-3.7) <= CEIL(-3.7) AS bounds_invariant_neg;
# CEIL(x) - FLOOR(x) is 0 (exact) or 1 (fractional).
SELECT CEIL(3.0) - FLOOR(3.0) = 0        AS exact_no_gap;
SELECT CEIL(3.5) - FLOOR(3.5) = 1        AS frac_one_gap;
# ABS(x) >= 0 for any x.
SELECT ABS(-99.99) >= 0                  AS abs_non_negative;

--echo === Determinism ===

SELECT ABS(-5)       = ABS(-5)           AS abs_det;
SELECT ROUND(3.5)    = ROUND(3.5)        AS round_det;
SELECT TRUNCATE(3.5, 0) = TRUNCATE(3.5, 0) AS trunc_det;
SELECT CEIL(3.1)     = CEIL(3.1)         AS ceil_det;
SELECT FLOOR(3.9)    = FLOOR(3.9)        AS floor_det;
