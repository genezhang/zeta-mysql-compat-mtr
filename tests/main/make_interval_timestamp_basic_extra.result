=== MAKE_TIMESTAMP — basic construction ===
SELECT MAKE_TIMESTAMP(2024, 5, 19, 14, 30, 45)                AS basic_ts;
basic_ts
2024-05-19 14:30:45
SELECT MAKE_TIMESTAMP(2024, 1, 1, 0, 0, 0)                    AS midnight_ts;
midnight_ts
2024-01-01 00:00:00
SELECT MAKE_TIMESTAMP(2024, 5, 19, 14, 30, 45.5)              AS frac_sec_ts;
frac_sec_ts
2024-05-19 14:30:45.500000
=== MAKE_TIMESTAMP — leap-year-aware day validation ===
SELECT MAKE_TIMESTAMP(2024, 2, 29, 0, 0, 0)                   AS leap_feb29_ok;
leap_feb29_ok
2024-02-29 00:00:00
SELECT MAKE_TIMESTAMP(2026, 2, 29, 0, 0, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP day 29 out of range (1..=28) for 2026-02
SELECT MAKE_TIMESTAMP(2024, 4, 31, 0, 0, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP day 31 out of range (1..=30) for 2024-04
=== MAKE_TIMESTAMP — month / hour / min / sec range errors ===
SELECT MAKE_TIMESTAMP(2024, 13, 1, 0, 0, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP month 13 out of range (1..=12)
SELECT MAKE_TIMESTAMP(2024, 0, 1, 0, 0, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP month 0 out of range (1..=12)
SELECT MAKE_TIMESTAMP(2024, 1, 1, 24, 0, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP time out of range: 24:00:0
SELECT MAKE_TIMESTAMP(2024, 1, 1, 0, 60, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP time out of range: 00:60:0
SELECT MAKE_TIMESTAMP(2024, 1, 1, 0, 0, 60.0);
ERROR 1105: execution error: MAKE_TIMESTAMP time out of range: 00:00:60
=== MAKE_TIMESTAMP — NULL PROPAGATION (any NULL → NULL) ===
SELECT MAKE_TIMESTAMP(NULL, 5, 19, 14, 30, 45)                AS null_year;
null_year
NULL
SELECT MAKE_TIMESTAMP(2024, NULL, 19, 14, 30, 45)             AS null_month;
null_month
NULL
SELECT MAKE_TIMESTAMP(2024, 5, NULL, 14, 30, 45)              AS null_day;
null_day
NULL
SELECT MAKE_TIMESTAMP(2024, 5, 19, NULL, 30, 45)              AS null_hour;
null_hour
NULL
SELECT MAKE_TIMESTAMP(2024, 5, 19, 14, NULL, 45)              AS null_min;
null_min
NULL
SELECT MAKE_TIMESTAMP(2024, 5, 19, 14, 30, NULL)              AS null_sec;
null_sec
NULL
SELECT MAKE_TIMESTAMP(NULL, NULL, NULL, NULL, NULL, NULL) IS NULL AS all_null_pred;
all_null_pred
1
=== MAKE_TIMESTAMP — arity errors → 1105 ===
SELECT MAKE_TIMESTAMP();
ERROR 1105: execution error: MAKE_TIMESTAMP requires 6 arguments
SELECT MAKE_TIMESTAMP(2024, 5, 19);
ERROR 1105: execution error: MAKE_TIMESTAMP requires 6 arguments
SELECT MAKE_TIMESTAMP(2024, 5, 19, 14, 30, 45, 0);
ERROR 1105: execution error: MAKE_TIMESTAMP requires 6 arguments
=== MAKE_TIMESTAMP — wrong-type per-position errors ===
SELECT MAKE_TIMESTAMP('twenty', 5, 19, 14, 30, 45);
ERROR 1105: execution error: MAKE_TIMESTAMP year must be integer
SELECT MAKE_TIMESTAMP(2024, 'May', 19, 14, 30, 45);
ERROR 1105: execution error: MAKE_TIMESTAMP month must be integer
SELECT MAKE_TIMESTAMP(2024, 5, 19, 14, 30, 'forty-five');
ERROR 1105: execution error: MAKE_TIMESTAMP second must be numeric
=== MAKE_INTERVAL — full 7-arg form ===
SELECT MAKE_INTERVAL(1, 2, 3, 4, 5, 6, 7)                     AS full_7_arg;
full_7_arg
1 year 2 mons 25 days 05:06:07
=== MAKE_INTERVAL — weeks*7 + days combined ===
SELECT MAKE_INTERVAL(0, 0, 2, 3)                              AS weeks_and_days_collapse;
weeks_and_days_collapse
408:00:00
=== MAKE_INTERVAL — years*12 + months combined ===
SELECT MAKE_INTERVAL(2, 5)                                    AS years_months_pg;
years_months_pg
2 years 5 mons
=== MAKE_INTERVAL — STRIKING: NULL is COERCED TO 0 (no NULL-prop) ===
SELECT MAKE_INTERVAL(NULL)                                    AS null_year_eq_zero;
null_year_eq_zero
00:00:00
SELECT MAKE_INTERVAL(NULL, NULL, NULL, NULL, NULL, NULL, NULL) AS all_null_zero;
all_null_zero
00:00:00
SELECT MAKE_INTERVAL(NULL, 5, 0, 0, 0, 0, 0)
     = MAKE_INTERVAL(0, 5, 0, 0, 0, 0, 0)                     AS null_eq_zero;
null_eq_zero
1
SELECT MAKE_INTERVAL(NULL, 6, NULL, 0)                        AS six_months;
six_months
6 mons
=== MAKE_INTERVAL — STRIKING: zero-arg form accepted ===
SELECT MAKE_INTERVAL()                                        AS zero_arg_form;
zero_arg_form
00:00:00
SELECT MAKE_INTERVAL() IS NULL                                AS zero_arg_NOT_null;
zero_arg_NOT_null
0
=== MAKE_INTERVAL — secs accepts fractional ===
SELECT MAKE_INTERVAL(0, 0, 0, 0, 0, 0, 1.5)                   AS one_point_five_sec;
one_point_five_sec
00:00:01.500000
=== MAKE_INTERVAL — arity > 7 → 1105 ===
SELECT MAKE_INTERVAL(0, 0, 0, 0, 0, 0, 0, 0);
ERROR 1105: execution error: MAKE_INTERVAL takes at most 7 arguments
=== MAKE_INTERVAL — wrong-type → 1105 ===
SELECT MAKE_INTERVAL('one');
ERROR 1105: execution error: MAKE_INTERVAL arguments must be integer or float
SELECT MAKE_INTERVAL(0, 'two');
ERROR 1105: execution error: MAKE_INTERVAL arguments must be integer or float
SELECT MAKE_INTERVAL(CAST(1.5 AS DOUBLE PRECISION));
ERROR 1105: execution error: MAKE_INTERVAL arguments must be integer or float
=== MAKE_INTERVAL — overflow guards ===
SELECT MAKE_INTERVAL(CAST(1000000000000000000 AS BIGINT), 0);
ERROR 1105: execution error: MAKE_INTERVAL months overflow
SELECT MAKE_INTERVAL(CAST(200000000 AS BIGINT), 0);
ERROR 1105: execution error: MAKE_INTERVAL months out of range: 2400000000
