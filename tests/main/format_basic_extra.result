=== Basic 2-arg formatting ===
SELECT FORMAT(12345.6789, 2)        AS basic;
basic
12,345.68
SELECT FORMAT(1234567, 0)           AS int_no_dec;
int_no_dec
1,234,567
SELECT FORMAT(0, 2)                 AS zero;
zero
0.00
SELECT FORMAT(0.5, 1)               AS half;
half
0.5
=== Negative numbers (sign preserved, grouping inside sign) ===
SELECT FORMAT(-1234567.89, 2)       AS neg_basic;
neg_basic
-1,234,567.89
SELECT FORMAT(-0.5, 1)              AS neg_half;
neg_half
-0.5
=== Decimal padding (more decimals than the input has) ===
SELECT FORMAT(1, 2)                 AS pad_int;
pad_int
1.00
SELECT FORMAT(1.5, 4)               AS pad_extra;
pad_extra
1.5000
SELECT FORMAT(123456789, 3)         AS pad_big_int;
pad_big_int
123,456,789.000
=== Decimal truncation (rust_decimal bankers rounding) ===
SELECT FORMAT(1.234, 2)             AS round_down_nontie;
round_down_nontie
1.23
SELECT FORMAT(1.5, 0)               AS tie_1_5_to_even;
tie_1_5_to_even
2
SELECT FORMAT(2.5, 0)               AS tie_2_5_to_even;
tie_2_5_to_even
2
SELECT FORMAT(0.5, 0)               AS tie_0_5_to_even;
tie_0_5_to_even
0
SELECT FORMAT(1.225, 2)             AS tie_1_225_to_even;
tie_1_225_to_even
1.22
SELECT FORMAT(1.245, 2)             AS tie_1_245_to_even;
tie_1_245_to_even
1.24
=== Large numbers (grouping every 3 digits) ===
SELECT FORMAT(1000, 0)              AS thousand;
thousand
1,000
SELECT FORMAT(1000000, 0)           AS million;
million
1,000,000
SELECT FORMAT(1000000000, 0)        AS billion;
billion
1,000,000,000
SELECT FORMAT(1234567890123, 2)     AS trillion_plus;
trillion_plus
1,234,567,890,123.00
=== Large-integer precision loss (i64 → f64) ===
SELECT FORMAT(9223372036854775807, 0) AS int_max_f64_precision_loss;
int_max_f64_precision_loss
9,223,372,036,854,775,808
=== 3-arg locale form (locale silently ignored) ===
SELECT FORMAT(1234.5, 2, 'en_US') = FORMAT(1234.5, 2) AS locale_en_us_noop;
locale_en_us_noop
1
SELECT FORMAT(1234.5, 2, 'de_DE') = FORMAT(1234.5, 2) AS locale_de_de_noop;
locale_de_de_noop
1
SELECT FORMAT(1234.5, 2, 'xx_YY') = FORMAT(1234.5, 2) AS locale_unknown_noop;
locale_unknown_noop
1
=== Decimals clamp: negative → 0, > 30 → 30 ===
SELECT FORMAT(1.5, -1)              AS neg_decimals;
neg_decimals
2
SELECT LENGTH(FORMAT(1, 99)) = 32   AS clamped_to_30;
clamped_to_30
1
=== Non-finite f64 → NULL ===
SELECT FORMAT(CAST('NaN' AS DOUBLE PRECISION),       2) IS NULL AS nan_returns_null;
nan_returns_null
1
SELECT FORMAT(CAST('Infinity' AS DOUBLE PRECISION),  2) IS NULL AS inf_returns_null;
inf_returns_null
1
SELECT FORMAT(CAST('-Infinity' AS DOUBLE PRECISION), 2) IS NULL AS neg_inf_returns_null;
neg_inf_returns_null
1
=== NULL passthrough ===
SELECT FORMAT(NULL, 2)        IS NULL AS null_n;
null_n
1
SELECT FORMAT(1.5, NULL)      IS NULL AS null_decimals;
null_decimals
1
=== Determinism ===
SELECT FORMAT(12345.67, 2) = FORMAT(12345.67, 2) AS deterministic;
deterministic
1
=== Arity errors ===
SELECT FORMAT();
ERROR 1105: execution error: FORMAT requires 2 or 3 arguments (number, decimals[, locale])
SELECT FORMAT(1.5);
ERROR 1105: execution error: FORMAT requires 2 or 3 arguments (number, decimals[, locale])
SELECT FORMAT(1.5, 2, 'en_US', 'extra');
ERROR 1105: execution error: FORMAT requires 2 or 3 arguments (number, decimals[, locale])
