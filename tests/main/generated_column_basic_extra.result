=== Setup: STORED generated column ===
DROP TABLE IF EXISTS gct;
CREATE TABLE gct (a INT, b INT, c INT GENERATED ALWAYS AS (a+b) STORED);
=== INSERT auto-fills generated col ===
INSERT INTO gct (a, b) VALUES (1, 2), (3, 4);
SELECT a, b, c FROM gct ORDER BY a;
a	b	c
1	2	3
3	4	7
=== UPDATE base col recomputes generated col ===
UPDATE gct SET a = 10 WHERE b = 2;
SELECT a, b, c FROM gct ORDER BY a;
a	b	c
3	4	7
10	2	12
=== NULL in base col propagates to generated col ===
INSERT INTO gct (a) VALUES (5);
SELECT a, b, c FROM gct WHERE b IS NULL;
a	b	c
5	NULL	NULL
=== String concat generated col ===
DROP TABLE IF EXISTS gconcat;
CREATE TABLE gconcat (first TEXT, last TEXT, full TEXT GENERATED ALWAYS AS (first || ' ' || last) STORED);
INSERT INTO gconcat (first, last) VALUES ('Ada', 'Lovelace');
SELECT full FROM gconcat;
full
Ada Lovelace
DROP TABLE gconcat;
=== UNIQUE on generated col enforced — duplicate is 1062 ===
DROP TABLE IF EXISTS gix;
CREATE TABLE gix (a INT, b INT, c INT GENERATED ALWAYS AS (a+b) STORED, UNIQUE (c));
INSERT INTO gix (a, b) VALUES (1, 2);
INSERT INTO gix (a, b) VALUES (2, 1);
ERROR 1062: duplicate key value violates unique constraint "test.public.gix_c_key": Key already exists in index "test.public.gix_c_key"
DROP TABLE gix;
=== KNOWN GAP: VIRTUAL keyword unsupported — errno 1064 ===
CREATE TABLE gv (a INT, b INT, c INT GENERATED ALWAYS AS (a*b) VIRTUAL);
ERROR 1064: SQL parse error: sql parser error: Expected: STORED, found: VIRTUAL at Line: 1, Column: 64
=== KNOWN GAP: shorthand col AS (expr) unsupported — errno 1064 ===
CREATE TABLE gshort (a INT, b INT, c INT AS (a+b));
ERROR 1064: SQL parse error: sql parser error: Expected: ',' or ')' after column definition, found: ( at Line: 1, Column: 45
=== KNOWN GAP: explicit INSERT into generated col — errno 1105 ===
INSERT INTO gct (a, b, c) VALUES (7, 8, 99);
ERROR 1105: plan error: column "c" is a generated column and cannot be written to directly
=== KNOWN GAP: chained generated cols — errno 1105 ===
CREATE TABLE gchain (a INT, b INT GENERATED ALWAYS AS (a*2) STORED, c INT GENERATED ALWAYS AS (b+1) STORED);
ERROR 1105: execution error: cannot use generated column "b" in expression for generated column "c"
=== KNOWN BUG: GENERATED ALWAYS AS IDENTITY leaves id NULL ===
DROP TABLE IF EXISTS gid;
CREATE TABLE gid (id INT GENERATED ALWAYS AS IDENTITY, n INT);
INSERT INTO gid (n) VALUES (10), (20);
SELECT id, n FROM gid ORDER BY n;
id	n
NULL	10
NULL	20
DROP TABLE gid;
=== KNOWN BUG: GENERATED BY DEFAULT AS IDENTITY same — leaves id NULL ===
DROP TABLE IF EXISTS gid2;
CREATE TABLE gid2 (id INT GENERATED BY DEFAULT AS IDENTITY, n INT);
INSERT INTO gid2 (n) VALUES (100);
SELECT id, n FROM gid2;
id	n
NULL	100
DROP TABLE gid2;
=== KNOWN BUG: ALTER ADD GENERATED does NOT backfill ===
DROP TABLE IF EXISTS gat;
CREATE TABLE gat (a INT, b INT);
INSERT INTO gat VALUES (1, 2);
ALTER TABLE gat ADD COLUMN c INT GENERATED ALWAYS AS (a+b) STORED;
# Existing row stays NULL (BUG); new inserts compute correctly:
SELECT a, b, c FROM gat;
a	b	c
1	2	NULL
INSERT INTO gat (a, b) VALUES (5, 6);
SELECT a, b, c FROM gat ORDER BY a;
a	b	c
1	2	NULL
5	6	11
DROP TABLE gat;
=== KNOWN BUG: generation expression is late-bound (bad ref accepted at CREATE) ===
DROP TABLE IF EXISTS gbad;
CREATE TABLE gbad (a INT, c INT GENERATED ALWAYS AS (a+z) STORED);
INSERT INTO gbad (a) VALUES (1);
ERROR 1054: column not found: z
DROP TABLE gbad;
=== KNOWN DIVERGENCE: SHOW CREATE TABLE strips GENERATED clause ===
SHOW CREATE TABLE gct;
Table	Create Table
gct	CREATE TABLE `gct` (
  `a` int,
  `b` int,
  `c` int,
  PRIMARY KEY (`_rowid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
=== KNOWN DIVERGENCE: information_schema.columns has no is_generated ===
SELECT column_name, is_generated, generation_expression FROM information_schema.columns WHERE table_name='gct';
ERROR 1054: Unknown column 'is_generated' in 'field list'
DROP TABLE gct;
