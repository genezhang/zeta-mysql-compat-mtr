=== PI — math constant (Float64) ===
SELECT PI() > 3.14159265                                      AS pi_above_lower;
pi_above_lower
1
SELECT PI() < 3.14159266                                      AS pi_below_upper;
pi_below_upper
1
SELECT 2 * PI() > 6.2831                                      AS two_pi_above;
two_pi_above
1
SELECT 2 * PI() < 6.2833                                      AS two_pi_below;
two_pi_below
1
SELECT PI() <> 3                                              AS pi_not_three;
pi_not_three
1
SELECT PI() = CAST(3.141592653589793 AS DOUBLE PRECISION)     AS exact_f64_match;
exact_f64_match
1
=== PI — wrong-arg error ===
SELECT PI(1);
ERROR 1105: execution error: PI() takes no arguments
SELECT PI('arg');
ERROR 1105: execution error: PI() takes no arguments
=== UUID_NIL — all-zero UUID sentinel ===
SELECT UUID_NIL()                                             AS nil_uuid;
nil_uuid
00000000-0000-0000-0000-000000000000
SELECT LENGTH(UUID_NIL())                                     AS len_36;
len_36
36
SELECT UUID_NIL() = UUID_NIL()                                AS self_eq_1;
self_eq_1
1
SELECT UUID_NIL() <> GEN_RANDOM_UUID()                        AS nil_ne_random;
nil_ne_random
1
SELECT UUID_NIL() = '00000000-0000-0000-0000-000000000000'    AS matches_canonical_zero;
matches_canonical_zero
1
=== UUID_NIL — wrong-arg error ===
SELECT UUID_NIL(1);
ERROR 1105: execution error: uuid_nil() takes no arguments
SELECT UUID_NIL('a', 'b');
ERROR 1105: execution error: uuid_nil() takes no arguments
=== ZETA_LAST_COMMIT_HLC — vendor HLC inspector ===
SELECT ZETA_LAST_COMMIT_HLC() >= 0                            AS hlc_non_negative;
hlc_non_negative
1
SELECT ZETA_LAST_COMMIT_HLC() = ZETA_LAST_COMMIT_HLC()        AS hlc_stable_in_stmt;
hlc_stable_in_stmt
1
BEGIN;
COMMIT;
SELECT ZETA_LAST_COMMIT_HLC() IS NOT NULL                     AS post_commit_hlc_defined;
post_commit_hlc_defined
1
=== ZETA_LAST_COMMIT_HLC — wrong-arg error ===
SELECT ZETA_LAST_COMMIT_HLC(1);
ERROR 1105: execution error: zeta_last_commit_hlc() takes no arguments
SELECT ZETA_LAST_COMMIT_HLC('a');
ERROR 1105: execution error: zeta_last_commit_hlc() takes no arguments
=== Cross-function: type independence ===
SELECT PI() > 0, UUID_NIL() IS NOT NULL,
       ZETA_LAST_COMMIT_HLC() >= 0                            AS types_distinct;
PI() > 0	UUID_NIL() IS NOT NULL	types_distinct
1	1	1
