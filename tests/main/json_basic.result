=== Setup ===
DROP TABLE IF EXISTS j;
CREATE TABLE j (id INT PRIMARY KEY, data JSON);
INSERT INTO j VALUES
 (1, '{"name":"alice","age":30}'),
 (2, '[1,2,3]'),
 (3, '{"a":{"b":42}}');
=== Stored JSON round-trips (keys sort lexicographically) ===
SELECT id, data FROM j ORDER BY id;
id	data
1	{"age":30,"name":"alice"}
2	[1,2,3]
3	{"a":{"b":42}}
=== JSON_OBJECT ===
SELECT JSON_OBJECT('k1', 'v1', 'k2', 42) AS o;
o
{"k1":"v1","k2":42}
=== JSON_ARRAY ===
SELECT JSON_ARRAY(1, 2, 3, 'x') AS a;
a
[1,2,3,"x"]
=== JSON_EXTRACT ===
SELECT JSON_EXTRACT(data, '$.name') AS name FROM j WHERE id = 1;
name
"alice"
=== -> (path) returns quoted ===
SELECT data->'name' AS n FROM j WHERE id = 1;
n
"alice"
=== ->> (path) returns unquoted text ===
SELECT data->>'name' AS n FROM j WHERE id = 1;
n
alice
=== Numeric path on array ===
SELECT data->0 AS first FROM j WHERE id = 2;
first
1
=== JSON_TYPE ===
SELECT id, JSON_TYPE(data) AS t FROM j ORDER BY id;
id	t
1	OBJECT
2	ARRAY
3	OBJECT
=== JSON_VALID ===
SELECT JSON_VALID('{"x":1}') AS ok;
ok
1
=== JSON_QUOTE / JSON_UNQUOTE ===
SELECT JSON_QUOTE('hello') AS q;
q
"hello"
SELECT JSON_UNQUOTE('"hello"') AS u;
u
hello
=== CAST AS JSON ===
SELECT CAST('{"x":1}' AS JSON) AS c;
c
{"x":1}
=== Zeta extras: @> containment and ? key-exists (PG) ===
SELECT data @> '{"name":"alice"}' AS contains FROM j WHERE id = 1;
contains
1
SELECT data ? 'name' AS has_name FROM j WHERE id = 1;
has_name
1
=== JSON_LENGTH — FIXED via zeta #1162 ===
# array → element count, object → key count, scalar → 1,
# NULL → NULL. Single-arg form only; the two-arg path form
# `JSON_LENGTH(j, '$.path')` is a separate slice.
SELECT id, JSON_LENGTH(data) AS n FROM j ORDER BY id;
id	n
1	2
2	3
3	1
SELECT JSON_LENGTH('42') AS scalar_n;
scalar_n
1
SELECT JSON_LENGTH(CAST(NULL AS JSON)) AS null_n;
null_n
NULL
=== JSON_KEYS — FIXED via zeta #1163 ===
# object → JSON ARRAY of keys (sorted, since zeta JSONB
# stores object keys sorted); array / scalar / JSON null
# → SQL NULL.
SELECT JSON_KEYS(data) AS k FROM j WHERE id = 1;
k
["age","name"]
SELECT JSON_KEYS(data) AS k FROM j WHERE id = 2;
k
NULL
SELECT JSON_KEYS(data) AS k FROM j WHERE id = 3;
k
["a"]
SELECT JSON_KEYS(CAST(NULL AS JSON)) AS null_k;
null_k
NULL
=== KNOWN GAPS: MySQL JSON_xxx functions not yet implemented ===
# All raise errno 1105 "unknown function". A future slice that
# wires these to the existing jsonb_* implementations must
# retighten each pin below.
=== JSON_SET — FIXED via zeta #1171 (first-pass, object keys) ===
# Replaces existing keys; adds new ones. Variadic (path, value).
SELECT JSON_SET('{"a":1}', '$.a', 99) AS s;
s
{"a":99}
SELECT JSON_SET('{"a":1}', '$.b', 2) AS s;
s
{"a":1,"b":2}
SELECT JSON_SET('{"a":1}', '$.a', 2, '$.b', 3) AS s;
s
{"a":2,"b":3}
SELECT JSON_INSERT(data, '$.new', 'x') FROM j WHERE id = 1;
ERROR 1105: execution error: unknown function: JSON_INSERT
SELECT JSON_REPLACE(data, '$.name', 'carol') FROM j WHERE id = 1;
ERROR 1105: execution error: unknown function: JSON_REPLACE
=== JSON_DEPTH — FIXED via zeta #1164 ===
# Recursive max depth. Scalar / empty container → 1;
# non-empty container → 1 + max(depth of children).
SELECT JSON_DEPTH('"hello"') AS d;
d
1
SELECT JSON_DEPTH('{}') AS d;
d
1
SELECT JSON_DEPTH('{"a": 1}') AS d;
d
2
SELECT JSON_DEPTH('{"a":{"b":1}}') AS d;
d
3
SELECT JSON_DEPTH('[[[1]]]') AS d;
d
4
=== JSON_CONTAINS — FIXED via zeta #1165 ===
# Two-arg form: 1 if candidate contained in target, else 0;
# NULL on NULL. Routes through zeta-jsonb's PG `@>`
# containment semantics.
SELECT JSON_CONTAINS('{"a":1,"b":2}', '{"a":1}') AS r;
r
1
SELECT JSON_CONTAINS('{"a":1}', '{"z":1}') AS r;
r
0
SELECT JSON_CONTAINS('[1,2,3]', '2') AS r;
r
1
SELECT JSON_CONTAINS('[1,2,3]', '4') AS r;
r
0
SELECT JSON_CONTAINS('[1,2,3]', '[2,3]') AS r;
r
1
SELECT JSON_CONTAINS(CAST(NULL AS JSON), '1') AS r;
r
NULL
=== JSON_OBJECTAGG — supported (alias for jsonb_object_agg) ===
# Builds a JSON object from a (key, value) pair across the
# group. Keys are sorted (JSONB semantics).
DROP TABLE IF EXISTS kv;
CREATE TABLE kv (k VARCHAR(10), v INT);
INSERT INTO kv VALUES ('a', 1), ('b', 2), ('c', 3);
SELECT JSON_OBJECTAGG(k, v) AS o FROM kv;
o
{"a":1,"b":2,"c":3}
DROP TABLE kv;
=== Cleanup ===
DROP TABLE j;
