=== FOUND_ROWS() returns 0 (executor stub) ===
SELECT FOUND_ROWS() AS frv;
frv
0
=== FOUND_ROWS in an expression ===
SELECT FOUND_ROWS() + 100 AS expr;
expr
101
=== Mixed case ===
SELECT Found_Rows() AS mixed_case;
mixed_case
1
=== Arity error ===
SELECT FOUND_ROWS(1);
ERROR 1582: Incorrect parameter count in the call to native function 'FOUND_ROWS'
