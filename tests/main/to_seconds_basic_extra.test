# Independently authored TO_SECONDS smoke test for the
# GPL MTR-format runner. NOT copied or adapted from
# MySQL's mysql-test/. TO_SECONDS was missing in zeta
# before zeta PR #1240 (errored "unknown function"); this
# slice locks in the new behavior.
#
# TO_SECONDS(d) returns the number of seconds from "year 0"
# to the date/datetime `d`. Mirrors TO_DAYS at second
# resolution. Sub-second precision is dropped.
#
# Anchor: TO_SECONDS('1970-01-01 00:00:00') = 62_167_219_200
# (= 719_528 days * 86_400 sec/day).
#
# Adaptation notes:
#   # zeta-adapt: TO_SECONDS — implemented in zeta PR #1240
#     with strict 1-arg arity.
#   # zeta-adapt: DATE source → time slice is 0.
#   # zeta-adapt: TIMESTAMP source → sub-second part dropped.
#   # zeta-adapt: NULL → NULL.

--echo === Anchor: 1970-01-01 00:00:00 = 62_167_219_200 ===

SELECT TO_SECONDS('1970-01-01 00:00:00') AS anchor;
SELECT TO_SECONDS('1970-01-01')          AS date_form;

--echo === Time-of-day adds linearly ===

SELECT TO_SECONDS('1970-01-01 12:00:00') - TO_SECONDS('1970-01-01') AS noon_offset;
SELECT TO_SECONDS('1970-01-01 23:59:59') - TO_SECONDS('1970-01-01') AS end_of_day;

--echo === Day-level deltas ===

SELECT TO_SECONDS('1970-01-02') - TO_SECONDS('1970-01-01') AS one_day;
SELECT TO_SECONDS('2024-01-01') - TO_SECONDS('2023-01-01') AS one_year_2023;

--echo === Sub-second precision dropped ===

SELECT TO_SECONDS('2024-03-15 13:00:00.999999')
     - TO_SECONDS('2024-03-15 13:00:00')
       AS subsec_zero;

--echo === DATE column source ===

SELECT TO_SECONDS(CAST('1970-01-01' AS DATE)) AS from_date_col;

--echo === NULL propagation ===

SELECT TO_SECONDS(NULL) AS n;

--echo === Arity error ===

--error 1105
SELECT TO_SECONDS();

--echo === Round-trip: TO_DAYS * 86400 matches TO_SECONDS for pure dates ===
# Sanity that the two MySQL day/sec helpers agree.

SELECT TO_DAYS('2024-03-15') * 86400 = TO_SECONDS('2024-03-15') AS day_sec_agree;
