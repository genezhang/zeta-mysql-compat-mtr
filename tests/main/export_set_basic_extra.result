=== Canonical doc example — 5 = 0b0101, 4 bits ===
SELECT EXPORT_SET(5, 'Y', 'N', ',', 4) AS canonical;
canonical
Y,N,Y,N
=== All zero / all one ===
SELECT EXPORT_SET(0, '1', '0', '|', 3) AS all_zero;
all_zero
0|0|0
SELECT EXPORT_SET(7, 'on', 'off', '/', 4) AS three_set;
three_set
on/on/on/off
=== Default separator (',') and default n_bits (64) ===
SELECT EXPORT_SET(1, 'Y', 'N') LIKE 'Y,N,N,N,N,%' AS default_prefix_ok;
default_prefix_ok
1
SELECT LENGTH(EXPORT_SET(1, 'Y', 'N')) - LENGTH(REPLACE(EXPORT_SET(1, 'Y', 'N'), ',', '')) AS comma_count;
comma_count
63
=== n_bits boundary: 0, 64, >64 (clamp), <0 (clamp) ===
SELECT EXPORT_SET(255, 'Y', 'N', ',', 0) AS nbits_zero;
nbits_zero

SELECT LENGTH(EXPORT_SET(0, '1', '0', '', 100)) AS nbits_clamped_high;
nbits_clamped_high
64
SELECT EXPORT_SET(255, 'Y', 'N', ',', -1) AS nbits_clamped_low;
nbits_clamped_low

=== Negative bits — two's complement (-1 = all 64 bits set) ===
SELECT EXPORT_SET(-1, '1', '0', '', 8) AS neg_all_set;
neg_all_set
11111111
=== NULL propagation in every arg slot ===
SELECT EXPORT_SET(NULL, 'Y', 'N') AS n1;
n1
NULL
SELECT EXPORT_SET(5, NULL, 'N') AS n2;
n2
NULL
SELECT EXPORT_SET(5, 'Y', NULL) AS n3;
n3
NULL
SELECT EXPORT_SET(5, 'Y', 'N', NULL) AS n4;
n4
NULL
SELECT EXPORT_SET(5, 'Y', 'N', ',', NULL) AS n5;
n5
NULL
=== Arity errors ===
SELECT EXPORT_SET();
ERROR 1105: execution error: EXPORT_SET requires 3 to 5 arguments
SELECT EXPORT_SET(1);
ERROR 1105: execution error: EXPORT_SET requires 3 to 5 arguments
SELECT EXPORT_SET(1, 'a');
ERROR 1105: execution error: EXPORT_SET requires 3 to 5 arguments
SELECT EXPORT_SET(1, 'a', 'b', ',', 4, 5);
ERROR 1105: execution error: EXPORT_SET requires 3 to 5 arguments
=== Against a TEXT/INT column ===
DROP TABLE IF EXISTS es_test;
CREATE TABLE es_test (id INT, mask INT);
INSERT INTO es_test VALUES (1, 0), (2, 1), (3, 3), (4, 7);
SELECT id, EXPORT_SET(mask, 'Y', 'N', '', 3) AS rendered FROM es_test ORDER BY id;
id	rendered
1	NNN
2	YNN
3	YYN
4	YYY
DROP TABLE es_test;
