=== YEARWEEK basic — mode 0, week 20 of 2026 ===
SELECT YEARWEEK(DATE '2026-05-19') AS week_20_2026;
week_20_2026
202620
=== YEARWEEK at year boundaries ===
SELECT YEARWEEK(DATE '2024-01-01') AS mon_jan1_2024;
mon_jan1_2024
202353
SELECT YEARWEEK(DATE '2026-01-01') AS thu_jan1_2026;
thu_jan1_2026
202552
SELECT YEARWEEK(DATE '2026-12-31') AS thu_dec31_2026;
thu_dec31_2026
202652
=== Week-year != calendar year (mode 0 rollover) ===
# 2024-12-30 Mon → week 52 of 2024 (no shift in mode 0)
# 2023-01-01 Sun → week 1 of 2023 (first Sunday)
# 2021-01-01 Fri → week 52 of 2020 (before first Sunday)
SELECT YEARWEEK(DATE '2024-12-30') AS dec30_2024;
dec30_2024
202452
SELECT YEARWEEK(DATE '2023-01-01') AS sun_jan1_2023;
sun_jan1_2023
202301
SELECT YEARWEEK(DATE '2021-01-01') AS fri_jan1_2021;
fri_jan1_2021
202052
=== Optional mode arg — MySQL mode semantics (default 0) ===
# mode 0 = Sunday-first; mode 3 = ISO (Monday, 4-day rule)
SELECT YEARWEEK(DATE '2026-05-19', 0) AS m0;
m0
202620
SELECT YEARWEEK(DATE '2026-05-19', 3) AS m3;
m3
202621
SELECT YEARWEEK(DATE '2026-05-19', 7) AS m7;
m7
202620
=== TIMESTAMP and string inputs ===
SELECT YEARWEEK(TIMESTAMP '2026-05-19 14:00:00') AS ts;
ts
202620
SELECT YEARWEEK('2026-05-19') AS str;
str
202620
=== NULL propagation in either arg ===
SELECT YEARWEEK(NULL) AS n_date;
n_date
NULL
SELECT YEARWEEK(DATE '2026-05-19', NULL) AS n_mode;
n_mode
NULL
=== Mode out of range — errno 1105 ===
SELECT YEARWEEK(DATE '2026-05-19', 8);
ERROR 1105: execution error: YEARWEEK: mode 8 out of valid range 0..=7
SELECT YEARWEEK(DATE '2026-05-19', -1);
ERROR 1105: execution error: YEARWEEK: mode -1 out of valid range 0..=7
=== Arity errors ===
SELECT YEARWEEK();
ERROR 1105: execution error: YEARWEEK requires 1 or 2 arguments
SELECT YEARWEEK(DATE '2026-05-19', 0, 1);
ERROR 1105: execution error: YEARWEEK requires 1 or 2 arguments
=== Unparseable string errors 1105 ===
SELECT YEARWEEK('not a date');
ERROR 1105: execution error: YEARWEEK: cannot parse "not a date" as a date or timestamp
=== On DATE column inside SELECT / GROUP BY ===
DROP TABLE IF EXISTS yw;
CREATE TABLE yw (id INT, d DATE);
INSERT INTO yw VALUES (1, DATE '2026-01-05'), (2, DATE '2026-01-12'), (3, DATE '2026-05-19'), (4, DATE '2026-12-31');
SELECT id, YEARWEEK(d) AS yw FROM yw ORDER BY id;
id	yw
1	202601
2	202602
3	202620
4	202652
SELECT YEARWEEK(d) AS yw, COUNT(*) AS c FROM yw GROUP BY YEARWEEK(d) ORDER BY yw;
yw	c
202601	1
202602	1
202620	1
202652	1
DROP TABLE yw;
