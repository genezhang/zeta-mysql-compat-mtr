=== Setup ===
DROP TABLE IF EXISTS fkna_c;
DROP TABLE IF EXISTS fkna_p;
CREATE TABLE fkna_p (id INT PRIMARY KEY);
=== ON DELETE NO ACTION — alias for RESTRICT ===
CREATE TABLE fkna_c (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fkna_p(id) ON DELETE NO ACTION);
INSERT INTO fkna_p VALUES (1);
INSERT INTO fkna_c VALUES (10, 1);
DELETE FROM fkna_p WHERE id = 1;
ERROR 1451: Cannot delete or update a parent row: a foreign key constraint fails (`test`.`fkna_c`, CONSTRAINT `fkna_c_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `fkna_p` (`id`))
=== ON DELETE SET DEFAULT — child reverts to column DEFAULT ===
DROP TABLE IF EXISTS fkd_c;
DROP TABLE IF EXISTS fkd_p;
CREATE TABLE fkd_p (id INT PRIMARY KEY);
CREATE TABLE fkd_c (id INT PRIMARY KEY, pid INT DEFAULT 1,
  FOREIGN KEY (pid) REFERENCES fkd_p(id) ON DELETE SET DEFAULT);
INSERT INTO fkd_p VALUES (1), (2);
INSERT INTO fkd_c VALUES (10, 2);
DELETE FROM fkd_p WHERE id = 2;
ERROR 1451: Cannot delete or update a parent row: a foreign key constraint fails (`test`.`fkd_c`, CONSTRAINT `fkd_c_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `fkd_p` (`id`))
SELECT id, pid FROM fkd_c;
id	pid
10	2
=== ALTER TABLE ADD CONSTRAINT FOREIGN KEY — enforced after ===
DROP TABLE IF EXISTS fka_c;
DROP TABLE IF EXISTS fka_p;
CREATE TABLE fka_p (id INT PRIMARY KEY);
CREATE TABLE fka_c (id INT PRIMARY KEY, pid INT);
INSERT INTO fka_p VALUES (1);
INSERT INTO fka_c VALUES (10, 1);
ALTER TABLE fka_c ADD CONSTRAINT fka_fk FOREIGN KEY (pid) REFERENCES fka_p(id);
INSERT INTO fka_c VALUES (20, 99);
ERROR 1452: Cannot add or update a child row: a foreign key constraint fails (`test`.`fka_c`, CONSTRAINT `fka_fk` FOREIGN KEY (`pid`) REFERENCES `fka_p` (`id`))
=== ALTER TABLE DROP CONSTRAINT — FK no longer enforced ===
ALTER TABLE fka_c DROP CONSTRAINT fka_fk;
INSERT INTO fka_c VALUES (30, 999);
SELECT id, pid FROM fka_c ORDER BY id;
id	pid
10	1
30	999
=== Named CONSTRAINT FOREIGN KEY — name surfaces in error ===
DROP TABLE IF EXISTS nfk_c;
DROP TABLE IF EXISTS nfk_p;
CREATE TABLE nfk_p (id INT PRIMARY KEY);
CREATE TABLE nfk_c (id INT PRIMARY KEY, pid INT,
  CONSTRAINT my_fk FOREIGN KEY (pid) REFERENCES nfk_p(id));
INSERT INTO nfk_p VALUES (1);
INSERT INTO nfk_c VALUES (10, 99);
ERROR 1452: Cannot add or update a child row: a foreign key constraint fails (`test`.`nfk_c`, CONSTRAINT `my_fk` FOREIGN KEY (`pid`) REFERENCES `nfk_p` (`id`))
=== Inline column-level REFERENCES (short form) ===
DROP TABLE IF EXISTS ifk_c;
DROP TABLE IF EXISTS ifk_p;
CREATE TABLE ifk_p (id INT PRIMARY KEY);
CREATE TABLE ifk_c (id INT PRIMARY KEY, pid INT REFERENCES ifk_p(id));
INSERT INTO ifk_p VALUES (1);
INSERT INTO ifk_c VALUES (10, 1);
INSERT INTO ifk_c VALUES (20, 999);
=== PG MATCH FULL clause — parses, silent no-op ===
DROP TABLE IF EXISTS mfk_c;
DROP TABLE IF EXISTS mfk_p;
CREATE TABLE mfk_p (id INT PRIMARY KEY);
CREATE TABLE mfk_c (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES mfk_p(id) MATCH FULL);
=== FK to non-existent table — errno 1146 ===
DROP TABLE IF EXISTS fknope;
CREATE TABLE fknope (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES no_such_parent(id));
ERROR 1824: Failed to open the referenced table 'no_such_parent'
=== FK to non-PK column — errno 1105 ===
DROP TABLE IF EXISTS fknopk;
DROP TABLE IF EXISTS fknopkc;
CREATE TABLE fknopk (id INT);
CREATE TABLE fknopkc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fknopk(id));
ERROR 6125: Failed to add the foreign key constraint. Missing unique key for constraint 'fknopkc_ibfk_1' in the referenced table 'fknopk'
=== DROP TABLE blocked when referenced — errno 1105 ===
DROP TABLE IF EXISTS dr_c;
DROP TABLE IF EXISTS dr_p;
CREATE TABLE dr_p (id INT PRIMARY KEY);
CREATE TABLE dr_c (id INT PRIMARY KEY, pid INT, FOREIGN KEY (pid) REFERENCES dr_p(id));
INSERT INTO dr_p VALUES (1);
INSERT INTO dr_c VALUES (10, 1);
DROP TABLE dr_p;
ERROR 3730: Cannot drop table 'dr_p' referenced by a foreign key constraint 'dr_c_ibfk_1' on table 'dr_c'.
=== KNOWN DIVERGENCE: DROP TABLE CASCADE still blocked ===
DROP TABLE dr_p CASCADE;
ERROR 3730: Cannot drop table 'dr_p' referenced by a foreign key constraint 'dr_c_ibfk_1' on table 'dr_c'.
=== KNOWN GAP: TRUNCATE parent with FK children — errno 1105 ===
TRUNCATE TABLE dr_p;
ERROR 1701: Cannot truncate a table referenced in a foreign key constraint (`test`.`dr_c`, CONSTRAINT `dr_c_ibfk_1`)
=== KNOWN DIVERGENCE: SHOW CREATE TABLE omits FK constraint ===
SHOW CREATE TABLE dr_c;
Table	Create Table
dr_c	CREATE TABLE `dr_c` (
  `id` int NOT NULL,
  `pid` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `pid` (`pid`),
  CONSTRAINT `dr_c_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `dr_p` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
=== KNOWN GAP: MySQL `ALTER TABLE DROP FOREIGN KEY` — errno 1064 ===
ALTER TABLE fka_c ADD CONSTRAINT fka_fk2 FOREIGN KEY (pid) REFERENCES fka_p(id);
ERROR 1452: <varies>
ALTER TABLE fka_c DROP FOREIGN KEY fka_fk2;
ERROR 1091: Can't DROP 'fka_fk2'; check that column/key exists
=== Cleanup ===
DROP TABLE dr_c;
DROP TABLE dr_p;
DROP TABLE fka_c;
DROP TABLE fka_p;
DROP TABLE fkna_c;
DROP TABLE fkna_p;
DROP TABLE fkd_c;
DROP TABLE fkd_p;
DROP TABLE nfk_c;
DROP TABLE nfk_p;
DROP TABLE ifk_c;
DROP TABLE ifk_p;
DROP TABLE mfk_c;
DROP TABLE mfk_p;
DROP TABLE fknopk;
