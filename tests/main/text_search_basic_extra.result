=== TO_TSVECTOR and TO_TSQUERY round-trips ===
# Display uses zeta's Debug formatter (divergence).
SELECT TO_TSVECTOR('the quick brown fox jumps') AS r;
ERROR 1305: FUNCTION test.TO_TSVECTOR does not exist
SELECT TO_TSQUERY('quick & fox') AS r;
ERROR 1305: FUNCTION test.TO_TSQUERY does not exist
SELECT PLAINTO_TSQUERY('quick fox') AS r;
ERROR 1305: FUNCTION test.PLAINTO_TSQUERY does not exist
=== @@ operator (tsvector @@ tsquery) ===
SELECT TO_TSVECTOR('the quick brown fox jumps') @@ TO_TSQUERY('quick & fox') AS match;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '@@ TO_TSQUERY('quick & fox') AS match' at line 1
SELECT TO_TSVECTOR('the quick brown fox jumps') @@ TO_TSQUERY('quick & lazy') AS no_match;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '@@ TO_TSQUERY('quick & lazy') AS no_match' at line 1
=== TS_RANK ===
# Matches return a positive score; non-matches return 0.
SELECT TS_RANK(TO_TSVECTOR('the quick brown fox jumps'), TO_TSQUERY('quick')) > 0 AS positive;
ERROR 1305: FUNCTION test.TS_RANK does not exist
SELECT TS_RANK(TO_TSVECTOR('quick fox'), TO_TSQUERY('jumps')) AS no_match;
ERROR 1305: FUNCTION test.TS_RANK does not exist
=== Setup table for query shapes ===
DROP TABLE IF EXISTS fts1;
CREATE TABLE fts1 (id INT PRIMARY KEY, body TEXT, body_tsv TSVECTOR);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TSVECTOR)' at line 1
INSERT INTO fts1 VALUES
  (1, 'the quick brown fox', TO_TSVECTOR('the quick brown fox')),
  (2, 'the lazy dog', TO_TSVECTOR('the lazy dog')),
  (3, 'fox and dog', TO_TSVECTOR('fox and dog'));
ERROR 1146: Table 'test.fts1' doesn't exist
=== tsquery & (AND) ===
SELECT id FROM fts1 WHERE body_tsv @@ TO_TSQUERY('fox & dog') ORDER BY id;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '@@ TO_TSQUERY('fox & dog') ORDER BY id' at line 1
=== tsquery | (OR) ===
SELECT id FROM fts1 WHERE body_tsv @@ TO_TSQUERY('fox | lazy') ORDER BY id;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '@@ TO_TSQUERY('fox | lazy') ORDER BY id' at line 1
=== tsquery ! (NOT) ===
SELECT id FROM fts1 WHERE body_tsv @@ TO_TSQUERY('!fox') ORDER BY id;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '@@ TO_TSQUERY('!fox') ORDER BY id' at line 1
=== TS_RANK ORDER BY ===
SELECT id FROM fts1 WHERE body_tsv @@ TO_TSQUERY('fox')
  ORDER BY TS_RANK(body_tsv, TO_TSQUERY('fox')) DESC, id;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '@@ TO_TSQUERY('fox')
  ORDER BY TS_RANK(body_tsv, TO_TSQUERY('fox')) DESC, id' at line 1
