=== KNOWN GAP: ::TSQUERY cast — errno 1105 ===
# Substitute: TO_TSQUERY(...).
SELECT 'quick & fox'::TSQUERY AS r;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::TSQUERY AS r' at line 1
=== KNOWN GAP: CREATE INDEX USING fts on TSVECTOR — errno 1105 ===
# The FTS index path is registered but the key-encoder
# for TSVECTOR isn't wired. @@ scans still work as
# sequential filters.
DROP TABLE IF EXISTS fts_t;
CREATE TABLE fts_t (id INT PRIMARY KEY, body TEXT, tsv TSVECTOR);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TSVECTOR)' at line 1
INSERT INTO fts_t VALUES (1, 'hello world', TO_TSVECTOR('hello world'));
ERROR 1146: Table 'test.fts_t' doesn't exist
CREATE INDEX ix_tsv ON fts_t USING fts(tsv);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'USING fts(tsv)' at line 1
DROP TABLE fts_t;
ERROR 1051: Unknown table 'test.fts_t'
