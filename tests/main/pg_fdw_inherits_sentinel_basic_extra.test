# Independently authored PG Foreign Data Wrapper +
# INHERITS + ALTER TYPE ADD VALUE + lo_* sentinel slice
# for the GPL MTR-format runner. NOT copied or adapted
# from MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - CREATE FOREIGN DATA WRAPPER / CREATE FOREIGN
#     TABLE / CREATE SERVER / CREATE USER MAPPING /
#     IMPORT FOREIGN SCHEMA / CREATE TABLE ... INHERITS
#     / `ALTER TYPE ... ADD VALUE 'x' BEFORE 'y'`
#     positional form / lo_create / lo_open / lo_unlink:
#     ZERO prior coverage.
#   - `ALTER TYPE ext ADD VALUE 'c'` BASIC FORM already
#     pinned at enum_type_basic_extra.test:96-102 — NOT
#     re-pinned here. Only the positional `BEFORE`/
#     `AFTER` form is new in this slice.
#   - "at least one column required" 1105 fingerprint
#     ALREADY pinned at partition_basic_extra.result:
#     64 (different DDL context).
#
# Pre-existing rejection shapes from prior taxonomies:
#   - Shape A — "Expected: an object type after CREATE,
#     found: <KW>" — see PR #390 enumeration.
#   - Shape (c) — "unsupported statement: sqlparser::
#     ast::Statement" — see PR #371 mysql_maintenance_
#     cmds_sentinel_basic_extra:79-83.
#   - Shape (d) — "Expected: an SQL statement, found:
#     <KW>" — see PR #371 mysql_maintenance_cmds_
#     sentinel_basic_extra:84-86.
#
# This slice pins:
#
#   Rejected — Shape A (PG-DDL keyword unknown):
#     - `CREATE FOREIGN DATA WRAPPER` / `CREATE FOREIGN
#       TABLE` — "Expected: an object type after
#       CREATE, found: FOREIGN".
#
#   Rejected — Shape (c) catch-all dispatcher:
#     - `CREATE SERVER ...` — sqlparser HAS a CREATE
#       SERVER AST arm, zeta dispatcher has no match
#       arm, falls through to convert.rs:432 with the
#       internal-type leak.
#
#   Rejected — Shape (d) (statement-level keyword unknown):
#     - `IMPORT FOREIGN SCHEMA ... FROM SERVER ...` —
#       "Expected: an SQL statement, found: IMPORT".
#       Same shape as PR #371's HANDLER/SHUTDOWN; new
#       keyword (IMPORT) added to the shape (d) bucket.
#
#   Rejected — NEW FINGERPRINT — CREATE USER MAPPING
#   partial-grammar 1064:
#     - "Expected: =, found: alice/PUBLIC at Line: 1,
#       Column: 25"
#     - sqlparser's CREATE USER arm (parse_create_user
#       at sqlparser-0.61.0/src/parser/mod.rs:5075-5101)
#       consumes `MAPPING` as the user-name token, then
#       expects `=` for an OPTION assignment and fails
#       on `FOR alice`/`FOR PUBLIC`. GENUINELY NEW
#       fingerprint — by-fingerprint wide-grep returns
#       zero priors for "Expected: =, found:".
#
#   KNOWN BUG — `CREATE TABLE ... INHERITS (parent)`
#   SILENTLY ACCEPTED but inheritance is DROPPED:
#     - sqlparser parses INHERITS into `CreateTable.
#       inherits` — but `zeta-parser/src/convert.rs:
#       443-668` `convert_create_table` NEVER REFERENCES
#       `ct.inherits`; the field is silently discarded.
#     - The CREATE succeeds with no error, BUT the
#       child table has NONE of the parent's columns.
#     - PROBE: `INSERT INTO child (id, n, extra)` after
#       `child (extra INT) INHERITS (parent (id, n))`
#       errors 1054 "column not found: id" — proves
#       inheritance was dropped.
#     - Two zeta internal test files
#       (zeta-server/tests/pg_regress_truncate.rs:8 and
#       pg_regress_returning.rs:8) explicitly state
#       INHERITS is "intentionally omitted".
#     - This is the silent-no-op trap pattern from
#       feedback_wire_path_divergence_check memory —
#       LOOKS supported via no-error, but the feature
#       is gone. Pinned so a fix (either implement
#       inheritance or reject the clause) drops the
#       pin in lockstep.
#     - QUIRK still present: empty child column list
#       errors 1105 "internal error: at least one
#       column required" (same fingerprint as
#       partition_basic_extra:64). Drops happen BEFORE
#       the column-count check.
#
#   SUPPORTED — `ALTER TYPE ... ADD VALUE 'x' BEFORE
#   'y'` (positional form):
#     - Basic `ALTER TYPE ext ADD VALUE 'c'` already
#       pinned at enum_type_basic_extra:96-102.
#     - This slice pins the POSITIONAL `BEFORE`/`AFTER`
#       form (genuinely new — wide-grep zero priors for
#       `ADD VALUE.*BEFORE|AFTER`). Verified via post-
#       ALTER cast: the inserted value works.
#
#   Rejected — Large-object lo_* functions:
#     - `lo_create(0)`, `lo_open(oid, mode)`,
#       `lo_unlink(oid)` → 1105 "unknown function:
#       lo_<X>" (lowercase function name).
#
# Big-picture finding:
#
#   The FDW family (CREATE SERVER / CREATE FOREIGN
#   TABLE / CREATE FOREIGN DATA WRAPPER / CREATE USER
#   MAPPING / IMPORT FOREIGN SCHEMA) hits THREE
#   distinct rejection sites: Shape A for FOREIGN-
#   prefixed DDL, Shape (c) for CREATE SERVER, Shape
#   (d) for IMPORT, plus a NEW partial-grammar shape
#   for CREATE USER MAPPING.
#
#   The INHERITS case is a SILENT-NO-OP BUG — the
#   DDL succeeds with no error but inheritance is
#   dropped. This is the wire-path-divergence trap
#   pattern: apps relying on inheritance will see
#   tables created successfully then fail at INSERT/
#   SELECT time when parent columns are missing.
#
# Adaptation notes:
#   # zeta-adapt: KNOWN GAP — FDW family (CREATE
#     SERVER, CREATE FOREIGN DATA WRAPPER, CREATE
#     FOREIGN TABLE, CREATE USER MAPPING, IMPORT
#     FOREIGN SCHEMA) all error 1064.
#   # zeta-adapt: KNOWN BUG — `CREATE TABLE ...
#     INHERITS (parent)` is silently accepted but
#     inheritance is dropped. The child table has
#     NONE of the parent's columns. Use explicit
#     column declarations or rewrite via VIEW.
#   # zeta-adapt: SUPPORTED — `ALTER TYPE ext ADD
#     VALUE 'x' BEFORE/AFTER 'y'` positional form.
#     Basic form pinned at enum_type_basic_extra:96.
#   # zeta-adapt: KNOWN GAP — Large-object lo_*
#     functions unknown. Use BYTEA storage instead.

--echo === Shape A — `CREATE FOREIGN ...` (sqlparser CREATE-dispatcher unknown) ===

--error 1064
CREATE FOREIGN DATA WRAPPER pgsql_fdw HANDLER pgsql_fdw_handler;
--error 1064
CREATE FOREIGN DATA WRAPPER stub_fdw;
--error 1064
CREATE FOREIGN TABLE ext_t (id INT) SERVER foo_server;

--echo === Shape (c) — `CREATE SERVER ...` (catch-all dispatcher, internal type leak) ===

--error 1064
CREATE SERVER foo_server FOREIGN DATA WRAPPER pgsql_fdw OPTIONS (host '127.0.0.1');
--error 1064
CREATE SERVER bar_server TYPE 'csv' FOREIGN DATA WRAPPER file_fdw;

--echo === NEW FINGERPRINT — CREATE USER MAPPING (sqlparser CREATE USER fall-through) ===

# sqlparser's CREATE USER arm consumes `MAPPING` as
# the user-name token then expects `=` for an OPTION
# assignment. "Expected: =, found: alice/PUBLIC".
--error 1064
CREATE USER MAPPING FOR alice SERVER foo_server OPTIONS (user 'a', password 'p');
--error 1064
CREATE USER MAPPING FOR PUBLIC SERVER foo_server;

--echo === Shape (d) — `IMPORT FOREIGN SCHEMA` (statement-level keyword unknown) ===

--error 1064
IMPORT FOREIGN SCHEMA public FROM SERVER foo_server INTO public;
--error 1064
IMPORT FOREIGN SCHEMA public LIMIT TO (t1, t2) FROM SERVER foo_server INTO public;

--echo === BUG — INHERITS SILENT NO-OP: DDL accepted, columns NOT inherited ===

CREATE TABLE parent_inh (id INT PRIMARY KEY, n INT);
# Silently accepted — looks like success.
CREATE TABLE child_inh (extra INT) INHERITS (parent_inh);
# PROBE: try to use parent's columns — proves inheritance
# was dropped (would work in PG; errors here).
--error 1054
INSERT INTO child_inh (id, n, extra) VALUES (1, 10, 99);
# Confirm child only has its own column.
INSERT INTO child_inh (extra) VALUES (99);
SELECT * FROM child_inh;
# Parent unaffected and works normally.
INSERT INTO parent_inh VALUES (2, 20);
SELECT * FROM parent_inh ORDER BY id;
# PG would show parent row in child too via inheritance;
# zeta does not (only child's own rows).
SELECT * FROM child_inh;
# QUIRK still present — empty column list errors 1105
# "at least one column required" (same fingerprint as
# partition_basic_extra:64). Drops happen BEFORE the
# column-count check.
--error 1105
CREATE TABLE child_empty () INHERITS (parent_inh);

--echo === SUPPORTED — ALTER TYPE ADD VALUE positional BEFORE/AFTER form ===

CREATE TYPE mood_pos AS ENUM ('sad', 'ok', 'happy');
# Basic form covered by enum_type_basic_extra:100 — not
# re-pinned. Positional form is new:
ALTER TYPE mood_pos ADD VALUE 'glad' BEFORE 'happy';
ALTER TYPE mood_pos ADD VALUE 'meh' AFTER 'ok';
# Verify the new values are usable (post-ALTER probe).
SELECT 'glad'::mood_pos AS r1;
SELECT 'meh'::mood_pos AS r2;

--echo === Rejected — Large-object lo_* functions (unknown function) ===

--error 1105
SELECT lo_create(0);
--error 1105
SELECT lo_open(12345, 262144);
--error 1105
SELECT lo_unlink(12345);

DROP TABLE child_inh;
DROP TABLE parent_inh;
DROP TYPE mood_pos;
