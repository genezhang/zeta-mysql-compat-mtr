SELECT JSON_LENGTH(JSON_SET('{"a":1}', '$',
                            CAST('{"x":1,"y":2}' AS JSONB)))  AS root_replace_with_object_len;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB)))  AS root_replace_with_object_len' at line 2
=== Mid-path array index → NULL (under-claim) ===
SELECT JSON_SET('{"a":[1,2,3]}', '$.a[0]', 9) IS NULL         AS mid_path_index_null;
mid_path_index_null
0
SELECT JSON_SET('{"a":{"b":[1,2]}}', '$.a.b[0]', 9) IS NULL   AS deep_mid_path_index_null;
deep_mid_path_index_null
0
=== Wildcard path rejection ===
SELECT JSON_SET('{"a":1,"b":2}', '$.*', 99) IS NULL           AS wildcard_object_null;
ERROR 3149: In this situation, path expressions may not contain the * and ** tokens or an array range.
SELECT JSON_SET('[1,2,3]', '$[*]', 99) IS NULL                AS wildcard_array_null;
ERROR 3149: In this situation, path expressions may not contain the * and ** tokens or an array range.
