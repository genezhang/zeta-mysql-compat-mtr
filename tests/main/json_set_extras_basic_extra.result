=== JSON_SET on already-typed JSONB target ===
SELECT JSON_EXTRACT(
  JSON_SET(CAST('{"a":1}' AS JSONB), '$.b', 2),
  '$.a', '$.b')                                               AS typed_set_extract_both;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB), '$.b', 2),
  '$.a', '$.b')                                              ' at line 2
SELECT JSON_LENGTH(
  JSON_SET(CAST('{"a":1}' AS JSONB), '$.b', 2))               AS typed_set_len;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB), '$.b', 2))               AS typed_set_len' at line 2
=== Wrong-type target → ERROR ===
SELECT JSON_SET(42, '$.a', 1);
ERROR 3146: Invalid data type for JSON data in argument 1 to function json_set; a JSON string or JSON type is required.
SELECT JSON_SET(3.14, '$.a', 1);
ERROR 3146: Invalid data type for JSON data in argument 1 to function json_set; a JSON string or JSON type is required.
SELECT JSON_SET(TRUE, '$.a', 1);
ERROR 3146: Invalid data type for JSON data in argument 1 to function json_set; a JSON string or JSON type is required.
=== Auto-create intermediate objects (set_path create=true) ===
SELECT JSON_EXTRACT(JSON_SET('{}', '$.a.b.c', 1), '$.a.b.c')
                                                              AS deep_create_leaf;
deep_create_leaf
NULL
SELECT JSON_DEPTH(JSON_SET('{}', '$.a.b.c', 1))               AS deep_create_depth;
deep_create_depth
1
SELECT JSON_TYPE(JSON_EXTRACT(JSON_SET('{}', '$.a.b.c', 1), '$.a'))
                                                              AS deep_create_a_is_object;
deep_create_a_is_object
NULL
SELECT JSON_TYPE(JSON_EXTRACT(JSON_SET('{}', '$.a.b.c', 1), '$.a.b'))
                                                              AS deep_create_ab_is_object;
deep_create_ab_is_object
NULL
SELECT JSON_LENGTH(JSON_EXTRACT(
  JSON_SET('{"x":{"z":1}}', '$.x.y', 9), '$.x'))              AS partial_create_sibling_preserved;
partial_create_sibling_preserved
2
=== Multi-pair chain: later pairs see earlier mutations ===
SELECT JSON_EXTRACT(
  JSON_SET('{"a":1}', '$.a', 2, '$.a', 3), '$.a')             AS chain_same_path_last_wins;
chain_same_path_last_wins
3
SELECT JSON_EXTRACT(
  JSON_SET('{}', '$.outer', 'scalar',
                  '$.outer.inner', 42),
  '$.outer.inner')                                            AS chain_scalar_then_nested_set;
chain_scalar_then_nested_set
NULL
SELECT JSON_TYPE(JSON_EXTRACT(
  JSON_SET('{}', '$.outer', 'scalar',
                  '$.outer.inner', 42),
  '$.outer'))                                                 AS chain_scalar_then_nested_outer_type;
chain_scalar_then_nested_outer_type
STRING
=== Root path '$' replaces target entirely ===
SELECT JSON_TYPE(JSON_SET('{"a":1}', '$', 42))                AS root_replace_with_int;
root_replace_with_int
INTEGER
SELECT JSON_TYPE(JSON_SET('{"a":1}', '$',
                          CAST('[1,2,3]' AS JSONB)))          AS root_replace_with_array;
