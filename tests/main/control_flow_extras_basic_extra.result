=== IF truthiness — String matrix ===
SELECT IF('0', 'then', 'else')                                AS str_zero_is_false;
str_zero_is_false
else
SELECT IF('', 'then', 'else')                                 AS empty_str_is_false;
empty_str_is_false
else
SELECT IF('hello', 'then', 'else')                            AS nonempty_str_is_true;
nonempty_str_is_true
then
SELECT IF('0.0', 'then', 'else')                              AS str_zero_point_zero_is_true;
str_zero_point_zero_is_true
then
SELECT IF(' ', 'then', 'else')                                AS whitespace_str_is_true;
whitespace_str_is_true
then
=== IF truthiness — Decimal vs Float64 (STRIKING finding) ===
SELECT IF(0.0, 'then', 'else')                                AS decimal_zero_is_TRUTHY;
decimal_zero_is_TRUTHY
then
SELECT IF(3.14, 'then', 'else')                               AS decimal_nonzero_is_truthy;
decimal_nonzero_is_truthy
then
SELECT IF(-1.5, 'then', 'else')                               AS decimal_negative_is_truthy;
decimal_negative_is_truthy
then
SELECT IF(0.0, 'then', 'else')
    <> IF(0,   'then', 'else')                                AS decimal_zero_differs_from_int_zero;
decimal_zero_differs_from_int_zero
1
SELECT IF(CAST(0.0 AS DOUBLE PRECISION), 'then', 'else')      AS float64_zero_is_false;
float64_zero_is_false
else
SELECT IF(CAST(3.14 AS DOUBLE PRECISION), 'then', 'else')     AS float64_nonzero_is_true;
float64_nonzero_is_true
then
=== IF truthiness — Int64 / UInt64 arms (CAST coercion) ===
SELECT IF(CAST(0 AS BIGINT), 'then', 'else')                  AS int64_zero_is_false;
int64_zero_is_false
else
SELECT IF(CAST(5 AS BIGINT), 'then', 'else')                  AS int64_nonzero_is_true;
int64_nonzero_is_true
then
SELECT IF(CAST(0 AS UNSIGNED), 'then', 'else')                AS uint64_zero_is_false;
uint64_zero_is_false
else
SELECT IF(CAST(5 AS UNSIGNED), 'then', 'else')                AS uint64_nonzero_is_true;
uint64_nonzero_is_true
then
=== IF truthiness — `_ => true` catch-all (non-scalar Value variants) ===
SELECT IF(DATE '2024-03-15', 'then', 'else')                  AS date_is_true;
date_is_true
then
SELECT IF(TIMESTAMP '2024-03-15 14:30:00', 'then', 'else')    AS timestamp_is_true;
timestamp_is_true
then
SELECT IF(CAST('{"a":1}' AS JSONB), 'then', 'else')           AS jsonb_is_true;
jsonb_is_true
then
SELECT IF(INTERVAL 1 DAY, 'then', 'else')                     AS interval_is_true;
interval_is_true
then
=== IF arity errors ===
SELECT IF();
ERROR 1105: execution error: IF requires exactly 3 arguments
SELECT IF(1);
ERROR 1105: execution error: IF requires exactly 3 arguments
SELECT IF(1, 2);
ERROR 1105: execution error: IF requires exactly 3 arguments
SELECT IF(1, 2, 3, 4);
ERROR 1105: execution error: IF requires exactly 3 arguments
=== NULLIF DATE/TIMESTAMP value-coercive equality (cross-slice link) ===
SELECT NULLIF(DATE '2024-03-15', TIMESTAMP '2024-03-15 00:00:00')
                                                              IS NULL
                                                              AS date_eq_ts_midnight_returns_null;
date_eq_ts_midnight_returns_null
1
SELECT NULLIF(DATE '2024-03-15', TIMESTAMP '2024-03-15 12:00:00')
                                                              IS NOT NULL
                                                              AS date_ne_ts_noon_returns_first;
date_ne_ts_noon_returns_first
1
=== NULLIF Bool/Int strict comparison ===
SELECT NULLIF(TRUE, 1)   IS NOT NULL                          AS bool_true_vs_int_1_kept_not_null;
bool_true_vs_int_1_kept_not_null
1
SELECT NULLIF(FALSE, 0)  IS NOT NULL                          AS bool_false_vs_int_0_kept_not_null;
bool_false_vs_int_0_kept_not_null
1
SELECT NULLIF(TRUE, TRUE)  IS NULL                            AS bool_eq_bool_returns_null;
bool_eq_bool_returns_null
1
SELECT NULLIF(1, 1)        IS NULL                            AS int_eq_int_returns_null;
int_eq_int_returns_null
1
=== ISNULL on typed values (JSONB, Date, Timestamp, Interval) ===
SELECT ISNULL(DATE '2024-03-15')                              AS isnull_date;
isnull_date
0
SELECT ISNULL(TIMESTAMP '2024-03-15 14:30:00')                AS isnull_timestamp;
isnull_timestamp
0
SELECT ISNULL(CAST('{"a":1}' AS JSONB))                       AS isnull_jsonb;
isnull_jsonb
0
SELECT ISNULL(INTERVAL 1 DAY)                                 AS isnull_interval;
isnull_interval
0
SELECT ISNULL(CAST(NULL AS DATE))                             AS isnull_typed_null;
isnull_typed_null
1
