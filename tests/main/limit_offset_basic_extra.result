=== Setup ===
DROP TABLE IF EXISTS lo;
CREATE TABLE lo (id INT PRIMARY KEY, n INT);
INSERT INTO lo VALUES (1,10),(2,20),(3,30),(4,40),(5,50);
=== LIMIT n OFFSET m (PG / SQL-standard) ===
SELECT id FROM lo ORDER BY id LIMIT 2 OFFSET 1;
id
2
3
=== LIMIT m, n (MySQL alt syntax) ===
SELECT id FROM lo ORDER BY id LIMIT 1, 2;
id
2
3
=== Bare LIMIT n (OFFSET defaults to 0) ===
SELECT id FROM lo ORDER BY id LIMIT 3;
id
1
2
3
=== LIMIT 0 — empty result ===
SELECT id FROM lo ORDER BY id LIMIT 0;
=== LIMIT exceeding row count returns all rows ===
SELECT id FROM lo ORDER BY id LIMIT 100;
id
1
2
3
4
5
=== Bare OFFSET (no LIMIT) ===
SELECT id FROM lo ORDER BY id OFFSET 3;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'OFFSET 3' at line 1
=== FETCH FIRST n ROWS ONLY (SQL-standard) ===
SELECT id FROM lo ORDER BY id FETCH FIRST 2 ROWS ONLY;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'FETCH FIRST 2 ROWS ONLY' at line 1
=== OFFSET m ROWS FETCH NEXT n ROWS ONLY ===
SELECT id FROM lo ORDER BY id OFFSET 2 ROWS FETCH NEXT 2 ROWS ONLY;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'OFFSET 2 ROWS FETCH NEXT 2 ROWS ONLY' at line 1
=== LIMIT in subquery (derived table) ===
SELECT MAX(id) AS mx FROM (SELECT id FROM lo ORDER BY id LIMIT 3) AS sub;
mx
3
=== LIMIT NULL — all rows (NULL = no-limit) ===
SELECT id FROM lo ORDER BY id LIMIT NULL;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'NULL' at line 1
=== LIMIT expression ===
SELECT id FROM lo ORDER BY id LIMIT 1+1;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '+1' at line 1
=== KNOWN GAP: negative LIMIT — errno 1105 ===
SELECT id FROM lo LIMIT -1;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '-1' at line 1
=== Cleanup ===
DROP TABLE lo;
