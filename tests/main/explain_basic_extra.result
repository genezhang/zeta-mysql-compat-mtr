=== Setup ===
DROP TABLE IF EXISTS ep;
CREATE TABLE ep (id INT PRIMARY KEY, name VARCHAR(20), age INT);
INSERT INTO ep VALUES (1, 'a', 10), (2, 'b', 20);
=== EXPLAIN SELECT — simple SeqScan ===
EXPLAIN SELECT * FROM ep;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	ep	NULL	ALL	NULL	NULL	NULL	NULL	2	100.00	NULL
=== EXPLAIN SELECT with WHERE filter ===
EXPLAIN SELECT * FROM ep WHERE id = 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	ep	NULL	const	PRIMARY	PRIMARY	4	const	1	100.00	NULL
=== EXPLAIN UPDATE ===
EXPLAIN UPDATE ep SET age = age + 1 WHERE id = 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	UPDATE	ep	NULL	range	PRIMARY	PRIMARY	4	const	1	100.00	Using where
=== EXPLAIN DELETE ===
EXPLAIN DELETE FROM ep WHERE id = 99;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	DELETE	ep	NULL	range	PRIMARY	PRIMARY	4	const	1	100.00	Using where
=== EXPLAIN with JOIN — HashJoin tree ===
DROP TABLE IF EXISTS j2;
CREATE TABLE j2 (id INT PRIMARY KEY, name VARCHAR(20));
EXPLAIN SELECT * FROM ep JOIN j2 ON ep.id = j2.id;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	j2	NULL	ALL	PRIMARY	NULL	NULL	NULL	1	100.00	NULL
1	SIMPLE	ep	NULL	eq_ref	PRIMARY	PRIMARY	4	test.j2.id	1	100.00	NULL
=== EXPLAIN with ORDER BY + LIMIT — Limit > Sort > SeqScan ===
EXPLAIN SELECT * FROM ep ORDER BY age LIMIT 10;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	ep	NULL	ALL	NULL	NULL	NULL	NULL	2	100.00	Using filesort
=== EXPLAIN FORMAT=JSON — accept, plain output (divergence) ===
EXPLAIN FORMAT=JSON SELECT * FROM ep;
EXPLAIN
