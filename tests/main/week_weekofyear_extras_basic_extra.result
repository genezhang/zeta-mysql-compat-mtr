=== WEEK (mode 0 default) vs WEEKOFYEAR (ISO) ===
SELECT WEEK(DATE '2024-05-19')        = WEEKOFYEAR(DATE '2024-05-19')        AS may_eq;
may_eq
1
SELECT WEEK(DATE '2024-01-01')        = WEEKOFYEAR(DATE '2024-01-01')        AS jan_diverge;
jan_diverge
0
SELECT WEEK(DATE '2024-12-31')        = WEEKOFYEAR(DATE '2024-12-31')        AS dec_diverge;
dec_diverge
0
SELECT WEEK(TIMESTAMP '2024-05-19 14:30:00')
     = WEEKOFYEAR(TIMESTAMP '2024-05-19 14:30:00')                           AS ts_eq;
ts_eq
1
=== WEEK default mode 0 — year boundary edges ===
SELECT WEEK(DATE '2024-01-01')                                AS mon_jan1_2024_w0;
mon_jan1_2024_w0
0
SELECT WEEK(DATE '2023-01-01')                                AS sun_jan1_2023_w1;
sun_jan1_2023_w1
1
SELECT WEEK(DATE '2024-12-30')                                AS mon_dec30_2024_w52;
mon_dec30_2024_w52
52
SELECT WEEK(DATE '2026-01-01')                                AS thu_jan1_2026_w0;
thu_jan1_2026_w0
0
SELECT WEEK(DATE '2021-12-31')                                AS fri_dec31_2021_w52;
fri_dec31_2021_w52
52
=== WEEKOFYEAR — always ISO (mode 3) ===
SELECT WEEKOFYEAR(DATE '2024-01-01')                          AS iso_jan1_2024_w1;
iso_jan1_2024_w1
1
SELECT WEEKOFYEAR(DATE '2023-01-01')                          AS iso_jan1_2023_w52;
iso_jan1_2023_w52
52
SELECT WEEKOFYEAR(DATE '2024-12-30')                          AS iso_dec30_2024_w1;
iso_dec30_2024_w1
1
=== WEEK(d, mode) — 2-arg form supported (zeta #1090) ===
SELECT WEEK(DATE '2024-05-19', 0)                             AS may_mode0;
may_mode0
20
SELECT WEEK(DATE '2024-05-19', 3)                             AS may_mode3;
may_mode3
20
SELECT WEEK(DATE '2024-05-19', 7)                             AS may_mode7;
may_mode7
20
SELECT WEEK(DATE '2024-01-01', 2)                             AS jan_mode2_w53;
jan_mode2_w53
53
=== WEEK — TIMESTAMP arg (time-of-day independent) ===
SELECT WEEK(TIMESTAMP '2024-05-19 00:00:00')                  AS midnight;
midnight
20
SELECT WEEK(TIMESTAMP '2024-05-19 23:59:59')                  AS one_sec_before_midnight;
one_sec_before_midnight
20
SELECT WEEK(TIMESTAMP '2024-05-19 00:00:00')
     = WEEK(TIMESTAMP '2024-05-19 23:59:59')                  AS time_of_day_irrelevant;
time_of_day_irrelevant
1
=== WEEK — String fallback arms ===
SELECT WEEK('2024-05-19')                                     AS str_date_only;
str_date_only
20
SELECT WEEK('2024-05-19 14:30:00')                            AS str_with_time;
str_with_time
20
SELECT WEEK('2024-05-19') = WEEK(DATE '2024-05-19')           AS str_eq_date;
str_eq_date
1
=== WEEKOFYEAR — 2-arg form rejected (1-arg only) ===
SELECT WEEKOFYEAR(DATE '2024-05-19', 0);
ERROR 1105: execution error: WEEKOFYEAR requires 1 argument
=== WEEK / WEEKOFYEAR arity 0 → ERROR 1105 ===
SELECT WEEK();
ERROR 1105: execution error: WEEK requires 1 or 2 arguments
SELECT WEEKOFYEAR();
ERROR 1105: execution error: WEEKOFYEAR requires 1 argument
=== WEEK — mode out of range → ERROR 1105 ===
SELECT WEEK(DATE '2024-05-19', 8);
ERROR 1105: execution error: WEEK: mode 8 out of valid range 0..=7
SELECT WEEK(DATE '2024-05-19', -1);
ERROR 1105: execution error: WEEK: mode -1 out of valid range 0..=7
=== WEEK / WEEKOFYEAR — wrong-type → ERROR 1105 ===
SELECT WEEK(20240519);
ERROR 1105: execution error: WEEK requires a date, timestamp, or parseable string
SELECT WEEK(CAST(1.5 AS DOUBLE PRECISION));
ERROR 1105: execution error: WEEK requires a date, timestamp, or parseable string
SELECT WEEK(TRUE);
ERROR 1105: execution error: WEEK requires a date, timestamp, or parseable string
SELECT WEEKOFYEAR(20240519);
ERROR 1105: execution error: WEEKOFYEAR requires a date, timestamp, or parseable string
=== WEEK — unparseable string → ERROR 1105 ===
SELECT WEEK('not a date');
ERROR 1105: execution error: WEEK: cannot parse "not a date" as a date or timestamp
SELECT WEEKOFYEAR('2024-13-99');
ERROR 1105: execution error: WEEKOFYEAR: cannot parse "2024-13-99" as a date or timestamp
=== WEEK / WEEKOFYEAR — NULL propagation ===
SELECT WEEK(NULL)                                             AS week_null_is_null;
week_null_is_null
NULL
SELECT WEEKOFYEAR(NULL)                                       AS weekofyear_null_is_null;
weekofyear_null_is_null
NULL
SELECT WEEK(CAST(NULL AS DATE))                               AS week_typed_null_is_null;
week_typed_null_is_null
NULL
SELECT WEEKOFYEAR(CAST(NULL AS TIMESTAMP))                    AS weekofyear_typed_null_is_null;
weekofyear_typed_null_is_null
NULL
SELECT WEEK(NULL) IS NULL                                     AS week_null_predicate;
week_null_predicate
1
