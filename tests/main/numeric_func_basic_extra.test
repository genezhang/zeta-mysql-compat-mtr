# Independently authored numeric-extra smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/func_math.test; pins zeta's behavior across the
# numeric/math surface NOT held by numeric_func_basic (which
# covers ABS/SIGN/SQRT/POW/POWER/MOD/CEIL/CEILING/FLOOR/ROUND
# (1-2 arg)/RAND/EXP/LN/LOG (1-arg base-10, 2-arg)/SIN/COS/TAN/
# ASIN/ACOS/ATAN/ATAN2/LOG2/LOG10/DEGREES/RADIANS/PI/TRUNCATE/
# CONV).
#
# Adaptation notes:
#   # zeta-adapt: CRC32(str) — supported (32-bit IEEE CRC).
#   # zeta-adapt: ROUND uses half-away-from-zero (MySQL-aligned):
#     2.5 → 3, -2.5 → -3, 3.5 → 4, -3.5 → -4. NOT banker's
#     rounding (PG default).
#   # zeta-adapt: ROUND with negative decimals — supported.
#     `ROUND(1234.567, -2) → 1200` (rounds to the nearest
#     10^|D| multiple).
#   # zeta-adapt: POW edge cases — POW(0, 0) → 1, POW(2, -1) →
#     0.5. NULL propagation through any arg.
#   # zeta-adapt: BIT_COUNT(n) — FIXED via zeta #1184. 64-bit
#     two's-complement popcount, returns Int32 (0..=64).
#     BIT_COUNT(-1) = 64 (all bits set).
#   # zeta-adapt: COT(x) — FIXED via zeta #1184. Returns
#     1.0 / TAN(x) as Float64. tan(0)=0 → COT(0) emits +Inf via
#     std::f64 (matching MySQL's "out of range value" behavior).
#   # zeta-adapt: KNOWN GAP — integer-division operator `DIV`
#     (MySQL spelling) errors 1064 "No infix parser for token
#     DIV". Portable substitute: FLOOR(a / b) or CAST(a / b AS
#     SIGNED).
#   # zeta-adapt: KNOWN GAP — FORMAT(n, dec, locale) 3-arg form
#     errors 1105 "FORMAT requires 2 arguments". zeta supports
#     the 2-arg US-locale form only; the locale-aware 3-arg form
#     is a separate slice.
#   # zeta-adapt: KNOWN DIVERGENCE — math domain errors raise
#     instead of returning NULL (MySQL semantics). SQRT(-1),
#     LN(0), LN(-1) all error 1105. Portable substitute: guard
#     with CASE/NULLIF in the calling SQL, e.g.
#     `CASE WHEN x > 0 THEN LN(x) ELSE NULL END`.
#   # zeta-adapt: KNOWN DIVERGENCE — ASIN(x) for |x| > 1 returns
#     a float NaN (Rust IEEE-754) instead of NULL (MySQL).
#     Detected via the result-row literal "NaN".
#   # zeta-adapt: 2-arg ATAN(y, x) — FIXED via zeta #1185. ATAN
#     now accepts 1 OR 2 args; the 2-arg form delegates to
#     ATAN2(y, x) with the same NULL-propagation contract.
#   # zeta-adapt: KNOWN GAP — RAND(seed) errors 1105 "RAND takes
#     no arguments". zeta supports only the no-arg form (with
#     no seedability through SQL).

--echo === CRC32 — supported ===

SELECT CRC32('hello') AS c;

--echo === ROUND half-away-from-zero (MySQL-aligned) ===

SELECT ROUND(2.5)   AS r_pos_half;
SELECT ROUND(-2.5)  AS r_neg_half;
SELECT ROUND(3.5)   AS r_pos_half2;
SELECT ROUND(-3.5)  AS r_neg_half2;

--echo === ROUND with negative decimals ===

SELECT ROUND(1234.567, -2) AS r_neg_d;

--echo === POW edge cases + NULL propagation ===

SELECT POW(0, 0)   AS p_zerozero;
SELECT POW(2, -1)  AS p_neg_exp;
SELECT ABS(NULL)   AS a_null;
SELECT POW(NULL, 2) AS p_null_base;
SELECT POW(2, NULL) AS p_null_exp;

--echo === BIT_COUNT — FIXED via zeta #1184 ===

SELECT BIT_COUNT(13) AS bc;
SELECT BIT_COUNT(0)  AS bc_zero;
SELECT BIT_COUNT(-1) AS bc_all_ones;

--echo === COT — FIXED via zeta #1184 ===
--echo # Use a fixed-bit input (1.0 radian) to keep the result
--echo # row-stable across runs. COT(1) ≈ 0.6420926159343306.

SELECT COT(1) AS c;

--echo === KNOWN GAP: integer-division operator `DIV` — errno 1064 ===

--error 1064
SELECT 17 DIV 5;

--echo === KNOWN GAP: FORMAT 3-arg (locale) — errno 1105 ===

--error 1105
SELECT FORMAT(1234567.891, 2, 'de_DE');

--echo === KNOWN DIVERGENCE: math domain errors — errno 1105 (MySQL returns NULL) ===

--error 1105
SELECT SQRT(-1);

--error 1105
SELECT LN(0);

--error 1105
SELECT LN(-1);

--echo === KNOWN DIVERGENCE: ASIN(2) — float NaN (MySQL: NULL) ===

SELECT ASIN(2) AS nan_val;

--echo === 2-arg ATAN — FIXED via zeta #1185 (delegates to ATAN2) ===

SELECT ATAN(1, 1) AS at2;

--echo === KNOWN GAP: RAND(seed) — errno 1105 (only no-arg form) ===

--error 1105
SELECT RAND(42);
