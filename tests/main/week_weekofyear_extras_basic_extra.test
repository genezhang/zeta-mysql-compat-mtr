# Independently authored WEEK / WEEKOFYEAR extras smoke for
# the GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - temporal_arithmetic_basic_extra.test:101: ONE row
#     `WEEK(DATE '2024-05-19')`.
#   - datetime_format_basic.test:80: ONE row `WEEK('2026-05-19')`.
#   - date_time_basic_extra.test:137: ONE row
#     `WEEKOFYEAR('2024-05-19')`.
#   - yearweek_basic_extra.test: covers YEARWEEK with the
#     2-arg mode form and year-boundary edge cases. This slice
#     keeps to bare WEEK/WEEKOFYEAR per-week-number values,
#     the WEEK(d, mode) 2-arg form, and arity.
#   - day_week_last_day_basic_extra.test: covers DAYOFWEEK /
#     DAYOFYEAR / WEEKDAY / LAST_DAY.
#
# Big-picture finding (zeta #1090):
#   WEEK(d) defaults to MySQL mode 0 (Sunday-first); WEEKOFYEAR(d)
#   is always ISO (== WEEK(d, 3), Monday-first 4-day rule). They
#   AGREE mid-year but DIVERGE near year boundaries (e.g.
#   2024-01-01: WEEK=0, WEEKOFYEAR=1). WEEK now accepts the
#   2-arg WEEK(d, mode) form for mode 0..7; WEEKOFYEAR stays
#   1-arg only. Values verified against MySQL 8.0.
#
# Adaptation notes:
#   # zeta-adapt: WEEK(d) = MySQL mode 0; WEEKOFYEAR(d) = ISO
#     (MySQL mode 3). 2-arg WEEK(d, mode) supported 0..=7.
#   # zeta-adapt: WEEKOFYEAR is 1-arg only → 2-arg is 1105.
#   # zeta-adapt: Wrong-type → 1105 'requires a date,
#     timestamp, or parseable string'.
#   # zeta-adapt: Unparseable string → 1105 'cannot parse <s>
#     as a date or timestamp'.

--echo === WEEK (mode 0 default) vs WEEKOFYEAR (ISO) ===

# Agree mid-year, diverge at year boundaries.
SELECT WEEK(DATE '2024-05-19')        = WEEKOFYEAR(DATE '2024-05-19')        AS may_eq;
SELECT WEEK(DATE '2024-01-01')        = WEEKOFYEAR(DATE '2024-01-01')        AS jan_diverge;
SELECT WEEK(DATE '2024-12-31')        = WEEKOFYEAR(DATE '2024-12-31')        AS dec_diverge;
SELECT WEEK(TIMESTAMP '2024-05-19 14:30:00')
     = WEEKOFYEAR(TIMESTAMP '2024-05-19 14:30:00')                           AS ts_eq;

--echo === WEEK default mode 0 — year boundary edges ===

# 2024-01-01 (Monday) before the first Sunday → week 0.
SELECT WEEK(DATE '2024-01-01')                                AS mon_jan1_2024_w0;
# 2023-01-01 is a Sunday → starts week 1.
SELECT WEEK(DATE '2023-01-01')                                AS sun_jan1_2023_w1;
# 2024-12-30 (Monday) → week 52 of 2024 in mode 0.
SELECT WEEK(DATE '2024-12-30')                                AS mon_dec30_2024_w52;
# 2026-01-01 (Thursday) before the first Sunday → week 0.
SELECT WEEK(DATE '2026-01-01')                                AS thu_jan1_2026_w0;
# 2021-12-31 (Friday) — week 52 of 2021.
SELECT WEEK(DATE '2021-12-31')                                AS fri_dec31_2021_w52;

--echo === WEEKOFYEAR — always ISO (mode 3) ===

SELECT WEEKOFYEAR(DATE '2024-01-01')                          AS iso_jan1_2024_w1;
SELECT WEEKOFYEAR(DATE '2023-01-01')                          AS iso_jan1_2023_w52;
SELECT WEEKOFYEAR(DATE '2024-12-30')                          AS iso_dec30_2024_w1;

--echo === WEEK(d, mode) — 2-arg form supported (zeta #1090) ===

SELECT WEEK(DATE '2024-05-19', 0)                             AS may_mode0;
SELECT WEEK(DATE '2024-05-19', 3)                             AS may_mode3;
SELECT WEEK(DATE '2024-05-19', 7)                             AS may_mode7;
# Mode 2 (Sunday-first, rollover) puts 2024-01-01 in week 53.
SELECT WEEK(DATE '2024-01-01', 2)                             AS jan_mode2_w53;

--echo === WEEK — TIMESTAMP arg (time-of-day independent) ===

SELECT WEEK(TIMESTAMP '2024-05-19 00:00:00')                  AS midnight;
SELECT WEEK(TIMESTAMP '2024-05-19 23:59:59')                  AS one_sec_before_midnight;
SELECT WEEK(TIMESTAMP '2024-05-19 00:00:00')
     = WEEK(TIMESTAMP '2024-05-19 23:59:59')                  AS time_of_day_irrelevant;

--echo === WEEK — String fallback arms ===

# parse_date first, then parse_timestamp.
SELECT WEEK('2024-05-19')                                     AS str_date_only;
SELECT WEEK('2024-05-19 14:30:00')                            AS str_with_time;
SELECT WEEK('2024-05-19') = WEEK(DATE '2024-05-19')           AS str_eq_date;

--echo === WEEKOFYEAR — 2-arg form rejected (1-arg only) ===

--error 1105
SELECT WEEKOFYEAR(DATE '2024-05-19', 0);

--echo === WEEK / WEEKOFYEAR arity 0 → ERROR 1105 ===

--error 1105
SELECT WEEK();
--error 1105
SELECT WEEKOFYEAR();

--echo === WEEK — mode out of range → ERROR 1105 ===

--error 1105
SELECT WEEK(DATE '2024-05-19', 8);
--error 1105
SELECT WEEK(DATE '2024-05-19', -1);

--echo === WEEK / WEEKOFYEAR — wrong-type → ERROR 1105 ===

# Int / Float / Bool — no implicit-coerce arm (parseable
# string is the only String→Date escape).
--error 1105
SELECT WEEK(20240519);
--error 1105
SELECT WEEK(CAST(1.5 AS DOUBLE PRECISION));
--error 1105
SELECT WEEK(TRUE);
--error 1105
SELECT WEEKOFYEAR(20240519);

--echo === WEEK — unparseable string → ERROR 1105 ===

--error 1105
SELECT WEEK('not a date');
--error 1105
SELECT WEEKOFYEAR('2024-13-99');

--echo === WEEK / WEEKOFYEAR — NULL propagation ===

SELECT WEEK(NULL)                                             AS week_null_is_null;
SELECT WEEKOFYEAR(NULL)                                       AS weekofyear_null_is_null;
SELECT WEEK(CAST(NULL AS DATE))                               AS week_typed_null_is_null;
SELECT WEEKOFYEAR(CAST(NULL AS TIMESTAMP))                    AS weekofyear_typed_null_is_null;
SELECT WEEK(NULL) IS NULL                                     AS week_null_predicate;
