=== Setup ===
DROP TABLE IF EXISTS wf;
CREATE TABLE wf (id INT PRIMARY KEY, region VARCHAR(10), n INT);
INSERT INTO wf VALUES
  (1, 'east', 10), (2, 'east', 20), (3, 'east', 30),
  (4, 'west', 40), (5, 'west', 50);
=== LAG with offset + default ===
SELECT id, LAG(n, 2, -1) OVER (ORDER BY id) AS lag2 FROM wf ORDER BY id;
id	lag2
1	-1
2	-1
3	10
4	20
5	30
=== LEAD with offset + default ===
SELECT id, LEAD(n, 2, -1) OVER (ORDER BY id) AS lead2 FROM wf ORDER BY id;
id	lead2
1	30
2	40
3	50
4	-1
5	-1
=== LAST_VALUE with UNBOUNDED frame ===
SELECT id,
       LAST_VALUE(n) OVER (
         PARTITION BY region ORDER BY id
         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
       ) AS lv
  FROM wf
  ORDER BY id;
id	lv
1	30
2	30
3	30
4	50
5	50
=== NTH_VALUE — 2nd row per partition ===
SELECT id,
       NTH_VALUE(n, 2) OVER (
         PARTITION BY region ORDER BY id
         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
       ) AS nv
  FROM wf
  ORDER BY id;
id	nv
1	20
2	20
3	20
4	50
5	50
=== PERCENT_RANK + CUME_DIST ===
SELECT id,
       PERCENT_RANK() OVER (ORDER BY n) AS pr,
       CUME_DIST()    OVER (ORDER BY n) AS cd
  FROM wf
  ORDER BY id;
id	pr	cd
1	0	0.2
2	0.25	0.4
3	0.5	0.6
4	0.75	0.8
5	1	1
=== NTILE(3) — three buckets ===
SELECT id, NTILE(3) OVER (ORDER BY id) AS t FROM wf ORDER BY id;
id	t
1	1
2	1
3	2
4	2
5	3
=== ROWS BETWEEN N PRECEDING AND N FOLLOWING ===
# Centered sliding window: SUM of {prev, current, next}.
SELECT id,
       SUM(n) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS sw
  FROM wf
  ORDER BY id;
id	sw
1	30
2	60
3	90
4	120
5	90
=== KNOWN GAP: EXCLUDE clause — errno 1064 ===
SELECT id,
       SUM(n) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                    EXCLUDE CURRENT ROW) AS sw
  FROM wf
  ORDER BY id;
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: EXCLUDE at Line: 3, Column: 21
=== Cleanup ===
DROP TABLE wf;
