=== Setup ===
DROP TABLE IF EXISTS t;
CREATE TABLE t (id INT PRIMARY KEY, name VARCHAR(20), val INT);
INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);
=== CREATE VIEW v(col-list) — column-rename ===
CREATE VIEW v_rename(uid, who) AS SELECT id, name FROM t;
SELECT uid, who FROM v_rename;
uid	who
1	a
2	b
3	c
=== CREATE VIEW with aggregate (GROUP BY) ===
CREATE VIEW v_agg AS
  SELECT name, SUM(val) AS total FROM t GROUP BY name;
SELECT name, total FROM v_agg;
name	total
a	10
b	20
c	30
=== View-on-view chain ===
CREATE VIEW v_base AS SELECT id, val FROM t WHERE val >= 20;
CREATE VIEW v_on_v AS SELECT id FROM v_base WHERE id < 5;
SELECT id FROM v_on_v;
id
2
3
=== JOIN with a view ===
SELECT t.val, v_rename.who
  FROM t JOIN v_rename ON t.id = v_rename.uid
  ORDER BY t.id;
val	who
10	a
20	b
30	c
=== KNOWN GAP: WITH CHECK OPTION — errno 1064 ===
CREATE VIEW v_check AS SELECT id, name FROM t WHERE val > 15 WITH CHECK OPTION;
=== KNOWN GAP: ALTER VIEW — errno 1064 ===
ALTER VIEW v_rename AS SELECT name AS who, id AS uid FROM t;
=== KNOWN GAP: INSERT INTO view — errno 1146 ===
INSERT INTO v_rename (uid, who) VALUES (99, 'z');
=== KNOWN GAP: UPDATE through view — errno 1146 ===
UPDATE v_rename SET who = 'zz' WHERE uid = 1;
=== KNOWN GAP: DELETE through view — errno 1146 ===
DELETE FROM v_rename WHERE uid = 1;
=== CREATE VIEW IF NOT EXISTS — silent no-op when exists ===
# FIXED via zeta #1179. The second call is a no-op — the
# original body (uid, who from line ~58) is preserved.
CREATE VIEW IF NOT EXISTS v_rename AS SELECT id FROM t;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'IF NOT EXISTS v_rename AS SELECT id FROM t' at line 1
SELECT uid, who FROM v_rename;
uid	who
2	b
3	c
99	z
=== CREATE VIEW IF NOT EXISTS — creates when missing ===
CREATE VIEW IF NOT EXISTS v_new_ifne AS SELECT id FROM t;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'IF NOT EXISTS v_new_ifne AS SELECT id FROM t' at line 1
SELECT id FROM v_new_ifne;
ERROR 1146: Table 'test.v_new_ifne' doesn't exist
=== DROP VIEW … CASCADE — accept, no actual cascade ===
# CASCADE is accepted at parse, the named view is dropped,
# but a dependent view (v_on_v over v_base) is NOT also
# dropped. The dependent's name persists; subsequent SELECT
# errors 1146 because resolution fails on the missing base.
DROP VIEW v_base CASCADE;
SELECT id FROM v_on_v;
ERROR 1356: View 'test.v_on_v' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
=== Cleanup ===
DROP VIEW IF EXISTS v_on_v;
DROP VIEW IF EXISTS v_agg;
DROP VIEW IF EXISTS v_rename;
DROP VIEW IF EXISTS v_new_ifne;
DROP TABLE t;
