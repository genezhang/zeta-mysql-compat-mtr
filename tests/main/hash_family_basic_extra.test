# Independently authored MD5 / SHA1 / SHA2 smoke for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/. All three are implemented in zeta but had no
# compat-mtr coverage yet — this slice locks in the hash family.
#
# Big-picture finding:
#   MD5(s)             — 16-byte digest → 32 lowercase hex chars
#   SHA(s) / SHA1(s)   — 20-byte digest → 40 lowercase hex chars
#   SHA2(s, bits)      — bits ∈ {224, 256, 384, 512}; 0 == 256
#                        (MySQL convention). 28/32/48/64-byte
#                        digest → 56/64/96/128 lowercase hex chars.
#                        Invalid bits → NULL (NOT an error,
#                        matches MySQL).
#
# Adaptation notes:
#   # zeta-adapt: All three return lowercase hex; MySQL also
#     returns lowercase, so no case-folding needed.
#   # zeta-adapt: Empty input is a well-defined input — yields
#     the engine's known empty-string digest (e.g. MD5('') =
#     d41d8cd98f00b204e9800998ecf8427e). Tested here.
#   # zeta-adapt: NULL → NULL on all three (matches MySQL).
#   # zeta-adapt: Arity errors → 1105 (MySQL: 1582). The error
#     codes differ; the behavior (reject) matches.

--echo === MD5: known vectors ===

# RFC 1321 §A.5 test vectors (lowercase hex; the engine emits
# lowercase, MySQL too).
SELECT MD5('')             AS md5_empty;
SELECT MD5('a')            AS md5_a;
SELECT MD5('abc')           AS md5_abc;
SELECT MD5('The quick brown fox jumps over the lazy dog') AS md5_pangram;

--echo === MD5: output shape (32 lowercase hex chars) ===

SELECT LENGTH(MD5('zeta'))               = 32 AS md5_len;
SELECT MD5('zeta') = LOWER(MD5('zeta'))       AS md5_lowercase;

--echo === Binary input via UNHEX (exercises Value::Bytes arm) ===

# Non-UTF-8 bytes — the impl's `Value::Bytes => b` branch must
# hash the raw bytes, not error or stringify.
SELECT MD5(UNHEX('DEADBEEF'))           AS md5_unhex;
SELECT SHA1(UNHEX('DEADBEEF'))          AS sha1_unhex;
SELECT SHA2(UNHEX('DEADBEEF'), 256)     AS sha256_unhex;

--echo === Multi-byte UTF-8 input ===

# Hash operates on UTF-8 bytes. 'café' is 5 bytes (c,a,f,0xC3,0xA9);
# the digest should differ from 'cafe' (4 ASCII bytes).
SELECT MD5('café') <> MD5('cafe')       AS md5_utf8_distinct;
SELECT SHA1('café') <> SHA1('cafe')     AS sha1_utf8_distinct;
SELECT SHA2('café', 256) <> SHA2('cafe', 256) AS sha256_utf8_distinct;

--echo === SHA1 / SHA: known vector + alias parity ===

# FIPS 180-1 §A.1 test vector.
SELECT SHA1('abc')         AS sha1_abc;
SELECT SHA('abc')          AS sha_abc_alias;
SELECT SHA1('abc') = SHA('abc') AS sha_is_sha1_alias;
SELECT SHA1('')            AS sha1_empty;
SELECT LENGTH(SHA1('zeta')) = 40 AS sha1_len;

--echo === SHA2: bit-width matrix + lengths ===

# All four valid bit widths. The known vector here is the
# empty-string digest for each width — these are the engine
# "fingerprint" values; if any change, something is wrong.
SELECT SHA2('', 224) AS sha224_empty;
SELECT SHA2('', 256) AS sha256_empty;
SELECT SHA2('', 384) AS sha384_empty;
SELECT SHA2('', 512) AS sha512_empty;
SELECT LENGTH(SHA2('zeta', 224)) = 56  AS sha224_len;
SELECT LENGTH(SHA2('zeta', 256)) = 64  AS sha256_len;
SELECT LENGTH(SHA2('zeta', 384)) = 96  AS sha384_len;
SELECT LENGTH(SHA2('zeta', 512)) = 128 AS sha512_len;

--echo === SHA2: 0 means 256 (MySQL convention) ===

SELECT SHA2('zeta', 0) = SHA2('zeta', 256) AS zero_is_256;

--echo === SHA2: invalid bit-width → NULL (not error) ===

SELECT SHA2('zeta', 100) IS NULL AS bad_bits;
SELECT SHA2('zeta', -1)  IS NULL AS neg_bits;
SELECT SHA2('zeta', 257) IS NULL AS off_by_one;

--echo === NULL passthrough on all three ===

SELECT MD5(NULL)     IS NULL AS md5_null;
SELECT SHA1(NULL)    IS NULL AS sha1_null;
SELECT SHA(NULL)     IS NULL AS sha_null;
SELECT SHA2(NULL, 256) IS NULL AS sha2_null_str;
SELECT SHA2('zeta', NULL) IS NULL AS sha2_null_bits;
# Both NULL — pins short-circuit ordering (str-arg NULL check
# fires first per the impl; result is NULL either way but the
# code path matters for future divergence).
SELECT SHA2(NULL, NULL) IS NULL AS sha2_null_both;

--echo === SHA2: non-integer bits coerces to NULL (not error) ===

# Impl's match arm: Int32/Int64 → use; Null → return NULL;
# `_` → return NULL. Pinning float here so a future tightening
# (e.g. erroring on float bits) breaks visibly.
SELECT SHA2('zeta', 256.0) IS NULL AS sha2_float_bits_null;
SELECT SHA2('zeta', 'abc') IS NULL AS sha2_string_bits_null;

--echo === Determinism: same input → same output ===

SELECT MD5('repeat') = MD5('repeat')       AS md5_det;
SELECT SHA1('repeat') = SHA1('repeat')     AS sha1_det;
SELECT SHA2('repeat', 256) = SHA2('repeat', 256) AS sha2_det;

--echo === Distinct inputs → distinct outputs ===

SELECT MD5('a') <> MD5('b')               AS md5_distinct;
SELECT SHA1('a') <> SHA1('b')             AS sha1_distinct;
SELECT SHA2('a', 256) <> SHA2('b', 256)   AS sha2_distinct;
# Different bit widths must produce different outputs even for
# the same input (lengths differ → trivially distinct, but the
# common-prefix is also not equal).
SELECT SHA2('zeta', 256) <> SHA2('zeta', 512) AS sha2_widths_distinct;

--echo === Arity errors ===

--error 1105
SELECT MD5();
--error 1105
SELECT MD5('a', 'b');
--error 1105
SELECT SHA1();
--error 1105
SELECT SHA1('a', 'b');
--error 1105
SELECT SHA2();
--error 1105
SELECT SHA2('a');
--error 1105
SELECT SHA2('a', 256, 'extra');
