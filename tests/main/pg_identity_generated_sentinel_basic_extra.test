# Independently authored PG GENERATED ALWAYS / BY DEFAULT
# AS IDENTITY sentinel slice for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - SERIAL / BIGSERIAL auto-increment: SUPPORTED,
#     pinned at auto_increment_basic.
#   - DEFAULT NEXTVAL(seq): SUPPORTED, pinned at the
#     sequence_basic_extra family.
#   - GENERATED ALWAYS AS IDENTITY (no PK) — auto-gen
#     leaves id NULL: pinned at generated_column_basic_
#     extra (KNOWN BUG, row stored with NULL id).
#   - GENERATED BY DEFAULT AS IDENTITY (no PK) — same:
#     pinned at generated_column_basic_extra.
#   - ALTER TABLE ADD COLUMN ... GENERATED ALWAYS AS
#     IDENTITY: pinned at alter_table_basic_extra
#     (KNOWN BUG, leaves column NULL).
#   - GENERATED ALWAYS AS IDENTITY *PRIMARY KEY*: ZERO
#     prior coverage. The PK form is distinct from the
#     existing no-PK pins because PRIMARY KEY makes the
#     id column implicitly NOT NULL, so auto-gen-leaves-
#     NULL is upgraded from "row stored with NULL" to
#     "INSERT errors with NOT NULL violation" — the
#     table is UNUSABLE without explicit id writes,
#     not just degraded.
#   - GENERATED ALWAYS AS IDENTITY *enforcement of
#     ALWAYS keyword on explicit INSERT*: ZERO prior
#     coverage. Real PG rejects `INSERT (id, ...) ...`
#     when column is ALWAYS; zeta silently accepts.
#     This is a SEMANTIC degradation distinct from the
#     storage-side auto-gen drop.
#   - OVERRIDING SYSTEM / USER VALUE clause: ZERO
#     prior coverage.
#   - IDENTITY sequence-options sub-grammar inside
#     the IDENTITY paren group (START WITH n
#     INCREMENT BY n, OWNED BY tbl.col, etc.): ZERO
#     prior coverage. Partial support — a SINGLE
#     option keyword parses, but a second option in
#     the same paren group rejects, and OWNED BY
#     rejects always.
#
# Pre-existing rejection / behavior shape patterns:
#   - SILENT-DROP family (storage-side): IDENTITY
#     auto-gen wiring is parser-accepted but no
#     sequence is created. Joins MATCH FULL→SIMPLE,
#     CYCLE→bound-error, NULLS NOT DISTINCT, etc.
#   - SILENT-DEGRADATION family (semantics-side):
#     ALWAYS-keyword enforcement is dropped, so the
#     identity column behaves as if BY DEFAULT (or
#     plain). Apps relying on "ALWAYS protects the
#     id from manual writes" silently lose that
#     guarantee.
#   - "Expected: SELECT, VALUES, or a subquery in
#     the query body, found: OVERRIDING at col 26"
#     — NEW fingerprint. sqlparser's INSERT grammar
#     does not accept the OVERRIDING SYSTEM/USER
#     VALUE clause between the column list and
#     VALUES.
#   - "Expected: ), found: <KEYWORD>" inside the
#     IDENTITY paren group — NEW fingerprint.
#     sqlparser parses ONE option keyword then
#     expects `)`. Combining options (e.g. `START
#     100 INCREMENT 10` or `CACHE 10 START 5`)
#     errors on the second option. OWNED BY rejects
#     always.
#
# This slice pins:
#
#   BUG 1 — SILENT-DROP (storage-side, auto-gen
#   wiring missing) — PK form is the unusable form:
#     - CREATE TABLE t (id INT GENERATED ALWAYS AS
#       IDENTITY PRIMARY KEY, v TEXT) — accepts.
#     - INSERT INTO t (v) VALUES ('a') — should
#       auto-gen id=1 in PG; zeta errors with NOT
#       NULL violation because the IDENTITY column
#       is treated as a plain INT NOT NULL with no
#       sequence and no DEFAULT. The IDENTITY
#       clause is fully ignored at storage time.
#     - Same for GENERATED BY DEFAULT AS IDENTITY.
#     - Distinct from the existing no-PK pin
#       (generated_column_basic_extra) which shows
#       the row IS stored with id=NULL. With PK
#       (implicit NOT NULL), the row CANNOT be
#       stored at all — the table is unusable
#       without explicit id writes.
#     - Also distinct from existing pin: even when
#       a single sequence-option (e.g. `(START 50)`)
#       parses successfully, the IDENTITY column
#       STILL is not wired — the START value is
#       silently dropped along with the rest of
#       the IDENTITY semantics.
#
#   BUG 2 — SILENT-DEGRADATION (semantics-side,
#   ALWAYS enforcement dropped):
#     - CREATE TABLE t (id INT GENERATED ALWAYS AS
#       IDENTITY PRIMARY KEY, v TEXT) — accepts.
#     - INSERT INTO t (id, v) VALUES (99, 'forbidden')
#       — real PG ERRORS: "cannot insert a non-DEFAULT
#       value into column \"id\"" because the ALWAYS
#       keyword forbids manual writes (only OVERRIDING
#       SYSTEM VALUE bypasses).
#     - zeta: SUCCESS, row IS stored, SELECT confirms.
#     - zeta treats ALWAYS as if BY DEFAULT (or as if
#       the IDENTITY clause is absent entirely).
#     - Effect: PG-aware apps that use ALWAYS as a
#       schema-level write-protection on the id
#       column silently lose that protection.
#
#   DOUBLE FAULT framing: BUG 1 makes the table
#   unusable (no inserts succeed without explicit id);
#   BUG 2 means the WORKAROUND (explicit id INSERT)
#   bypasses the ALWAYS enforcement that the schema
#   author intended. Together: the only path that
#   works is the path that violates the schema's
#   stated intent.
#
#   PARSE-REJECT 1 — OVERRIDING SYSTEM/USER VALUE:
#     - INSERT INTO t (id, v) OVERRIDING SYSTEM
#       VALUE VALUES (1, 'x') — sqlparser cannot
#       handle the OVERRIDING clause; rejects
#       between column list and VALUES.
#     - Same for OVERRIDING USER VALUE.
#     - Effect: even if BUG 2 were fixed, apps
#       could not use the PG-standard mechanism
#       (OVERRIDING SYSTEM VALUE) to legitimately
#       bypass ALWAYS for restore/import scenarios.
#
#   PARSE-REJECT 2 — IDENTITY sequence options
#   (combined forms and OWNED BY):
#     - CREATE TABLE t (id INT GENERATED ALWAYS AS
#       IDENTITY (START 100 INCREMENT 10) PRIMARY
#       KEY) — sqlparser rejects at the INCREMENT
#       keyword (the second option).
#     - Same for `START WITH 100 INCREMENT BY 10`.
#     - Same for `CACHE 10 START 5` (rejects at
#       START as second option).
#     - OWNED BY tbl.col rejects always (sqlparser
#       does not accept OWNED inside IDENTITY).
#     - Effect: apps cannot customise the sequence
#       parameters (start, step, min, max, cache,
#       cycle) in any combined form inline with
#       the IDENTITY clause. Even if BUG 1 were
#       fixed, only single-option forms would
#       parse (and even those silently drop the
#       IDENTITY semantics).
#
#   SUPPORT PIN — single-option IDENTITY paren
#   parses (BUT IDENTITY semantics still dropped):
#     - CREATE ... IDENTITY (START 50) ... parses.
#     - INSERT still errors with NOT NULL (BUG 1
#       intact even when sub-grammar accepts the
#       single option).
#     - This is a SECOND silent-drop: the START
#       value itself is silently discarded.
#
# Big-picture finding:
#
#   zeta's IDENTITY implementation is BOTH a silent-
#   drop AND a silent-degradation. The auto-gen
#   wiring is missing (storage) AND the ALWAYS
#   keyword's semantic enforcement is missing
#   (parser/planner). This compound failure is
#   uniquely bad for PG porting: schemas with
#   `GENERATED ALWAYS AS IDENTITY PRIMARY KEY`
#   (the dominant PG idiom since PG 10) fail
#   closed on INSERT (BUG 1), and the only
#   workaround (write id explicitly) silently
#   bypasses the schema-level write-protection
#   the ALWAYS keyword was meant to provide
#   (BUG 2).
#
#   Apps porting PG identity-keyed schemas should:
#     - Replace GENERATED ALWAYS AS IDENTITY with
#       SERIAL or DEFAULT NEXTVAL(seq) (both
#       supported in zeta).
#     - Treat all id writes as application-side
#       enforced; do not rely on ALWAYS keyword
#       for write-protection.
#     - Avoid combined sequence-options inline with
#       IDENTITY; use CREATE SEQUENCE + DEFAULT
#       NEXTVAL pattern. Single-option IDENTITY
#       paren parses but is also silently dropped.
#     - Avoid OVERRIDING SYSTEM/USER VALUE in
#       INSERT.
#
# Wire divergence check: probed both wires (pgwire
# port 13501 and mysqlwire port 3307) — IDENTICAL
# behavior. IDENTITY storage wiring lives in the
# executor (wire-shared); parse-rejects live in
# sqlparser (wire-shared). No wire-side divergence
# expected here.
#
# Adaptation notes:
#   # zeta-adapt: KNOWN BUG (silent-drop) — GENERATED
#     ALWAYS/BY DEFAULT AS IDENTITY parse-accepts but
#     no sequence is wired. With PRIMARY KEY, INSERT
#     errors with NOT NULL violation; without PK, row
#     stored with id=NULL (see generated_column_basic_
#     extra). Use SERIAL / BIGSERIAL or DEFAULT
#     NEXTVAL(seq) instead.
#   # zeta-adapt: KNOWN BUG (silent-degradation) —
#     ALWAYS keyword is not enforced. Explicit
#     `INSERT (id, ...)` succeeds where real PG would
#     error. Apps must enforce id-write protection
#     application-side; do not rely on ALWAYS.
#   # zeta-adapt: KNOWN GAP — OVERRIDING SYSTEM/USER
#     VALUE clause parse-rejected. No PG-standard
#     ALWAYS-bypass available even if the keyword
#     were enforced.
#   # zeta-adapt: KNOWN GAP — multi-option IDENTITY
#     sequence options (e.g. `START 100 INCREMENT 10`)
#     parse-rejected on the second option. OWNED BY
#     rejects always. Single-option forms parse but
#     the option is silently dropped (BUG 1 intact).

--echo === BUG 1 (SILENT-DROP) — GENERATED ALWAYS AS IDENTITY PRIMARY KEY: CREATE accepts ===

DROP TABLE IF EXISTS t_id_always;
CREATE TABLE t_id_always (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v TEXT);

--echo === BUG 1 — auto-gen broken: INSERT without id errors NOT NULL (PG would auto-gen id=1) ===

--error 1105
INSERT INTO t_id_always (v) VALUES ('a');

--echo === BUG 2 (SILENT-DEGRADATION) — explicit INSERT of id SUCCEEDS (PG would error: ALWAYS forbids) ===

INSERT INTO t_id_always (id, v) VALUES (99, 'forbidden');

--echo === Cross-check: BUG 2 stored the row PG would reject ===

SELECT id, v FROM t_id_always;

DROP TABLE t_id_always;

--echo === BUG 1 again — GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY: CREATE accepts ===

DROP TABLE IF EXISTS t_id_default;
CREATE TABLE t_id_default (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, v TEXT);

--echo === BUG 1 — auto-gen broken: INSERT without id errors NOT NULL (PG would auto-gen id=1) ===

--error 1105
INSERT INTO t_id_default (v) VALUES ('b');

--echo === BY DEFAULT — explicit INSERT of id SUCCEEDS (PG also allows; no degradation here) ===

INSERT INTO t_id_default (id, v) VALUES (77, 'manual');
SELECT id, v FROM t_id_default;

DROP TABLE t_id_default;

--echo === PARSE-REJECT 1 — OVERRIDING SYSTEM / USER VALUE (PG-standard ALWAYS bypass) ===

DROP TABLE IF EXISTS t_ov;
CREATE TABLE t_ov (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v TEXT);

--error 1064
INSERT INTO t_ov (id, v) OVERRIDING SYSTEM VALUE VALUES (1, 'x');

--error 1064
INSERT INTO t_ov (id, v) OVERRIDING USER VALUE VALUES (2, 'y');

DROP TABLE t_ov;

--echo === PARSE-REJECT 2 — IDENTITY multi-option sub-grammar (combined forms) ===

--error 1064
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (START 100 INCREMENT 10) PRIMARY KEY, v TEXT);

--error 1064
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (START WITH 100 INCREMENT BY 10) PRIMARY KEY, v TEXT);

--error 1064
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (CACHE 10 START 5) PRIMARY KEY, v TEXT);

--echo === PARSE-REJECT 2 (cont.) — OWNED BY inside IDENTITY paren group ===

--error 1064
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (OWNED BY x.y) PRIMARY KEY, v TEXT);

--echo === SUPPORT PIN — single-option IDENTITY paren parses, but BUG 1 still drops the option ===

DROP TABLE IF EXISTS t_single;
CREATE TABLE t_single (id INT GENERATED ALWAYS AS IDENTITY (START 50) PRIMARY KEY, v TEXT);

--echo # PG would auto-gen id=50 here; zeta still errors NOT NULL — START is silently dropped too:
--error 1105
INSERT INTO t_single (v) VALUES ('s');

DROP TABLE t_single;
