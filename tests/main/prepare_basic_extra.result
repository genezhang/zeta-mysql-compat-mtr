PREPARE p1 AS SELECT 1 + 1;
ERROR 1105: plan error: statement is handled before planning
=== KNOWN GAP: PG-style EXECUTE — errno 1105 ===
EXECUTE p1;
ERROR 1105: plan error: statement is handled before planning
=== KNOWN GAP: PG-style PREPARE with parameter — errno 1105 ===
PREPARE p3(INT) AS SELECT $1 + 10;
ERROR 1105: plan error: statement is handled before planning
=== KNOWN GAP: PG-style EXECUTE with arg list — errno 1105 ===
EXECUTE p3(5);
ERROR 1105: plan error: statement is handled before planning
=== KNOWN GAP: MySQL PREPARE FROM string — errno 1064 ===
PREPARE p2 FROM 'SELECT 2 + 2';
ERROR 1064: SQL parse error: sql parser error: Expected: AS, found: FROM at Line: 1, Column: 12
=== KNOWN GAP: MySQL PREPARE FROM @var — errno 1064 ===
PREPARE p4 FROM @s;
ERROR 1064: SQL parse error: sql parser error: Expected: AS, found: FROM at Line: 1, Column: 12
