# Independently authored window-function edge-case smoke
# test for the GPL MTR-format runner. NOT copied or adapted
# from MySQL's mysql-test/t/window_*.test or PG regress;
# complements window_func_basic / window_func_basic_extra
# (which cover the base shapes for LAG/LEAD/FIRST_VALUE/
# LAST_VALUE/NTILE/PERCENT_RANK/CUME_DIST) by pinning the
# EDGE behavior NOT covered there: offset > partition,
# offset = 0, FILTER clause, NTH_VALUE, ROW_NUMBER without
# ORDER BY, nested-window, window-in-WHERE.
#
# Big-picture finding: zeta handles LAG/LEAD overflow
# correctly (returns NULL or the default value), NTH_VALUE
# with the explicit ROWS frame works, ROW_NUMBER tolerates
# OVER () without ORDER BY. Two remaining issues: (a)
# NTILE(0) and NTILE(-1) silently return per-row bucket
# numbers instead of erroring (MySQL: error for n <= 0).
# (b) LAG with a negative offset returns NULL instead of
# acting like LEAD (PG/MySQL semantics: `LAG(n, -k)` ≡
# `LEAD(n, k)`). Nested window functions don't error but
# evaluate to NULL; window functions in WHERE error 1105
# (correct).
#
# FILTER clause on aggregate window functions now errors
# explicitly (fixed in zeta PR #1215). Previously silently
# IGNORED — gave wrong answers without an error signal.
# Full semantic support (PG/Spark behavior) is a follow-up.
#
# Adaptation notes:
#   # zeta-adapt: LAG/LEAD offset > partition size returns
#     NULL (or the supplied default for the 3-arg form).
#   # zeta-adapt: LAG(n, 0) — returns the current row's
#     value (matches PG/MySQL: zero-offset is identity).
#   # zeta-adapt: NTILE(N) with N > row count distributes
#     one row per bucket (no bucket has more than 1 row).
#   # zeta-adapt: PERCENT_RANK / CUME_DIST per-partition —
#     single-row partition: PR = 0, CD = 1; two-row: PR
#     for the first = 0, for second = 1.
#   # zeta-adapt: NTH_VALUE with explicit
#     `ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED
#     FOLLOWING` frame returns the Nth row's value across
#     the whole partition.
#   # zeta-adapt: ROW_NUMBER() OVER () (no ORDER BY) —
#     supported; numbers rows in scan order.
#   # zeta-adapt: ROW_NUMBER() OVER (PARTITION BY x) (no
#     ORDER BY) — numbers per partition in scan order.
#   # zeta-adapt: Window function in WHERE clause — errors
#     1105 "unsupported expression: WindowFunction"
#     (correct: SQL spec forbids).
#   # zeta-adapt: FILTER (WHERE ...) clause on aggregate
#     window functions errors 1064 \"FILTER clause on
#     window aggregate \`<NAME>\` not yet supported\".
#     Fixed in zeta PR #1215 — previously silently IGNORED
#     (returned the unfiltered value). Full PG/Spark
#     semantics (filter the per-row contribution to the
#     running aggregate) is a follow-up; for now, rewrite
#     as a subquery with a CASE expression:
#     `SUM(CASE WHEN n > 15 THEN n END) OVER (...)`.
#   # zeta-adapt: KNOWN DIVERGENCE — NTILE(0) returns 1
#     for every row instead of erroring; NTILE(-1) returns
#     1..N as if N were positive. MySQL doc says NTILE(n)
#     requires n > 0; zeta silently accepts.
#   # zeta-adapt: KNOWN DIVERGENCE — LAG(n, -k) returns
#     NULL where PG/MySQL semantics are `LAG(n, -k)` ≡
#     `LEAD(n, k)` (negative offset flips direction).
#   # zeta-adapt: KNOWN DIVERGENCE — nested window
#     functions like `SUM(ROW_NUMBER() OVER ()) OVER ()`
#     return NULL instead of erroring 'window function
#     not allowed inside aggregate' (PG behavior).

--echo === Setup ===

DROP TABLE IF EXISTS wf;
CREATE TABLE wf (id INT PRIMARY KEY, n INT);
INSERT INTO wf VALUES (1, 10), (2, 20), (3, 30);

--echo === LAG/LEAD offset > partition size — NULL or default ===

SELECT id, LAG(n, 5) OVER (ORDER BY id) AS lag5 FROM wf ORDER BY id;
SELECT id, LAG(n, 5, -1) OVER (ORDER BY id) AS lag5_def FROM wf ORDER BY id;
SELECT id, LEAD(n, 5, -1) OVER (ORDER BY id) AS lead5_def FROM wf ORDER BY id;

--echo === LAG offset = 0 — identity ===

SELECT id, LAG(n, 0) OVER (ORDER BY id) AS lag0 FROM wf ORDER BY id;

--echo === NTILE(N) with N > row count — 1 row per bucket ===

SELECT id, NTILE(10) OVER (ORDER BY id) AS nt10 FROM wf ORDER BY id;

--echo === NTH_VALUE with explicit ROWS frame ===

SELECT id, NTH_VALUE(n, 2) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS nth2 FROM wf ORDER BY id;

--echo === ROW_NUMBER without ORDER BY — scan order ===

SELECT id, ROW_NUMBER() OVER () AS rn FROM wf ORDER BY id;

--echo === ROW_NUMBER with PARTITION BY but no ORDER BY ===

SELECT id, ROW_NUMBER() OVER (PARTITION BY id % 2) AS rn FROM wf ORDER BY id;

--echo === FILTER clause on aggregate window — errors 1064 (was silent-ignore) ===
--echo # Fixed in zeta PR #1215. Previously returned the unfiltered
--echo # cumulative sum without any error signal. Full PG/Spark
--echo # semantics is a follow-up. Workaround: rewrite as
--echo # `SUM(CASE WHEN n > 15 THEN n END) OVER (...)`.

--error 1064
SELECT id, n, SUM(n) FILTER (WHERE n > 15) OVER (ORDER BY id) AS s_filt FROM wf ORDER BY id;

--echo === FILTER workaround using CASE ===

SELECT id, n, SUM(CASE WHEN n > 15 THEN n END) OVER (ORDER BY id) AS s_filt_case FROM wf ORDER BY id;

--echo === KNOWN DIVERGENCE: NTILE(0) returns 1 per row (MySQL would error) ===

SELECT id, NTILE(0) OVER (ORDER BY id) AS n0 FROM wf ORDER BY id;

--echo === KNOWN DIVERGENCE: LAG(n, -1) returns NULL (PG/MySQL: ≡ LEAD(n, 1)) ===

SELECT id, LAG(n, -1) OVER (ORDER BY id) AS lag_neg FROM wf ORDER BY id;

--echo === KNOWN DIVERGENCE: nested window functions evaluate to NULL (PG: error) ===

SELECT id, SUM(ROW_NUMBER() OVER ()) OVER () AS nested FROM wf ORDER BY id;

--echo === Window function in WHERE — correctly errors 1105 ===

--error 1105
SELECT id FROM wf WHERE ROW_NUMBER() OVER () = 1;

DROP TABLE wf;
