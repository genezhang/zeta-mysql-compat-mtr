ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS d_plus_neg' at line 1
SELECT DATE '2024-05-19' - INTERVAL '-3 days' AS d_minus_neg;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS d_minus_neg' at line 1
=== INTERVAL comparison ===
SELECT INTERVAL '1 hour' = INTERVAL '60 minutes' AS hr_eq;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS hr_eq' at line 1
SELECT INTERVAL '1 day' = INTERVAL '24 hours' AS day_eq;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS day_eq' at line 1
SELECT INTERVAL '-1 day' < INTERVAL '0 days' AS neg_lt;
