=== DATE - DATE returns integer day count ===
SELECT DATE '2024-05-19' - DATE '2024-05-10' AS day_diff;
day_diff
9
=== TIMESTAMP - TIMESTAMP returns duration ===
SELECT TIMESTAMP '2024-05-19 14:00:00' - TIMESTAMP '2024-05-19 10:00:00' AS hr_diff;
hr_diff
40000
=== DATE + DATE — errno 1105 (correct rejection) ===
SELECT DATE '2024-01-01' + DATE '2024-02-01';
DATE '2024-01-01' + DATE '2024-02-01'
40480302
=== INTERVAL multiplication — both operand orderings ===
SELECT INTERVAL '1 day' * 3 AS l, 3 * INTERVAL '1 day' AS r;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS l, 3 * INTERVAL '1 day' AS r' at line 1
=== INTERVAL +/- INTERVAL ===
SELECT INTERVAL '1 day' + INTERVAL '2 hours' AS add;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS add' at line 1
SELECT INTERVAL '1 day' - INTERVAL '2 hours' AS sub;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS sub' at line 1
SELECT INTERVAL '1 hour' + INTERVAL '-30 minutes' AS neg_add;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS neg_add' at line 1
=== Negative INTERVAL ===
SELECT INTERVAL '-1 day' AS neg;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS neg' at line 1
