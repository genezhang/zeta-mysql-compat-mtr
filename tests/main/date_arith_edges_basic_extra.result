=== KNOWN BUG: INTERVAL '1 day' / 2 returns 1 day (should be 12 hours) ===
# Day-tier division loses fractional precision; hour-tier works.
SELECT INTERVAL '1 day' / 2 AS bug_day_div, INTERVAL '4 hours' / 2 AS ok_hour_div;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS bug_day_div, INTERVAL '4 hours' / 2 AS ok_hour_div' at line 1
=== KNOWN DIVERGENCE: date range allows year > 9999 and year < 1 ===
# MySQL errors 1292 'incorrect datetime value' outside
# 0001-01-01..9999-12-31; zeta accepts year 0 and 10000+.
SELECT DATE '9999-12-31' + INTERVAL '1 day' AS over;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS over' at line 1
SELECT DATE '0001-01-01' - INTERVAL '1 day' AS under;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'AS under' at line 1
