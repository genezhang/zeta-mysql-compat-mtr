=== Setup ===
DROP TABLE IF EXISTS emp;
CREATE TABLE emp (id INT PRIMARY KEY, name VARCHAR(20), mgr INT, dept VARCHAR(20));
INSERT INTO emp VALUES
 (1, 'alice', NULL, 'eng'),
 (2, 'bob',   1,    'eng'),
 (3, 'carol', 1,    'sales'),
 (4, 'dave',  2,    'eng'),
 (5, 'eve',   3,    'sales');
=== Simple WITH ===
WITH x AS (SELECT 1 AS v) SELECT * FROM x;
v
1
=== WITH with column-alias list ===
WITH x(a, b) AS (SELECT 1, 'hello') SELECT a, b FROM x;
a	b
1	hello
=== Multiple CTEs in one WITH ===
WITH a AS (SELECT 1 AS v), b AS (SELECT 2 AS v)
SELECT a.v + b.v AS sm FROM a, b;
sm
3
=== Second CTE references first ===
WITH a AS (SELECT 5 AS v), b AS (SELECT v + 1 AS v FROM a)
SELECT * FROM b;
v
6
=== CTE referenced multiple times ===
WITH eng AS (SELECT * FROM emp WHERE dept='eng')
SELECT COUNT(*) AS c FROM eng
UNION ALL
SELECT COUNT(*) AS c FROM eng;
c
3
3
=== WITH RECURSIVE — numeric counter ===
WITH RECURSIVE n(v) AS (
  SELECT 1
  UNION ALL
  SELECT v + 1 FROM n WHERE v < 5
)
SELECT * FROM n ORDER BY v;
v
1
2
3
4
5
=== WITH RECURSIVE — hierarchy traversal ===
WITH RECURSIVE org AS (
  SELECT id, name, mgr, 0 AS depth FROM emp WHERE mgr IS NULL
  UNION ALL
  SELECT e.id, e.name, e.mgr, org.depth + 1
  FROM emp e JOIN org ON e.mgr = org.id
)
SELECT id, name, depth FROM org ORDER BY id;
id	name	depth
1	alice	0
2	bob	1
3	carol	1
4	dave	2
5	eve	2
=== CTE inside scalar subquery in SELECT-list ===
SELECT (WITH x AS (SELECT 1 AS v) SELECT v FROM x) AS r;
r
1
=== PARTIAL FIX: WITH+INSERT now works; WITH+UPDATE/DELETE still 1064 ===
# MySQL 8.0+ accepts `WITH … INSERT/UPDATE/DELETE`. zeta now
# supports the INSERT form (was 1064). UPDATE and DELETE still
# reject with a more helpful error pointing to the rewrite.
DROP TABLE IF EXISTS dest;
CREATE TABLE dest (v INT);
WITH x AS (SELECT 42 AS v) INSERT INTO dest SELECT * FROM x;
SELECT v FROM dest ORDER BY v;
v
42
INSERT INTO dest VALUES (5);
WITH y AS (SELECT 99 AS v) UPDATE dest SET v = (SELECT v FROM y);
ERROR 1064: SQL parse error: WITH … UPDATE/DELETE is not supported yet — move the CTE into a subquery, or split into a separate statement
WITH y AS (SELECT 5 AS v) DELETE FROM dest WHERE v = (SELECT v FROM y);
ERROR 1064: SQL parse error: WITH … UPDATE/DELETE is not supported yet — move the CTE into a subquery, or split into a separate statement
=== Cleanup ===
DROP TABLE emp;
DROP TABLE dest;
