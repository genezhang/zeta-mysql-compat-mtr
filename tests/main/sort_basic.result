=== Setup ===
DROP TABLE IF EXISTS sd;
CREATE TABLE sd (id INT PRIMARY KEY, name VARCHAR(10), v INT);
INSERT INTO sd VALUES (1, 'b', 20), (2, 'a', 30), (3, 'c', NULL), (4, 'a', 10);
=== ORDER BY single column ASC / DESC ===
SELECT id FROM sd ORDER BY id ASC;
id
1
2
3
4
SELECT id FROM sd ORDER BY id DESC;
id
4
3
2
1
=== ORDER BY multiple columns ===
SELECT id, name FROM sd ORDER BY name, id;
id	name
2	a
4	a
1	b
3	c
SELECT id, name FROM sd ORDER BY name DESC, id;
id	name
3	c
1	b
2	a
4	a
=== ORDER BY with NULL — DIVERGENCE: PG-style placement ===
# zeta: NULL is HIGHEST (LAST in ASC, FIRST in DESC).
# MySQL: NULL is LOWEST (FIRST in ASC, LAST in DESC).
SELECT id, v FROM sd ORDER BY v;
id	v
3	NULL
4	10
1	20
2	30
SELECT id, v FROM sd ORDER BY v DESC;
id	v
2	30
1	20
4	10
3	NULL
=== DIVERGENCE: NULLS FIRST / NULLS LAST clauses silently ignored ===
# zeta accepts the syntax but doesn't honor it — NULL falls
# to the ASC/DESC default. MySQL rejects the syntax at parse
# with 1064. Both forms below produce the SAME output as a
# plain ASC sort.
SELECT id, v FROM sd ORDER BY v NULLS FIRST;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'NULLS FIRST' at line 1
SELECT id, v FROM sd ORDER BY v NULLS LAST;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'NULLS LAST' at line 1
=== ORDER BY column position ===
SELECT id, v FROM sd ORDER BY 2;
id	v
3	NULL
4	10
1	20
2	30
SELECT id, name FROM sd ORDER BY 2, 1;
id	name
2	a
4	a
1	b
3	c
=== ORDER BY alias ===
SELECT id, v AS val FROM sd ORDER BY val DESC;
id	val
2	30
1	20
4	10
3	NULL
=== ORDER BY expression ===
SELECT id FROM sd ORDER BY UPPER(name), id;
id
2
4
1
3
=== LIMIT / OFFSET ===
SELECT id FROM sd ORDER BY id LIMIT 2;
id
1
2
SELECT id FROM sd ORDER BY id LIMIT 2 OFFSET 1;
id
2
3
=== Cleanup ===
DROP TABLE sd;
