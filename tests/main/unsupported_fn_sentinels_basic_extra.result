ERROR 1105: execution error: unknown function: CONVERT_TZ
SELECT MICROSECOND(TIMESTAMP '2024-01-01 12:34:56.789012');
ERROR 1105: execution error: unknown function: MICROSECOND
SELECT GET_FORMAT('DATE', 'USA');
ERROR 1105: execution error: unknown function: GET_FORMAT
