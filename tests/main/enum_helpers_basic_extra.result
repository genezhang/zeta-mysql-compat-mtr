=== Setup: create an enum type with 3 labels in declaration order ===
CREATE TYPE mood_ehb AS ENUM ('sad', 'ok', 'happy');
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TYPE mood_ehb AS ENUM ('sad', 'ok', 'happy')' at line 1
=== ENUM_FIRST returns first label ===
SELECT ENUM_FIRST(NULL::mood_ehb)                             AS first_label;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::mood_ehb)                             AS first_label' at line 1
=== ENUM_LAST returns last label ===
SELECT ENUM_LAST(NULL::mood_ehb)                              AS last_label;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::mood_ehb)                              AS last_label' at line 1
=== ENUM_RANGE returns Array of all labels (declaration order) ===
SELECT ENUM_RANGE(NULL::mood_ehb)                             AS all_labels;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::mood_ehb)                             AS all_labels' at line 1
=== Equality of ENUM_FIRST/LAST results against label strings ===
SELECT CAST(ENUM_FIRST(NULL::mood_ehb) AS TEXT) = 'sad'       AS first_eq_sad;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::mood_ehb) AS TEXT) = 'sad'       AS first_eq_sad' at line 1
SELECT CAST(ENUM_LAST(NULL::mood_ehb)  AS TEXT) = 'happy'     AS last_eq_happy;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::mood_ehb)  AS TEXT) = 'happy'     AS last_eq_happy' at line 1
