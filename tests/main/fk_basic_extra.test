# Independently authored foreign-key smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/innodb_fk_basic.test or innodb_constraints.test;
# pins zeta's FK behavior across the referential-action shapes
# ORMs and migration tools emit at CREATE TABLE time.
#
# Adaptation notes:
#   # zeta-adapt: ON DELETE CASCADE — supported. Parent delete
#     removes matching child rows.
#   # zeta-adapt: ON DELETE SET NULL — supported. Parent delete
#     nulls the FK column in matching child rows (column must
#     allow NULL).
#   # zeta-adapt: ON DELETE RESTRICT (default) — supported.
#     Parent delete with referenced child rows errors. Same
#     behavior as ON DELETE NO ACTION.
#   # zeta-adapt: ON DELETE NO ACTION — accepted, identical
#     to RESTRICT (no deferral; PG distinguishes only when
#     INITIALLY DEFERRED, which zeta accepts but ignores).
#   # zeta-adapt: Self-referencing FK (parent_id REFERENCES
#     self(id)) — supported.
#   # zeta-adapt: Composite FK (multi-column REFERENCES) —
#     supported.
#   # zeta-adapt: Named CONSTRAINT — the constraint name is
#     preserved verbatim in violation messages (no `public.`
#     prefix when user-named; auto-generated names get the
#     `public.<table>_<col>_fkey` form).
#   # zeta-adapt: NULL in FK column — allowed when the column
#     is NULL-able; no parent lookup required for NULL values.
#   # zeta-adapt: KNOWN DIVERGENCE — ON UPDATE CASCADE errors
#     1105 "UPDATE of primary key column 'id' is not
#     supported" because zeta doesn't allow updating PK
#     columns of a row in-place. Portable substitute: DELETE
#     + re-INSERT under the new PK, or set surrogate column.
#   # zeta-adapt: KNOWN DIVERGENCE — FK violation errno is
#     1105 (generic). MySQL would use 1452 "ER_NO_REFERENCED_
#     ROW_2" on insert and 1451 "ER_ROW_IS_REFERENCED_2" on
#     delete. Portable substitute: parse the error message,
#     don't depend on the errno.
#   # zeta-adapt: KNOWN DIVERGENCE — DEFERRABLE / INITIALLY
#     DEFERRED clauses are accepted at parse but the FK is
#     evaluated EAGERLY (no actual deferral until COMMIT).
#     Portable substitute: structure the writes so the
#     invariant holds at each statement boundary.

--echo === Setup parent + child ===

DROP TABLE IF EXISTS fkc; DROP TABLE IF EXISTS fkp;
CREATE TABLE fkp (id INT PRIMARY KEY);
INSERT INTO fkp VALUES (1), (2);

--echo === ON DELETE CASCADE — parent delete removes children ===

CREATE TABLE fkc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fkp(id) ON DELETE CASCADE);
INSERT INTO fkc VALUES (10, 1), (20, 1), (30, 2);
DELETE FROM fkp WHERE id = 1;
SELECT id, pid FROM fkc ORDER BY id;

--echo === ON DELETE SET NULL ===

DROP TABLE IF EXISTS fksc; DROP TABLE IF EXISTS fksp;
CREATE TABLE fksp (id INT PRIMARY KEY);
CREATE TABLE fksc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fksp(id) ON DELETE SET NULL);
INSERT INTO fksp VALUES (1);
INSERT INTO fksc VALUES (10, 1);
DELETE FROM fksp WHERE id = 1;
SELECT id, pid FROM fksc;

--echo === ON DELETE RESTRICT — errors when children exist ===

DROP TABLE IF EXISTS fkrc; DROP TABLE IF EXISTS fkrp;
CREATE TABLE fkrp (id INT PRIMARY KEY);
CREATE TABLE fkrc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fkrp(id) ON DELETE RESTRICT);
INSERT INTO fkrp VALUES (1);
INSERT INTO fkrc VALUES (10, 1);
--error 1105
DELETE FROM fkrp WHERE id = 1;

--echo === Self-referencing FK ===

DROP TABLE IF EXISTS fself;
CREATE TABLE fself (id INT PRIMARY KEY, parent_id INT,
  FOREIGN KEY (parent_id) REFERENCES fself(id));
INSERT INTO fself VALUES (1, NULL), (2, 1), (3, 2);
SELECT id, parent_id FROM fself ORDER BY id;

--echo === Composite FK (multi-column REFERENCES) ===

DROP TABLE IF EXISTS fkmc; DROP TABLE IF EXISTS fkmp;
CREATE TABLE fkmp (a INT, b INT, PRIMARY KEY (a, b));
CREATE TABLE fkmc (id INT PRIMARY KEY, a INT, b INT,
  FOREIGN KEY (a, b) REFERENCES fkmp(a, b));
INSERT INTO fkmp VALUES (1, 10), (2, 20);
INSERT INTO fkmc VALUES (100, 1, 10), (200, 2, 20);
SELECT id, a, b FROM fkmc ORDER BY id;

--echo === FK violation on missing parent — errno 1105 ===

--error 1105
INSERT INTO fkmc VALUES (300, 9, 99);

--echo === NULL in FK column — allowed (no parent required) ===

DROP TABLE IF EXISTS fknull_c; DROP TABLE IF EXISTS fknull_p;
CREATE TABLE fknull_p (id INT PRIMARY KEY);
CREATE TABLE fknull_c (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fknull_p(id));
INSERT INTO fknull_c VALUES (1, NULL);
SELECT id, pid FROM fknull_c;

--echo === DEFERRABLE INITIALLY DEFERRED — accepted (no actual deferral) ===

DROP TABLE IF EXISTS fkdc; DROP TABLE IF EXISTS fkdp;
CREATE TABLE fkdp (id INT PRIMARY KEY);
CREATE TABLE fkdc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fkdp(id) DEFERRABLE INITIALLY DEFERRED);

--echo === KNOWN DIVERGENCE: ON UPDATE CASCADE — errno 1105 ===
--echo # zeta doesn't allow updating PK columns of an existing
--echo # row in-place, so ON UPDATE CASCADE can never fire.

DROP TABLE IF EXISTS fkuc; DROP TABLE IF EXISTS fkup;
CREATE TABLE fkup (id INT PRIMARY KEY);
CREATE TABLE fkuc (id INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES fkup(id) ON UPDATE CASCADE);
INSERT INTO fkup VALUES (1);
INSERT INTO fkuc VALUES (10, 1);
--error 1105
UPDATE fkup SET id = 100 WHERE id = 1;

--echo === Cleanup ===

DROP TABLE fkuc; DROP TABLE fkup;
DROP TABLE fkdc; DROP TABLE fkdp;
DROP TABLE fknull_c; DROP TABLE fknull_p;
DROP TABLE fkmc; DROP TABLE fkmp;
DROP TABLE fself;
DROP TABLE fkrc; DROP TABLE fkrp;
DROP TABLE fksc; DROP TABLE fksp;
DROP TABLE fkc; DROP TABLE fkp;
