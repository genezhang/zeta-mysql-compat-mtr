# Independently authored UPDATE-extra smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/update.test or update_join.test; pins zeta's
# UPDATE surface NOT held by update_basic (single-row +
# WHERE IN + col=col+N + multi-col + LIMIT-gap + JOIN).
#
# Adaptation notes:
#   # zeta-adapt: UPDATE WHERE id IN (subquery) — supported.
#   # zeta-adapt: UPDATE WHERE EXISTS (correlated subquery) —
#     supported.
#   # zeta-adapt: UPDATE ... FROM <table> (PG cross-table
#     update) — supported.
#   # zeta-adapt: UPDATE ... RETURNING (PG) — supported.
#     Returns the post-update row.
#   # zeta-adapt: UPDATE SET col = CASE WHEN ... — supported.
#   # zeta-adapt: UPDATE SET col = NULL — supported (when the
#     column is NULL-able).
#   # zeta-adapt: UPDATE with no WHERE — affects every row in
#     the table (no surprise; matches SQL standard).
#   # zeta-adapt: KNOWN GAP — UPDATE ... ORDER BY ... LIMIT N
#     (MySQL row-count cap) errors 1064 "Expected: end of
#     statement, found: ORDER". Portable substitute: rewrite
#     as WHERE clause that picks the same rows.
#   # zeta-adapt: KNOWN GAP — UPDATE SET col = (correlated
#     subquery) errors 1105 "unsupported expression:
#     ScalarSubquery". Portable substitute: use UPDATE ... FROM
#     (PG cross-table form) or a derived-table JOIN.

--echo === Setup ===

DROP TABLE IF EXISTS up;
CREATE TABLE up (id INT PRIMARY KEY, n INT);
INSERT INTO up VALUES (1, 10), (2, 20), (3, 30);

--echo === UPDATE WHERE id IN (subquery) ===

UPDATE up SET n = 0 WHERE id IN (SELECT id FROM up WHERE n < 25);
SELECT id, n FROM up ORDER BY id;

--echo === UPDATE WHERE EXISTS (correlated subquery) ===

DROP TABLE IF EXISTS up2; CREATE TABLE up2 (id INT PRIMARY KEY, n INT);
INSERT INTO up2 VALUES (1, 100), (2, 200);
DROP TABLE IF EXISTS upx; CREATE TABLE upx (rid INT);
INSERT INTO upx VALUES (1);
UPDATE up2 SET n = -1 WHERE EXISTS (SELECT 1 FROM upx WHERE rid = up2.id);
SELECT id, n FROM up2 ORDER BY id;

--echo === UPDATE ... FROM <other> (PG cross-table) ===

DROP TABLE IF EXISTS upf; CREATE TABLE upf (id INT PRIMARY KEY, n INT);
DROP TABLE IF EXISTS upo; CREATE TABLE upo (id INT PRIMARY KEY, val INT);
INSERT INTO upf VALUES (1, 0), (2, 0);
INSERT INTO upo VALUES (1, 100), (2, 200);
UPDATE upf SET n = upo.val FROM upo WHERE upf.id = upo.id;
SELECT id, n FROM upf ORDER BY id;

--echo === UPDATE ... RETURNING (PG) — accepted, no wire-side rows ===
--echo # DIVERGENCE: zeta accepts RETURNING at parse and the
--echo # underlying UPDATE applies, but the MySQL wire path
--echo # does NOT propagate the RETURNING rows back to the
--echo # client (the row set is silently dropped). Through
--echo # the PG wire / psql, RETURNING works as expected.
--echo # Verified by the next SELECT showing the n=101/201
--echo # post-update state.

UPDATE upf SET n = n + 1 RETURNING id, n;
SELECT id, n FROM upf ORDER BY id;

--echo === UPDATE SET col = CASE WHEN ... ===

UPDATE upf SET n = CASE WHEN id = 1 THEN 999 ELSE n END;
SELECT id, n FROM upf ORDER BY id;

--echo === UPDATE SET col = NULL ===

UPDATE upf SET n = NULL WHERE id = 2;
SELECT id, n FROM upf ORDER BY id;

--echo === UPDATE with no WHERE — every row ===

UPDATE upf SET n = 42;
SELECT id, n FROM upf ORDER BY id;

--echo === KNOWN GAP: UPDATE ... ORDER BY ... LIMIT N — errno 1064 ===

--error 1064
UPDATE upf SET n = 0 WHERE id > 0 ORDER BY id DESC LIMIT 1;

--echo === KNOWN GAP: UPDATE SET col = (correlated subquery) — errno 1105 ===

--error 1105
UPDATE upf SET n = (SELECT MAX(val) FROM upo WHERE upo.id = upf.id);

--echo === Cleanup ===

DROP TABLE up;
DROP TABLE up2;
DROP TABLE upx;
DROP TABLE upf;
DROP TABLE upo;
