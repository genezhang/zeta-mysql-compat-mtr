=== Setup ===
DROP TABLE IF EXISTS vt;
CREATE TABLE vt (id INT PRIMARY KEY, n INT);
INSERT INTO vt VALUES (1, 10), (2, 20);
=== VACUUM (no args) — silent no-op ===
VACUUM;
=== VACUUM <table> — silent no-op ===
VACUUM vt;
=== VACUUM ANALYZE (no table) — silent no-op ===
VACUUM ANALYZE;
=== VACUUM FULL <table> — silent no-op ===
VACUUM FULL vt;
=== ANALYZE (no table) — silent no-op ===
ANALYZE;
=== ANALYZE <table> ===
ANALYZE vt;
=== ANALYZE TABLE <table> (MySQL spelling) ===
ANALYZE TABLE vt;
=== KNOWN GAP: VACUUM ANALYZE <table> combined — errno 1064 ===
# Substitute: VACUUM <t>; ANALYZE <t>;
VACUUM ANALYZE vt;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: vt at Line: 1, Column: 16
=== KNOWN GAP: VACUUM (option, …) <table> (parens form) — errno 1064 ===
VACUUM (VERBOSE) vt;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: ( at Line: 1, Column: 8
