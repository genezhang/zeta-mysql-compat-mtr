=== BUG — DESCENDING CYCLE silent-drop + MINVALUE breach ===
DROP SEQUENCE IF EXISTS s_dc;
CREATE SEQUENCE s_dc INCREMENT -1 START 3 MINVALUE 1 MAXVALUE 3 CYCLE;
=== First 3 NEXTVAL: 3, 2, 1 (within [1, 3]) ===
SELECT NEXTVAL('s_dc');
NEXTVAL
3
SELECT NEXTVAL('s_dc');
NEXTVAL
2
SELECT NEXTVAL('s_dc');
NEXTVAL
1
=== 4th NEXTVAL: PG would wrap to MAXVALUE (3); zeta returns 0 (BELOW MINVALUE 1) ===
SELECT NEXTVAL('s_dc');
NEXTVAL
0
DROP SEQUENCE s_dc;
=== COMPREHENSIVE GAP — ALTER SEQUENCE family (all 12+ forms parse-reject) ===
