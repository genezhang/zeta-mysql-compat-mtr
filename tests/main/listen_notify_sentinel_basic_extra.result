=== LISTEN — accepts channel name, no rows returned ===
LISTEN cache_invalidate;
LISTEN job_queue;
LISTEN "with spaces";
=== UNLISTEN — accepts channel name ===
UNLISTEN cache_invalidate;
UNLISTEN job_queue;
=== UNLISTEN * — wildcard "all channels" ===
UNLISTEN *;
=== NOTIFY — accepts channel name, no rows ===
NOTIFY cache_invalidate;
=== NOTIFY with payload string ===
NOTIFY cache_invalidate, 'cache_key_42';
NOTIFY cache_invalidate, 'payload with spaces';
NOTIFY cache_invalidate, '';
=== Sequence: LISTEN then NOTIFY then UNLISTEN — all silent ===
LISTEN test_seq;
NOTIFY test_seq, 'hello';
UNLISTEN test_seq;
=== Subsequent SELECT confirms no rows were generated ===
SELECT 1 AS sanity;
sanity
1
