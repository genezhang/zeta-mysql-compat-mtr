=== Setup ===
DROP TABLE IF EXISTS d1;
CREATE TABLE d1 (id INT PRIMARY KEY, name VARCHAR(20), grade INT);
INSERT INTO d1 (id, name, grade) VALUES
  (1, 'alice', 90),
  (2, 'bob', 80),
  (3, 'carol', 70),
  (4, 'dave', 60),
  (5, 'erin', 50);
=== DELETE with WHERE — single row ===
DELETE FROM d1 WHERE id = 2;
SELECT id, name, grade FROM d1;
id	name	grade
1	alice	90
3	carol	70
4	dave	60
5	erin	50
=== DELETE with WHERE IN — multi-row ===
DELETE FROM d1 WHERE id IN (3, 4);
SELECT id, name, grade FROM d1;
id	name	grade
1	alice	90
5	erin	50
=== Setup helper table for subquery / JOIN DELETE ===
DROP TABLE IF EXISTS d_filter;
CREATE TABLE d_filter (fid INT PRIMARY KEY);
INSERT INTO d_filter (fid) VALUES (1);
=== DELETE WHERE col IN (SELECT ...) (zeta #1125 FIXED) ===
# MySQL semantics: the inner SELECT returns {1}; rows with
# matching id are deleted, leaving id=5 in d1.
DELETE FROM d1 WHERE id IN (SELECT fid FROM d_filter);
SELECT id, name, grade FROM d1;
id	name	grade
5	erin	50
=== DELETE t1 FROM t1 JOIN t2 ... (MySQL multi-table form) ===
# Repopulate d_filter with the surviving id so the JOIN-form
# DELETE has something to match against; subquery DELETE above
# already drained the (id=1) entry.
INSERT INTO d_filter (fid) VALUES (5);
DELETE d1 FROM d1 JOIN d_filter ON d1.id = d_filter.fid;
SELECT id, name, grade FROM d1;
=== DELETE ... LIMIT — rejected (zeta #1124 FIXED) ===
# MySQL caps DELETE to N rows. zeta does not honor LIMIT;
# the parser rejects with errno 1064 instead of silently
# deleting every matching row.
DELETE FROM d1 WHERE id > 0 LIMIT 1;
ERROR 1064: SQL parse error: DELETE ... LIMIT is not supported (would silently delete all matching rows; remove the LIMIT clause)
=== DELETE ... ORDER BY — rejected (zeta #1124 FIXED) ===
# MySQL uses ORDER BY with LIMIT to pick which rows survive.
# zeta does not honor ORDER BY in DELETE; rejected at the
# parser with errno 1064 (ordering would be silently dropped).
DELETE FROM d1 ORDER BY id DESC;
ERROR 1064: SQL parse error: DELETE ... ORDER BY is not supported (the ordering is dropped without LIMIT; remove the ORDER BY clause)
=== DELETE all rows (no WHERE) ===
DELETE FROM d1;
SELECT COUNT(*) AS remaining FROM d1;
remaining
0
=== Cleanup ===
DROP TABLE d1;
DROP TABLE d_filter;
