=== Setup ===
DROP TABLE IF EXISTS d1;
CREATE TABLE d1 (id INT PRIMARY KEY, name VARCHAR(20), grade INT);
INSERT INTO d1 (id, name, grade) VALUES
  (1, 'alice', 90),
  (2, 'bob', 80),
  (3, 'carol', 70),
  (4, 'dave', 60),
  (5, 'erin', 50);
=== DELETE with WHERE — single row ===
DELETE FROM d1 WHERE id = 2;
SELECT id, name, grade FROM d1;
id	name	grade
1	alice	90
3	carol	70
4	dave	60
5	erin	50
=== DELETE with WHERE IN — multi-row ===
DELETE FROM d1 WHERE id IN (3, 4);
SELECT id, name, grade FROM d1;
id	name	grade
1	alice	90
5	erin	50
=== Setup helper table for JOIN-DELETE ===
# Documented divergence (NOT actively probed): MySQL accepts
# `DELETE FROM d1 WHERE id IN (SELECT fid FROM d_filter)`,
# zeta's executor does not support InSubquery for DELETE and
# errors with 1105. The exact message wraps a Rust Debug dump
# of the AST, which is unstable — pinning it here would break
# on harmless AST changes. The equivalent JOIN-form DELETE
# below works in both engines and is what's pinned instead.
DROP TABLE IF EXISTS d_filter;
CREATE TABLE d_filter (fid INT PRIMARY KEY);
INSERT INTO d_filter (fid) VALUES (1);
=== DELETE t1 FROM t1 JOIN t2 ... (MySQL multi-table form) ===
DELETE d1 FROM d1 JOIN d_filter ON d1.id = d_filter.fid;
SELECT id, name, grade FROM d1;
id	name	grade
5	erin	50
=== DELETE all rows (no WHERE) ===
DELETE FROM d1;
SELECT COUNT(*) AS remaining FROM d1;
remaining
0
=== Cleanup ===
DROP TABLE d1;
DROP TABLE d_filter;
