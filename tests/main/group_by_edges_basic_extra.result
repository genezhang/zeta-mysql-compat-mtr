=== Setup ===
DROP TABLE IF EXISTS gb;
CREATE TABLE gb (id INT PRIMARY KEY, name VARCHAR(20), region VARCHAR(10), amt INT);
INSERT INTO gb VALUES
  (1, 'Alice', 'east', 100),
  (2, 'BOB', 'east', 200),
  (3, 'carol', 'west', 150),
  (4, 'Dan', 'west', 300),
  (5, NULL, NULL, 50);
=== GROUP BY expression / function ===
SELECT LOWER(name) AS lname, COUNT(*) AS c FROM gb GROUP BY LOWER(name) ORDER BY lname;
lname	c
alice	1
bob	1
carol	1
dan	1
NULL	1
SELECT id % 2 AS parity, COUNT(*) AS c FROM gb GROUP BY id % 2 ORDER BY parity;
parity	c
0	2
1	3
=== GROUP BY SELECT alias (MySQL/PG extension) ===
SELECT LOWER(name) AS lname, COUNT(*) AS c FROM gb GROUP BY lname ORDER BY lname;
lname	c
alice	1
bob	1
carol	1
dan	1
NULL	1
=== GROUP BY positional with multiple cols ===
SELECT region, name, COUNT(*) AS c FROM gb GROUP BY 1, 2 ORDER BY 1, 2;
region	name	c
east	Alice	1
east	BOB	1
west	Dan	1
west	carol	1
NULL	NULL	1
=== ROLLUP — adds grand-total NULL row ===
SELECT region, SUM(amt) AS s FROM gb GROUP BY ROLLUP(region) ORDER BY region;
region	s
east	300
west	450
NULL	50
NULL	800
=== CUBE — same as ROLLUP for single col ===
SELECT region, SUM(amt) AS s FROM gb GROUP BY CUBE(region) ORDER BY region;
region	s
east	300
west	450
NULL	50
NULL	800
=== GROUPING SETS — multi-set ===
SELECT region, name, SUM(amt) AS s FROM gb GROUP BY GROUPING SETS ((region), (name)) ORDER BY region, name;
region	name	s
east	NULL	300
west	NULL	450
NULL	Alice	100
NULL	BOB	200
NULL	Dan	300
NULL	carol	150
NULL	NULL	50
NULL	NULL	50
=== GROUPING() function — distinguishes real vs grand-total NULL ===
SELECT region, SUM(amt) AS s, GROUPING(region) AS g FROM gb GROUP BY ROLLUP(region) ORDER BY region;
region	s	g
east	300	0
west	450	0
NULL	50	0
NULL	800	1
=== GROUP BY NULL — all NULLs collapse to one group ===
SELECT region, COUNT(*) AS c FROM gb GROUP BY region ORDER BY region;
region	c
east	2
west	2
NULL	1
=== HAVING with raw aggregate predicate ===
SELECT COUNT(*) AS c FROM gb HAVING c > 0;
c
5
SELECT COUNT(*) AS c FROM gb HAVING c > 1000;
=== HAVING with implicit single-group aggregate (no aggregates in SELECT) ===
# SQL standard / PG / MySQL: at most ONE row. zeta correctly
# recognizes the implicit-aggregate single-group form.
SELECT 1 AS v FROM gb HAVING COUNT(*) > 0;
v
1
=== KNOWN GAP: GROUP BY col WITH ROLLUP (MySQL suffix) — errno 1064 ===
SELECT region, SUM(amt) FROM gb GROUP BY region WITH ROLLUP;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: WITH at Line: 1, Column: 49
=== KNOWN GAP: GROUP BY ALL (Spark / SQL Server) — errno 1064 ===
SELECT region, COUNT(*) FROM gb GROUP BY ALL;
ERROR 1064: SQL parse error: GROUP BY ALL not supported
DROP TABLE gb;
