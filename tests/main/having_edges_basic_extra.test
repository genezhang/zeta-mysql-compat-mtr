# Independently authored HAVING edge smoke test for the
# GPL MTR-format runner. NOT copied or adapted from
# MySQL's mysql-test/t/having.test or PG regress;
# complements group_by_edges_basic_extra by pinning the
# HAVING-specific edge behavior: alias references,
# multi-predicate combinations, aggregate vs scalar
# predicates, subquery-driven HAVING, NULL filters, and
# the no-GROUP-BY HAVING gap.
#
# Big-picture finding: HAVING works correctly with
# aggregates against a GROUP BY clause across all the
# usual predicate shapes — comparison, IN, BETWEEN,
# IS NULL, AND / OR / NOT, alias references (PG/MySQL
# extension), CASE, subquery, multi-aggregate
# comparison. WHERE-before-aggregate and HAVING-after-
# aggregate semantics are correct.
#
# Notable: HAVING <aggregate> in a no-GROUP-BY query
# (whole-table) works via prepared statements / driver
# protocols but returns NULL via the mysql CLI text
# protocol. Pinning the prepared behavior since drivers
# are the dominant path; the CLI divergence is a
# separate gap to investigate.
#
# Adaptation notes:
#   # zeta-adapt: HAVING <aggregate> <op> <const> — works
#     with GROUP BY.
#   # zeta-adapt: HAVING references column alias from
#     SELECT (`s` for `SUM(v) AS s`) — works (PG/MySQL
#     extension; not strict SQL).
#   # zeta-adapt: HAVING multi-predicate AND / OR / NOT —
#     works, including mixed scalar (grp = 1) + aggregate
#     (SUM(v) > N) predicates.
#   # zeta-adapt: HAVING with subquery (uncorrelated) —
#     `HAVING SUM(v) > (SELECT AVG(v) FROM h)` works.
#   # zeta-adapt: HAVING comparing two aggregates —
#     `HAVING MAX(v) > MIN(v) * 1.5` works.
#   # zeta-adapt: HAVING IN / BETWEEN / IS NULL /
#     IS NOT NULL — all supported.
#   # zeta-adapt: HAVING with arithmetic on aggregate
#     (`SUM(v) + 10 > 50`) — works.
#   # zeta-adapt: HAVING column NOT in GROUP BY and NOT
#     aggregated — errors 1054 \"column not found\" at
#     resolution (correct: PG would error too, with a
#     more specific message).
#   # zeta-adapt: WHERE vs HAVING — WHERE filters before
#     aggregation, HAVING after. Both work as expected
#     when combined.
#   # zeta-adapt: HAVING <aggregate> with no GROUP BY —
#     works via prepared statements (mysql_async etc.).
#     Note: the mysql text-protocol CLI returns NULL for
#     the same query, suggesting a divergence between
#     zeta's prepared and text execution paths for this
#     shape. Pinning the driver-visible behavior; the CLI
#     gap is a separate workstream.

--echo === Setup ===

DROP TABLE IF EXISTS h;
CREATE TABLE h (id INT, grp INT, v INT);
INSERT INTO h VALUES (1,1,10), (2,1,20), (3,2,30), (4,2,40), (5,3,5), (6,3,NULL);

--echo === HAVING with aggregate vs constant ===

SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING SUM(v) > 30 ORDER BY grp;
SELECT grp, COUNT(*) AS c FROM h GROUP BY grp HAVING COUNT(*) >= 2 ORDER BY grp;

--echo === HAVING references SELECT alias (PG/MySQL extension) ===

SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING s > 30 ORDER BY grp;

--echo === HAVING multi-predicate AND / OR / NOT ===

SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING SUM(v) > 10 AND SUM(v) < 100 ORDER BY grp;
SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING SUM(v) < 20 OR SUM(v) > 50 ORDER BY grp;
SELECT grp, COUNT(*) AS c FROM h GROUP BY grp HAVING NOT (COUNT(*) = 2) ORDER BY grp;

--echo === HAVING with subquery (uncorrelated) ===

SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING SUM(v) > (SELECT AVG(v) FROM h) ORDER BY grp;

--echo === HAVING comparing two aggregates ===

SELECT grp, MIN(v) AS mn, MAX(v) AS mx FROM h GROUP BY grp HAVING MAX(v) > MIN(v) * 1.5 ORDER BY grp;

--echo === HAVING IN / BETWEEN ===

SELECT grp, COUNT(*) AS c FROM h GROUP BY grp HAVING grp IN (1, 3) ORDER BY grp;
SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING SUM(v) BETWEEN 10 AND 50 ORDER BY grp;

--echo === HAVING IS NULL / IS NOT NULL ===

DROP TABLE IF EXISTS h2;
CREATE TABLE h2 (grp INT, v INT);
INSERT INTO h2 VALUES (1, 10), (1, NULL), (2, NULL), (2, NULL);
SELECT grp, SUM(v) AS s FROM h2 GROUP BY grp HAVING SUM(v) IS NULL ORDER BY grp;
SELECT grp, SUM(v) AS s FROM h2 GROUP BY grp HAVING SUM(v) IS NOT NULL ORDER BY grp;
DROP TABLE h2;

--echo === HAVING with arithmetic on aggregate ===

SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING SUM(v) + 10 > 50 ORDER BY grp;

--echo === HAVING with column NOT in GROUP BY and NOT aggregated — errno 1054 ===

--error 1054
SELECT grp, COUNT(*) FROM h GROUP BY grp HAVING v > 0;

--echo === WHERE filters before aggregate; HAVING after ===

SELECT grp, SUM(v) AS s FROM h WHERE v > 5 GROUP BY grp HAVING SUM(v) > 20 ORDER BY grp;

--echo === HAVING with mixed scalar + aggregate predicates ===

SELECT grp, SUM(v) AS s FROM h GROUP BY grp HAVING grp >= 2 AND SUM(v) > 5 ORDER BY grp;

--echo === HAVING combined with multi-column GROUP BY ===

SELECT grp, v IS NULL AS is_n, COUNT(*) AS c FROM h GROUP BY grp, v IS NULL HAVING COUNT(*) >= 1 ORDER BY grp, is_n;

--echo === HAVING <aggregate> with no GROUP BY — works (via prepared-statement path) ===
--echo # Probed via mysql_async (prepared statements) — works.
--echo # NB: via the mysql text-protocol CLI the same query returns
--echo # NULL — divergence between zeta's prepared and text paths
--echo # for this specific shape. Pinning the prepared behavior
--echo # since that's what the runner / drivers use.

SELECT SUM(v) AS s FROM h HAVING TRUE;
SELECT SUM(v) AS s FROM h HAVING SUM(v) > 100;
SELECT SUM(v) AS s FROM h GROUP BY 1 HAVING SUM(v) > 100;

DROP TABLE h;
