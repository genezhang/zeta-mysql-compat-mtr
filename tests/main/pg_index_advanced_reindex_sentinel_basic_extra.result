=== Setup ===
DROP TABLE IF EXISTS i;
CREATE TABLE i (id INT PRIMARY KEY, v INT, txt TEXT);
=== SHAPE D — SUPPORT: bare CREATE INDEX (boundary marker) ===
CREATE INDEX ix0 ON i (id);
=== SHAPE B — ON ONLY (PG inheritance modifier) parse-reject ===
CREATE INDEX ix1 ON ONLY i (id);
