CREATE INDEX ix5 ON i (id) WITH (fillfactor = 70);
=== SHAPE A — WITH (deduplicate_items = on) silent-accept (PG13+) ===
CREATE INDEX ix6 ON i (id) WITH (deduplicate_items = on);
=== SHAPE A — WITH (nosuchopt = 99) UNKNOWN option silent-accept (most damning — no validation registry) ===
CREATE INDEX ix7 ON i (id) WITH (nosuchopt = 99);
=== SHAPE A — UNIQUE … NULLS DISTINCT silent-accept (PG15+) ===
CREATE UNIQUE INDEX ix8 ON i (id) NULLS DISTINCT;
=== SHAPE A — UNIQUE … NULLS NOT DISTINCT silent-accept (PG15+) ===
CREATE UNIQUE INDEX ix9 ON i (id) NULLS NOT DISTINCT;
