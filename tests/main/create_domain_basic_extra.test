# Independently authored CREATE DOMAIN / DROP DOMAIN
# smoke for the GPL MTR-format runner. NOT copied or
# adapted from MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - CREATE DOMAIN — NONE (checked all *.test files per
#     PR #357 lesson).
#   - DROP DOMAIN — NONE.
#   - enum_type_basic_extra covers CREATE TYPE ... AS ENUM
#     (sibling user-type feature) — distinct surface.
#   - column_constraint_basic_extra covers column-level
#     NOT NULL / DEFAULT / CHECK, but NOT via domains.
#
# This slice pins:
#   - CREATE DOMAIN <name> AS <base_type> registers a
#     type alias.
#   - Using the domain in CREATE TABLE: column gets the
#     domain's base type (impl at lib.rs:22789-22793).
#   - CREATE DOMAIN <name> AS <type> DEFAULT <expr> parses.
#   - CREATE DOMAIN <name> AS <type> CHECK (<expr>) parses.
#   - DROP DOMAIN <name>.
#   - DROP DOMAIN IF EXISTS <name> (existing and unknown).
#   - DROP DOMAIN <unknown> without IF EXISTS errors.
#
# Big-picture finding (FOUR STRIKING LIMITATIONS):
#
#   1. **NOT NULL clause is NOT PARSEABLE.** sqlparser-rs
#      doesn't accept `CREATE DOMAIN x AS T NOT NULL` or
#      `... CONSTRAINT n NOT NULL` — the parser only
#      accepts CONSTRAINT clauses of types PRIMARY KEY /
#      UNIQUE / FOREIGN KEY / CHECK. The
#      convert.rs:354-360 comment "sqlparser may encode
#      NOT NULL as a named constraint" is DEAD CODE in
#      the current sqlparser version. So even though
#      zeta's `DomainDef.not_null` field exists and the
#      lib.rs:22790-22791 propagation comment promises
#      domain-NOT-NULL → column-NOT-NULL, you CAN'T
#      reach that code path from SQL today.
#
#   2. **Domain CHECK is NOT ENFORCED on INSERT.** The
#      impl at lib.rs:22789-22793 propagates the base
#      type but the comment says "Domain CHECK is stored
#      separately" — and grep for `check_sql.*domain` in
#      the executor returns zero hits. So a CHECK exists
#      in catalog but doesn't reject violating INSERTs.
#      REAL DIVERGENCE from PG.
#
#   2a. **Domain DEFAULT is NOT PROPAGATED to columns.**
#      Same code path at lib.rs:22789-22793 reads
#      `domain_def.not_null` but NEVER reads
#      `domain_def.default_expr`. Column DEFAULT at
#      lib.rs:22838-22842 reads only `cs.default_expr`
#      (the column statement's own default). So a
#      DOMAIN's DEFAULT exists in catalog but doesn't
#      fire when an INSERT omits the column — the column
#      stays NULL. Symmetric dead-code partner to #2.
#      Pinned with an INSERT-with-omitted-column row.
#
#   3. **DROP DOMAIN does NOT check for dependent tables.**
#      Per impl comment at lib.rs:14761-14763: "does not
#      check for dependent tables. Since domains resolve
#      to base types at CREATE TABLE time, existing
#      tables are unaffected. PostgreSQL rejects DROP
#      DOMAIN with dependents unless CASCADE." Apps
#      porting from PG migrations that rely on this
#      safety net will silently lose protection.
#
#   These four combine to make zeta's CREATE DOMAIN
#   currently a TYPE-ALIAS-ONLY feature — strip the
#   NOT NULL / CHECK / DEFAULT enforcement claims and
#   use domains as documentation/naming for shared base
#   types only.
#
#   STRIKING — CHECK and DEFAULT can't be combined in
#   one CREATE DOMAIN. The parser accepts either CHECK
#   or DEFAULT but not both. Pinned in a sentinel row.
#
# Adaptation notes:
#   # zeta-adapt: CREATE DOMAIN is TYPE-ALIAS-ONLY today.
#     NOT NULL clause won't parse; CHECK parses but isn't
#     enforced on INSERT; DEFAULT parses but doesn't fire
#     on omitted columns; DROP doesn't reject dependents.
#   # zeta-adapt: DEFAULT and CHECK can't be combined in
#     one CREATE DOMAIN — parser rejects.
#   # zeta-adapt: For real NOT NULL / CHECK enforcement,
#     put the constraints on the table column directly.

--echo === CREATE DOMAIN — basic type alias ===

CREATE DOMAIN dom_email AS TEXT;
CREATE DOMAIN dom_score AS INTEGER;

--echo === Use domain in CREATE TABLE — column gets base type ===

CREATE TABLE users_with_dom (
    id    INT PRIMARY KEY,
    email dom_email,
    score dom_score
);
INSERT INTO users_with_dom VALUES (1, 'alice@example.com', 42);
SELECT id, email, score FROM users_with_dom ORDER BY id;

--echo === CREATE DOMAIN — DEFAULT clause parses (NOT propagated to column) ===

CREATE DOMAIN dom_with_default AS INTEGER DEFAULT 99;
CREATE TABLE need_default (id INT, val dom_with_default);
# Explicit value supplied — works.
INSERT INTO need_default VALUES (1, 5);
# STRIKING: INSERT without `val` does NOT pick up the
# domain's DEFAULT 99. Column resolves to plain INTEGER
# (no default), so val becomes NULL. PG would set it to
# 99 — real divergence.
INSERT INTO need_default (id) VALUES (2);
SELECT id, val FROM need_default ORDER BY id;

--echo === CREATE DOMAIN — CHECK clause parses (NOT ENFORCED on insert) ===

CREATE DOMAIN dom_positive_check AS INTEGER CHECK (VALUE > 0);
CREATE TABLE check_test (id INT, val dom_positive_check);
INSERT INTO check_test VALUES (1, 5);
# CHECK constraints are now enforced (MySQL behavior).
--error 1105
INSERT INTO check_test VALUES (2, -1);
--error 1105
INSERT INTO check_test VALUES (3, 0);
SELECT * FROM check_test ORDER BY id;

--echo === STRIKING: NOT NULL clause is NOT PARSEABLE ===

# sqlparser-rs only recognizes PRIMARY/UNIQUE/FOREIGN/CHECK
# constraints on DOMAIN. NOT NULL fails parse → 1064.
--error 1064
CREATE DOMAIN dom_required AS TEXT NOT NULL;
--error 1064
CREATE DOMAIN dom_required2 AS TEXT CONSTRAINT nn NOT NULL;

--echo === STRIKING: CHECK + DEFAULT in one CREATE DOMAIN — not parseable ===

--error 1064
CREATE DOMAIN dom_combined AS INTEGER CHECK (VALUE > 0) DEFAULT 99;

--echo === DROP DOMAIN — basic + idempotent IF EXISTS ===

CREATE DOMAIN dom_disposable AS TEXT;
DROP DOMAIN dom_disposable;
# Re-drop without IF EXISTS — errors (unknown name).
--error 1105
DROP DOMAIN dom_disposable;
# IF EXISTS swallows the unknown.
DROP DOMAIN IF EXISTS dom_disposable;
DROP DOMAIN IF EXISTS dom_never_existed;

--echo === STRIKING: DROP DOMAIN with dependent table — succeeds ===

# PG would reject this without CASCADE. zeta allows it
# because the dependent column already resolved to base
# type at CREATE TABLE time.
DROP DOMAIN dom_email;
# Existing table column still works — kept its TEXT type.
INSERT INTO users_with_dom VALUES (4, 'survives@example.com', 99);
SELECT id, email FROM users_with_dom WHERE id = 4;

--echo === Cleanup ===

DROP TABLE users_with_dom;
DROP TABLE need_default;
DROP TABLE check_test;
DROP DOMAIN dom_score;
DROP DOMAIN dom_with_default;
DROP DOMAIN dom_positive_check;
