=== INTENTIONAL COMPAT NO-OP — SET TIME ZONE (5 forms) via ast.rs:117 generic SET ===
SET TIME ZONE 'UTC';
SET TIME ZONE 'America/Los_Angeles';
SET TIME ZONE INTERVAL '+05:30' HOUR TO MINUTE;
SET TIME ZONE LOCAL;
SET TIME ZONE DEFAULT;
=== INTENTIONAL COMPAT NO-OP — SET CONSTRAINTS (3 forms) same path ===
SET CONSTRAINTS ALL DEFERRED;
SET CONSTRAINTS ALL IMMEDIATE;
SET CONSTRAINTS my_fk DEFERRED;
=== INTENTIONAL COMPAT NO-OP — SET SESSION AUTHORIZATION (2 forms) same path ===
SET SESSION AUTHORIZATION 'alice';
SET SESSION AUTHORIZATION DEFAULT;
=== PARSE-REJECTED — RESET TIME ZONE / RESET SESSION AUTHORIZATION (asymmetric with SET) ===
RESET TIME ZONE;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: ZONE at Line: 1, Column: 12
RESET SESSION AUTHORIZATION;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: AUTHORIZATION at Line: 1, Column: 15
=== SUPPORTED — TRUNCATE ... CONTINUE / RESTART IDENTITY (PG sequence-reset semantics) ===
CREATE TABLE t_cont (id SERIAL PRIMARY KEY, n INT);
INSERT INTO t_cont (n) VALUES (10), (20), (30);
SELECT id, n FROM t_cont ORDER BY id;
id	n
1	10
2	20
3	30
TRUNCATE t_cont CONTINUE IDENTITY;
INSERT INTO t_cont (n) VALUES (40);
SELECT id, n FROM t_cont;
id	n
4	40
TRUNCATE t_cont RESTART IDENTITY;
INSERT INTO t_cont (n) VALUES (50);
SELECT id, n FROM t_cont;
id	n
1	50
TRUNCATE TABLE t_cont CONTINUE IDENTITY CASCADE;
=== PARSE-REJECTED — VACUUM FREEZE variants (3 forms) ===
VACUUM FREEZE t_cont;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: t_cont at Line: 1, Column: 15
VACUUM FULL FREEZE t_cont;
ERROR 1064: SQL parse error: sql parser error: Expected: end of statement, found: t_cont at Line: 1, Column: 20
VACUUM (FREEZE, ANALYZE) t_cont;
