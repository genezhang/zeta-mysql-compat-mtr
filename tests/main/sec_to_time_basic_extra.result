=== SEC_TO_TIME — basic, zero, day boundary ===
SELECT SEC_TO_TIME(3666) AS one_hr_one_min_six_sec;
one_hr_one_min_six_sec
01:01:06
SELECT SEC_TO_TIME(0)    AS midnight;
midnight
00:00:00
SELECT SEC_TO_TIME(86400) AS one_day_boundary;
one_day_boundary
24:00:00
=== SEC_TO_TIME — NULL → NULL ===
SELECT SEC_TO_TIME(NULL) AS n;
n
NULL
=== SEC_TO_TIME — out of range (MySQL allows; zeta rejects) ===
SELECT SEC_TO_TIME(86401);
ERROR 1105: execution error: SEC_TO_TIME: 86401 seconds out of 0..86400 range
SELECT SEC_TO_TIME(-1);
ERROR 1105: execution error: SEC_TO_TIME: -1 seconds out of 0..86400 range
=== TIME_TO_SEC — TIME literal, string form, NULL ===
SELECT TIME_TO_SEC(TIME '01:01:06') AS hms;
hms
3666
SELECT TIME_TO_SEC(TIME '23:59:59') AS day_end;
day_end
86399
SELECT TIME_TO_SEC(TIME '00:00:00') AS zero;
zero
0
SELECT TIME_TO_SEC('01:00:00')      AS str_one_hr;
str_one_hr
3600
SELECT TIME_TO_SEC(NULL)            AS n;
n
NULL
=== TIME_TO_SEC — unparseable string errors 1105 ===
SELECT TIME_TO_SEC('not a time');
ERROR 1105: execution error: TIME_TO_SEC: cannot parse "not a time" as a time
=== Roundtrip: TIME_TO_SEC(SEC_TO_TIME(n)) = n ===
SELECT TIME_TO_SEC(SEC_TO_TIME(3661)) AS rt;
rt
3661
=== Arity errors ===
SELECT SEC_TO_TIME();
ERROR 1105: execution error: SEC_TO_TIME requires 1 argument
SELECT SEC_TO_TIME(1, 2);
ERROR 1105: execution error: SEC_TO_TIME requires 1 argument
SELECT TIME_TO_SEC();
ERROR 1105: execution error: TIME_TO_SEC requires 1 argument
SELECT TIME_TO_SEC(TIME '00:30:00', TIME '00:00:00');
ERROR 1105: execution error: TIME_TO_SEC requires 1 argument
=== On TIME column inside SELECT / WHERE ===
DROP TABLE IF EXISTS tt;
CREATE TABLE tt (id INT, t TIME);
INSERT INTO tt VALUES (1, TIME '00:00:30'), (2, TIME '01:00:00'), (3, TIME '02:30:00');
SELECT id, TIME_TO_SEC(t) AS s FROM tt ORDER BY id;
id	s
1	30
2	3600
3	9000
SELECT id FROM tt WHERE TIME_TO_SEC(t) > 3600 ORDER BY id;
id
3
DROP TABLE tt;
