# Independently authored INITCAP / TRANSLATE / OCTET_LENGTH-
# family smoke for the GPL MTR-format runner. NOT copied or
# adapted from MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - INITCAP — NONE (zero compat-mtr coverage; PG-flavor).
#   - TRANSLATE — NONE (zero compat-mtr coverage; PG-flavor).
#   - OCTET_LENGTH — string_func_extra.test:90-95 pins
#     OCTET_LENGTH('abc')/('héllo'); string_compare_basic_
#     extra.test:96-99 pins OCTET_LENGTH('abc')/('é'). The
#     basic ASCII + UTF-8 byte-count rows are already pinned.
#   - BIT_LENGTH — bitwise_basic_extra.test:100 pins INT
#     arg (known-divergence "TEXT length × 8"); string_
#     func_extra.test:90-95 pins BIT_LENGTH('abc')/('héllo');
#     string_compare_basic_extra.test:96-99 pins BIT_LENGTH('é').
#   - LENGTHB — NONE (zero compat-mtr coverage; Oracle alias).
#
# This slice pins (net-new — duplicate rows DROPPED):
#   - INITCAP: capitalize first letter of each word; word
#     boundary is non-alphanumeric. Per-word lowercasing of
#     remaining chars. NULL → NULL.
#   - TRANSLATE(s, from, to): char-by-char replacement; chars
#     in `from` with no matching position in `to` are DELETED
#     (when `to` is shorter than `from`). Any NULL arg → NULL.
#   - LENGTHB ≡ OCTET_LENGTH IDENTITY (Oracle alias on the
#     same impl arm at lib.rs:46146; no existing slice pins
#     this equivalence).
#   - BIT_LENGTH = OCTET_LENGTH × 8 IDENTITY pin (existing
#     slices show the bytes/bits values separately but not
#     the algebraic relationship).
#   - OCTET_LENGTH non-string coerce — Int/Bool/DATE via
#     value_to_sql_string catch-all (uncovered).
#   - LENGTHB arity + NULL prop (separate from OCTET_LENGTH
#     coverage since LENGTHB itself is uncovered).
#
# Big-picture finding:
#   INITCAP and TRANSLATE are PG-style string functions that
#   zeta supports but no MySQL app would use them by those
#   names (MySQL has neither). Pinning them documents that
#   the engine surface IS broader than the MySQL surface, and
#   provides a contract for tooling that translates PG SQL.
#
#   The OCTET_LENGTH/LENGTHB/BIT_LENGTH triple share ONE impl
#   arm (lib.rs:46146). LENGTHB is an Oracle alias; using it
#   in a MySQL app is fine in zeta because all three pipe
#   through identical byte-counting logic.
#
#   TRANSLATE "delete-when-no-mapping" semantics differ from
#   REPLACE — REPLACE substitutes one string for another (no
#   per-char remapping). TRANSLATE on the same input gives a
#   DIFFERENT result. Pinned via a side-by-side comparison.
#
# Adaptation notes:
#   # zeta-adapt: INITCAP word boundary = !is_alphanumeric.
#     `O'CONNOR` becomes `O'Connor` (apostrophe is a
#     boundary). Numbers are alphanumeric so `abc123def`
#     becomes `Abc123def` (single word).
#   # zeta-adapt: TRANSLATE shorter `to` deletes — useful for
#     character stripping (e.g. removing digits).
#   # zeta-adapt: OCTET_LENGTH / LENGTHB / BIT_LENGTH are the
#     ONLY way to count BYTES of a UTF-8 string. zeta's
#     LENGTH counts CHARS (impl is `s.chars().count()` at
#     lib.rs:46130), divergent from MySQL where LENGTH counts
#     BYTES. Existing slice string_func_basic.result:73 pins
#     this. So in zeta: LENGTH ≡ CHAR_LENGTH (chars),
#     OCTET_LENGTH ≡ LENGTHB (bytes).

--echo === INITCAP basic ===

SELECT INITCAP('hello world')                                 AS two_words;
SELECT INITCAP('HELLO WORLD')                                 AS all_caps_normalized;
SELECT INITCAP('hello')                                       AS single_word;
SELECT INITCAP('')                                            AS empty_string;

--echo === INITCAP word boundary = non-alphanumeric ===

# Apostrophe is a boundary — `O'CONNOR` becomes `O'Connor`.
SELECT INITCAP('O''CONNOR')                                   AS apostrophe_boundary;
# Numbers ARE alphanumeric — `abc123def` is ONE word.
SELECT INITCAP('abc123def')                                   AS digit_inside_one_word;
# Multiple consecutive separators preserved.
SELECT INITCAP('hello---world')                               AS dash_separators;
# Tab and other whitespace as boundaries.
SELECT INITCAP('a b  c')                                      AS multi_space;
# Mixed punctuation.
SELECT INITCAP('hello, world! how are you?')                  AS sentence;

--echo === INITCAP UTF-8 multibyte ===

# `café` — first letter uppercased, rest lowercased.
SELECT INITCAP('CAFÉ MENU')                                   AS utf8_uppercased;
SELECT INITCAP('café menu')                                   AS utf8_lowercased;

--echo === INITCAP NULL + arity + non-string coerce ===

SELECT INITCAP(NULL)                                          AS null_propagates;
SELECT INITCAP(NULL) IS NULL                                  AS null_predicate;
# Non-string coerced via value_to_sql_string then INITCAPped.
SELECT INITCAP(42)                                            AS int_coerce;
SELECT INITCAP(TRUE)                                          AS bool_coerce;
--error 1105
SELECT INITCAP();
--error 1105
SELECT INITCAP('a', 'b');

--echo === TRANSLATE basic (1:1 char map) ===

# Standard PG TRANSLATE: replace per-char position.
SELECT TRANSLATE('abc',     'abc', 'xyz')                     AS abc_to_xyz;
SELECT TRANSLATE('hello',   'el',  'ip')                      AS partial_map;
# No-op when from and to are identical.
SELECT TRANSLATE('hello',   'aeiou', 'aeiou')                 AS noop_identity;
# Char not in `from` passes through unchanged.
SELECT TRANSLATE('hello',   'xyz', 'abc')                     AS no_match_passthrough;

--echo === TRANSLATE delete semantics — shorter `to` strips ===

# Chars in `from` past the length of `to` are DELETED. Useful
# for stripping digits / punctuation.
SELECT TRANSLATE('phone: 555-1234', '0123456789', '')         AS strip_digits;
SELECT TRANSLATE('hello!world?', '!?', '')                    AS strip_punctuation;
# Partial: 'el' map; if to='i', then 'e'→'i', 'l' deleted.
SELECT TRANSLATE('hello', 'el', 'i')                          AS shorter_to_partial_delete;

--echo === TRANSLATE NULL + arity ===

# ANY null arg → NULL.
SELECT TRANSLATE(NULL,  'a', 'b')                             AS null_s;
SELECT TRANSLATE('abc', NULL, 'b')                            AS null_from;
SELECT TRANSLATE('abc', 'a',  NULL)                           AS null_to;
SELECT TRANSLATE(NULL,  'a', 'b') IS NULL                     AS null_s_pred;
--error 1105
SELECT TRANSLATE('abc', 'a');
--error 1105
SELECT TRANSLATE('abc');
--error 1105
SELECT TRANSLATE();
--error 1105
SELECT TRANSLATE('abc', 'a', 'b', 'c');

--echo === TRANSLATE vs REPLACE — DIFFERENT semantics ===

# REPLACE substitutes one whole substring for another;
# TRANSLATE does per-character mapping with positional
# `from`→`to`. Pinned on `('hello', 'l', 'XY')` where the
# divergence shows: REPLACE doubles each 'l' to 'XY' (the
# whole 'XY' string substitutes for each 'l'), while
# TRANSLATE only maps the first char of `to` (l→X) and
# ignores the extra 'Y' since `from` has only one char.
SELECT REPLACE('hello',   'l', 'XY')                          AS replace_doubles;
SELECT TRANSLATE('hello', 'l', 'XY')                          AS translate_singles;
SELECT REPLACE('hello',   'l', 'XY') = TRANSLATE('hello', 'l', 'XY')
                                                              AS divergence_eq_is_false;

--echo === LENGTHB ≡ OCTET_LENGTH IDENTITY (Oracle alias, same impl arm) ===

# Net-new: pin the alias equivalence. Basic ASCII/UTF-8 byte
# values are already covered by string_func_extra.test:90-95
# and string_compare_basic_extra.test:96-99 — do NOT repeat.
# Here pin only that LENGTHB is literally the same function.
SELECT OCTET_LENGTH('hello') = LENGTHB('hello')               AS ol_eq_lb_ascii;
SELECT OCTET_LENGTH('café')  = LENGTHB('café')                AS ol_eq_lb_utf8;
SELECT OCTET_LENGTH('')      = LENGTHB('')                    AS ol_eq_lb_empty;

--echo === BIT_LENGTH = OCTET_LENGTH × 8 ALGEBRAIC IDENTITY ===

# Net-new: pin the algebraic relationship (existing slices
# show bytes/bits separately but not the multiplier identity).
SELECT BIT_LENGTH('hello') = OCTET_LENGTH('hello') * 8        AS bl_eq_ol8_ascii;
SELECT BIT_LENGTH('café')  = OCTET_LENGTH('café')  * 8        AS bl_eq_ol8_utf8;
SELECT BIT_LENGTH('')      = OCTET_LENGTH('')      * 8        AS bl_eq_ol8_empty;

--echo === LENGTHB — NULL prop + arity (uncovered alias) ===

SELECT LENGTHB(NULL)                                          AS lb_null;
SELECT LENGTHB(NULL) IS NULL                                  AS lb_null_pred;
--error 1105
SELECT LENGTHB();
--error 1105
SELECT LENGTHB('a', 'b');

--echo === OCTET_LENGTH on non-string types (catch-all coerce) ===

# Int / Bool / DATE coerce via value_to_sql_string, then bytes.
# Uncovered arm in existing slices.
SELECT OCTET_LENGTH(42)                                       AS ol_int_is_2;
SELECT OCTET_LENGTH(TRUE)                                     AS ol_true_is_4;
SELECT OCTET_LENGTH(DATE '2024-03-15')                        AS ol_date_is_10;
