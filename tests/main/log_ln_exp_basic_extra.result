=== LOG: 1-arg = log10 (MySQL convention) ===
SELECT LOG(1)                            AS log_one_is_zero;
log_one_is_zero
0
SELECT LOG(10)                           AS log_ten_is_one;
log_ten_is_one
2.302585092994046
SELECT LOG(100)                          AS log_hundred_is_two;
log_hundred_is_two
4.605170185988092
SELECT LOG(1000)                         AS log_thousand_is_three;
log_thousand_is_three
6.907755278982137
SELECT LOG(EXP(1)) <> 1                  AS log_is_log10_not_ln;
log_is_log10_not_ln
0
SELECT ROUND(LN(EXP(1)), 10) > 0.99
   AND ROUND(LN(EXP(1)), 10) < 1.01      AS ln_inverse_exp_range;
ln_inverse_exp_range
1
=== LOG: 2-arg form (log base b of x) ===
SELECT LOG(2, 8)                         AS log2_eight_is_three;
log2_eight_is_three
3
SELECT LOG(10, 1000)                     AS log10_thousand_is_three;
log10_thousand_is_three
2.9999999999999996
SELECT LOG(3, 27)                        AS log3_27_is_three;
log3_27_is_three
3
SELECT POW(2, LOG(2, 16)) > 15.99
   AND POW(2, LOG(2, 16)) < 16.01      AS log_pow_round_trip_range;
log_pow_round_trip_range
1
=== LOG / LN / EXP: error on invalid input (zeta strict, MySQL NULL) ===
SELECT LOG(0);
LOG(0)
NULL
SELECT LOG(-1);
LOG(-1)
NULL
SELECT LN(0);
LN(0)
NULL
SELECT LN(-1);
LN(-1)
NULL
SELECT LOG(-2, 8);
LOG(-2, 8)
NULL
SELECT LOG(2, -8);
LOG(2, -8)
NULL
SELECT LOG(1, 100);
LOG(1, 100)
NULL
=== LN: known vectors ===
SELECT LN(1)                             AS ln_one_is_zero;
ln_one_is_zero
0
SELECT LN(EXP(1))                        AS ln_e_is_one;
ln_e_is_one
1
SELECT LN(EXP(2))                        AS ln_e_sq;
ln_e_sq
2
=== EXP: known vectors ===
SELECT EXP(0)                            AS exp_zero_is_one;
exp_zero_is_one
1
SELECT ROUND(EXP(1), 10)                 AS exp_one_rounded_e;
exp_one_rounded_e
2.7182818285
SELECT EXP(-1) > 0.36 AND EXP(-1) < 0.37 AS exp_neg_one_range;
exp_neg_one_range
1
=== EXP: overflow returns +Infinity (NOT error) ===
SELECT EXP(1000) > 1e308                 AS overflow_is_inf;
ERROR 1690: DOUBLE value is out of range in 'exp(1000)'
SELECT EXP(-1000) < 1e-300               AS underflow_below_1e_neg_300;
underflow_below_1e_neg_300
1
SELECT EXP(-1000) >= 0                   AS underflow_non_neg;
underflow_non_neg
1
=== Cross-family inverse: LN(EXP(x)) ≈ x ===
SELECT ROUND(LN(EXP(5)), 9)              AS inverse_5;
inverse_5
5
SELECT ROUND(LN(EXP(-3)), 9)             AS inverse_neg_3;
inverse_neg_3
-3
=== NULL passthrough ===
SELECT LOG(NULL)         IS NULL         AS log1_null;
log1_null
1
SELECT LOG(NULL, 10)     IS NULL         AS log_null_base;
log_null_base
1
SELECT LOG(2, NULL)      IS NULL         AS log_null_x;
log_null_x
1
SELECT LN(NULL)          IS NULL         AS ln_null;
ln_null
1
SELECT EXP(NULL)         IS NULL         AS exp_null;
exp_null
1
=== Arity errors ===
SELECT LOG();
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near ')' at line 1
SELECT LOG(2, 8, 3);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near ', 3)' at line 1
SELECT LN();
ERROR 1582: Incorrect parameter count in the call to native function 'LN'
SELECT LN(1, 2);
ERROR 1582: Incorrect parameter count in the call to native function 'LN'
SELECT EXP();
ERROR 1582: Incorrect parameter count in the call to native function 'EXP'
SELECT EXP(1, 2);
ERROR 1582: Incorrect parameter count in the call to native function 'EXP'
=== Determinism ===
SELECT LOG(10)   = LOG(10)              AS log_det;
log_det
1
SELECT LN(2)     = LN(2)                AS ln_det;
ln_det
1
SELECT EXP(1)    = EXP(1)               AS exp_det;
exp_det
1
