=== Setup ===
DROP TABLE IF EXISTS txv;
CREATE TABLE txv (id INT PRIMARY KEY, v INT);
INSERT INTO txv VALUES (1, 10);
=== Within-transaction visibility ===
BEGIN;
INSERT INTO txv VALUES (2, 20);
SELECT id, v FROM txv ORDER BY id;
id	v
1	10
2	20
ROLLBACK;
SELECT id, v FROM txv ORDER BY id;
id	v
1	10
=== RELEASE SAVEPOINT ===
BEGIN;
SAVEPOINT s1;
RELEASE SAVEPOINT s1;
COMMIT;
=== SET TRANSACTION ISOLATION LEVEL — three forms ===
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
=== SET SESSION / SET GLOBAL TRANSACTION ISOLATION LEVEL ===
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET GLOBAL  TRANSACTION ISOLATION LEVEL READ COMMITTED;
=== SET autocommit toggles ===
SET autocommit = 0;
SET autocommit = 1;
SET @@autocommit = 0;
SET @@autocommit = 1;
=== START TRANSACTION READ WRITE — accepted ===
START TRANSACTION READ WRITE;
COMMIT;
=== KNOWN GAP: COMMIT AND CHAIN — errno 1105 ===
BEGIN;
COMMIT AND CHAIN;
ERROR 1105: plan error: transaction control statements are not planned
ROLLBACK;
=== KNOWN GAP: ROLLBACK AND CHAIN — errno 1105 ===
BEGIN;
ROLLBACK AND CHAIN;
ERROR 1105: plan error: transaction control statements are not planned
ROLLBACK;
=== KNOWN GAP: START TRANSACTION READ ONLY — errno 1235 ===
START TRANSACTION READ ONLY;
ERROR 1235: START TRANSACTION READ ONLY is not supported
=== KNOWN GAP: START TRANSACTION ISOLATION LEVEL inline — errno 1235 ===
START TRANSACTION ISOLATION LEVEL SERIALIZABLE;
ERROR 1235: START TRANSACTION ISOLATION LEVEL is not supported (use SET TRANSACTION ISOLATION LEVEL before BEGIN)
=== RELEASE SAVEPOINT on missing — errno 1105 ===
BEGIN;
RELEASE SAVEPOINT no_such_sp;
ERROR 1105: execution error: savepoint "no_such_sp" does not exist
ROLLBACK;
=== Cleanup ===
DROP TABLE txv;
