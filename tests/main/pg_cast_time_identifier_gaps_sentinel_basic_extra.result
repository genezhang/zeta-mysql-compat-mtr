=== SHAPE A — TIME-family CAST-registry gap (3 rejects + 1 TIMESTAMP-family SUPPORT) ===
SELECT CAST('12:00' AS TIMETZ);
ERROR 1105: execution error: unsupported CAST target type: TIMETZ
SELECT CAST('12:00:00+05:00' AS TIME WITH TIME ZONE);
ERROR 1105: execution error: unsupported CAST target type: TIME WITH TIME ZONE
SELECT CAST('12:00:00' AS TIME WITHOUT TIME ZONE);
ERROR 1105: execution error: unsupported CAST target type: TIME WITHOUT TIME ZONE
SELECT CAST('2024-01-01 12:00:00' AS TIMESTAMP WITHOUT TIME ZONE) AS timestamp_without_tz_works;
timestamp_without_tz_works
2024-01-01 12:00:00
