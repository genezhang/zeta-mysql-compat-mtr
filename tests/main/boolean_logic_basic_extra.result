=== Setup ===
DROP TABLE IF EXISTS bt;
CREATE TABLE bt (id INT PRIMARY KEY, flag BOOLEAN, name TEXT);
INSERT INTO bt VALUES (1, true, 'a'), (2, false, 'b'), (3, NULL, 'c');
=== BOOLEAN renders as 1 / 0 over MySQL wire ===
SELECT id, flag FROM bt ORDER BY id;
id	flag
1	1
2	0
3	NULL
=== BOOLEAN in WHERE: WHERE flag matches true; WHERE NOT flag matches false ===
SELECT id FROM bt WHERE flag;
id
1
SELECT id FROM bt WHERE NOT flag;
id
2
=== IS TRUE / IS NOT TRUE / IS FALSE / IS NOT FALSE ===
SELECT id FROM bt WHERE flag IS TRUE;
id
1
SELECT id FROM bt WHERE flag IS NOT TRUE ORDER BY id;
id
2
3
SELECT id FROM bt WHERE flag IS FALSE;
id
2
SELECT id FROM bt WHERE flag IS NOT FALSE ORDER BY id;
id
1
3
=== IS NULL / IS UNKNOWN ===
SELECT id FROM bt WHERE flag IS NULL;
id
3
SELECT id FROM bt WHERE flag IS UNKNOWN;
id
3
=== Equality with TRUE literal ===
SELECT id FROM bt WHERE flag = true ORDER BY id;
id
1
=== 3-valued AND / OR / NOT — full truth table for NULL ===
SELECT true AND false AS aa, true OR false AS oo, NOT true AS nt;
aa	oo	nt
0	1	0
SELECT true AND NULL AS tan, false AND NULL AS fan,
       true OR NULL AS ton, false OR NULL AS fon;
tan	fan	ton	fon
NULL	0	1	NULL
SELECT NULL AND NULL AS r;
r
NULL
=== IS DISTINCT FROM / IS NOT DISTINCT FROM ===
SELECT NULL IS DISTINCT FROM NULL AS nidn, NULL IS DISTINCT FROM true AS nidt,
       true IS DISTINCT FROM true AS tidt;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'DISTINCT FROM NULL AS nidn, NULL IS DISTINCT FROM true AS nidt,
       true IS D' at line 1
SELECT NULL IS NOT DISTINCT FROM NULL AS r;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'DISTINCT FROM NULL AS r' at line 1
=== FILTER clause and boolean aggregates ===
SELECT COUNT(*) FILTER (WHERE flag) AS yes_cnt, COUNT(*) AS total FROM bt;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(WHERE flag) AS yes_cnt, COUNT(*) AS total FROM bt' at line 1
SELECT BOOL_AND(flag) AS ba, BOOL_OR(flag) AS bo, EVERY(flag) AS ev FROM bt;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(flag) AS ev FROM bt' at line 1
SELECT BOOL_AND(flag) AS ba FROM bt WHERE id IN (1, 2);
ERROR 1305: FUNCTION test.BOOL_AND does not exist
=== ORDER BY boolean — false (0) before true (1), NULLs last ===
SELECT id, flag FROM bt ORDER BY flag, id;
id	flag
3	NULL
2	0
1	1
=== String-literal casts to BOOLEAN ===
SELECT 't'::BOOLEAN, 'f'::BOOLEAN, '1'::BOOLEAN, '0'::BOOLEAN,
       'true'::BOOLEAN, 'false'::BOOLEAN, 'yes'::BOOLEAN, 'no'::BOOLEAN;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::BOOLEAN, 'f'::BOOLEAN, '1'::BOOLEAN, '0'::BOOLEAN,
       'true'::BOOLEAN, 'fa' at line 1
=== CAST(int AS BOOLEAN) ===
SELECT CAST(1 AS BOOLEAN) AS r1, CAST(0 AS BOOLEAN) AS r2;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'BOOLEAN) AS r1, CAST(0 AS BOOLEAN) AS r2' at line 1
=== BOOL alias of BOOLEAN ===
DROP TABLE IF EXISTS bool_alt;
CREATE TABLE bool_alt (id INT PRIMARY KEY, b1 BOOL, b2 BOOLEAN);
INSERT INTO bool_alt VALUES (1, true, false);
SELECT id, b1, b2 FROM bool_alt;
id	b1	b2
1	1	0
DROP TABLE bool_alt;
=== BOOLEAN column with DEFAULT false ===
DROP TABLE IF EXISTS bool_def;
CREATE TABLE bool_def (id INT PRIMARY KEY, flag BOOLEAN DEFAULT false);
INSERT INTO bool_def (id) VALUES (1), (2);
SELECT id, flag FROM bool_def ORDER BY id;
id	flag
1	0
2	0
DROP TABLE bool_def;
=== CHECK constraint on BOOLEAN column ===
DROP TABLE IF EXISTS bool_chk;
CREATE TABLE bool_chk (id INT PRIMARY KEY, flag BOOLEAN, CHECK (flag IS NOT NULL));
INSERT INTO bool_chk VALUES (1, true);
INSERT INTO bool_chk VALUES (2, NULL);
ERROR 3819: Check constraint 'bool_chk_chk_1' is violated.
DROP TABLE bool_chk;
=== COALESCE on BOOLEAN ===
SELECT COALESCE(NULL::BOOLEAN, true) AS r1, COALESCE(NULL::BOOLEAN, NULL) AS r2;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::BOOLEAN, true) AS r1, COALESCE(NULL::BOOLEAN, NULL) AS r2' at line 1
=== CASE WHEN bool_col THEN ... ===
SELECT id, CASE WHEN flag THEN 'on' ELSE 'off' END AS s FROM bt ORDER BY id;
id	s
1	on
2	off
3	off
=== KNOWN GAP: bool → INT cast — errno 1105 ===
# The reverse direction (INT → BOOLEAN) works; only
# bool → INT fails. Substitute:
# `CASE WHEN flag THEN 1 ELSE 0 END`.
SELECT flag::INT FROM bt WHERE id = 1;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::INT FROM bt WHERE id = 1' at line 1
=== Cleanup ===
DROP TABLE bt;
