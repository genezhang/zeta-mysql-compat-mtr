# Independently authored standalone VALUES edge smoke
# test for the GPL MTR-format runner. NOT copied or
# adapted from MySQL's mysql-test/t/values.test or PG
# regress; complements insert_basic / insert_basic_extra
# (which cover VALUES inside INSERT) by pinning the
# STANDALONE VALUES surface (PG / Spark feature, MySQL 8+
# also supports via `VALUES ROW(...)`): bare query,
# derived table, set-op, ORDER BY / LIMIT / OFFSET,
# CROSS JOIN, IN subquery, arithmetic / function calls,
# arity validation, and the CTE-with-VALUES gap.
#
# Big-picture finding: zeta accepts standalone VALUES as
# a query form with auto-generated `column1`, `column2`,
# ... headers. Most clause combinations (ORDER BY,
# LIMIT, OFFSET, UNION / UNION ALL, derived-table alias,
# IN subquery, CROSS JOIN) compose cleanly. Column-count
# mismatch and empty VALUES are correctly rejected.
#
#
# Adaptation notes:
#   # zeta-adapt: Standalone VALUES — accepted as a
#     query; column headers default to `column1`,
#     `column2`, etc.
#   # zeta-adapt: VALUES with NULL — NULL accepted in
#     any cell; column type inferred from first non-NULL.
#   # zeta-adapt: VALUES + ORDER BY / LIMIT / OFFSET —
#     work the same as on a SELECT.
#   # zeta-adapt: VALUES UNION / UNION ALL — works.
#   # zeta-adapt: VALUES as derived table with column
#     aliases — `(VALUES (1), (2)) AS t(col)` works.
#   # zeta-adapt: VALUES as derived table without
#     aliases — works; default `column1` etc. carry
#     through.
#   # zeta-adapt: VALUES in IN — `WHERE x IN (VALUES ...)`
#     works as a row-set subquery.
#   # zeta-adapt: CROSS JOIN of two VALUES — works
#     (Cartesian product as expected).
#   # zeta-adapt: VALUES with arithmetic / function calls
#     in cells — works.
#   # zeta-adapt: VALUES column-count mismatch — errors
#     1064 "VALUES rows must all have the same number of
#     columns".
#   # zeta-adapt: Empty VALUES `VALUES ()` — errors 1064
#     at parse.
#   # zeta-adapt: VALUES inside a CTE
#     (`WITH t(c) AS (VALUES (1), (2)) SELECT ...`) works
#     after zeta PR #1222. PG and Spark accept this shape;
#     common for inline test fixtures.

--echo === Standalone VALUES — single row, single col ===

VALUES (42);

--echo === Standalone VALUES — multi-row, multi-col ===

VALUES (1, 'a'), (2, 'b'), (3, 'c');

--echo === VALUES with NULL — NULL accepted in any cell ===

VALUES (1, NULL), (NULL, 'a');

--echo === VALUES + ORDER BY ===

VALUES (3), (1), (2) ORDER BY column1;

--echo === VALUES + LIMIT / OFFSET — ORDER BY for deterministic output ===

VALUES (1), (2), (3), (4), (5) ORDER BY column1 LIMIT 2 OFFSET 1;

--echo === VALUES UNION (dedup) — ORDER BY for deterministic output ===

SELECT * FROM (VALUES (1), (2)) AS a UNION SELECT * FROM (VALUES (2), (3)) AS b ORDER BY column1;

--echo === VALUES UNION ALL — duplicates preserved; ORDER BY for deterministic output ===

SELECT * FROM (VALUES (1)) AS a UNION ALL SELECT * FROM (VALUES (1)) AS b ORDER BY column1;

--echo === VALUES as derived table with column aliases ===

SELECT * FROM (VALUES (1, 'a'), (2, 'b')) AS t(id, name) WHERE id > 1;

--echo === VALUES as derived table without aliases — default `column1` ===

SELECT * FROM (VALUES (1), (2)) ORDER BY column1;

--echo === VALUES in IN — row-set subquery ===

SELECT * FROM (VALUES (1), (2), (3)) AS t(id) WHERE id IN (VALUES (1), (3));

--echo === CROSS JOIN of two VALUES — Cartesian product ===

SELECT a.x, b.y FROM (VALUES (1), (2)) AS a(x) CROSS JOIN (VALUES (10), (20)) AS b(y);

--echo === VALUES with arithmetic ===

VALUES (1+1), (2*3), (10-5);

--echo === VALUES with function calls ===

VALUES (UPPER('hello')), (LOWER('WORLD'));

--echo === VALUES column-count mismatch — errno 1064 ===

--error 1064
VALUES (1, 'a'), (2);

--echo === Empty VALUES — errno 1064 at parse ===

--error 1064
VALUES ();

--echo === VALUES inside CTE — fixed in zeta PR #1222 ===

WITH t(id, name) AS (VALUES (1, 'a'), (2, 'b')) SELECT * FROM t ORDER BY id;

--echo === VALUES inside CTE — filter and order ===

WITH t(c) AS (VALUES (3), (1), (2)) SELECT c FROM t WHERE c >= 2 ORDER BY c;

--echo === VALUES inside CTE — multiple CTEs, mix VALUES + SELECT ===

WITH a(x) AS (VALUES (1), (2)), b(y) AS (SELECT 10) SELECT a.x, b.y FROM a CROSS JOIN b ORDER BY a.x;
