=== SHAPE A === UNLOGGED/LOGGED reject at CREATE-object-type whitelist (4th whitelist in series)
CREATE UNLOGGED TABLE u1 (id INT);
ERROR 1064: SQL parse error: sql parser error: Expected: an object type after CREATE, found: UNLOGGED at Line: 1, Column: 8
CREATE LOGGED TABLE l1 (id INT);
ERROR 1064: SQL parse error: sql parser error: Expected: an object type after CREATE, found: LOGGED at Line: 1, Column: 8
CREATE UNLOGGED TEMP TABLE ut1 (id INT);
ERROR 1064: SQL parse error: sql parser error: Expected: an object type after CREATE, found: UNLOGGED at Line: 1, Column: 8
CREATE TEMP UNLOGGED TABLE ut2 (id INT);
ERROR 1064: SQL parse error: sql parser error: Expected: an object type after CREATE, found: UNLOGGED at Line: 1, Column: 13
=== SHAPE B === GLOBAL/LOCAL TEMP all four modifier orderings silently accepted
DROP TABLE IF EXISTS gt1;
CREATE GLOBAL TEMPORARY TABLE gt1 (id INT);
DROP TABLE gt1;
DROP TABLE IF EXISTS gt2;
CREATE GLOBAL TEMP TABLE gt2 (id INT);
DROP TABLE gt2;
DROP TABLE IF EXISTS lt1;
CREATE LOCAL TEMPORARY TABLE lt1 (id INT);
DROP TABLE lt1;
DROP TABLE IF EXISTS lt2;
CREATE LOCAL TEMP TABLE lt2 (id INT);
DROP TABLE lt2;
=== SHAPE C === ON COMMIT DELETE/PRESERVE ROWS silent on TEMP; ON COMMIT DROP silent on NON-TEMP (BUG)
DROP TABLE IF EXISTS oc_t1;
CREATE TEMPORARY TABLE oc_t1 (id INT) ON COMMIT DELETE ROWS;
DROP TABLE oc_t1;
DROP TABLE IF EXISTS oc_t2;
CREATE TEMPORARY TABLE oc_t2 (id INT) ON COMMIT PRESERVE ROWS;
DROP TABLE oc_t2;
DROP TABLE IF EXISTS oc_perm;
CREATE TABLE oc_perm (id INT) ON COMMIT DROP;
DROP TABLE oc_perm;
