# Independently authored generated-column smoke test for
# the GPL MTR-format runner. NOT copied or adapted from
# MySQL's mysql-test/t/gcol_*.test files; pins zeta's
# generated-column surface from the MySQL wire (no prior
# compat coverage). Generated columns are common in ORMs
# (Hibernate @Formula, Django GeneratedField, Sequelize
# virtual fields, ActiveRecord computed columns).
#
# Big-picture finding: zeta supports STORED generated
# columns with proper recomputation on UPDATE and works
# with UNIQUE constraints — but several common
# specifications are silently broken: (1) GENERATED ALWAYS
# AS IDENTITY parses and accepts INSERTs but the id column
# stays NULL (no autoincrement); (2) ALTER TABLE ADD
# COLUMN … GENERATED does NOT backfill existing rows (they
# stay NULL); (3) the generation expression is late-bound,
# so a CREATE TABLE referencing a non-existent column
# succeeds and only errors at the first INSERT; (4) SHOW
# CREATE TABLE strips the GENERATED ... STORED clause; and
# (5) information_schema.columns has no is_generated /
# generation_expression columns, so ORMs cannot discover
# which columns are computed.
#
# Adaptation notes:
#   # zeta-adapt: CREATE TABLE ... col INT GENERATED ALWAYS
#     AS (expr) STORED — works; INSERT auto-fills it from
#     the expression.
#   # zeta-adapt: UPDATE base col → STORED generated col is
#     recomputed on the row.
#   # zeta-adapt: NULL in any base col propagates to NULL in
#     the generated col (standard SQL semantics).
#   # zeta-adapt: UNIQUE on a generated col is enforced
#     across rows (1062 on collision).
#   # zeta-adapt: KNOWN GAP — VIRTUAL keyword (MySQL's
#     non-persisted form) errors 1064 "Expected: STORED,
#     found: VIRTUAL". Only STORED is supported.
#   # zeta-adapt: KNOWN GAP — shorthand `col INT AS (expr)`
#     (no GENERATED ALWAYS prefix) errors 1064. The full
#     GENERATED ALWAYS AS (...) STORED spelling is
#     required.
#   # zeta-adapt: KNOWN GAP — explicit INSERT into a
#     generated column errors 1105 "column is a generated
#     column and cannot be written to directly" (correct
#     SQL semantics, matches PG/MySQL).
#   # zeta-adapt: KNOWN GAP — chained generated columns
#     (one generated col referencing another) errors 1105
#     "cannot use generated column ... in expression for
#     generated column". MySQL and PG both allow this.
#   # zeta-adapt: KNOWN BUG — GENERATED ALWAYS AS IDENTITY
#     and GENERATED BY DEFAULT AS IDENTITY parse fine but
#     INSERT leaves the id NULL (no autoincrement happens).
#     Use SERIAL / BIGSERIAL or DEFAULT NEXTVAL(seq)
#     instead.
#   # zeta-adapt: KNOWN BUG — ALTER TABLE ADD COLUMN …
#     GENERATED does NOT backfill existing rows; they get
#     NULL. New rows inserted after the ALTER are computed
#     correctly. To backfill, recompute and UPDATE.
#   # zeta-adapt: KNOWN BUG — generation expression is
#     late-bound: CREATE TABLE with `AS (a+z)` where z does
#     not exist SUCCEEDS, and only the first INSERT
#     surfaces the 1054 column-not-found error. PG/MySQL
#     reject this at CREATE TABLE time.
#   # zeta-adapt: KNOWN DIVERGENCE — SHOW CREATE TABLE
#     strips the GENERATED ALWAYS AS (...) STORED clause
#     from a generated column's definition; the column
#     appears as a plain `int`. Round-tripping the dump
#     loses the computation.
#   # zeta-adapt: KNOWN DIVERGENCE — information_schema
#     .columns does not expose `is_generated` /
#     `generation_expression` (1054 unknown column). ORMs
#     cannot introspect which columns are generated.

--echo === Setup: STORED generated column ===

DROP TABLE IF EXISTS gct;
CREATE TABLE gct (a INT, b INT, c INT GENERATED ALWAYS AS (a+b) STORED);

--echo === INSERT auto-fills generated col ===

INSERT INTO gct (a, b) VALUES (1, 2), (3, 4);
SELECT a, b, c FROM gct ORDER BY a;

--echo === UPDATE base col recomputes generated col ===

UPDATE gct SET a = 10 WHERE b = 2;
SELECT a, b, c FROM gct ORDER BY a;

--echo === NULL in base col propagates to generated col ===

INSERT INTO gct (a) VALUES (5);
SELECT a, b, c FROM gct WHERE b IS NULL;

--echo === String concat generated col ===

DROP TABLE IF EXISTS gconcat;
CREATE TABLE gconcat (first TEXT, last TEXT, full TEXT GENERATED ALWAYS AS (first || ' ' || last) STORED);
INSERT INTO gconcat (first, last) VALUES ('Ada', 'Lovelace');
SELECT full FROM gconcat;
DROP TABLE gconcat;

--echo === UNIQUE on generated col enforced — duplicate is 1062 ===

DROP TABLE IF EXISTS gix;
CREATE TABLE gix (a INT, b INT, c INT GENERATED ALWAYS AS (a+b) STORED, UNIQUE (c));
INSERT INTO gix (a, b) VALUES (1, 2);
--error 1062
INSERT INTO gix (a, b) VALUES (2, 1);
DROP TABLE gix;

--echo === KNOWN GAP: VIRTUAL keyword unsupported — errno 1064 ===

--error 1064
CREATE TABLE gv (a INT, b INT, c INT GENERATED ALWAYS AS (a*b) VIRTUAL);

--echo === KNOWN GAP: shorthand col AS (expr) unsupported — errno 1064 ===

--error 1064
CREATE TABLE gshort (a INT, b INT, c INT AS (a+b));

--echo === KNOWN GAP: explicit INSERT into generated col — errno 1105 ===

--error 1105
INSERT INTO gct (a, b, c) VALUES (7, 8, 99);

--echo === KNOWN GAP: chained generated cols — errno 1105 ===

--error 1105
CREATE TABLE gchain (a INT, b INT GENERATED ALWAYS AS (a*2) STORED, c INT GENERATED ALWAYS AS (b+1) STORED);

--echo === KNOWN BUG: GENERATED ALWAYS AS IDENTITY leaves id NULL ===

DROP TABLE IF EXISTS gid;
CREATE TABLE gid (id INT GENERATED ALWAYS AS IDENTITY, n INT);
INSERT INTO gid (n) VALUES (10), (20);
SELECT id, n FROM gid ORDER BY n;
DROP TABLE gid;

--echo === KNOWN BUG: GENERATED BY DEFAULT AS IDENTITY same — leaves id NULL ===

DROP TABLE IF EXISTS gid2;
CREATE TABLE gid2 (id INT GENERATED BY DEFAULT AS IDENTITY, n INT);
INSERT INTO gid2 (n) VALUES (100);
SELECT id, n FROM gid2;
DROP TABLE gid2;

--echo === KNOWN BUG: ALTER ADD GENERATED does NOT backfill ===

DROP TABLE IF EXISTS gat;
CREATE TABLE gat (a INT, b INT);
INSERT INTO gat VALUES (1, 2);
ALTER TABLE gat ADD COLUMN c INT GENERATED ALWAYS AS (a+b) STORED;
--echo # Existing row stays NULL (BUG); new inserts compute correctly:
SELECT a, b, c FROM gat;
INSERT INTO gat (a, b) VALUES (5, 6);
SELECT a, b, c FROM gat ORDER BY a;
DROP TABLE gat;

--echo === KNOWN BUG: generation expression is late-bound (bad ref accepted at CREATE) ===

DROP TABLE IF EXISTS gbad;
CREATE TABLE gbad (a INT, c INT GENERATED ALWAYS AS (a+z) STORED);
--error 1054
INSERT INTO gbad (a) VALUES (1);
DROP TABLE gbad;

--echo === KNOWN DIVERGENCE: SHOW CREATE TABLE strips GENERATED clause ===

SHOW CREATE TABLE gct;

--echo === KNOWN DIVERGENCE: information_schema.columns has no is_generated ===

--error 1054
SELECT column_name, is_generated, generation_expression FROM information_schema.columns WHERE table_name='gct';

DROP TABLE gct;
