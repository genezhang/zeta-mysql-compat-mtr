# Independently authored ORDER BY edge-case smoke test
# for the GPL MTR-format runner. NOT copied or adapted
# from MySQL's mysql-test/t/order_by.test or PG regress;
# complements sort_basic (which covers ASC/DESC, multi-
# col, positional, alias, expression, NULL placement,
# NULLS-FIRST/LAST divergence) by pinning the EDGE
# behavior NOT covered there: ORDER BY a non-SELECTed
# column, CASE WHEN ordering, constant-only ORDER BY,
# subquery ORDER BY propagation, INSERT...SELECT
# ordering, DISTINCT ordering, aggregate ordering,
# UNION-tail ordering, multi-col NULL ordering, and
# out-of-range / COLLATE gaps.
#
# Big-picture finding: zeta handles most ORDER BY edges
# correctly. ORDER BY can reference columns NOT in the
# SELECT list (works against the underlying scan).
# CASE WHEN expressions in ORDER BY work. Multi-col NULL
# ordering follows PG semantics (NULL last in ASC).
# Two notable divergences: (a) out-of-range positional
# ORDER BY (`ORDER BY 99`, `ORDER BY 0`, `ORDER BY -1`)
# is silently ignored — the rows come back in default
# order with no error. PG/MySQL both error here.
# (b) `ORDER BY col COLLATE name` errors 1064 — zeta
# doesn't expose a collate-in-expression surface.
#
# Adaptation notes:
#   # zeta-adapt: ORDER BY column not in SELECT list —
#     works.
#   # zeta-adapt: ORDER BY CASE WHEN — supported.
#   # zeta-adapt: ORDER BY in subquery (derived table) —
#     the inner ORDER BY does propagate to the outer
#     result. SQL standard says it shouldn't, but zeta's
#     planner preserves the inner sort.
#   # zeta-adapt: ORDER BY in INSERT...SELECT — works.
#   # zeta-adapt: ORDER BY DISTINCT — works.
#   # zeta-adapt: ORDER BY aggregate alias + LIMIT
#     (Top-N) — works.
#   # zeta-adapt: Mixed ASC/DESC multi-col — works.
#   # zeta-adapt: ORDER BY at the end of UNION applies
#     to the unified result.
#   # zeta-adapt: Multi-col ORDER BY with NULL keys —
#     NULL sorts last in ASC.
#   # zeta-adapt: KNOWN DIVERGENCE — ORDER BY positional
#     references outside [1..N] (`ORDER BY 99`,
#     `ORDER BY 0`, `ORDER BY -1`) are SILENTLY IGNORED;
#     the rows come back in default order with no error.
#     PG / MySQL both error 'ORDER BY position N is not
#     in select list'.
#   # zeta-adapt: KNOWN GAP — `ORDER BY col COLLATE
#     <name>` errors 1064 "unsupported expression". No
#     collate-in-expression surface; substitute via
#     ORDER BY LOWER(col) / UPPER(col) / explicit
#     transformation.

--echo === Setup ===

DROP TABLE IF EXISTS ot;
CREATE TABLE ot (id INT, name VARCHAR(20));
INSERT INTO ot VALUES (1, 'b'), (2, 'A'), (3, 'c'), (4, 'B');

--echo === ORDER BY column not in SELECT list ===

SELECT name FROM ot ORDER BY id;

--echo === ORDER BY CASE WHEN ===

SELECT id, name FROM ot ORDER BY CASE WHEN id = 2 THEN 0 ELSE 1 END, id;

--echo === ORDER BY constants via UNION (no FROM in branches) ===

SELECT 3 AS x UNION SELECT 1 UNION SELECT 2 ORDER BY x;

--echo === ORDER BY in subquery — propagates to outer (zeta-specific) ===

SELECT id FROM (SELECT id FROM ot ORDER BY id DESC) AS sub;

--echo === ORDER BY in INSERT...SELECT ===

DROP TABLE IF EXISTS ot2;
CREATE TABLE ot2 (id INT);
INSERT INTO ot2 SELECT id FROM ot ORDER BY id;
SELECT id FROM ot2 ORDER BY id;

--echo === ORDER BY DISTINCT ===

SELECT DISTINCT name FROM ot ORDER BY name;

--echo === ORDER BY aggregate alias + LIMIT (Top-N) ===

SELECT id, COUNT(*) AS c FROM ot GROUP BY id ORDER BY c DESC, id LIMIT 2;

--echo === Mixed ASC/DESC multi-col ===

SELECT id, name FROM ot ORDER BY name DESC, id ASC;

--echo === ORDER BY in UNION — applies to whole ===

SELECT id FROM ot WHERE id = 1 UNION SELECT id FROM ot WHERE id = 3 ORDER BY id DESC;

--echo === Multi-col ORDER BY with NULL keys — NULL sorts last (PG style) ===

DROP TABLE IF EXISTS otn;
CREATE TABLE otn (a INT, b INT);
INSERT INTO otn VALUES (1, 100), (NULL, 50), (NULL, NULL), (2, 200);
SELECT a, b FROM otn ORDER BY a, b;

--echo === KNOWN DIVERGENCE: ORDER BY 99 (out-of-range) silently ignored ===

SELECT id, name FROM ot ORDER BY 99;

--echo === KNOWN DIVERGENCE: ORDER BY 0 silently ignored ===

SELECT id, name FROM ot ORDER BY 0;

--echo === KNOWN DIVERGENCE: ORDER BY -1 silently ignored ===

SELECT id, name FROM ot ORDER BY -1;

--echo === KNOWN GAP: ORDER BY col COLLATE name — errno 1064 ===

--error 1064
SELECT name FROM ot ORDER BY name COLLATE utf8mb4_bin;

DROP TABLE ot;
DROP TABLE ot2;
DROP TABLE otn;
