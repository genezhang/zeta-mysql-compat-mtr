# Independently authored string-extra-extra smoke test for the
# GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/func_str.test or func_regexp.test files; pins
# zeta's behavior across MySQL string surface NOT covered by
# string_func_basic (which holds SUBSTRING_INDEX / HEX-UNHEX /
# ELT-FIELD-FIND_IN_SET / SPACE / QUOTE / SOUNDEX / FORMAT /
# LPAD-RPAD / MD5 / UCASE-LCASE-MID / ASCII / TRIM / SHA1-SHA-
# SHA2) or string_func_extra (LOCATE/INSTR/INSERT/SOUNDEX/HEX/
# UNHEX/CHAR_LENGTH/CHARACTER_LENGTH/BIT_LENGTH/OCTET_LENGTH/
# SPACE/QUOTE/FORMAT/ASCII/CHAR/BIN/OCT).
#
# Adaptation notes:
#   # zeta-adapt: POSITION(substr IN str) — SQL-standard
#     spelling of LOCATE. Supported, 1-based, 0 on miss.
#   # zeta-adapt: REGEXP_LIKE(str, pattern) — supported. Returns
#     1/0 instead of true/false through the MySQL wire (boolean
#     bridges as 0/1 byte).
#   # zeta-adapt: REGEXP_INSTR(str, pattern) — supported. 1-based
#     start position of the first match, 0 on miss.
#   # zeta-adapt: ORD(char) — MySQL alt to ASCII for first
#     character; supported.
#   # zeta-adapt: HEX(int) — integer encoding to uppercase hex
#     string. Supported (HEX overloaded: HEX('AB') → string-of-
#     hex-bytes; HEX(255) → 'FF').
#   # zeta-adapt: CONCAT('a', NULL, 'c') — NULL propagates;
#     result is NULL (matches both MySQL and PG semantics).
#     CONCAT_WS('-', 'a', NULL, 'c') skips NULL arguments,
#     produces 'a-c' (MySQL semantics — PG returns 'a--c').
#   # zeta-adapt: CONCAT_WS includes empty-string arguments —
#     CONCAT_WS('-', '', 'a', '') → '-a-' (the separator is
#     placed between every pair of non-NULL args including
#     empties).
#   # zeta-adapt: REGEXP_SUBSTR(str, pattern[, pos]) — FIXED via
#     zeta #1183. Returns the substring of the first regex match
#     (or NULL if none). Same arg shape as REGEXP_INSTR. Extra
#     MySQL args (occurrence, match_type) aren't supported yet.
#   # zeta-adapt: `str REGEXP pattern` (and synonym
#     `str RLIKE pattern`) infix — FIXED via zeta #1189.
#     Both forms convert to a synthetic REGEXP_LIKE(expr,
#     pattern) function call at AST conversion. NOT REGEXP /
#     NOT RLIKE builds as `REGEXP_LIKE(...) = 0` to preserve
#     NULL propagation (REGEXP_LIKE returns Int64 1/0; the
#     `= 0` keeps NULL → NULL via standard comparison 3VL).
#   # zeta-adapt: KNOWN GAP — `CONVERT(str USING <charset>)`
#     errors 1064 "unsupported expression". zeta is UTF-8
#     throughout (no per-column charset). Portable substitute:
#     no-op — strings are already UTF-8.
#   # zeta-adapt: PARTIAL FIX — WEIGHT_STRING(str) now executes
#     but returns input bytes unchanged (no collation weighting).
#     RISK: collation-comparison use cases (sort-key generation
#     for case-insensitive ordering, etc.) will silently produce
#     wrong-order results. Do NOT rely on WEIGHT_STRING for
#     cross-collation ordering until zeta wires collation through.
#   # zeta-adapt: FIXED — COMPRESS(s), UNCOMPRESS(b) (zlib)
#     supported. UNCOMPRESS on invalid bytes returns NULL
#     (MySQL emits a warning; zeta drops it). Pin via round-trip.
#   # zeta-adapt: FIXED — EXPORT_SET(bits, on, off, sep, cnt)
#     supported. Bit-by-bit on/off render with separator,
#     LSB-first; truncated/padded to cnt bits.

--echo === POSITION(substr IN str) — SQL-standard ===

SELECT POSITION('lo' IN 'hello')    AS p;
SELECT POSITION('xx' IN 'hello')    AS p_miss;

--echo === REGEXP_LIKE / REGEXP_INSTR ===

SELECT REGEXP_LIKE('hello world', 'l+')        AS m;
SELECT REGEXP_LIKE('xyz', 'l+')                AS m_miss;
SELECT REGEXP_INSTR('hello world', 'wo')       AS p;
SELECT REGEXP_INSTR('hello world', 'zz')       AS p_miss;

--echo === ORD — first-character codepoint (MySQL alt to ASCII) ===

SELECT ORD('A') AS a;
SELECT ORD('z') AS z;

--echo === HEX(int) — integer encoding ===

SELECT HEX(255)    AS h1;
SELECT HEX(123456) AS h2;

--echo === CONCAT with NULL — NULL propagates ===

SELECT CONCAT('a', NULL, 'c') AS c;

--echo === CONCAT_WS with NULL — silently skipped ===

SELECT CONCAT_WS(',', 'a', NULL, 'c') AS c;

--echo === CONCAT_WS with empty-string args — included ===

SELECT CONCAT_WS('-', '', 'a', '') AS c;

--echo === REGEXP_SUBSTR — FIXED via zeta #1183 ===

SELECT REGEXP_SUBSTR('hello world', 'w[a-z]+') AS r;
SELECT REGEXP_SUBSTR('hello world', 'zz[a-z]+') AS r_miss;

--echo === infix REGEXP / RLIKE — FIXED via zeta #1189 ===

SELECT 'hello' REGEXP 'l+' AS m;
SELECT 'hello' RLIKE 'l+'  AS r;
SELECT 'xyz'   NOT REGEXP 'l+' AS nr;

--echo === KNOWN GAP: CONVERT(str USING charset) — errno 1064 ===

--error 1064
SELECT CONVERT('hello' USING utf8);

--echo === PARTIAL FIX: WEIGHT_STRING executes but skips collation ===
# Returns input bytes unchanged (HEX-rendered for stability).
# RISK: MySQL apps that use WEIGHT_STRING for collation-based
# sort-key generation (e.g. case-insensitive ordering) will
# silently produce wrong-order results. Do NOT rely on
# WEIGHT_STRING for cross-collation ordering on zeta.

SELECT HEX(WEIGHT_STRING('hello')) AS w;

--echo === FIXED: COMPRESS / UNCOMPRESS / UNCOMPRESSED_LENGTH (zlib) ===
# COMPRESS bytes are non-deterministic; pin via round-trip.
# UNCOMPRESS on invalid bytes returns NULL (lenient — MySQL would
# return NULL with a warning; zeta drops the warning).

SELECT UNCOMPRESS(COMPRESS('hello')) AS rt;
SELECT UNCOMPRESS('some-bytes') AS invalid;

--echo === FIXED: EXPORT_SET now supported ===
# EXPORT_SET(bits, on, off, sep, n) — bit-by-bit on/off render.
# 5 = 0b101 → Y,N,Y,N (padded to n=4 bits).

SELECT EXPORT_SET(5, 'Y', 'N', ',', 4) AS e;
