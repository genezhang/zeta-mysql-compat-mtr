=== BUG 1 (SILENT-DROP) — GENERATED ALWAYS AS IDENTITY PRIMARY KEY: CREATE accepts ===
DROP TABLE IF EXISTS t_id_always;
CREATE TABLE t_id_always (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v TEXT);
=== BUG 1 — auto-gen broken: INSERT without id errors NOT NULL (PG would auto-gen id=1) ===
INSERT INTO t_id_always (v) VALUES ('a');
ERROR 1105: execution error: null value in column "id" of relation "test.public.t_id_always" violates not-null constraint
=== BUG 2 (SILENT-DEGRADATION) — explicit INSERT of id SUCCEEDS (PG would error: ALWAYS forbids) ===
INSERT INTO t_id_always (id, v) VALUES (99, 'forbidden');
=== Cross-check: BUG 2 stored the row PG would reject ===
SELECT id, v FROM t_id_always;
id	v
99	forbidden
DROP TABLE t_id_always;
=== BUG 1 again — GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY: CREATE accepts ===
DROP TABLE IF EXISTS t_id_default;
CREATE TABLE t_id_default (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, v TEXT);
=== BUG 1 — auto-gen broken: INSERT without id errors NOT NULL (PG would auto-gen id=1) ===
INSERT INTO t_id_default (v) VALUES ('b');
ERROR 1105: execution error: null value in column "id" of relation "test.public.t_id_default" violates not-null constraint
=== BY DEFAULT — explicit INSERT of id SUCCEEDS (PG also allows; no degradation here) ===
INSERT INTO t_id_default (id, v) VALUES (77, 'manual');
SELECT id, v FROM t_id_default;
id	v
77	manual
DROP TABLE t_id_default;
=== PARSE-REJECT 1 — OVERRIDING SYSTEM / USER VALUE (PG-standard ALWAYS bypass) ===
DROP TABLE IF EXISTS t_ov;
CREATE TABLE t_ov (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v TEXT);
INSERT INTO t_ov (id, v) OVERRIDING SYSTEM VALUE VALUES (1, 'x');
ERROR 1064: SQL parse error: sql parser error: Expected: SELECT, VALUES, or a subquery in the query body, found: OVERRIDING at Line: 1, Column: 26
INSERT INTO t_ov (id, v) OVERRIDING USER VALUE VALUES (2, 'y');
ERROR 1064: SQL parse error: sql parser error: Expected: SELECT, VALUES, or a subquery in the query body, found: OVERRIDING at Line: 1, Column: 26
DROP TABLE t_ov;
=== PARSE-REJECT 2 — IDENTITY multi-option sub-grammar (combined forms) ===
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (START 100 INCREMENT 10) PRIMARY KEY, v TEXT);
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: INCREMENT at Line: 1, Column: 69
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (START WITH 100 INCREMENT BY 10) PRIMARY KEY, v TEXT);
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: INCREMENT at Line: 1, Column: 74
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (CACHE 10 START 5) PRIMARY KEY, v TEXT);
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: START at Line: 1, Column: 68
=== PARSE-REJECT 2 (cont.) — OWNED BY inside IDENTITY paren group ===
CREATE TABLE t_opts (id INT GENERATED ALWAYS AS IDENTITY (OWNED BY x.y) PRIMARY KEY, v TEXT);
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: OWNED at Line: 1, Column: 59
=== SUPPORT PIN — single-option IDENTITY paren parses, but BUG 1 still drops the option ===
DROP TABLE IF EXISTS t_single;
CREATE TABLE t_single (id INT GENERATED ALWAYS AS IDENTITY (START 50) PRIMARY KEY, v TEXT);
# PG would auto-gen id=50 here; zeta still errors NOT NULL — START is silently dropped too:
INSERT INTO t_single (v) VALUES ('s');
ERROR 1105: execution error: null value in column "id" of relation "test.public.t_single" violates not-null constraint
DROP TABLE t_single;
