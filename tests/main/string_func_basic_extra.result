=== POSITION(substr IN str) — SQL-standard ===
SELECT POSITION('lo' IN 'hello')    AS p;
p
4
SELECT POSITION('xx' IN 'hello')    AS p_miss;
p_miss
0
=== REGEXP_LIKE / REGEXP_INSTR ===
SELECT REGEXP_LIKE('hello world', 'l+')        AS m;
m
1
SELECT REGEXP_LIKE('xyz', 'l+')                AS m_miss;
m_miss
0
SELECT REGEXP_INSTR('hello world', 'wo')       AS p;
p
7
SELECT REGEXP_INSTR('hello world', 'zz')       AS p_miss;
p_miss
0
=== ORD — first-character codepoint (MySQL alt to ASCII) ===
SELECT ORD('A') AS a;
a
65
SELECT ORD('z') AS z;
z
122
=== HEX(int) — integer encoding ===
SELECT HEX(255)    AS h1;
h1
FF
SELECT HEX(123456) AS h2;
h2
1E240
=== CONCAT with NULL — NULL propagates ===
SELECT CONCAT('a', NULL, 'c') AS c;
c
NULL
=== CONCAT_WS with NULL — silently skipped ===
SELECT CONCAT_WS(',', 'a', NULL, 'c') AS c;
c
a,c
=== CONCAT_WS with empty-string args — included ===
SELECT CONCAT_WS('-', '', 'a', '') AS c;
c
-a-
=== REGEXP_SUBSTR — FIXED via zeta #1183 ===
SELECT REGEXP_SUBSTR('hello world', 'w[a-z]+') AS r;
r
world
SELECT REGEXP_SUBSTR('hello world', 'zz[a-z]+') AS r_miss;
r_miss
NULL
=== infix REGEXP / RLIKE — FIXED via zeta #1189 ===
SELECT 'hello' REGEXP 'l+' AS m;
m
1
SELECT 'hello' RLIKE 'l+'  AS r;
r
1
SELECT 'xyz'   NOT REGEXP 'l+' AS nr;
nr
1
=== KNOWN GAP: CONVERT(str USING charset) — errno 1064 ===
SELECT CONVERT('hello' USING utf8);
ERROR 1064: SQL parse error: unsupported expression: CONVERT('hello' USING utf8)
=== PARTIAL FIX: WEIGHT_STRING executes but skips collation ===
SELECT HEX(WEIGHT_STRING('hello')) AS w;
w
68656C6C6F
=== FIXED: COMPRESS / UNCOMPRESS / UNCOMPRESSED_LENGTH (zlib) ===
SELECT UNCOMPRESS(COMPRESS('hello')) AS rt;
rt
hello
SELECT UNCOMPRESS('some-bytes') AS invalid;
invalid
NULL
=== FIXED: EXPORT_SET now supported ===
SELECT EXPORT_SET(5, 'Y', 'N', ',', 4) AS e;
e
Y,N,Y,N
