# Independently authored BYTEA/BLOB smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/type_binary.test or type_blob.test; pins
# zeta's binary-data surface (no prior compat coverage).
#
# Adaptation notes:
#   # zeta-adapt: BYTEA column type (PG) — supported.
#   # zeta-adapt: BLOB column type (MySQL alias) — supported.
#   # zeta-adapt: TINYBLOB / MEDIUMBLOB / LONGBLOB (MySQL
#     blob-size aliases) — all supported (no length
#     enforcement: all map to the same underlying type).
#   # zeta-adapt: Hex literal `'\xDEADBEEF'` — supported as
#     the standard PG bytea hex-escape.
#   # zeta-adapt: E-string literal `E'\\x00'` — supported.
#   # zeta-adapt: BYTEA equality and ORDER BY — supported.
#     Ordering is lexicographic over the escape-encoded
#     string form (NOT raw bytes).
#   # zeta-adapt: BYTEA `||` concatenation — supported.
#   # zeta-adapt: BYTEA SUBSTRING — supported, but operates
#     on the ESCAPE-ENCODED string form, not raw bytes (see
#     divergence below).
#   # zeta-adapt: KNOWN DIVERGENCE — BYTEA values are
#     internally represented and rendered as their PG-escape
#     STRING form (`\xDEADBEEF`, 10 chars), and SQL string
#     operators (LENGTH, OCTET_LENGTH, SUBSTRING) operate on
#     that escaped string instead of the raw 4-byte payload.
#     `LENGTH('\xDEADBEEF'::bytea_col)` returns 10, not 4.
#     `SUBSTRING(... FROM 2 FOR 2)` extracts chars 2-3 of the
#     escape string, returning `'xD'`, not bytes 2-3. PG and
#     MySQL return byte counts / byte ranges from the raw
#     payload.
#   # zeta-adapt: KNOWN GAP — `::BYTEA` cast (PG ::-style)
#     errors 1105 "unsupported CAST target type: BYTEA".
#     `CAST(x AS BYTEA)` likewise errors. BYTEA values can
#     only flow in via column INSERT or string literal.
#   # zeta-adapt: KNOWN GAP — ENCODE(bytea, 'hex'|'base64')
#     errors 1105 "unknown function: ENCODE". To get
#     hex/base64 textual form, use the default display
#     form (\xHEX) and strip the leading '\\x'.
#   # zeta-adapt: KNOWN GAP — DECODE('hex', 'hex'|'base64')
#     errors 1105 "unknown function: DECODE". Substitute:
#     write the bytea hex-escape literal directly,
#     `'\xDEADBEEF'`.
#   # zeta-adapt: KNOWN GAP — GET_BYTE / SET_BYTE error 1105
#     "unknown function".
#   # zeta-adapt: KNOWN GAP — MySQL VARBINARY(n) and
#     BINARY(n) column types error 1064 "unsupported data
#     type". Substitute: BYTEA (no length parameter).

--echo === BYTEA column + hex literal ===

DROP TABLE IF EXISTS b1;
CREATE TABLE b1 (id INT PRIMARY KEY, data BYTEA);
INSERT INTO b1 VALUES (1, '\xDEADBEEF'), (2, '\x00FF');
SELECT id, data FROM b1 ORDER BY id;

--echo === LENGTH / OCTET_LENGTH (see divergence: counts escape-string chars) ===

SELECT id, LENGTH(data) AS l, OCTET_LENGTH(data) AS o FROM b1 ORDER BY id;

--echo === Equality and ORDER BY ===

SELECT id FROM b1 WHERE data = '\xDEADBEEF';
SELECT id, data FROM b1 ORDER BY data, id;

--echo === || concatenation ===

SELECT '\xAB' || '\xCD' AS r;

--echo === SUBSTRING — operates on escape-encoded chars (divergence) ===
--echo # `\xDEADBEEF` is 10 chars: `\`,`x`,`D`,`E`,`A`,`D`,`B`,`E`,`E`,`F`.
--echo # FROM 2 FOR 2 extracts chars 2-3 → 'xD'.

SELECT SUBSTRING(data FROM 2 FOR 2) AS r FROM b1 WHERE id = 1;
DROP TABLE b1;

--echo === BLOB (MySQL alias for BYTEA) ===

DROP TABLE IF EXISTS bl;
CREATE TABLE bl (id INT PRIMARY KEY, data BLOB);
INSERT INTO bl VALUES (1, '\xCAFEBABE');
SELECT id, data FROM bl;
DROP TABLE bl;

--echo === TINYBLOB / MEDIUMBLOB / LONGBLOB — all accepted ===

DROP TABLE IF EXISTS tb;
CREATE TABLE tb (id INT PRIMARY KEY, t TINYBLOB);
INSERT INTO tb VALUES (1, '\xAA');
SELECT id, t FROM tb;
DROP TABLE tb;

DROP TABLE IF EXISTS mb;
CREATE TABLE mb (id INT PRIMARY KEY, t MEDIUMBLOB);
INSERT INTO mb VALUES (1, '\xBB');
SELECT id, t FROM mb;
DROP TABLE mb;

DROP TABLE IF EXISTS lb;
CREATE TABLE lb (id INT PRIMARY KEY, t LONGBLOB);
INSERT INTO lb VALUES (1, '\xCC');
SELECT id, t FROM lb;
DROP TABLE lb;

--echo === E-string literal E'\\x00' ===

DROP TABLE IF EXISTS be;
CREATE TABLE be (id INT PRIMARY KEY, data BYTEA);
INSERT INTO be VALUES (1, E'\\x00');
SELECT id, data FROM be;
DROP TABLE be;

--echo === KNOWN GAP: ::BYTEA cast — errno 1105 ===

--error 1105
SELECT '\xAB'::BYTEA AS r;

--echo === KNOWN GAP: CAST(x AS BYTEA) — errno 1105 ===

--error 1105
SELECT CAST('\xAB' AS BYTEA) AS r;

--echo === KNOWN GAP: ENCODE — errno 1105 ===
--echo # The default BYTEA display is already `\xHEX`;
--echo # strip the leading `\\x` for the hex string.

--error 1105
SELECT ENCODE('\xDEADBEEF', 'hex') AS r;

--echo === KNOWN GAP: DECODE — errno 1105 ===
--echo # Substitute: write the `\xHEX` literal directly.

--error 1105
SELECT DECODE('deadbeef', 'hex') AS r;

--echo === KNOWN GAP: GET_BYTE — errno 1105 ===

DROP TABLE IF EXISTS gb;
CREATE TABLE gb (id INT PRIMARY KEY, data BYTEA);
INSERT INTO gb VALUES (1, '\xDEADBEEF');
--error 1105
SELECT GET_BYTE(data, 0) AS r FROM gb;
DROP TABLE gb;

--echo === KNOWN GAP: VARBINARY(n) column type — errno 1064 ===
--echo # Substitute: BYTEA (no length parameter).

--error 1064
CREATE TABLE vb_gap (id INT PRIMARY KEY, data VARBINARY(16));

--echo === KNOWN GAP: BINARY(n) column type — errno 1064 ===

--error 1064
CREATE TABLE bi_gap (id INT PRIMARY KEY, data BINARY(4));
