=== SHAPE A === ON UPDATE action variants — silent-accept
CREATE TABLE pro_c1 (pid INT REFERENCES pro_p(id) ON UPDATE SET NULL);
CREATE TABLE pro_c2 (pid INT REFERENCES pro_p(id) ON UPDATE SET DEFAULT);
CREATE TABLE pro_c3 (pid INT REFERENCES pro_p(id) ON UPDATE RESTRICT);
CREATE TABLE pro_c4 (pid INT REFERENCES pro_p(id) ON UPDATE NO ACTION);
=== SHAPE B === Combined ON DELETE + ON UPDATE — silent-accept
CREATE TABLE pro_c5 (pid INT REFERENCES pro_p(id)
  ON DELETE CASCADE ON UPDATE CASCADE);
=== SHAPE C === DEFERRABLE qualifier variants — silent-accept
CREATE TABLE pro_c6 (pid INT REFERENCES pro_p(id) DEFERRABLE);
CREATE TABLE pro_c7 (pid INT REFERENCES pro_p(id) NOT DEFERRABLE);
CREATE TABLE pro_c8 (pid INT REFERENCES pro_p(id)
  DEFERRABLE INITIALLY IMMEDIATE);
=== SHAPE D === Combined MATCH FULL + DEFERRABLE INITIALLY DEFERRED — silent-accept
CREATE TABLE pro_c9 (pid INT REFERENCES pro_p(id)
  MATCH FULL DEFERRABLE INITIALLY DEFERRED);
=== SHAPE E === PG15+ column-list for SET NULL / SET DEFAULT — sqlparser reject
CREATE TABLE pro_c10 (pid INT REFERENCES pro_p(id) ON DELETE SET NULL (pid));
