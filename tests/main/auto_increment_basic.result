=== Setup ===
DROP TABLE IF EXISTS ai1;
CREATE TABLE ai1 (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(20));
=== Implicit AUTO_INCREMENT — sequential 1, 2 ===
# LAST_INSERT_ID() after a multi-row INSERT returns the FIRST
# generated value (1) — zeta #1121 FIXED. Matches MySQL.
INSERT INTO ai1 (name) VALUES ('alice'), ('bob');
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
1
SELECT id, name FROM ai1;
id	name
1	alice
2	bob
=== NULL explicit value — triggers auto-assign ===
DROP TABLE IF EXISTS ai2;
CREATE TABLE ai2 (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(20));
INSERT INTO ai2 (id, name) VALUES (NULL, 'null-id');
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
1
SELECT id, name FROM ai2;
id	name
1	null-id
=== 0 explicit value — triggers auto-assign ===
INSERT INTO ai2 (id, name) VALUES (0, 'zero-id');
SELECT id, name FROM ai2;
id	name
1	null-id
2	zero-id
=== Explicit jump value + subsequent implicit (zeta #1123 FIXED) ===
# Explicit id=100 advances the sequence past 100; the next
# implicit insert correctly gets id=101 (matches MySQL).
INSERT INTO ai1 (id, name) VALUES (100, 'jump');
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
2
INSERT INTO ai1 (name) VALUES ('next');
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
101
SELECT id, name FROM ai1 ORDER BY id;
id	name
1	alice
2	bob
100	jump
101	next
=== Cleanup ===
DROP TABLE ai1;
DROP TABLE ai2;
