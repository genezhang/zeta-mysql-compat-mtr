SELECT CURRENT_CATALOG                                        AS current_catalog_kw;
ERROR 1054: Unknown column 'CURRENT_CATALOG' in 'field list'
=== STRIKING BUG: shim prefix-match drops trailing expression + alias ===
SELECT DATABASE() = 'zeta'                                    AS this_alias_dropped;
this_alias_dropped
0
SELECT SCHEMA()   = 'zeta'                                    AS this_alias_dropped_too;
this_alias_dropped_too
0
SELECT DATABASE() <> 'somethingelse'                          AS this_alias_dropped_3;
this_alias_dropped_3
1
=== Workaround: embed DATABASE() in CONCAT to bypass shim intercept ===
SELECT CONCAT('', DATABASE())                                 AS via_concat_returns_zeta;
via_concat_returns_zeta
test
SELECT CONCAT('', DATABASE()) = 'zeta'                        AS concat_eq_zeta_via_runtime;
concat_eq_zeta_via_runtime
0
=== CURRENT_DATABASE() / CURRENT_CATALOG go through runtime, not shim ===
SELECT CURRENT_DATABASE() = 'zeta'                            AS current_db_is_zeta_runtime;
ERROR 1305: FUNCTION test.CURRENT_DATABASE does not exist
SELECT CURRENT_DATABASE() = CURRENT_CATALOG                   AS current_db_eq_catalog;
ERROR 1305: FUNCTION test.CURRENT_DATABASE does not exist
