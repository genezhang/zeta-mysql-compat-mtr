=== DB-flavor bare forms — DATABASE()/SCHEMA() return session db ===
SELECT DATABASE()                                             AS db_returns_session;
db_returns_session
test
SELECT SCHEMA()                                               AS schema_returns_session;
schema_returns_session
test
SELECT CURRENT_DATABASE()                                     AS current_db_paren;
