# Independently authored CASE-expression smoke test for the
# GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/case.test or func_case.test; pins zeta's CASE
# expression surface (no prior compat coverage for CASE).
#
# Adaptation notes:
#   # zeta-adapt: Simple CASE — `CASE expr WHEN v1 THEN r1 …
#     ELSE r END` supported.
#   # zeta-adapt: Searched CASE — `CASE WHEN cond THEN r1 …
#     ELSE r END` supported.
#   # zeta-adapt: CASE in SELECT projection — supported.
#   # zeta-adapt: CASE in WHERE — supported.
#   # zeta-adapt: CASE in ORDER BY — supported.
#   # zeta-adapt: CASE in GROUP BY — supported. The same
#     CASE expression must appear in both the SELECT list
#     and the GROUP BY clause to be groupable.
#   # zeta-adapt: Nested CASE — supported (CASE in THEN/ELSE
#     branch of another CASE).
#   # zeta-adapt: CASE with explicit `ELSE NULL` — supported.
#   # zeta-adapt: CASE without an ELSE clause — supported;
#     unmatched rows return NULL (SQL standard).
#   # zeta-adapt: Arithmetic and NULL handling inside CASE
#     branches — supported.
#   # zeta-adapt: SUM(CASE WHEN cond THEN 1 ELSE 0 END)
#     conditional aggregation — supported.
#   # zeta-adapt: Simple CASE NULL semantics — `CASE n WHEN
#     NULL THEN …` does NOT match rows where n IS NULL (SQL
#     spec: equality to NULL is unknown). Match via the
#     searched form `CASE WHEN n IS NULL THEN …`.
#   # zeta-adapt: KNOWN BUG — `CASE WHEN <aggregate(...)>
#     <op> <const> THEN x ELSE y END` (e.g. `CASE WHEN
#     COUNT(*) >= 1 THEN 1 ELSE 0 END`) unconditionally
#     returns the ELSE branch over the MySQL wire. Aggregates
#     referenced inside CASE WHEN conditions appear to
#     evaluate to a sentinel/0 rather than the aggregated
#     value. Portable substitute: pre-compute the aggregate
#     in a derived table and reference the column, e.g.
#     `SELECT CASE WHEN c >= 1 THEN 1 ELSE 0 END FROM
#     (SELECT COUNT(*) c FROM t) sub`. Inverting the form to
#     `SUM(CASE WHEN cond THEN 1 ELSE 0 END)` also works
#     because the aggregate is on the outside of the CASE.
#   # zeta-adapt: KNOWN BUG — HAVING with a CASE that
#     references an aggregate yields no rows for the same
#     reason (the CASE always evaluates to its ELSE branch,
#     so the predicate is never satisfied). Use the
#     aggregate directly in HAVING (e.g. `HAVING COUNT(*)
#     >= 1`) instead.

--echo === Setup ===

DROP TABLE IF EXISTS ce;
CREATE TABLE ce (id INT PRIMARY KEY, n INT, s TEXT);
INSERT INTO ce VALUES (1, 10, 'a'), (2, 20, 'b'), (3, NULL, 'c');

--echo === Simple CASE: CASE expr WHEN v THEN r ... END ===

SELECT id, CASE n WHEN 10 THEN 'ten' WHEN 20 THEN 'twenty' ELSE 'other' END AS w FROM ce ORDER BY id;

--echo === Searched CASE: CASE WHEN cond THEN r ... END ===

SELECT id, CASE WHEN n IS NULL THEN 'null' WHEN n < 15 THEN 'small' ELSE 'big' END AS w FROM ce ORDER BY id;

--echo === CASE in WHERE clause ===

SELECT id FROM ce WHERE CASE WHEN n IS NULL THEN 0 ELSE n END > 10 ORDER BY id;

--echo === CASE in ORDER BY (NULLs last) ===

SELECT id, n FROM ce ORDER BY CASE WHEN n IS NULL THEN 1 ELSE 0 END, n;

--echo === CASE in GROUP BY ===

SELECT CASE WHEN n IS NULL THEN 'null' ELSE 'val' END AS grp, COUNT(*) AS c
  FROM ce
  GROUP BY CASE WHEN n IS NULL THEN 'null' ELSE 'val' END
  ORDER BY grp;

--echo === Nested CASE (CASE inside THEN of another CASE) ===

SELECT id,
       CASE WHEN n IS NOT NULL
            THEN CASE WHEN n > 15 THEN 'big' ELSE 'small' END
            ELSE 'null' END AS w
  FROM ce ORDER BY id;

--echo === CASE with explicit ELSE NULL ===

SELECT id, CASE WHEN n = 10 THEN 'ten' ELSE NULL END AS w FROM ce ORDER BY id;

--echo === CASE without ELSE (unmatched -> NULL) ===

SELECT id, CASE WHEN n = 10 THEN 'ten' END AS w FROM ce ORDER BY id;

--echo === Arithmetic inside CASE branches ===

SELECT id, CASE WHEN n IS NULL THEN 0 ELSE n * 2 END AS d FROM ce ORDER BY id;

--echo === SUM(CASE WHEN cond THEN 1 ELSE 0 END) — conditional aggregation ===

SELECT SUM(CASE WHEN n > 10 THEN 1 ELSE 0 END) AS big FROM ce;

--echo === Simple CASE NULL semantics — WHEN NULL does NOT match n IS NULL ===
--echo # SQL spec: equality to NULL is "unknown", so the
--echo # WHEN NULL branch is never taken. Row 3 (n IS NULL)
--echo # falls into ELSE.

SELECT id, CASE n WHEN NULL THEN 'nl' WHEN 10 THEN 'ten' ELSE 'oth' END AS w FROM ce ORDER BY id;

--echo === KNOWN BUG: CASE WHEN <aggregate> ... END returns ELSE ===
--echo # `CASE WHEN COUNT(*) >= 1 THEN 1 ELSE 0 END` should
--echo # return 1 but returns 0 over the MySQL wire — the
--echo # aggregate inside the WHEN condition does not see
--echo # the aggregated value. Workaround: SUM(CASE WHEN cond
--echo # THEN 1 ELSE 0 END), or pre-compute via subquery.

SELECT COUNT(*) AS cnt, CASE WHEN COUNT(*) >= 1 THEN 1 ELSE 0 END AS buggy_case FROM ce;

--echo === KNOWN BUG: HAVING CASE WHEN <aggregate> ... yields no rows ===
--echo # Same root cause as above: the HAVING predicate
--echo # always evaluates to the ELSE branch, so no group
--echo # qualifies. Use the aggregate directly in HAVING.

SELECT s, COUNT(*) AS c FROM ce GROUP BY s HAVING CASE WHEN COUNT(*) >= 1 THEN 1 ELSE 0 END = 1 ORDER BY s;

--echo === Cleanup ===

DROP TABLE ce;
