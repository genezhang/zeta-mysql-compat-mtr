# Independently authored COALESCE / NULLIF / IFNULL / NVL
# edge smoke test for the GPL MTR-format runner. NOT
# copied or adapted from MySQL's mysql-test/t/func_if.test
# or PG regress; complements null_handling_basic_extra
# (which pins COALESCE / NULLIF / IFNULL / ISNULL basics)
# by pinning the EDGE behavior NOT covered there:
# all-NULL inputs, single-arg / zero-arg, mixed-type
# coercion, short-circuit evaluation, type coercion in
# NULLIF comparisons, IFNULL arity errors, NVL alias, and
# the NVL2 gap.
#
# Big-picture finding: zeta handles the standard
# COALESCE/NULLIF/IFNULL/NVL surface correctly. COALESCE
# short-circuits (later args aren't evaluated once a
# non-NULL is found, so a divide-by-zero or bad-cast
# expression in a tail arg doesn't error). NULLIF type
# coercion follows the same equality rules used elsewhere
# — Int / Decimal compare equal, but Int / String do not.
# Zero-arg COALESCE returns NULL (lenient — PG errors at
# parse).
#
# Adaptation notes:
#   # zeta-adapt: COALESCE all-NULL → NULL.
#   # zeta-adapt: COALESCE single-arg accepted (returns
#     the arg).
#   # zeta-adapt: COALESCE() with zero args returns NULL
#     (lenient extension; PG / MySQL both error).
#   # zeta-adapt: COALESCE mixed types — picks the first
#     non-NULL regardless of subsequent argument types.
#   # zeta-adapt: COALESCE short-circuits — `COALESCE(1,
#     10/0)` returns 1 without evaluating the divide.
#   # zeta-adapt: NULLIF type coercion — Int/Decimal
#     compare equal (`NULLIF(1, 1.0)` = NULL); Int/String
#     do NOT (`NULLIF(1, '1')` = 1, `NULLIF('1', 1)` =
#     '1').
#   # zeta-adapt: NULLIF with NULL — `NULLIF(NULL, x)` →
#     NULL; `NULLIF(x, NULL)` → x; `NULLIF(NULL, NULL)`
#     → NULL.
#   # zeta-adapt: IFNULL arity is fixed at 2; 1-arg or
#     3+-arg errors 1105.
#   # zeta-adapt: ISNULL — 1-arg boolean wrapper around
#     `IS NULL`.
#   # zeta-adapt: NVL — Oracle 2-arg alias, equivalent
#     to IFNULL / COALESCE-2.
#   # zeta-adapt: KNOWN GAP — NVL2 (Oracle 3-arg) errors
#     1105 \"unknown function: NVL2\". MySQL doesn't have
#     it either; substitute via CASE WHEN x IS NOT NULL
#     THEN a ELSE b END.

--echo === COALESCE all-NULL → NULL ===

SELECT COALESCE(NULL, NULL, NULL) AS all_null;

--echo === COALESCE single-arg ===

SELECT COALESCE(NULL) AS single_null, COALESCE('a') AS single_set;

--echo === COALESCE zero-arg — lenient NULL (PG / MySQL would error) ===

SELECT COALESCE() AS empty;

--echo === COALESCE mixed types — first non-NULL ===

SELECT COALESCE(NULL, 1, 'a') AS pick_int, COALESCE(NULL, 'a', 1) AS pick_str;

--echo === COALESCE short-circuits — bad-cast tail arg not evaluated ===

SELECT COALESCE(1, 10/0) AS short_div, COALESCE('result', CAST('not-a-date' AS DATE)) AS short_cast;

--echo === NULLIF type coercion — Int/Decimal equal, Int/String not ===

SELECT NULLIF(1, 1.0) AS int_dec_eq, NULLIF(1, '1') AS int_str_keep, NULLIF('1', 1) AS str_int_keep;

--echo === NULLIF with NULL — lhs-NULL, rhs-NULL, both-NULL ===

SELECT NULLIF(NULL, 1) AS lhs_null, NULLIF(1, NULL) AS rhs_null, NULLIF(NULL, NULL) AS both_null;

--echo === IFNULL arity — exactly 2 args ===

SELECT IFNULL(NULL, 'fb') AS use_fb, IFNULL('val', 'fb') AS keep_val, IFNULL(NULL, NULL) AS both_null;

--echo === IFNULL 3-arg — errno 1105 ===

--error 1105
SELECT IFNULL(NULL, NULL, 'three');

--echo === ISNULL — 1-arg boolean wrapper around IS NULL ===

SELECT ISNULL(NULL) AS n1, ISNULL('a') AS n2;

--echo === NVL — Oracle 2-arg alias ===

SELECT NVL(NULL, 'fb') AS n_null, NVL('a', 'fb') AS n_keep;

--echo === KNOWN GAP: NVL2 — errno 1105 "unknown function" ===

--error 1105
SELECT NVL2('a', 'first', 'second');

--echo === COALESCE on table column — fallback for NULL rows ===

DROP TABLE IF EXISTS c;
CREATE TABLE c (id INT, v INT);
INSERT INTO c VALUES (1,10), (2,NULL), (3,30), (4,NULL);
SELECT id, COALESCE(v, -1) AS def FROM c ORDER BY id;

--echo === COALESCE in WHERE — predicate on coalesced value ===

SELECT id FROM c WHERE COALESCE(v, 0) > 15 ORDER BY id;

--echo === COALESCE around aggregate — NULL → fallback ===

SELECT SUM(COALESCE(v, 0)) AS s_with_zero FROM c;

DROP TABLE c;
