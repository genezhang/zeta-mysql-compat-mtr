# Independently authored DELETE-extra smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/delete.test or delete_multi.test; pins zeta's
# DELETE surface NOT held by delete_basic (which covers
# single/multi WHERE + WHERE IN subquery + multi-table JOIN
# form + LIMIT-gap + ORDER BY-gap + no-WHERE).
#
# Adaptation notes:
#   # zeta-adapt: DELETE FROM <t> USING <other> WHERE … (PG
#     cross-table form) — supported.
#   # zeta-adapt: DELETE FROM <t> WHERE EXISTS (correlated
#     subquery) — supported.
#   # zeta-adapt: DELETE … RETURNING (PG) — see KNOWN
#     DIVERGENCE below: the DELETE applies but the MySQL
#     wire path silently drops the RETURNING rowset.
#   # zeta-adapt: TRUNCATE TABLE — supported.
#   # zeta-adapt: TRUNCATE TABLE … RESTART IDENTITY — supported.
#     The auto-increment counter resets to 1.
#   # zeta-adapt: DELETE FROM <t> AS <alias> WHERE alias.col …
#     — supported (table alias in DELETE).
#   # zeta-adapt: KNOWN GAP — WITH … DELETE … in a CTE (PG
#     data-modifying CTE) errors 1064 "unsupported query form
#     (only SELECT supported)". Portable substitute: run the
#     DELETE outside the WITH, capturing the deleted ids in
#     a temporary table.
#   # zeta-adapt: TRUNCATE TABLE … CASCADE — supported. The
#     parent's child tables are emptied transitively.
#   # zeta-adapt: KNOWN DIVERGENCE — DELETE … RETURNING (PG)
#     is accepted at parse and the DELETE applies, but the
#     MySQL wire path silently drops the RETURNING rowset.
#     Same as UPDATE RETURNING. Through PG wire / psql,
#     RETURNING works correctly.

--echo === Setup ===

DROP TABLE IF EXISTS dt; DROP TABLE IF EXISTS dx;
CREATE TABLE dt (id INT PRIMARY KEY, n INT);
CREATE TABLE dx (rid INT);
INSERT INTO dt VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO dx VALUES (1), (3);

--echo === DELETE FROM <t> USING <other> (PG cross-table) ===

DELETE FROM dt USING dx WHERE dt.id = dx.rid;
SELECT id, n FROM dt ORDER BY id;

--echo === DELETE WHERE EXISTS (correlated subquery) ===

DROP TABLE IF EXISTS de1; DROP TABLE IF EXISTS dex;
CREATE TABLE de1 (id INT PRIMARY KEY, n INT);
CREATE TABLE dex (rid INT);
INSERT INTO de1 VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO dex VALUES (1), (3);
DELETE FROM de1 WHERE EXISTS (SELECT 1 FROM dex WHERE rid = de1.id);
SELECT id, n FROM de1 ORDER BY id;

--echo === DELETE ... RETURNING (PG) — accepted, no wire-side rows ===
--echo # Same divergence as UPDATE RETURNING: the underlying
--echo # DELETE applies, but the MySQL wire path silently
--echo # drops the RETURNING rowset. Through PG wire / psql,
--echo # RETURNING works as expected. Verified via the
--echo # follow-up SELECT showing the post-delete state.

DROP TABLE IF EXISTS dr;
CREATE TABLE dr (id INT PRIMARY KEY, n INT);
INSERT INTO dr VALUES (1, 10), (2, 20);
DELETE FROM dr WHERE id = 1 RETURNING id, n;
SELECT id, n FROM dr;

--echo === TRUNCATE TABLE ===

DROP TABLE IF EXISTS tr;
CREATE TABLE tr (id INT PRIMARY KEY);
INSERT INTO tr VALUES (1), (2);
TRUNCATE TABLE tr;
SELECT COUNT(*) AS c FROM tr;

--echo === TRUNCATE TABLE ... RESTART IDENTITY ===

DROP TABLE IF EXISTS tri;
CREATE TABLE tri (id SERIAL PRIMARY KEY, name VARCHAR(10));
INSERT INTO tri (name) VALUES ('a'), ('b');
TRUNCATE TABLE tri RESTART IDENTITY;
INSERT INTO tri (name) VALUES ('c');
SELECT id, name FROM tri;

--echo === DELETE FROM <t> AS <alias> ===

DROP TABLE IF EXISTS da;
CREATE TABLE da (id INT PRIMARY KEY, n INT);
INSERT INTO da VALUES (1, 10), (2, 20);
DELETE FROM da AS a WHERE a.id = 1;
SELECT id, n FROM da;

--echo === KNOWN GAP: WITH ... DELETE in CTE — errno 1064 ===

DROP TABLE IF EXISTS dctp; DROP TABLE IF EXISTS dctc;
CREATE TABLE dctp (id INT PRIMARY KEY);
CREATE TABLE dctc (id INT PRIMARY KEY, pid INT);
INSERT INTO dctp VALUES (1), (2);
INSERT INTO dctc VALUES (10, 1), (20, 1), (30, 2);
--error 1064
WITH del AS (DELETE FROM dctp WHERE id = 1 RETURNING id)
DELETE FROM dctc WHERE pid IN (SELECT id FROM del);

--echo === TRUNCATE TABLE … CASCADE — empties parent + child ===

DROP TABLE IF EXISTS tcc; DROP TABLE IF EXISTS tcp;
CREATE TABLE tcp (id INT PRIMARY KEY);
CREATE TABLE tcc (id INT PRIMARY KEY, pid INT, FOREIGN KEY (pid) REFERENCES tcp(id));
INSERT INTO tcp VALUES (1);
INSERT INTO tcc VALUES (10, 1);
TRUNCATE TABLE tcp CASCADE;
SELECT COUNT(*) AS p_count FROM tcp;
SELECT COUNT(*) AS c_count FROM tcc;

--echo === Cleanup ===

DROP TABLE dt; DROP TABLE dx;
DROP TABLE de1; DROP TABLE dex;
DROP TABLE dr;
DROP TABLE tr;
DROP TABLE tri;
DROP TABLE da;
DROP TABLE dctc; DROP TABLE dctp;
DROP TABLE tcc; DROP TABLE tcp;
