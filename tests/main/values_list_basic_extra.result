=== Standalone VALUES — single row, single col ===
VALUES (42);
column1
42
=== Standalone VALUES — multi-row, multi-col ===
VALUES (1, 'a'), (2, 'b'), (3, 'c');
column1	column2
1	a
2	b
3	c
=== VALUES with NULL — NULL accepted in any cell ===
VALUES (1, NULL), (NULL, 'a');
column1	column2
1	NULL
NULL	a
=== VALUES + ORDER BY ===
VALUES (3), (1), (2) ORDER BY column1;
column1
1
2
3
=== VALUES + LIMIT / OFFSET — ORDER BY for deterministic output ===
VALUES (1), (2), (3), (4), (5) ORDER BY column1 LIMIT 2 OFFSET 1;
column1
2
3
=== VALUES UNION (dedup) — ORDER BY for deterministic output ===
SELECT * FROM (VALUES (1), (2)) AS a UNION SELECT * FROM (VALUES (2), (3)) AS b ORDER BY column1;
column1
1
2
3
=== VALUES UNION ALL — duplicates preserved; ORDER BY for deterministic output ===
SELECT * FROM (VALUES (1)) AS a UNION ALL SELECT * FROM (VALUES (1)) AS b ORDER BY column1;
column1
1
1
=== VALUES as derived table with column aliases ===
SELECT * FROM (VALUES (1, 'a'), (2, 'b')) AS t(id, name) WHERE id > 1;
id	name
2	b
=== VALUES as derived table without aliases — default `column1` ===
SELECT * FROM (VALUES (1), (2)) ORDER BY column1;
column1
1
2
=== VALUES in IN — row-set subquery ===
SELECT * FROM (VALUES (1), (2), (3)) AS t(id) WHERE id IN (VALUES (1), (3));
id
1
3
=== CROSS JOIN of two VALUES — Cartesian product ===
SELECT a.x, b.y FROM (VALUES (1), (2)) AS a(x) CROSS JOIN (VALUES (10), (20)) AS b(y);
x	y
1	10
1	20
2	10
2	20
=== VALUES with arithmetic ===
VALUES (1+1), (2*3), (10-5);
column1
2
6
5
=== VALUES with function calls ===
VALUES (UPPER('hello')), (LOWER('WORLD'));
column1
HELLO
world
=== VALUES column-count mismatch — errno 1064 ===
VALUES (1, 'a'), (2);
ERROR 1064: SQL parse error: VALUES rows must all have the same number of columns: row 0 has 2, row 1 has 1
=== Empty VALUES — errno 1064 at parse ===
VALUES ();
ERROR 1064: SQL parse error: sql parser error: Expected: an expression, found: ) at Line: 1, Column: 9
=== VALUES inside CTE — fixed in zeta PR #1222 ===
WITH t(id, name) AS (VALUES (1, 'a'), (2, 'b')) SELECT * FROM t ORDER BY id;
id	name
1	a
2	b
=== VALUES inside CTE — filter and order ===
WITH t(c) AS (VALUES (3), (1), (2)) SELECT c FROM t WHERE c >= 2 ORDER BY c;
c
2
3
=== VALUES inside CTE — multiple CTEs, mix VALUES + SELECT ===
WITH a(x) AS (VALUES (1), (2)), b(y) AS (SELECT 10) SELECT a.x, b.y FROM a CROSS JOIN b ORDER BY a.x;
x	y
1	10
2	10
