=== Round-trip identity and length ===
SELECT HEX(UNCOMPRESS(COMPRESS('hello world')))
       = HEX('hello world')                          AS rt_identity;
rt_identity
1
SELECT UNCOMPRESSED_LENGTH(COMPRESS('hello world'))
       = LENGTH('hello world')                       AS rt_len;
rt_len
1
=== Empty-input identity ===
SELECT LENGTH(COMPRESS(''))           AS empty_compressed_len;
empty_compressed_len
0
SELECT LENGTH(UNCOMPRESS(''))         AS empty_uncompressed_len;
empty_uncompressed_len
0
SELECT UNCOMPRESSED_LENGTH('')        AS empty_header_len;
empty_header_len
0
=== Compression actually shrinks repetitive input ===
SELECT LENGTH(COMPRESS(REPEAT('x', 1000))) < 1000    AS shrinks;
shrinks
1
=== UNCOMPRESSED_LENGTH header read ===
SELECT UNCOMPRESSED_LENGTH(COMPRESS(REPEAT('x', 500))) AS recorded_len;
recorded_len
500
=== NULL propagation ===
SELECT COMPRESS(NULL)             AS c_null;
c_null
NULL
SELECT UNCOMPRESS(NULL)           AS u_null;
u_null
NULL
SELECT UNCOMPRESSED_LENGTH(NULL)  AS l_null;
l_null
NULL
=== Corrupt input → NULL (not error) ===
SELECT UNCOMPRESS('ab')                                AS too_short;
too_short
NULL
SELECT UNCOMPRESSED_LENGTH('ab')                       AS too_short_hdr;
too_short_hdr
0
SELECT UNCOMPRESS(CONCAT(UNHEX('63000000'), 'junk'))   AS bad_zlib;
bad_zlib
NULL
=== Arity errors ===
SELECT COMPRESS();
ERROR 1582: Incorrect parameter count in the call to native function 'COMPRESS'
SELECT UNCOMPRESS();
ERROR 1582: Incorrect parameter count in the call to native function 'UNCOMPRESS'
SELECT UNCOMPRESSED_LENGTH();
ERROR 1582: Incorrect parameter count in the call to native function 'UNCOMPRESSED_LENGTH'
SELECT COMPRESS('a', 'b');
ERROR 1582: Incorrect parameter count in the call to native function 'COMPRESS'
=== Mixed case ===
SELECT UNCOMPRESSED_LENGTH(Compress('mixed')) AS mixed_ok;
mixed_ok
5
