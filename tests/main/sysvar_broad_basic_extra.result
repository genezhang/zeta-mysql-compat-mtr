=== Time zone — both = 'UTC' ===
SELECT @@time_zone;
@@time_zone
+00:00
SELECT @@system_time_zone;
@@system_time_zone
<masked>
=== sql_mode / engine (isolation vars already in txn_isolation_basic_extra) ===
SELECT @@sql_mode;
@@sql_mode
ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
SELECT @@default_storage_engine;
@@default_storage_engine
InnoDB
SELECT @@storage_engine;
ERROR 1193: Unknown system variable 'storage_engine'
SELECT @@innodb_version;
@@innodb_version
8.4.6
=== @@lc_time_names — hardcoded 'en_US' ===
SELECT @@lc_time_names;
@@lc_time_names
en_US
=== STRIKING: SET lc_time_names absorbed, @@-read STILL 'en_US' ===
SET lc_time_names = 'fr_FR';
SELECT @@lc_time_names;
@@lc_time_names
fr_FR
=== STRIKING: unknown @@var → NULL silent (not MySQL error) ===
SELECT @@nonexistent_var;
ERROR 1193: Unknown system variable 'nonexistent_var'
SELECT @@made_up_variable;
ERROR 1193: Unknown system variable 'made_up_variable'
SELECT @@some_other_garbage;
ERROR 1193: Unknown system variable 'some_other_garbage'
SELECT @@nonexistent_var IS NULL                              AS unknown_is_null;
ERROR 1193: Unknown system variable 'nonexistent_var'
