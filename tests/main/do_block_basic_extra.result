=== DO with $body$ delim, single-statement body ===
DO $body$ SELECT 1 $body$;
=== DO with $$ default delim ===
DO $$ SELECT 1 $$;
=== DO with empty BEGIN..END ===
DO $body$ BEGIN END $body$;
DO $$ BEGIN END $$;
=== DO LANGUAGE plpgsql / LANGUAGE sql ===
DO LANGUAGE plpgsql $body$ BEGIN END $body$;
DO LANGUAGE sql $body$ SELECT 1 $body$;
=== KNOWN GAP: DO body invalid SQL — errno 1064 at parse ===
DO $body$ INVALID SYNTAX $body$;
ERROR 1064: SQL parse error: sql parser error: Expected: an SQL statement, found: INVALID at Line: 1, Column: 1
=== KNOWN GAP: DO body incomplete SELECT — errno 1064 ===
DO $body$ SELECT FROM $body$;
ERROR 1064: SQL parse error: sql parser error: Expected: identifier, found: EOF
=== KNOWN GAP: DO 'plain string' (non-dollar-quoted) — errno 1064 ===
DO 'not a dollar quoted string';
ERROR 1064: SQL parse error: DO block body must be dollar-quoted
=== KNOWN GAP: DO body referencing real table — errno 1146 ===
# DO resolves table names against `public` schema only,
# ignoring the connection's current database. Even
# `test.t` and `test.public.t` error.
DROP TABLE IF EXISTS dot;
CREATE TABLE dot (id INT PRIMARY KEY, n INT);
INSERT INTO dot VALUES (1, 10);
DO $body$ SELECT * FROM dot $body$;
ERROR 1146: table not found: public.dot
DO $body$ INSERT INTO dot VALUES (2, 20) $body$;
ERROR 1146: table not found: public.dot
DROP TABLE dot;
