# Independently authored JSON_CONTAINS deep-matrix smoke for
# the GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - json_basic.test:186-191: 6 rows (basic object/array/scalar)
#   - json_introspect.test (json/ suite): 1 row + the
#     JSON_CONTAINS_PATH gap pin (`unknown function`)
#
# This slice pins what those slices DO NOT:
#   - Containment semantic walk: scalar==scalar, object-subset,
#     array-element-membership, nested-object containment,
#     mixed-shape mismatch (object vs array).
#   - NULL handling matrix — left NULL, right NULL, both NULL,
#     JSON 'null' vs SQL NULL on either side.
#   - Already-typed JSONB inputs (CAST AS JSONB) on both arg
#     positions, so a refactor that breaks the Value::Jsonb arm
#     of the coerce helper is caught.
#   - Empty-container edge cases.
#   - Error paths: invalid JSON in either position, wrong type
#     (INT, etc.), arity 0/1/3.
#   - JSON_CONTAINS_PATH GAP sentinel in main/ (already pinned
#     in json/ but worth visibility from main/).
#
# Big-picture finding:
#   JSON_CONTAINS(target, candidate) routes through zeta-jsonb's
#   PG `@>` containment matcher (per the impl comment in the
#   JSON_CONTAINS arm of zeta-server/src/lib.rs), so the
#   semantics are:
#     - Scalar containment = strict equality.
#     - Array containment = every candidate element appears as
#       some target element. Non-array candidate matches if it
#       equals one element of the array target.
#     - Object containment = candidate is a "subset" of target
#       (every key/value pair of candidate must appear in
#       target with matching value).
#     - Container-vs-container shape must match (object NOT in
#       array, array NOT in object).
#
# Adaptation notes:
#   # zeta-adapt: NULL on either arg → SQL NULL (impl
#     short-circuits at the coerce helper). JSON 'null' vs SQL
#     NULL distinction: SQL NULL → NULL, JSON 'null' → ordinary
#     scalar contained in a JSON 'null' target.
#   # zeta-adapt: Invalid JSON → 1105 ERROR (MySQL would NULL).
#   # zeta-adapt: Non-JSON-typed arg (INT, etc.) → 1105.
#   # zeta-adapt: Arity errors → 1105 (MySQL: 1582). Codes
#     differ, behavior (reject) matches.
#   # zeta-adapt: JSON_CONTAINS_PATH NOT implemented in zeta
#     (`unknown function`). Pinned via json_introspect.test
#     in the json/ suite; sentinel here for main/ visibility.

--echo === Scalar = scalar (strict equality) ===

SELECT JSON_CONTAINS('1', '1')                AS scalar_int_match;
SELECT JSON_CONTAINS('1', '2')                AS scalar_int_mismatch;
SELECT JSON_CONTAINS('"hi"', '"hi"')          AS scalar_str_match;
SELECT JSON_CONTAINS('"hi"', '"bye"')         AS scalar_str_mismatch;
SELECT JSON_CONTAINS('true', 'true')          AS scalar_bool_match;
SELECT JSON_CONTAINS('true', 'false')         AS scalar_bool_mismatch;
# Cross-type scalar comparison: type matters.
SELECT JSON_CONTAINS('1', '"1"')              AS scalar_int_vs_string;

--echo === Array containment — element membership ===

# Non-array candidate matches if it equals one array element.
SELECT JSON_CONTAINS('[1,2,3]', '1')          AS arr_contains_first;
SELECT JSON_CONTAINS('[1,2,3]', '3')          AS arr_contains_last;
# (Negative `[1,2,3] @> 4` and trivial subset `[1,2,3] @> [2,3]`
#  are already pinned in json_basic.test:189-190; not re-pinned.)
# Array candidate: every element must appear in target.
SELECT JSON_CONTAINS('[1,2,3]', '[1,2]')      AS arr_contains_subset;
SELECT JSON_CONTAINS('[1,2,3]', '[3,2,1]')    AS arr_contains_reordered_full;
SELECT JSON_CONTAINS('[1,2,3]', '[1,4]')      AS arr_contains_partial_miss;
# Empty-array candidate matches ANY array target (vacuous subset).
SELECT JSON_CONTAINS('[1,2,3]', '[]')         AS empty_arr_candidate_matches_any;
# Duplicates in candidate: still treated as set membership.
SELECT JSON_CONTAINS('[1,2,3]', '[1,1,1]')    AS arr_contains_dup_candidate;
# Asymmetry footgun: scalar target with array candidate. The
# scalar 5 does NOT contain the array [5] (target must have
# matching SHAPE — a scalar is not a 1-element array).
SELECT JSON_CONTAINS('5',       '[5]')        AS scalar_target_arr_candidate;

--echo === Object subset (every k/v of candidate in target) ===

SELECT JSON_CONTAINS('{"a":1,"b":2,"c":3}', '{"a":1}')         AS obj_subset_single;
SELECT JSON_CONTAINS('{"a":1,"b":2}', '{"a":1,"b":2}')         AS obj_subset_full;
SELECT JSON_CONTAINS('{"a":1,"b":2}', '{"b":2,"a":1}')         AS obj_subset_reordered;
SELECT JSON_CONTAINS('{"a":1,"b":2}', '{"a":2}')               AS obj_subset_value_mismatch;
SELECT JSON_CONTAINS('{"a":1,"b":2}', '{"c":3}')               AS obj_subset_missing_key;
SELECT JSON_CONTAINS('{"a":1}', '{}')                          AS obj_empty_candidate;
SELECT JSON_CONTAINS('{}', '{}')                               AS empty_obj_in_empty;

--echo === Nested containment ===

# Nested objects: candidate's nested keys must match target's.
SELECT JSON_CONTAINS('{"a":{"b":1,"c":2}}', '{"a":{"b":1}}')   AS nested_obj_subset;
SELECT JSON_CONTAINS('{"a":{"b":1}}',       '{"a":{"b":2}}')   AS nested_obj_value_mismatch;
# Nested arrays.
SELECT JSON_CONTAINS('[[1,2],[3,4]]',  '[[3,4]]')              AS nested_arr_elem;
SELECT JSON_CONTAINS('[[1,2],[3,4]]',  '[[5,6]]')              AS nested_arr_miss;
# Object inside array.
SELECT JSON_CONTAINS('[{"a":1},{"b":2}]', '[{"a":1}]')         AS arr_of_obj;
SELECT JSON_CONTAINS('[{"a":1,"b":2}]',   '[{"a":1}]')         AS arr_of_obj_subset;

--echo === Mixed-shape mismatch (object vs array) ===

# An object is never contained in an array, and vice versa.
SELECT JSON_CONTAINS('[1,2,3]',     '{"a":1}')                 AS arr_obj_mismatch;
SELECT JSON_CONTAINS('{"a":1}',     '[1]')                     AS obj_arr_mismatch;

--echo === NULL handling matrix ===

# SQL NULL on either side → SQL NULL.
SELECT JSON_CONTAINS(NULL, '1')        IS NULL                 AS null_target;
SELECT JSON_CONTAINS('1', NULL)        IS NULL                 AS null_candidate;
SELECT JSON_CONTAINS(NULL, NULL)       IS NULL                 AS null_both;
# JSON 'null' is NOT SQL NULL — it's an ordinary JSON scalar.
# 'null' is contained in 'null' (scalar equality).
SELECT JSON_CONTAINS('null', 'null')                           AS json_null_in_json_null;
# JSON 'null' is contained in an array of JSON null.
SELECT JSON_CONTAINS('[null]', 'null')                         AS json_null_in_arr;
# JSON 'null' is NOT contained in an integer scalar (type
# mismatch).
SELECT JSON_CONTAINS('1', 'null')                              AS json_null_in_int;
# JSON 'null' as an OBJECT VALUE — separate path from scalar
# and array containment. {"a":null} should contain {"a":null}.
SELECT JSON_CONTAINS('{"a":null}', '{"a":null}')               AS json_null_as_obj_value;
# Object containment with one null value and one non-null:
# {"a":null,"b":1} should contain {"a":null}.
SELECT JSON_CONTAINS('{"a":null,"b":1}', '{"a":null}')         AS json_null_obj_value_subset;

--echo === Already-typed JSONB inputs (Value::Jsonb arm) ===

# Without CAST, both args route through from_json_str. CAST
# AS JSONB forces the Value::Jsonb branch on either or both
# sides. The (neither-typed) baseline is implicit throughout
# the rest of the file; pin the three CAST permutations.
SELECT JSON_CONTAINS(CAST('{"a":1,"b":2}' AS JSONB),
                     CAST('{"a":1}'       AS JSONB))           AS both_typed;
SELECT JSON_CONTAINS(CAST('{"a":1,"b":2}' AS JSONB),
                     '{"a":1}')                                AS target_typed;
SELECT JSON_CONTAINS('{"a":1,"b":2}',
                     CAST('{"a":1}'       AS JSONB))           AS candidate_typed;

--echo === Invalid JSON → ERROR (zeta strict; MySQL NULLs) ===

--error 1105
SELECT JSON_CONTAINS('not json', '1');
--error 1105
SELECT JSON_CONTAINS('1', 'not json');

--echo === Non-JSON-typed arg → ERROR ===

--error 1105
SELECT JSON_CONTAINS(42, '1');
--error 1105
SELECT JSON_CONTAINS('1', 42);

--echo === Arity errors ===

--error 1105
SELECT JSON_CONTAINS();
--error 1105
SELECT JSON_CONTAINS('1');
# 3-arg form (path) — MySQL supports this; zeta does not.
--error 1105
SELECT JSON_CONTAINS('{"a":1}', '1', '$.a');

--echo === KNOWN GAP: JSON_CONTAINS_PATH not implemented (sentinel) ===

# Pinned in json_introspect.test (json/ suite); sentinel here
# for main/ visibility. Returns errno 1105 with message
# "unknown function: JSON_CONTAINS_PATH".
--error 1105
SELECT JSON_CONTAINS_PATH('{"a":1}', 'one', '$.a');

