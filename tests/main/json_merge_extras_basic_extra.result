=== Routing-proof: CAST AS JSONB lands a typed Value::Jsonb ===
SELECT JSON_TYPE(CAST('{"a":1}' AS JSONB))                  AS jsonb_cast_lands_as_object;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB))                  AS jsonb_cast_lands_as_object' at line 1
=== JSON_MERGE_PATCH on already-typed JSONB args ===
SELECT JSON_LENGTH(JSON_MERGE_PATCH(
  CAST('{"a":1,"b":2}' AS JSONB),
  CAST('{"b":99,"c":3}' AS JSONB)))                          AS patch_both_typed_len;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB),
  CAST('{"b":99,"c":3}' AS JSONB)))                          AS patch_bo' at line 2
SELECT JSON_EXTRACT(JSON_MERGE_PATCH(
  CAST('{"a":1,"b":2}' AS JSONB),
  CAST('{"b":99,"c":3}' AS JSONB)),
  '$.b')                                                     AS patch_both_typed_b;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB),
  CAST('{"b":99,"c":3}' AS JSONB)),
  '$.b')                            ' at line 2
=== JSON_MERGE_PRESERVE on already-typed JSONB args ===
SELECT JSON_LENGTH(JSON_MERGE_PRESERVE(
  CAST('[1,2]' AS JSONB),
  CAST('[3,4]' AS JSONB)))                                   AS preserve_both_typed_len;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB),
  CAST('[3,4]' AS JSONB)))                                   AS preserve' at line 2
