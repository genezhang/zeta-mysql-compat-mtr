  '{"b":2}'))                                                AS patch_ty' at line 2
SELECT JSON_LENGTH(JSON_MERGE_PATCH(
  '{"a":1}',
  CAST('{"b":2}' AS JSONB)))                                 AS patch_str_left_typed_right;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'JSONB)))                                 AS patch_str_left_typed_right' at line 3
SELECT JSON_LENGTH(JSON_MERGE_PRESERVE(
