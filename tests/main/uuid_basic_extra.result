=== KNOWN GAP: DEFAULT GEN_RANDOM_UUID() — errno 1105 ===
# The DEFAULT expression is bound as a text literal,
# so zeta tries to UUID-parse the string
# 'GEN_RANDOM_UUID()'. Same root cause as the
# DEFAULT NEXTVAL gap in sequence_basic_extra.
# Substitute: pass GEN_RANDOM_UUID() explicitly in
# each INSERT's VALUES list.
DROP TABLE IF EXISTS u_dflt;
CREATE TABLE u_dflt (id UUID DEFAULT GEN_RANDOM_UUID() PRIMARY KEY, n INT);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'UUID DEFAULT GEN_RANDOM_UUID() PRIMARY KEY, n INT)' at line 1
INSERT INTO u_dflt (n) VALUES (1);
ERROR 1146: Table 'test.u_dflt' doesn't exist
DROP TABLE u_dflt;
