DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, name VARCHAR(20));
INSERT INTO t1 VALUES (3, 'c'), (1, 'a'), (2, 'b');
SELECT id, name FROM t1;
