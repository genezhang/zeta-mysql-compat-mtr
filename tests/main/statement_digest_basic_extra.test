# Independently authored STATEMENT_DIGEST / STATEMENT_DIGEST_TEXT
# smoke for the GPL MTR-format runner. NOT copied or adapted from
# MySQL's mysql-test/. Both functions errored "unknown function"
# in zeta before zeta PR #1268; this slice locks in the
# fingerprinting properties that matter for app-level use
# (dedup, monitoring), without claiming byte-exact MySQL output.
#
# Big-picture finding:
#   STATEMENT_DIGEST_TEXT(stmt)
#     - line comments (-- ..., # ...) stripped
#     - block comments (/* ... */) stripped
#     - string literals ('...', "...") → ?
#     - numeric literals (int, dec, scientific, hex 0x...) → ?
#     - whitespace runs collapsed; ends trimmed
#   STATEMENT_DIGEST(stmt) = lowercase 64-char SHA-256 hex of the
#                            DIGEST_TEXT.
#   Properties:
#     - DIGEST == SHA2(DIGEST_TEXT, 256)
#     - same-shape stmt → same DIGEST
#     - different-shape stmt → different DIGEST
#     - NULL → NULL
#
# Adaptation notes:
#   # zeta-adapt: zeta's normalization does NOT backtick
#     identifiers, does NOT case-normalize keywords, and does NOT
#     collapse `IN (?, ?, ?)`. MySQL does all three. The BYTES of
#     DIGEST_TEXT therefore differ between engines, so DIGEST
#     also differs — but the INTERNAL CONSISTENCY (same shape →
#     same hash) is preserved on both engines.
#     Tests assert the PROPERTIES that hold across engines, NOT
#     the exact bytes:
#       - exact DIGEST_TEXT only checked for very simple inputs
#         where zeta's normalization happens to match MySQL
#       - DIGEST checked via collision/divergence properties
#         instead of literal hex values

--echo === DIGEST_TEXT: literal replacement ===

SELECT STATEMENT_DIGEST_TEXT('SELECT 1') AS int_lit;
SELECT STATEMENT_DIGEST_TEXT('SELECT ''hi''') AS str_lit;
SELECT STATEMENT_DIGEST_TEXT('SELECT 0x1A') AS hex_lit;
SELECT STATEMENT_DIGEST_TEXT('SELECT 1.5') AS dec_lit;
SELECT STATEMENT_DIGEST_TEXT('SELECT 2e-3') AS sci_lit;

--echo === DIGEST_TEXT: comment stripping ===

SELECT STATEMENT_DIGEST_TEXT('SELECT /* skip */ 1') AS block_stripped;
SELECT STATEMENT_DIGEST_TEXT(CONCAT('SELECT 1 -- ignored', CHAR(10), 'FROM t')) AS line_dashdash;
SELECT STATEMENT_DIGEST_TEXT(CONCAT('SELECT 1 # ignored', CHAR(10), 'FROM t')) AS line_hash;

--echo === DIGEST_TEXT: whitespace collapse + trim ===

SELECT STATEMENT_DIGEST_TEXT('SELECT   *   FROM   t') AS collapsed;
SELECT STATEMENT_DIGEST_TEXT('   SELECT 1   ') AS trimmed;

--echo === DIGEST: same shape → same hash (collision) ===

SELECT STATEMENT_DIGEST('SELECT * FROM t WHERE a = 1')
     = STATEMENT_DIGEST('SELECT * FROM t WHERE a = 2') AS int_collide;
SELECT STATEMENT_DIGEST('SELECT * FROM t WHERE a = ''x''')
     = STATEMENT_DIGEST('SELECT * FROM t WHERE a = ''y''') AS str_collide;
SELECT STATEMENT_DIGEST('SELECT /* note A */ 1')
     = STATEMENT_DIGEST('SELECT /* note B */ 1') AS comment_collide;

--echo === DIGEST: different shape → different hash ===

SELECT STATEMENT_DIGEST('SELECT a FROM t')
    != STATEMENT_DIGEST('SELECT b FROM t') AS ident_differ;
SELECT STATEMENT_DIGEST('SELECT * FROM t')
    != STATEMENT_DIGEST('SELECT * FROM u') AS table_differ;

--echo === DIGEST: format = 64 lowercase hex chars ===

SELECT LENGTH(STATEMENT_DIGEST('SELECT 1')) AS hex_len;
SELECT STATEMENT_DIGEST('SELECT 1') REGEXP '^[0-9a-f]{64}$' AS hex_format;

--echo === DIGEST = SHA2(DIGEST_TEXT, 256) ===

SELECT STATEMENT_DIGEST('SELECT 1')
     = SHA2(STATEMENT_DIGEST_TEXT('SELECT 1'), 256) AS digest_eq_sha2_text;

--echo === NULL propagation ===

SELECT STATEMENT_DIGEST_TEXT(NULL) IS NULL AS dt_null;
SELECT STATEMENT_DIGEST(NULL)      IS NULL AS d_null;

--echo === Empty string: empty text, SHA2('', 256) digest ===

SELECT STATEMENT_DIGEST_TEXT('') AS empty_text;
SELECT STATEMENT_DIGEST('')
     = SHA2('', 256) AS empty_digest_consistent;

--echo === Arity errors ===

--error 1105
SELECT STATEMENT_DIGEST();
--error 1105
SELECT STATEMENT_DIGEST_TEXT('a', 'b');
