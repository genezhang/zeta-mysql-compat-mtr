=== INT4RANGE column + bracket literal + display ===
# Display uses Debug formatter (see KNOWN DIVERGENCE).
DROP TABLE IF EXISTS r1;
CREATE TABLE r1 (id INT PRIMARY KEY, r INT4RANGE);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT4RANGE)' at line 1
INSERT INTO r1 VALUES (1, '[1,10)'), (2, '(5,15]'), (3, 'empty');
ERROR 1146: Table 'test.r1' doesn't exist
SELECT id, r FROM r1 ORDER BY id;
ERROR 1146: Table 'test.r1' doesn't exist
=== LOWER / UPPER ===
SELECT LOWER(r) AS lo, UPPER(r) AS up FROM r1 WHERE id = 1;
ERROR 1146: Table 'test.r1' doesn't exist
=== ISEMPTY ===
SELECT ISEMPTY(r) AS not_empty FROM r1 WHERE id = 1;
ERROR 1146: Table 'test.r1' doesn't exist
SELECT ISEMPTY('empty'::INT4RANGE) AS r;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::INT4RANGE) AS r' at line 1
=== @> contains element ===
SELECT id FROM r1 WHERE r @> 7 ORDER BY id;
