SELECT '$1,000.50'::MONEY;
ERROR 1105: execution error: unsupported CAST target type: MONEY
SELECT 12.34::MONEY;
ERROR 1105: execution error: unsupported CAST target type: MONEY
=== Shape B — `MONEY` DDL column (1064, lowercase) ===
CREATE TABLE m_t (id INT PRIMARY KEY, price MONEY);
