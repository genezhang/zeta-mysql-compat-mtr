=== L2_NORMALIZE: classical unit-vector decomposition ===
SELECT L2_NORMALIZE('[3,4]'::vector)                          AS unit_3_4;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::vector)                          AS unit_3_4' at line 1
=== Round-trip: VECTOR_NORM after L2_NORMALIZE ≈ 1 ===
SELECT VECTOR_NORM(L2_NORMALIZE('[3,4]'::vector)) > 0.9999    AS norm_above_threshold;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::vector)) > 0.9999    AS norm_above_threshold' at line 1
SELECT VECTOR_NORM(L2_NORMALIZE('[3,4]'::vector)) < 1.0001    AS norm_below_threshold;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::vector)) < 1.0001    AS norm_below_threshold' at line 1
SELECT VECTOR_NORM(L2_NORMALIZE('[5,12]'::vector)) > 0.9999   AS norm_5_12_above;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::vector)) > 0.9999   AS norm_5_12_above' at line 1
