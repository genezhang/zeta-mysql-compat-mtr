# Independently authored column-constraint smoke test for the
# GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/column_constraint.test or default.test; pins
# zeta's column-level constraint surface NOT held by
# constraint_basic (which covers PK dup / NOT NULL / UNIQUE /
# DEFAULT-literal / CHECK / FK).
#
# Adaptation notes:
#   # zeta-adapt: DEFAULT CURRENT_TIMESTAMP — supported. The
#     column gets the row-insert timestamp when omitted.
#   # zeta-adapt: AUTO_INCREMENT (MySQL) — supported on PK
#     INT columns. IDs are auto-assigned starting at 1.
#   # zeta-adapt: SERIAL / BIGSERIAL (PG pseudo-types) —
#     supported. Same semantics as AUTO_INCREMENT.
#   # zeta-adapt: GENERATED ALWAYS AS (<expr>) STORED —
#     supported. Computed at INSERT time and stored.
#   # zeta-adapt: Column-level CHECK — supported. Violation
#     errors 1105 (MySQL would use 3819).
#   # zeta-adapt: Column COMMENT 'text' — accepted at parse
#     (silent OK; not surfaced through introspection).
#   # zeta-adapt: ENUM column type — supported. Insert of a
#     valid label works; an invalid label errors 1105
#     (MySQL would use 1265 ER_DATA_TRUNCATED).
#   # zeta-adapt: Multiple constraints on one column
#     (e.g. NOT NULL UNIQUE DEFAULT 'x') — supported in
#     combination.
#   # zeta-adapt: KNOWN DIVERGENCE — COLLATE clause is
#     accepted at parse but does NOT enforce any collation;
#     comparisons remain case-sensitive UTF-8. Portable
#     substitute: case-insensitive comparison via LOWER()
#     or ILIKE.
#   # zeta-adapt: KNOWN DIVERGENCE — INVISIBLE column
#     attribute (MySQL 8) is accepted at parse but the
#     column is NOT hidden from SELECT *. The "invisible"
#     attribute is essentially a no-op; the column shows
#     up in result sets like any other column. MySQL
#     omits it unless explicitly named.

--echo === DEFAULT CURRENT_TIMESTAMP ===
--echo # Compare against a fixed past timestamp to confirm the
--echo # default was actually substituted.

DROP TABLE IF EXISTS de;
CREATE TABLE de (id INT PRIMARY KEY, ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP);
INSERT INTO de (id) VALUES (1);
SELECT id, ts > '2020-01-01' AS ts_set FROM de;

--echo === AUTO_INCREMENT — IDs auto-assigned ===

DROP TABLE IF EXISTS ai;
CREATE TABLE ai (id INT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(20));
INSERT INTO ai (name) VALUES ('a'), ('b'), ('c');
SELECT id, name FROM ai ORDER BY id;

--echo === SERIAL (PG pseudo-type) ===

DROP TABLE IF EXISTS s;
CREATE TABLE s (id SERIAL PRIMARY KEY, name VARCHAR(20));
INSERT INTO s (name) VALUES ('a'), ('b');
SELECT id, name FROM s ORDER BY id;

--echo === BIGSERIAL (PG pseudo-type) ===

DROP TABLE IF EXISTS bs;
CREATE TABLE bs (id BIGSERIAL PRIMARY KEY, name VARCHAR(20));
INSERT INTO bs (name) VALUES ('a'), ('b');
SELECT id, name FROM bs ORDER BY id;

--echo === GENERATED ALWAYS AS (expr) STORED ===

DROP TABLE IF EXISTS g;
CREATE TABLE g (a INT, b INT, c INT GENERATED ALWAYS AS (a + b) STORED, PRIMARY KEY (a, b));
INSERT INTO g (a, b) VALUES (1, 2), (3, 4);
SELECT a, b, c FROM g ORDER BY a;

--echo === Column-level CHECK — violation errno 1105 ===

DROP TABLE IF EXISTS cc;
CREATE TABLE cc (id INT PRIMARY KEY, age INT CHECK (age > 0));
--error 1105
INSERT INTO cc VALUES (1, -5);

--echo === Column COMMENT clause — silent OK ===

DROP TABLE IF EXISTS cm;
CREATE TABLE cm (id INT PRIMARY KEY COMMENT 'primary key',
                 name VARCHAR(20) COMMENT 'user name');

--echo === ENUM column type — valid insert ===

DROP TABLE IF EXISTS en;
CREATE TABLE en (id INT PRIMARY KEY, color ENUM('red', 'green', 'blue'));
INSERT INTO en VALUES (1, 'red'), (2, 'blue');
SELECT id, color FROM en ORDER BY id;

--echo === ENUM column type — invalid value errno 1105 ===

--error 1105
INSERT INTO en VALUES (3, 'yellow');

--echo === Multiple constraints on one column (NOT NULL UNIQUE DEFAULT) ===

DROP TABLE IF EXISTS mc;
CREATE TABLE mc (id INT PRIMARY KEY,
                 code VARCHAR(10) NOT NULL UNIQUE DEFAULT 'x');
INSERT INTO mc (id) VALUES (1);
SELECT id, code FROM mc;

--echo === KNOWN DIVERGENCE: COLLATE clause — silent no-op ===

DROP TABLE IF EXISTS cs;
CREATE TABLE cs (name VARCHAR(20) COLLATE utf8mb4_general_ci);

--echo === KNOWN DIVERGENCE: INVISIBLE column — NOT hidden from SELECT * ===
--echo # MySQL 8 hides INVISIBLE columns from SELECT * unless
--echo # explicitly named; zeta returns them like any column.

DROP TABLE IF EXISTS inv;
CREATE TABLE inv (id INT PRIMARY KEY, hidden INT INVISIBLE);
INSERT INTO inv (id, hidden) VALUES (1, 100);
SELECT * FROM inv;

--echo === Cleanup ===

DROP TABLE de;
DROP TABLE ai;
DROP TABLE s;
DROP TABLE bs;
DROP TABLE g;
DROP TABLE cc;
DROP TABLE cm;
DROP TABLE en;
DROP TABLE mc;
DROP TABLE cs;
DROP TABLE inv;
