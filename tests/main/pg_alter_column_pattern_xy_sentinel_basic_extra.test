# Independently authored PG ALTER TABLE ALTER COLUMN
# sub-operations sentinel slice for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's
# mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - SHAPE E at pg_alter_table_pg_ops_sentinel_basic_extra.test:201-209
#     pins SET STATISTICS / SET STORAGE PLAIN|EXTERNAL|EXTENDED|MAIN
#     as Pattern Y whitelist-leak rejects (wrapped with --error 1064).
#     Also pins SET DEFAULT and DROP NOT NULL implicitly via the
#     whitelist string. This slice is COMPLEMENTARY — adds 9 NEW
#     Pattern Y shapes (DROP IDENTITY, RESTART, SET GENERATED, SET
#     COMPRESSION, SET (...), RESET (...)) + 2 NEW Pattern X shapes
#     (ADD GENERATED ALWAYS / BY DEFAULT).
#   - ALTER COLUMN TYPE edges (SET DATA TYPE adjacent): covered at
#     alter_column_type_edges_basic_extra.test.
#
# IMPORTANT: this slice does NOT claim the whitelist string is
# incomplete. The parser's whitelist message ("SET/DROP NOT NULL,
# SET DEFAULT, SET DATA TYPE, or ADD GENERATED after ALTER COLUMN")
# IS accurate as the surface enumeration of legal forms — every
# non-listed form rejects with that exact Pattern Y fingerprint.
#
# Headline structural findings (TWO):
#
#   (1) Two-layer ALTER COLUMN rejection — ADD GENERATED parses at
#       the sqlparser layer (the whitelist explicitly lists it) but
#       rejects at the convert.rs dispatcher with a literal echo
#       "unsupported ALTER COLUMN operation: ADD GENERATED ALWAYS|BY
#       DEFAULT AS IDENTITY". Every other non-whitelisted form (DROP
#       IDENTITY, RESTART, SET GENERATED, SET COMPRESSION, SET (...),
#       RESET (...), SET STATISTICS, SET STORAGE) rejects earlier at
#       the parser whitelist-check with the uniform Pattern Y
#       fingerprint. This is parallel to PR #452's ALTER TABLE
#       3-pattern rejection split (parser-grammar vs dispatcher
#       catch-all) — see also the two-layer type-recognition note
#       at project_two_layer_type_recognition_pattern. The same
#       split exists inside the ALTER COLUMN sub-grammar.
#
#   (2) DROP IDENTITY IF EXISTS suffix is ignored at the parser
#       layer — the bare `DROP IDENTITY` and the IF-EXISTS-guarded
#       form produce the same col-32 Pattern Y fingerprint ("found:
#       DROP"). The IF EXISTS guard never reaches a deeper check;
#       the parser rejects on the leading `DROP` token before
#       parsing the rest. PG users porting scripts that defensively
#       use `DROP IDENTITY IF EXISTS` (to make scripts idempotent)
#       get the same hard reject as bare `DROP IDENTITY`, with no
#       hint that the IF EXISTS suffix was even seen.
#
# Pre-existing rejection / behavior shape patterns:
#   - PATTERN X — "unsupported ALTER COLUMN operation: <op>" —
#     convert.rs dispatcher catch-all for ALTER COLUMN sub-ops
#     that sqlparser parses into the AlterColumnOperation AST
#     variant but convert.rs lacks an arm for. Echoes the operation
#     name literally.
#   - PATTERN Y — "Expected: SET/DROP NOT NULL, SET DEFAULT, SET
#     DATA TYPE, or ADD GENERATED after ALTER COLUMN, found: <KW>"
#     — sqlparser's ALTER COLUMN sub-grammar whitelist; any
#     keyword not in the whitelist rejects with this exact
#     fingerprint. Column-position deterministic: col 31 for
#     1-char column names (`v`), col 32 for 2-char column names
#     (`id`).
#
# Cross-link probe-fingerprint hazard:
#   - All probes here use the mysqlwire path (the MTR runner's
#     canonical wire). Probing via psql/pgwire can show different
#     fingerprints — see feedback_wire_path_divergence_check.

DROP TABLE IF EXISTS at;
CREATE TABLE at (id INT, v TEXT);

--echo === PATTERN X — ADD GENERATED parses but dispatcher rejects (literal echo) ===

--error 1064
ALTER TABLE at ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY;
--error 1064
ALTER TABLE at ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY;

--echo === PATTERN Y — parser whitelist-leak reject (uniform fingerprint, col 31/32) ===

--error 1064
ALTER TABLE at ALTER COLUMN id DROP IDENTITY;
--error 1064
ALTER TABLE at ALTER COLUMN id DROP IDENTITY IF EXISTS;
--error 1064
ALTER TABLE at ALTER COLUMN id RESTART;
--error 1064
ALTER TABLE at ALTER COLUMN id RESTART WITH 1000;
--error 1064
ALTER TABLE at ALTER COLUMN id SET GENERATED ALWAYS;
--error 1064
ALTER TABLE at ALTER COLUMN v SET COMPRESSION pglz;
--error 1064
ALTER TABLE at ALTER COLUMN v SET COMPRESSION DEFAULT;
--error 1064
ALTER TABLE at ALTER COLUMN v SET (n_distinct = 100);
--error 1064
ALTER TABLE at ALTER COLUMN v RESET (n_distinct);

--echo === SUPPORT — whitelist-listed op succeeds (baseline) ===

ALTER TABLE at ALTER COLUMN id SET NOT NULL;

DROP TABLE at;
