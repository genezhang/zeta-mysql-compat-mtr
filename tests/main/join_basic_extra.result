=== Setup ===
DROP TABLE IF EXISTS jp; DROP TABLE IF EXISTS jc;
CREATE TABLE jp (id INT PRIMARY KEY, name VARCHAR(10));
CREATE TABLE jc (id INT PRIMARY KEY, pid INT, x INT);
INSERT INTO jp VALUES (1, 'a'), (2, 'b');
INSERT INTO jc VALUES (10, 1, 100), (20, 1, 200);
=== LEFT JOIN with WHERE on right — NULL filter trap ===
# `jp.id=2` had NO match, so jc.x is NULL on that row.
# `WHERE jc.x > 150` evaluates NULL > 150 → NULL → row
# filtered. Only the matched id=1 row with x=200 survives.
SELECT jp.id, jc.x
  FROM jp LEFT JOIN jc ON jp.id = jc.pid
  WHERE jc.x > 150
  ORDER BY jp.id;
id	x
1	200
=== LEFT JOIN with ON-side predicate — preserves NULL row ===
# Moving the filter into ON keeps jp.id=2 with jc.x=NULL.
SELECT jp.id, jc.x
  FROM jp LEFT JOIN jc ON jp.id = jc.pid AND jc.x > 150
  ORDER BY jp.id;
id	x
1	200
2	NULL
=== JOIN with non-equality ON (a.id < b.id) ===
SELECT jp.id, jc.id
  FROM jp JOIN jc ON jp.id < jc.id
  ORDER BY jp.id, jc.id;
id	id
1	10
1	20
2	10
2	20
=== USING (col1, col2) — multi-column ===
DROP TABLE IF EXISTS ja; DROP TABLE IF EXISTS jb;
CREATE TABLE ja (x INT, y INT);
CREATE TABLE jb (x INT, y INT, z INT);
INSERT INTO ja VALUES (1, 10), (2, 20);
INSERT INTO jb VALUES (1, 10, 100), (2, 20, 200), (3, 30, 300);
SELECT * FROM ja JOIN jb USING (x, y) ORDER BY x;
ja.x	ja.y	jb.z
1	10	100
2	20	200
=== LEFT JOIN with grouped subquery on right ===
# COUNT per parent; NULL for parents with no children.
SELECT jp.id, sub.cnt
  FROM jp LEFT JOIN (SELECT pid, COUNT(*) AS cnt FROM jc GROUP BY pid) AS sub
       ON jp.id = sub.pid
  ORDER BY jp.id;
id	cnt
1	2
2	NULL
=== LEFT JOIN + COALESCE for default-value pattern ===
SELECT jp.id, COALESCE(jc.x, -1) AS x
  FROM jp LEFT JOIN jc ON jp.id = jc.pid
  ORDER BY jp.id, x;
id	x
1	100
1	200
2	-1
=== COUNT(*) over JOIN ===
SELECT COUNT(*) AS c FROM jp INNER JOIN jc ON jp.id = jc.pid;
c
2
=== KNOWN DIVERGENCE: LATERAL — accepted but returns 0 rows ===
# zeta accepts LATERAL syntax but doesn't propagate the
# outer-row correlation into the lateral subquery, so the
# join produces an empty result instead of N rows.
# Portable substitute: rewrite as correlated subquery.
SELECT 1 FROM jp, LATERAL (SELECT x FROM jc WHERE jc.pid = jp.id) AS l;
=== Cleanup ===
DROP TABLE jp; DROP TABLE jc;
DROP TABLE ja; DROP TABLE jb;
