=== Setup ===
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, name VARCHAR(20), grade INT DEFAULT 50);
=== Single-row INSERT with explicit values ===
INSERT INTO t1 (id, name, grade) VALUES (1, 'alice', 90);
SELECT id, name, grade FROM t1 WHERE id = 1;
id	name	grade
1	alice	90
=== Multi-row INSERT ===
INSERT INTO t1 (id, name, grade) VALUES (2, 'bob', 80), (3, 'carol', 70);
SELECT id, name, grade FROM t1 WHERE id IN (2, 3);
id	name	grade
2	bob	80
3	carol	70
=== Omitted column takes DEFAULT ===
INSERT INTO t1 (id, name) VALUES (4, 'dave');
SELECT id, name, grade FROM t1 WHERE id = 4;
id	name	grade
4	dave	50
=== ON DUPLICATE KEY UPDATE — applies on PK conflict ===
# VALUES(col) refers to the rejected new value.
INSERT INTO t1 (id, name, grade) VALUES (1, 'alice2', 100)
  ON DUPLICATE KEY UPDATE name = VALUES(name), grade = VALUES(grade);
SELECT id, name, grade FROM t1 WHERE id = 1;
id	name	grade
1	alice2	100
=== ON DUPLICATE KEY UPDATE — applies even with non-VALUES expression ===
INSERT INTO t1 (id, name, grade) VALUES (1, 'ignored', 0)
  ON DUPLICATE KEY UPDATE grade = grade + 1;
SELECT id, name, grade FROM t1 WHERE id = 1;
id	name	grade
1	alice2	101
=== INSERT IGNORE — silently skips PK conflict (zeta #1120 FIXED) ===
# MySQL accepts INSERT IGNORE INTO ... to silently skip rows
# that would violate a unique constraint. zeta now translates
# this at the wire layer to ON CONFLICT DO NOTHING so the row
# is preserved verbatim.
INSERT IGNORE INTO t1 (id, name, grade) VALUES (1, 'alice-ignored', 0);
SELECT id, name, grade FROM t1 WHERE id = 1;
id	name	grade
1	alice2	101
INSERT IGNORE INTO t1 (id, name, grade) VALUES (5, 'erin', 75);
SELECT id, name, grade FROM t1 WHERE id = 5;
id	name	grade
5	erin	75
=== INSERT ... SET form (zeta #1120 FIXED) ===
# MySQL accepts INSERT INTO ... SET col=val, ... as syntactic
# sugar for INSERT ... (col, ...) VALUES (val, ...). zeta now
# rewrites this at the wire layer into the standard form.
INSERT INTO t1 SET id = 10, name = 'frank', grade = 88;
SELECT id, name, grade FROM t1 WHERE id = 10;
id	name	grade
10	frank	88
INSERT INTO t1 SET id = 10, name = 'ignored', grade = 0
  ON DUPLICATE KEY UPDATE grade = VALUES(grade) + 5;
SELECT id, name, grade FROM t1 WHERE id = 10;
id	name	grade
10	frank	5
=== INSERT ... SELECT (copy from another table) ===
DROP TABLE IF EXISTS t2;
CREATE TABLE t2 (id INT PRIMARY KEY, name VARCHAR(20), grade INT DEFAULT 50);
INSERT INTO t2 (id, name, grade) SELECT id, name, grade FROM t1 WHERE id <= 3;
SELECT id, name, grade FROM t2;
id	name	grade
1	alice2	101
2	bob	80
3	carol	70
=== Cleanup ===
DROP TABLE t1;
DROP TABLE t2;
