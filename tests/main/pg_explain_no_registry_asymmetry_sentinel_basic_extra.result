=== Setup ===
DROP TABLE IF EXISTS e;
CREATE TABLE e (id INT PRIMARY KEY, v INT);
INSERT INTO e VALUES (1, 10), (2, 20);
=== SHAPE A — parenthesized EXPLAIN: ANY option silently accepted (no registry) ===
=== Shape A1: (GENERIC_PLAN) — PG16+ option silently accepted ===
EXPLAIN (GENERIC_PLAN) SELECT * FROM e;
QUERY PLAN
SeqScan (e) [id, v]
  (cost=1.00 rows=0)
