=== Setup ===
DROP TABLE IF EXISTS sales;
CREATE TABLE sales (id INT PRIMARY KEY, dept VARCHAR(10), amt INT);
INSERT INTO sales VALUES
 (1, 'a', 10), (2, 'a', 20), (3, 'a', 30),
 (4, 'b', 15), (5, 'b', 25),
 (6, 'c', 50);
=== ROW_NUMBER over ORDER BY ===
SELECT id, dept, ROW_NUMBER() OVER (ORDER BY id) AS rn FROM sales ORDER BY id;
id	dept	rn
1	a	1
2	a	2
3	a	3
4	b	4
5	b	5
6	c	6
=== RANK with PARTITION BY ===
SELECT id, dept, amt, RANK() OVER (PARTITION BY dept ORDER BY amt DESC) AS rk
FROM sales ORDER BY id;
id	dept	amt	rk
1	a	10	3
2	a	20	2
3	a	30	1
4	b	15	2
5	b	25	1
6	c	50	1
=== DENSE_RANK with PARTITION BY ===
SELECT id, dept, amt, DENSE_RANK() OVER (PARTITION BY dept ORDER BY amt DESC) AS dr
FROM sales ORDER BY id;
id	dept	amt	dr
1	a	10	3
2	a	20	2
3	a	30	1
4	b	15	2
5	b	25	1
6	c	50	1
=== LAG / LEAD with default ===
SELECT id, amt,
       LAG(amt, 1, 0)  OVER (ORDER BY id) AS lg,
       LEAD(amt, 1, 0) OVER (ORDER BY id) AS ld
FROM sales ORDER BY id;
id	amt	lg	ld
1	10	0	20
2	20	10	30
3	30	20	15
4	15	30	25
5	25	15	50
6	50	25	0
=== FIRST_VALUE per partition ===
SELECT id, dept, FIRST_VALUE(amt) OVER (PARTITION BY dept ORDER BY id) AS fv
FROM sales ORDER BY id;
id	dept	fv
1	a	10
2	a	10
3	a	10
4	b	15
5	b	15
6	c	50
=== NTILE(2) ===
SELECT id, NTILE(2) OVER (ORDER BY id) AS nt FROM sales ORDER BY id;
id	nt
1	1
2	1
3	1
4	2
5	2
6	2
=== COUNT(*) OVER (PARTITION BY …) ===
SELECT id, dept, COUNT(*) OVER (PARTITION BY dept) AS cnt
FROM sales ORDER BY id;
id	dept	cnt
1	a	3
2	a	3
3	a	3
4	b	2
5	b	2
6	c	1
=== SUM(...) OVER () — empty-OVER total ===
SELECT id, SUM(amt) OVER () AS total FROM sales ORDER BY id;
id	total
1	150
2	150
3	150
4	150
5	150
6	150
=== Running total via ROWS UNBOUNDED PRECEDING ===
SELECT id, amt,
       SUM(amt) OVER (ORDER BY id
                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_sum
FROM sales ORDER BY id;
id	amt	run_sum
1	10	10
2	20	30
3	30	60
4	15	75
5	25	100
6	50	150
=== ROWS BETWEEN N PRECEDING AND CURRENT ROW ===
SELECT id, amt,
       SUM(amt) OVER (ORDER BY id
                      ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS rs
FROM sales ORDER BY id;
id	amt	rs
1	10	10
2	20	30
3	30	50
4	15	45
5	25	40
6	50	75
=== RANGE BETWEEN N PRECEDING AND N FOLLOWING (numeric offsets, zeta #1051) ===
SELECT id, amt,
       SUM(amt) OVER (ORDER BY amt
                      RANGE BETWEEN 10 PRECEDING AND 10 FOLLOWING) AS rg
FROM sales ORDER BY id;
id	amt	rg
1	10	45
2	20	100
3	30	75
4	15	70
5	25	90
6	50	50
=== Named WINDOW clause ===
SELECT id,
       ROW_NUMBER() OVER w AS rn,
       RANK()       OVER w AS rk
FROM sales
WINDOW w AS (ORDER BY id);
id	rn	rk
1	1	1
2	2	2
3	3	3
4	4	4
5	5	5
6	6	6
=== Zeta extension: NULLS FIRST inside OVER (rejected by MySQL 8.0) ===
# zeta accepts `ORDER BY … NULLS FIRST` via the PG dialect;
# MySQL 8.0 rejects this at parse with errno 1064. Documented
# as a zeta extra. Portable substitute: ORDER BY x IS NULL …
SELECT id, ROW_NUMBER() OVER (ORDER BY amt NULLS FIRST) AS rn
FROM sales ORDER BY id;
id	rn
1	1
2	3
3	5
4	2
5	4
6	6
=== Cleanup ===
DROP TABLE sales;
