=== SHA2 — extended digest sizes ===
SELECT LENGTH(SHA2('hello', 224)) AS l224, LENGTH(SHA2('hello', 256)) AS l256;
l224	l256
56	64
SELECT LENGTH(SHA2('hello', 384)) AS l384, LENGTH(SHA2('hello', 512)) AS l512;
l384	l512
96	128
=== SHA2 fixed digests (deterministic) ===
SELECT SHA2('hello', 384) AS h384;
h384
59e1748777448c69de6b800d7a33bbfb9ff1b463e44354c3553bcdb9c666fa90125a3c79f90397bdf5f6a13de828684f
=== CRC32 edges ===
SELECT CRC32('hello') AS basic;
basic
907060870
SELECT CRC32('') AS empty, CRC32(NULL) AS nl;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'empty, CRC32(NULL) AS nl' at line 1
SELECT CRC32(123) AS num;
num
2286445522
=== DIGEST (PG pgcrypto) ===
SELECT HEX(DIGEST('hello', 'sha256')) AS d_256;
ERROR 1305: FUNCTION test.DIGEST does not exist
SELECT HEX(DIGEST('hello', 'md5')) AS d_md5;
ERROR 1305: FUNCTION test.DIGEST does not exist
=== ENCRYPT / DECRYPT round-trip (3-arg, PG pgcrypto) ===
SELECT DECRYPT(ENCRYPT('plain', 'key', 'aes'), 'key', 'aes') AS round_trip;
ERROR 1305: FUNCTION test.DECRYPT does not exist
=== HMAC — algorithm variants ===
SELECT LENGTH(HEX(HMAC('hello', 'key', 'md5'))) AS l_md5;
ERROR 1305: FUNCTION test.HMAC does not exist
SELECT LENGTH(HEX(HMAC('hello', 'key', 'sha1'))) AS l_sha1;
ERROR 1305: FUNCTION test.HMAC does not exist
SELECT LENGTH(HEX(HMAC('hello', 'key', 'sha256'))) AS l_sha256;
ERROR 1305: FUNCTION test.HMAC does not exist
SELECT LENGTH(HEX(HMAC('hello', 'key', 'sha512'))) AS l_sha512;
ERROR 1305: FUNCTION test.HMAC does not exist
=== FIXED: RANDOM_BYTES (MySQL) now supported ===
SELECT LENGTH(RANDOM_BYTES(16)) AS len16, LENGTH(RANDOM_BYTES(32)) AS len32;
len16	len32
<masked>	<masked>
=== KNOWN GAP: GEN_RANDOM_BYTES (PG pgcrypto) — errno 1105 ===
SELECT GEN_RANDOM_BYTES(16);
ERROR 1305: FUNCTION test.GEN_RANDOM_BYTES does not exist
=== AES_ENCRYPT / AES_DECRYPT — supported since zeta #1209 ===
SELECT AES_DECRYPT(AES_ENCRYPT('hello', 'mykey'), 'mykey') AS round_trip;
round_trip
hello
SELECT LENGTH(HEX(AES_ENCRYPT('plain', 'key'))) AS enc_hex_len;
enc_hex_len
32
=== FIXED: COMPRESS / UNCOMPRESS / UNCOMPRESSED_LENGTH (zlib) ===
SELECT UNCOMPRESS(COMPRESS('hello')) AS round_trip;
round_trip
hello
SELECT UNCOMPRESSED_LENGTH(COMPRESS('hello world')) AS orig_len;
orig_len
11
=== KNOWN GAP: PASSWORD (legacy MySQL) — errno 1105 ===
SELECT PASSWORD('secret');
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '('secret')' at line 1
=== KNOWN GAP: ENCRYPT 2-arg MySQL form — errno 1105 ===
SELECT ENCRYPT('plain', 'key');
ERROR 1305: FUNCTION test.ENCRYPT does not exist
=== KNOWN GAP: HMAC 2-arg form — errno 1105 ===
SELECT HMAC('hello', 'key');
ERROR 1305: FUNCTION test.HMAC does not exist
