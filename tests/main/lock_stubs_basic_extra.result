=== GET_LOCK / RELEASE_LOCK — return NULL ===
SELECT GET_LOCK('mylock', 5)    AS got_lock;
got_lock
1
SELECT RELEASE_LOCK('mylock')   AS released;
released
1
=== IS_FREE_LOCK — always 1 ===
SELECT IS_FREE_LOCK('any-name') AS is_free;
is_free
1
=== IS_USED_LOCK — NULL ===
SELECT IS_USED_LOCK('mylock')   AS is_used;
is_used
<masked>
=== RELEASE_ALL_LOCKS — 0 ===
SELECT RELEASE_ALL_LOCKS()      AS released_all;
released_all
0
=== NULL propagation ===
SELECT GET_LOCK(NULL, 5)        AS n_name;
ERROR 3057: Incorrect user-level lock name 'NULL'. The name is empty, NULL, or can not be expressed in the current character-set.
SELECT GET_LOCK('mylock', NULL) AS n_timeout;
n_timeout
1
SELECT RELEASE_LOCK(NULL)       AS rl_n;
ERROR 3057: Incorrect user-level lock name 'NULL'. The name is empty, NULL, or can not be expressed in the current character-set.
SELECT IS_FREE_LOCK(NULL)       AS if_n;
ERROR 3057: Incorrect user-level lock name 'NULL'. The name is empty, NULL, or can not be expressed in the current character-set.
SELECT IS_USED_LOCK(NULL)       AS iu_n;
ERROR 3057: Incorrect user-level lock name 'NULL'. The name is empty, NULL, or can not be expressed in the current character-set.
=== Mixed case ===
SELECT Get_Lock('x', 1)         AS mixed_get;
mixed_get
1
SELECT Is_Free_Lock('x')        AS mixed_free;
mixed_free
0
=== Arity errors ===
SELECT GET_LOCK('x');
ERROR 1582: Incorrect parameter count in the call to native function 'GET_LOCK'
SELECT RELEASE_LOCK();
ERROR 1582: Incorrect parameter count in the call to native function 'RELEASE_LOCK'
SELECT IS_FREE_LOCK();
ERROR 1582: Incorrect parameter count in the call to native function 'IS_FREE_LOCK'
SELECT RELEASE_ALL_LOCKS(1);
ERROR 1582: Incorrect parameter count in the call to native function 'RELEASE_ALL_LOCKS'
