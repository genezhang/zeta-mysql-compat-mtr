=== Symmetry: a <@ b ≡ b @> a ===
SELECT '{"a":1}'::JSONB <@ '{"a":1,"b":2}'::JSONB
     = ('{"a":1,"b":2}'::JSONB @> '{"a":1}'::JSONB)           AS symmetry_object_subset;
