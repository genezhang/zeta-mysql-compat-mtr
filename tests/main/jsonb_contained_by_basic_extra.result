     = ('[1,2,3]'::JSONB @> '[1,2]'::JSONB)         ' at line 1
SELECT '1'::JSONB <@ '[1,2,3]'::JSONB
     = ('[1,2,3]'::JSONB @> '1'::JSONB)                       AS symmetry_scalar_in_arr;
