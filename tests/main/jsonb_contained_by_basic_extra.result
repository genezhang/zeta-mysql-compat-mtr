     = ('{"a":1,"b":2}'::JSONB @> '{"a":1}'::J' at line 1
SELECT '[1,2]'::JSONB <@ '[1,2,3]'::JSONB
     = ('[1,2,3]'::JSONB @> '[1,2]'::JSONB)                   AS symmetry_array_subset;
