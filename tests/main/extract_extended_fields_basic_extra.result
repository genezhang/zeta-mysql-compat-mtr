=== Per-type validity — Date rejects time fields ===
SELECT EXTRACT(HOUR FROM DATE '2024-05-19');
EXTRACT(HOUR FROM DATE '2024-05-19')
0
SELECT EXTRACT(MICROSECOND FROM DATE '2024-05-19');
EXTRACT(MICROSECOND FROM DATE '2024-05-19')
0
=== Per-type validity — Time rejects date fields ===
SELECT EXTRACT(YEAR FROM TIME '14:30:45');
EXTRACT(YEAR FROM TIME '14:30:45')
2026
SELECT EXTRACT(CENTURY FROM TIME '14:30:45');
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CENTURY FROM TIME '14:30:45')' at line 1
=== Per-type validity — Interval rejects extras (only Y/M/D/H/M/S/EPOCH) ===
SELECT EXTRACT(CENTURY FROM INTERVAL '1 year');
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CENTURY FROM INTERVAL '1 year')' at line 1
SELECT EXTRACT(ISOYEAR FROM INTERVAL '1 year');
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'ISOYEAR FROM INTERVAL '1 year')' at line 1
