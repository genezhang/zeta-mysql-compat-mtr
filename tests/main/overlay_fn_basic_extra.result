=== OVERLAY: SQL-standard PLACING/FROM/FOR syntax ===
SELECT OVERLAY('Txxxxas' PLACING 'hom' FROM 2 FOR 4)          AS thomas;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near ''hom' FROM 2 FOR 4)          AS thomas' at line 1
SELECT OVERLAY('yabadoo' PLACING 'daba' FROM 5 FOR 0)         AS yabadabadoo;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near ''daba' FROM 5 FOR 0)         AS yabadabadoo' at line 1
SELECT OVERLAY('babosa' PLACING 'ubb' FROM 2 FOR 4)           AS bubba;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near ''ubb' FROM 2 FOR 4)           AS bubba' at line 1
=== OVERLAY: positional function-call form (same impl) ===
SELECT OVERLAY('Txxxxas', 'hom', 2, 4)                        AS thomas_positional;
ERROR 1305: FUNCTION test.OVERLAY does not exist
SELECT OVERLAY('yabadoo', 'daba', 5, 0)                       AS yabadabadoo_positional;
ERROR 1305: FUNCTION test.OVERLAY does not exist
SELECT OVERLAY('babosa',  'ubb',  2, 4)                       AS bubba_positional;
ERROR 1305: FUNCTION test.OVERLAY does not exist
=== OVERLAY: PLACING form ≡ positional form ===
SELECT OVERLAY('Txxxxas' PLACING 'hom' FROM 2 FOR 4)
     = OVERLAY('Txxxxas', 'hom', 2, 4)                        AS forms_equivalent;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near ''hom' FROM 2 FOR 4)
     = OVERLAY('Txxxxas', 'hom', 2, 4)                      ' at line 1
