=== KNOWN GAP: MINVALUE not enforced for descending ===
# NEXTVAL silently continues past MINVALUE. Compare
# with the ascending MAXVALUE case above which errors.
DROP SEQUENCE IF EXISTS s_minneg;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE IF EXISTS s_minneg' at line 1
CREATE SEQUENCE s_minneg START WITH 0 INCREMENT BY -1 MINVALUE -3;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE s_minneg START WITH 0 INCREMENT BY -1 MINVALUE -3' at line 1
SELECT NEXTVAL('s_minneg') AS v1, NEXTVAL('s_minneg') AS v2, NEXTVAL('s_minneg') AS v3, NEXTVAL('s_minneg') AS v4;
ERROR 1305: FUNCTION test.NEXTVAL does not exist
SELECT NEXTVAL('s_minneg') AS past_minvalue;
ERROR 1305: FUNCTION test.NEXTVAL does not exist
DROP SEQUENCE s_minneg;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE s_minneg' at line 1
=== KNOWN GAP: column DEFAULT NEXTVAL — errno 1105 (type) ===
# "type mismatch … expected Int64, got String" — NEXTVAL
# in a DEFAULT clause is bound as a text-returning
# function. Substitute: SERIAL/BIGSERIAL, or pass
# NEXTVAL in each INSERT's VALUES list.
DROP TABLE IF EXISTS t_dflt;
DROP SEQUENCE IF EXISTS s_dflt;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE IF EXISTS s_dflt' at line 1
CREATE SEQUENCE s_dflt START WITH 100;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE s_dflt START WITH 100' at line 1
CREATE TABLE t_dflt (id BIGINT DEFAULT NEXTVAL('s_dflt') PRIMARY KEY, name TEXT);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'NEXTVAL('s_dflt') PRIMARY KEY, name TEXT)' at line 1
INSERT INTO t_dflt (name) VALUES ('x');
ERROR 1146: Table 'test.t_dflt' doesn't exist
DROP TABLE t_dflt;
ERROR 1051: Unknown table 'test.t_dflt'
DROP SEQUENCE s_dflt;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE s_dflt' at line 1
