=== MAXVALUE enforced for ascending sequence ===
# After NEXTVAL hits MAXVALUE, the next call errors 1105.
DROP SEQUENCE IF EXISTS s_maxv;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE IF EXISTS s_maxv' at line 1
CREATE SEQUENCE s_maxv START WITH 5 MINVALUE 5 MAXVALUE 7;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE s_maxv START WITH 5 MINVALUE 5 MAXVALUE 7' at line 1
SELECT NEXTVAL('s_maxv') AS v1, NEXTVAL('s_maxv') AS v2, NEXTVAL('s_maxv') AS v3;
ERROR 1305: FUNCTION test.NEXTVAL does not exist
SELECT NEXTVAL('s_maxv') AS overflow;
ERROR 1305: FUNCTION test.NEXTVAL does not exist
DROP SEQUENCE s_maxv;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SEQUENCE s_maxv' at line 1
