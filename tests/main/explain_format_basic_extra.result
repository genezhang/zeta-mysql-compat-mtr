=== Setup ===
DROP TABLE IF EXISTS et;
CREATE TABLE et (id INT PRIMARY KEY, n INT);
INSERT INTO et VALUES (1,10),(2,20),(3,30);
=== DESC <table> — MySQL shorthand for DESCRIBE ===
DESC et;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	
n	int	YES		NULL	
=== DESCRIBE <table> — full spelling ===
DESCRIBE et;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	
n	int	YES		NULL	
=== EXPLAIN (FORMAT YAML) — parses, output is plain text plan ===
EXPLAIN (FORMAT YAML) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'FORMAT YAML) SELECT * FROM et' at line 1
=== EXPLAIN (FORMAT XML) — parses, output is plain text plan ===
EXPLAIN (FORMAT XML) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'FORMAT XML) SELECT * FROM et' at line 1
=== EXPLAIN (ANALYZE, BUFFERS) — parses, but ANALYZE NOT honored ===
EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'ANALYZE, BUFFERS) SELECT * FROM et' at line 1
=== EXPLAIN (COSTS OFF) — parses, costs still shown ===
EXPLAIN (COSTS OFF) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'COSTS OFF) SELECT * FROM et' at line 1
=== EXPLAIN (BUFFERS) — parses, no buffer info added ===
EXPLAIN (BUFFERS) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'BUFFERS) SELECT * FROM et' at line 1
=== EXPLAIN (SETTINGS) — parses, no settings shown ===
EXPLAIN (SETTINGS) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SETTINGS) SELECT * FROM et' at line 1
=== EXPLAIN FORMAT=TREE (MySQL) — parses, plain text plan ===
EXPLAIN FORMAT=TREE SELECT * FROM et;
EXPLAIN
-> Table scan on et  (cost=0.55 rows=3)

=== KNOWN DIVERGENCE: (FORMAT JUNK) accepted even though FORMAT=JUNK rejected ===
EXPLAIN (FORMAT JUNK) SELECT * FROM et;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'FORMAT JUNK) SELECT * FROM et' at line 1
=== KNOWN DIVERGENCE: DESCRIBE SELECT returns empty (no error, no plan) ===
DESCRIBE SELECT * FROM et;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	et	NULL	ALL	NULL	NULL	NULL	NULL	3	100.00	NULL
=== KNOWN GAP: EXPLAIN FORMAT=TRADITIONAL — errno 1064 ===
EXPLAIN FORMAT=TRADITIONAL SELECT * FROM et;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	et	NULL	ALL	NULL	NULL	NULL	NULL	3	100.00	NULL
=== KNOWN GAP: EXPLAIN FORMAT=JUNK (no parens) — errno 1064 ===
EXPLAIN FORMAT=JUNK SELECT * FROM et;
ERROR 1791: Unknown EXPLAIN format name: 'JUNK'
=== KNOWN GAP: EXPLAIN ANALYZE INSERT — errno 1105 ===
EXPLAIN ANALYZE INSERT INTO et VALUES (99, 99);
EXPLAIN
-> Insert into et
    -> Rows fetched before execution

=== KNOWN GAP: EXPLAIN ANALYZE UPDATE — errno 1105 ===
EXPLAIN ANALYZE UPDATE et SET n = n+1;
EXPLAIN
-> <not executable by iterator executor>

=== KNOWN GAP: EXPLAIN ANALYZE DELETE — errno 1105 ===
EXPLAIN ANALYZE DELETE FROM et WHERE n = 99;
EXPLAIN
-> <not executable by iterator executor>

=== Cleanup ===
DROP TABLE et;
