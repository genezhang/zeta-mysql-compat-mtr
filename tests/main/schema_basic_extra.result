=== CREATE SCHEMA + CREATE TABLE in schema + DML round-trip ===
DROP SCHEMA IF EXISTS s1 CASCADE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CASCADE' at line 1
CREATE SCHEMA s1;
CREATE TABLE s1.t (id INT PRIMARY KEY, n INT);
INSERT INTO s1.t VALUES (1, 10), (2, 20);
SELECT id, n FROM s1.t ORDER BY id;
id	n
1	10
2	20
UPDATE s1.t SET n = 99 WHERE id = 1;
DELETE FROM s1.t WHERE id = 2;
SELECT id, n FROM s1.t;
id	n
1	99
DROP TABLE s1.t;
DROP SCHEMA s1;
=== DROP SCHEMA on non-empty (no CASCADE) — errno 1105 ===
DROP SCHEMA IF EXISTS sx;
CREATE SCHEMA sx;
CREATE TABLE sx.t (id INT);
DROP SCHEMA sx;
DROP SCHEMA sx CASCADE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CASCADE' at line 1
=== DROP SCHEMA missing without IF EXISTS — errno 1105 ===
DROP SCHEMA no_such_schema;
ERROR 1008: Can't drop database 'no_such_schema'; database doesn't exist
=== DROP SCHEMA IF EXISTS on missing — no-op ===
DROP SCHEMA IF EXISTS no_such_schema;
=== CREATE SCHEMA IF NOT EXISTS — second CREATE is no-op ===
DROP SCHEMA IF EXISTS sy;
CREATE SCHEMA IF NOT EXISTS sy;
CREATE SCHEMA IF NOT EXISTS sy;
DROP SCHEMA sy;
=== DROP TABLE IF EXISTS on missing schema-qualified table — no-op ===
DROP SCHEMA IF EXISTS sm CASCADE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CASCADE' at line 1
CREATE SCHEMA sm;
DROP TABLE IF EXISTS sm.no_such;
DROP SCHEMA sm;
