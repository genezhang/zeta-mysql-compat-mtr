=== KNOWN GAP: schema-qualified column ref — errno 1054 ===
# `<schema>.<table>.<col>` is rejected; the bare
# `<table>.<col>` works inside the same DML.
DROP SCHEMA IF EXISTS sd CASCADE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CASCADE' at line 1
CREATE SCHEMA sd;
CREATE TABLE sd.t (id INT PRIMARY KEY, n INT);
INSERT INTO sd.t VALUES (1, 10), (2, 20);
SELECT id FROM sd.t WHERE sd.t.n > 15;
id
2
DROP SCHEMA sd CASCADE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CASCADE' at line 1
=== KNOWN GAP: SET search_path has no effect — errno 1146 ===
# The unqualified SELECT FROM t still resolves only in
# `public`. Substitute: always qualify the schema.
DROP SCHEMA IF EXISTS sp CASCADE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CASCADE' at line 1
CREATE SCHEMA sp;
CREATE TABLE sp.t (id INT PRIMARY KEY);
INSERT INTO sp.t VALUES (1);
SET search_path TO sp, public;
