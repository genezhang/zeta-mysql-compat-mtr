# Independently authored PG 14+ CTE CYCLE/SEARCH +
# FOR KEY SHARE + TIMESTAMPTZ sentinel slice for the
# GPL MTR-format runner. NOT copied or adapted from
# MySQL's mysql-test/.
#
# Existing coverage (do NOT duplicate):
#   - WITH RECURSIVE CYCLE clause (PG 14+): ZERO prior
#     coverage.
#   - WITH RECURSIVE SEARCH BREADTH FIRST (PG 14+):
#     ZERO prior coverage.
#   - WITH RECURSIVE SEARCH DEPTH FIRST: ALREADY pinned
#     at recursive_cte_basic_extra.test:141 with the
#     identical fingerprint at the same line/col. NOT
#     re-pinned here (caught by PR #398 round-1 review).
#   - SELECT ... FOR KEY SHARE / FOR NO KEY UPDATE
#     (PG-specific lock modes): ZERO prior coverage.
#     (lock_basic_extra covers FOR UPDATE OF / FOR
#     SHARE / SKIP LOCKED / NOWAIT.)
#   - TIMESTAMP WITH TIME ZONE / TIMESTAMPTZ: ZERO
#     prior coverage at the type-surface level.
#
# Pre-existing rejection shape patterns:
#   - "Expected: SELECT, VALUES, or a subquery in the
#     query body, found: <KW>" — pre-existing at
#     cte_edges_basic_extra, recursive_cte_basic_extra,
#     set_ops_edges_basic_extra.
#
# This slice pins:
#
#   "WITH RECURSIVE body expects SELECT" — adds CYCLE
#   and SEARCH BREADTH FIRST (2 forms; DEPTH FIRST
#   variant already pinned per above):
#     - `... CYCLE id SET is_cycle USING path` (PG 14+
#       cycle detection)
#     - `... SEARCH BREADTH FIRST BY id SET ord` (PG 14+)
#     - Both hit at line 5 col 3. Pre-existing
#       fingerprint; new keywords added.
#
#   NEW FINGERPRINT — `Expected: one of UPDATE or
#   SHARE, found: <KW>` at col 21 (PG-specific weaker
#   lock modes):
#     - `FOR KEY SHARE` (PG 9.3+ weaker than FOR SHARE)
#     - `FOR NO KEY UPDATE` (PG 9.3+ weaker than FOR
#       UPDATE)
#     - `FOR KEY SHARE OF g` (target-specific form)
#     - sqlparser's FOR-lock-clause dispatcher accepts
#       only UPDATE or SHARE, NOT KEY SHARE / NO KEY
#       UPDATE. GENUINELY NEW fingerprint.
#
#   DATA-CORRECTNESS BUG — TIMESTAMPTZ silently
#   truncates TZ offset (NOT mere wire-rendering):
#     - zeta-parser/src/datatype.rs:178 maps TIMESTAMPTZ
#       → DataType::Timestamp (no separate TZ type).
#     - zeta-common/src/value.rs:1137-1153 strip_tz_
#       suffix TRUNCATES the offset (doesn't convert
#       to UTC). `'2024-01-01 12:00:00+05'` becomes
#       `2024-01-01 12:00:00`, NOT `2024-01-01
#       07:00:00 UTC`.
#     - PROBE: insert +00, +05, -08 — all three
#       collapse to identical stored value, proving
#       data corruption (PG would store three
#       distinct UTC values: 12:00, 07:00, 20:00).
#     - This is NOT a wire-rendering quirk (initial
#       round-1 framing) — it's parse-time data loss
#       BEFORE storage. The TZ offset is silently
#       dropped, and the time is treated as if it
#       were in UTC regardless of the offset given.
#     - 6th silent-no-op/data-corruption witness:
#         1. LISTEN/NOTIFY mysqlwire silent (PR #366)
#         2. Multi-dim ARRAY Debug-repr (PR #385)
#         3. INHERITS column-drop (PR #391)
#         4. ROLLBACK TO SAVEPOINT mysqlwire (PR #392)
#         5. ALTER DATABASE silent-drop (PR #396 —
#            though that turned out to be intentional
#            compat no-op, not a bug)
#         6. TIMESTAMPTZ TZ-offset silent-truncation
#            (this slice — genuine BUG, NOT intentional)
#
# Big-picture finding:
#
#   PG 14+ CTE CYCLE/SEARCH BREADTH FIRST and PG-
#   specific weaker lock modes (FOR KEY SHARE / FOR
#   NO KEY UPDATE) are unreachable. TIMESTAMPTZ is
#   silently accepted as data type but truncates the
#   TZ offset on input — data corruption for any app
#   that stores timestamps from multiple time zones.
#
#   Apps porting PG code:
#     - CYCLE / SEARCH BREADTH FIRST: rewrite the
#       recursion's termination clause manually
#       (depth counter or set-membership probe).
#     - FOR KEY SHARE → degrade to FOR SHARE.
#     - FOR NO KEY UPDATE → degrade to FOR UPDATE.
#     - TIMESTAMPTZ → use TIMESTAMP and convert all
#       app-side input to UTC BEFORE insert; never
#       rely on zeta to do the TZ conversion.
#
# Adaptation notes:
#   # zeta-adapt: KNOWN GAP — WITH RECURSIVE CYCLE
#     and SEARCH BREADTH FIRST (PG 14+) clauses error
#     1064. (DEPTH FIRST same shape, already pinned
#     at recursive_cte_basic_extra:141.)
#   # zeta-adapt: KNOWN GAP — SELECT ... FOR KEY SHARE
#     and FOR NO KEY UPDATE error 1064. Degrade to
#     FOR SHARE / FOR UPDATE (loses concurrency benefit).
#   # zeta-adapt: KNOWN BUG — TIMESTAMPTZ silently
#     truncates TZ offset (does NOT convert to UTC).
#     `'2024-01-01 12:00:00+05'`, `+00`, `-08` all
#     stored as `2024-01-01 12:00:00`. Convert to UTC
#     application-side BEFORE insert; never assume
#     zeta-side TZ handling.

CREATE TABLE g (id INT PRIMARY KEY, n INT);
INSERT INTO g VALUES (1, 10), (2, 20);

--echo === WITH RECURSIVE CYCLE / SEARCH BREADTH FIRST (PG 14+) — adds 2 new keywords to WITH-body bucket ===

# DEPTH FIRST variant ALREADY pinned at recursive_cte_
# basic_extra:141; not re-pinned here.
--error 1064
WITH RECURSIVE r(id, n) AS (
  SELECT id, n FROM g WHERE id = 1
  UNION ALL
  SELECT g.id, g.n FROM g JOIN r ON g.id = r.id + 1
) CYCLE id SET is_cycle USING path
SELECT id FROM r;
--error 1064
WITH RECURSIVE r(id, n) AS (
  SELECT id, n FROM g WHERE id = 1
  UNION ALL
  SELECT g.id, g.n FROM g JOIN r ON g.id = r.id + 1
) SEARCH BREADTH FIRST BY id SET ord
SELECT id FROM r;

--echo === NEW FINGERPRINT — FOR KEY SHARE / FOR NO KEY UPDATE ===

--error 1064
SELECT * FROM g FOR KEY SHARE;
--error 1064
SELECT * FROM g FOR NO KEY UPDATE;
--error 1064
SELECT * FROM g FOR KEY SHARE OF g;

--echo === BUG — TIMESTAMPTZ silently TRUNCATES TZ offset (data corruption, NOT wire-render) ===

# Cast and DDL both succeed — but the stored value loses
# the TZ information. zeta-parser/src/datatype.rs:178
# aliases TIMESTAMPTZ → DataType::Timestamp; zeta-common/
# src/value.rs:1137-1153 strip_tz_suffix TRUNCATES the
# offset rather than converting to UTC.
SELECT '2024-01-01 12:00:00'::TIMESTAMP WITH TIME ZONE                   AS cast_works;
SELECT '2024-01-01 12:00:00'::TIMESTAMPTZ                                AS cast_short_works;

# PROBE: three different TZ offsets — all collapse to
# identical stored value. PG would store as 12:00 UTC,
# 07:00 UTC, 20:00 UTC respectively.
CREATE TABLE tz_p (id INT PRIMARY KEY, t TIMESTAMPTZ);
INSERT INTO tz_p VALUES (1, '2024-01-01 12:00:00+00');
INSERT INTO tz_p VALUES (2, '2024-01-01 12:00:00+05');
INSERT INTO tz_p VALUES (3, '2024-01-01 12:00:00-08');
# Three distinct PG values collapsed to identical zeta
# storage — proves the silent-truncation BUG.
SELECT id, t FROM tz_p ORDER BY id;

DROP TABLE g;
DROP TABLE tz_p;
