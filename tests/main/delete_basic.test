# Independently authored DELETE smoke test for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's mysql-test/t/delete.test;
# pins zeta's behavior across common MySQL DELETE forms.
#
# Adaptation notes:
#   # zeta-adapt: DELETE ... LIMIT N and DELETE ... ORDER BY —
#     MySQL caps DELETE to N rows and lets ORDER BY drive which
#     rows survive. zeta does not yet honor either (planner/
#     executor work). zeta #1124 FIXED: both are rejected with
#     errno 1064 (clear "would silently delete all matching rows"
#     / "ordering is dropped without LIMIT" messages) instead of
#     silently ignoring the clauses. Pinned below; remove the
#     --error pins once proper support lands.
#   # zeta-adapt: DELETE FROM t WHERE col IN (SELECT ...) —
#     subquery DELETE. zeta #1125 FIXED: exec_dml_in_txn now
#     materializes non-correlated subqueries in the WHERE filter
#     before dispatching, and qualify_statement walks the DELETE
#     WHERE clause so unqualified subquery FROM tables resolve
#     against the connection's search_path. Pinned with an active
#     row-pin probe below.
#   # zeta-adapt: DELETE t1 FROM t1 JOIN t2 ON ... — MySQL multi-
#     table DELETE works in zeta (parsed via PG-style multi-table
#     DELETE shape).

--echo === Setup ===

DROP TABLE IF EXISTS d1;
CREATE TABLE d1 (id INT PRIMARY KEY, name VARCHAR(20), grade INT);
INSERT INTO d1 (id, name, grade) VALUES
  (1, 'alice', 90),
  (2, 'bob', 80),
  (3, 'carol', 70),
  (4, 'dave', 60),
  (5, 'erin', 50);

--echo === DELETE with WHERE — single row ===

DELETE FROM d1 WHERE id = 2;
--sorted_result
SELECT id, name, grade FROM d1;

--echo === DELETE with WHERE IN — multi-row ===

DELETE FROM d1 WHERE id IN (3, 4);
--sorted_result
SELECT id, name, grade FROM d1;

--echo === Setup helper table for subquery / JOIN DELETE ===

DROP TABLE IF EXISTS d_filter;
CREATE TABLE d_filter (fid INT PRIMARY KEY);
INSERT INTO d_filter (fid) VALUES (1);

--echo === DELETE WHERE col IN (SELECT ...) (zeta #1125 FIXED) ===
--echo # MySQL semantics: the inner SELECT returns {1}; rows with
--echo # matching id are deleted, leaving id=5 in d1.

DELETE FROM d1 WHERE id IN (SELECT fid FROM d_filter);
--sorted_result
SELECT id, name, grade FROM d1;

--echo === DELETE t1 FROM t1 JOIN t2 ... (MySQL multi-table form) ===
--echo # Repopulate d_filter with the surviving id so the JOIN-form
--echo # DELETE has something to match against; subquery DELETE above
--echo # already drained the (id=1) entry.

INSERT INTO d_filter (fid) VALUES (5);
DELETE d1 FROM d1 JOIN d_filter ON d1.id = d_filter.fid;
--sorted_result
SELECT id, name, grade FROM d1;

--echo === DELETE ... LIMIT — rejected (zeta #1124 FIXED) ===
--echo # MySQL caps DELETE to N rows. zeta does not honor LIMIT;
--echo # the parser rejects with errno 1064 instead of silently
--echo # deleting every matching row.

--error 1064
DELETE FROM d1 WHERE id > 0 LIMIT 1;

--echo === DELETE ... ORDER BY — rejected (zeta #1124 FIXED) ===
--echo # MySQL uses ORDER BY with LIMIT to pick which rows survive.
--echo # zeta does not honor ORDER BY in DELETE; rejected at the
--echo # parser with errno 1064 (ordering would be silently dropped).

--error 1064
DELETE FROM d1 ORDER BY id DESC;

--echo === DELETE all rows (no WHERE) ===

DELETE FROM d1;
SELECT COUNT(*) AS remaining FROM d1;

--echo === Cleanup ===

DROP TABLE d1;
DROP TABLE d_filter;
