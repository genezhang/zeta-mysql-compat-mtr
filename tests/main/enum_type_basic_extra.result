=== CREATE TYPE AS ENUM (PG form) + table column + INSERT + SELECT ===
DROP TABLE IF EXISTS e1;
DROP TYPE IF EXISTS mood;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TYPE IF EXISTS mood' at line 1
CREATE TYPE mood AS ENUM ('sad', 'ok', 'happy');
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TYPE mood AS ENUM ('sad', 'ok', 'happy')' at line 1
CREATE TABLE e1 (id INT PRIMARY KEY, m mood);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'mood)' at line 1
INSERT INTO e1 VALUES (1, 'sad'), (2, 'ok'), (3, 'happy'), (4, 'sad');
ERROR 1146: Table 'test.e1' doesn't exist
SELECT id, m FROM e1 ORDER BY id;
ERROR 1146: Table 'test.e1' doesn't exist
=== ORDER BY follows DECLARATION order (sad < ok < happy) ===
# Note: alphabetical would put 'happy' first.
SELECT id, m FROM e1 ORDER BY m, id;
ERROR 1146: Table 'test.e1' doesn't exist
=== Equality and ordered comparison ===
SELECT id FROM e1 WHERE m = 'happy';
ERROR 1146: Table 'test.e1' doesn't exist
SELECT id, m FROM e1 WHERE m > 'sad' ORDER BY id;
ERROR 1146: Table 'test.e1' doesn't exist
=== INSERT of an invalid value — errno 1105 ===
INSERT INTO e1 VALUES (5, 'bogus');
ERROR 1146: Table 'test.e1' doesn't exist
=== UPDATE to a valid value ===
UPDATE e1 SET m = 'ok' WHERE id = 1;
ERROR 1146: Table 'test.e1' doesn't exist
SELECT id, m FROM e1 ORDER BY id;
ERROR 1146: Table 'test.e1' doesn't exist
DROP TABLE e1;
ERROR 1051: Unknown table 'test.e1'
DROP TYPE mood;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TYPE mood' at line 1
=== ::enum cast and CAST(text AS enum) ===
DROP TYPE IF EXISTS color;
