=== GENERATE_SERIES JOINed against a table ===
CREATE TABLE gs_t (id INT, name TEXT);
INSERT INTO gs_t VALUES (1, 'a'), (2, 'b'), (3, 'c');
SELECT t.name, gs.n
  FROM gs_t t
  JOIN GENERATE_SERIES(1, 3) AS gs(n) ON t.id = gs.n
 ORDER BY t.id;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(1, 3) AS gs(n) ON t.id = gs.n
 ORDER BY t.id' at line 3
DROP TABLE gs_t;
