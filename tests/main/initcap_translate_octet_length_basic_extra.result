=== LENGTHB ≡ OCTET_LENGTH IDENTITY (Oracle alias, same impl arm) ===
SELECT OCTET_LENGTH('hello') = LENGTHB('hello')               AS ol_eq_lb_ascii;
ERROR 1305: FUNCTION test.LENGTHB does not exist
SELECT OCTET_LENGTH('café')  = LENGTHB('café')                AS ol_eq_lb_utf8;
ERROR 1305: FUNCTION test.LENGTHB does not exist
SELECT OCTET_LENGTH('')      = LENGTHB('')                    AS ol_eq_lb_empty;
ERROR 1305: FUNCTION test.LENGTHB does not exist
=== BIT_LENGTH = OCTET_LENGTH × 8 ALGEBRAIC IDENTITY ===
SELECT BIT_LENGTH('hello') = OCTET_LENGTH('hello') * 8        AS bl_eq_ol8_ascii;
bl_eq_ol8_ascii
1
SELECT BIT_LENGTH('café')  = OCTET_LENGTH('café')  * 8        AS bl_eq_ol8_utf8;
bl_eq_ol8_utf8
1
SELECT BIT_LENGTH('')      = OCTET_LENGTH('')      * 8        AS bl_eq_ol8_empty;
bl_eq_ol8_empty
1
