=== HARDCODED SINGLE-ROW STUBS ===
SELECT * FROM information_schema.engines LIMIT 5;
ENGINE	SUPPORT	COMMENT	TRANSACTIONS	XA	SAVEPOINTS
InnoDB	DEFAULT	Supports transactions, row-level locking, and foreign keys	YES	YES	YES
SELECT * FROM information_schema.character_sets LIMIT 5;
CHARACTER_SET_NAME	DEFAULT_COLLATE_NAME	DESCRIPTION	MAXLEN
utf8mb4	utf8mb4_general_ci	UTF-8 Unicode	4
SELECT * FROM information_schema.collations LIMIT 5;
COLLATION_NAME	CHARACTER_SET_NAME	ID	IS_DEFAULT	IS_COMPILED	SORTLEN
utf8mb4_general_ci	utf8mb4	45	Yes	Yes	1
=== EMPTY STUBS — always zero rows ===
SELECT * FROM information_schema.parameters LIMIT 5;
SELECT * FROM information_schema.routines LIMIT 5;
SELECT * FROM information_schema.triggers LIMIT 5;
SELECT * FROM information_schema.user_privileges LIMIT 5;
SELECT * FROM information_schema.processlist LIMIT 5;
SELECT * FROM information_schema.global_variables LIMIT 5;
SELECT * FROM information_schema.session_variables LIMIT 5;
=== GAP: count(*) over information_schema errors 1235 ===
SELECT count(*) FROM information_schema.engines;
ERROR 1235: information_schema queries with function call or expression are not yet supported by zeta's MySQL wire shim
SELECT count(*) FROM information_schema.routines;
ERROR 1235: information_schema queries with function call or expression are not yet supported by zeta's MySQL wire shim
SELECT UPPER(ENGINE) FROM information_schema.engines;
ERROR 1235: information_schema queries with function call or expression are not yet supported by zeta's MySQL wire shim
SELECT MAXLEN + 1 FROM information_schema.character_sets;
ERROR 1235: information_schema queries with multi-token projection element are not yet supported by zeta's MySQL wire shim
=== Sentinel: SELECT-LIST with COLUMN refs works (no aggregate/fn) ===
SELECT ENGINE, SUPPORT FROM information_schema.engines LIMIT 5;
ENGINE	SUPPORT
InnoDB	DEFAULT
SELECT CHARACTER_SET_NAME FROM information_schema.character_sets LIMIT 5;
CHARACTER_SET_NAME
utf8mb4
