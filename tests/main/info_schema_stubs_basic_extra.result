=== CONTEXT-DEPENDENT: information_schema.routines populated by CREATE FUNCTION ===
SELECT * FROM information_schema.routines LIMIT 5;
CREATE FUNCTION info_schema_stub_fn(x INT) RETURNS INT
  AS $$ SELECT x + 1 $$ LANGUAGE SQL;
SELECT * FROM information_schema.routines LIMIT 5;
ROUTINE_CATALOG	ROUTINE_SCHEMA	ROUTINE_NAME	ROUTINE_TYPE	DATA_TYPE	ROUTINE_BODY	ROUTINE_DEFINITION	EXTERNAL_LANGUAGE	SECURITY_TYPE
def	test	info_schema_stub_fn	FUNCTION	trigger	SQL	 SELECT x + 1 	SQL	DEFINER
DROP FUNCTION info_schema_stub_fn;
SELECT * FROM information_schema.routines LIMIT 5;
=== PROJECTION-SHAPE GAP: errno 1235 — FIVE rejected classes ===
SELECT DISTINCT ENGINE FROM information_schema.engines;
ERROR 1235: information_schema queries with DISTINCT are not yet supported by zeta's MySQL wire shim
SELECT count(*) FROM information_schema.engines;
ERROR 1235: information_schema queries with function call or expression are not yet supported by zeta's MySQL wire shim
SELECT UPPER(ENGINE) FROM information_schema.engines;
ERROR 1235: information_schema queries with function call or expression are not yet supported by zeta's MySQL wire shim
SELECT ENGINE, FROM information_schema.engines;
ERROR 1235: information_schema queries with empty projection element are not yet supported by zeta's MySQL wire shim
SELECT MAXLEN + 1 FROM information_schema.character_sets;
ERROR 1235: information_schema queries with multi-token projection element are not yet supported by zeta's MySQL wire shim
SELECT t.* FROM information_schema.engines t;
ERROR 1235: information_schema queries with qualified star are not yet supported by zeta's MySQL wire shim
=== FRAGILE BOUNDARY: no-whitespace expression bypasses 1235, errors 1054 ===
SELECT MAXLEN+1 FROM information_schema.character_sets;
ERROR 1054: Unknown column 'maxlen+1' in 'field list'
