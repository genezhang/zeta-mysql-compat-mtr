=== Integer targets — INTEGER / INT / BIGINT ===
SELECT CAST('42' AS INTEGER) AS i, CAST('42' AS INT) AS i2, CAST('42' AS BIGINT) AS b;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INTEGER) AS i, CAST('42' AS INT) AS i2, CAST('42' AS BIGINT) AS b' at line 1
=== Text targets — TEXT / VARCHAR(N) / CHAR / CHAR(N) ===
SELECT CAST(42 AS TEXT) AS t, CAST(42 AS VARCHAR(20)) AS v;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TEXT) AS t, CAST(42 AS VARCHAR(20)) AS v' at line 1
SELECT CAST(42 AS CHAR) AS c, CAST(42 AS CHAR(20)) AS cn;
c	cn
42	42
=== DECIMAL target (precision/scale documented divergence) ===
SELECT CAST('3.14' AS DECIMAL(10,2)) AS d;
d
3.14
=== PG shorthand x::TYPE ===
SELECT '42'::INT AS i;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '::INT AS i' at line 1
=== Date / Timestamp / Time targets ===
SELECT CAST('2024-05-19' AS DATE) AS d;
d
2024-05-19
SELECT CAST('2024-05-19 14:30:00' AS TIMESTAMP) AS ts;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TIMESTAMP) AS ts' at line 1
SELECT CAST('14:30:00' AS TIME) AS t;
t
14:30:00
=== BOOLEAN target — integer + string forms ===
SELECT CAST(1 AS BOOLEAN) AS b_int, CAST('true' AS BOOLEAN) AS b_str;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'BOOLEAN) AS b_int, CAST('true' AS BOOLEAN) AS b_str' at line 1
=== NULL through CAST ===
SELECT CAST(NULL AS INT) AS n_i, CAST(NULL AS TEXT) AS n_t;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT) AS n_i, CAST(NULL AS TEXT) AS n_t' at line 1
=== Negative integer string ===
SELECT CAST('-42' AS INT) AS neg;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT) AS neg' at line 1
=== Float-to-INT half-away-from-zero ===
SELECT CAST(3.7 AS INT) AS pos, CAST(-3.7 AS INT) AS neg;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT) AS pos, CAST(-3.7 AS INT) AS neg' at line 1
=== KNOWN DIVERGENCE: DECIMAL precision/scale NOT enforced ===
# MySQL/PG round to scale; zeta returns the input value
# unchanged.
SELECT CAST('123.456789' AS DECIMAL(5,2)) AS d;
d
123.46
=== KNOWN GAP: CONVERT(x, SIGNED/UNSIGNED) — errno 1064 ===
SELECT CONVERT('42', UNSIGNED);
CONVERT('42', UNSIGNED)
42
SELECT CONVERT('42', SIGNED);
CONVERT('42', SIGNED)
42
=== KNOWN DIVERGENCE: float overflow on CAST AS INT — errno 1105 ===
SELECT CAST(1e20 AS INT);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT)' at line 1
=== KNOWN DIVERGENCE: invalid int literal — errno 1105 ===
SELECT CAST('abc' AS INT);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT)' at line 1
=== KNOWN GAP: CAST AS BYTEA — errno 1105 ===
SELECT CAST('abc' AS BYTEA);
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'BYTEA)' at line 1
=== TRY_CAST / SAFE_CAST — FIXED via zeta #1187 (NULL on fail) ===
SELECT TRY_CAST('abc' AS INT) AS bad;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT) AS bad' at line 1
SELECT TRY_CAST('42' AS INT)  AS good;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT)  AS good' at line 1
SELECT SAFE_CAST('abc' AS INT) AS safe;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INT) AS safe' at line 1
