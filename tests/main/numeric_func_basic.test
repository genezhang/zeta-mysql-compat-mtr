# Independently authored numeric-function smoke test for the GPL
# MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/func_math.test or similar; pins zeta's behavior
# across the MySQL numeric / math functions.
#
# Adaptation notes:
#   # zeta-adapt: ABS, SIGN, SQRT, POW/POWER, MOD, % operator,
#     CEIL/CEILING, FLOOR, ROUND (1-arg and 2-arg), RAND — all
#     supported.
#   # zeta-adapt: EXP, LN — supported. LN(e) ≈ 1 with small
#     floating drift (asserted as 0.9999999998311266 in the
#     result).
#   # zeta-adapt: KNOWN DIVERGENCE — `LOG(x)` in zeta is BASE-10
#     (returns log10). In MySQL `LOG(x)` is the NATURAL log (ln).
#     Pinned in the result. Portable substitutes: `LN(x)` for
#     natural log (works on both); `LOG(10, x)` for explicit
#     base-10.
#   # zeta-adapt: `LOG(base, x)` 2-arg form — supported on both
#     engines, same semantics. Asserted in the result.
#   # zeta-adapt: Trig + log + angle-conversion + PI batch —
#     supported (FIXED via zeta #1167):
#       SIN, COS, TAN, ASIN, ACOS, ATAN, ATAN2, LOG2, LOG10,
#       DEGREES, RADIANS, PI(). All return Float64; NULL on NULL.
#       LOG2/LOG10 of zero/negative raise execution error.
#     Pinned positively below.
#   # zeta-adapt: CRC32 — supported (FIXED via zeta #1168).
#     IEEE CRC32 of UTF-8 bytes returned as Int64 (preserves full
#     u32 range). NULL → NULL. Pinned positively below.
#   # zeta-adapt: TRUNCATE(X, D) — supported (FIXED via zeta #1169).
#     Truncate X toward zero to D decimal places; D < 0 truncates
#     to a multiple of 10^|D|. Decimal input stays Decimal; Float
#     stays Float; integer + D >= 0 is identity. NULL → NULL.
#     Pinned positively below.
#   # zeta-adapt: CONV(N, from_base, to_base) — supported
#     (FIXED via zeta #1170). Base conversion 2..36 (or negative
#     to_base for signed output). Always returns string;
#     uppercase letters. NULL on NULL or invalid base.
#
#   ALL MySQL numeric/math functions pinned in this test are now
#   supported via zeta #1167 (12 math fns) / #1168 (CRC32) /
#   #1169 (TRUNCATE) / #1170 (CONV).

--echo === ABS / SIGN ===

SELECT ABS(-5)                  AS a;
SELECT ABS(-3.14)               AS af;
SELECT SIGN(-7)                 AS sn;
SELECT SIGN(0)                  AS sz;
SELECT SIGN(7)                  AS sp;

--echo === SQRT / POW / POWER ===

SELECT SQRT(16)                 AS s;
SELECT POW(2, 10)               AS p;
SELECT POWER(2, 10)             AS p2;

--echo === MOD and % operator ===

SELECT MOD(10, 3)               AS m;
SELECT 10 % 3                   AS m_op;

--echo === CEIL / CEILING / FLOOR ===

SELECT CEIL(3.2)                AS c;
SELECT CEILING(3.2)             AS c2;
SELECT FLOOR(3.8)               AS f;

--echo === ROUND (1-arg and 2-arg) ===

SELECT ROUND(3.567)             AS r1;
SELECT ROUND(3.567, 2)          AS r2;

--echo === RAND (sanity, just check > 0) ===

SELECT RAND() > 0               AS positive;

--echo === EXP / LN ===

SELECT EXP(1)                   AS e;
SELECT LN(2.718281828)          AS ln_e;

--echo === LOG — DIVERGENCE: 1-arg is base-10 in zeta, natural in MySQL ===
--echo # Portable substitute: use LN(x) for natural log.

SELECT LOG(100)                 AS log_zeta_base10;
SELECT LOG(10, 1000)            AS log_base10_2arg;

--echo === Trig + LOG2/LOG10 + DEGREES/RADIANS + PI — FIXED via zeta #1167 ===

SELECT SIN(0)                            AS s;
SELECT COS(0)                            AS c;
SELECT TAN(0)                            AS t;
SELECT ASIN(1)                           AS asn;
SELECT ACOS(1)                           AS acs;
SELECT ATAN(1)                           AS atn;
SELECT ATAN2(1, 1)                       AS at2;
SELECT LOG2(8)                           AS l2;
SELECT LOG10(1000)                       AS l10;
SELECT DEGREES(3.141592653589793)        AS deg;
SELECT RADIANS(180)                      AS rad;
SELECT PI()                              AS pi;

--echo === TRUNCATE — FIXED via zeta #1169 ===
--echo # Truncate toward zero to D decimal places; D < 0 → 10^|D|
--echo # multiple. Decimal stays Decimal; integer + D >= 0 is identity.

SELECT TRUNCATE(3.567, 1)                AS t;
SELECT TRUNCATE(3.567, 2)                AS t;
SELECT TRUNCATE(-3.567, 1)               AS t_neg;
SELECT TRUNCATE(123.456, -2)             AS t_neg_d;

--echo === CONV — FIXED via zeta #1170 ===
--echo # Base conversion 2..36; returns string with uppercase
--echo # letters. Negative to_base → signed output.

SELECT CONV(255, 10, 16)                 AS c;
SELECT CONV('FF', 16, 10)                AS c;
SELECT CONV(13, 10, 2)                   AS c;
SELECT CONV(CAST(NULL AS CHAR), 10, 16)  AS c_null;

--echo === CRC32 — FIXED via zeta #1168 ===
--echo # IEEE CRC32; values cross-checked against MySQL.

SELECT CRC32('test')                     AS c;
SELECT CRC32('MySQL')                    AS c2;
SELECT CRC32('')                         AS c_empty;
SELECT CRC32(CAST(NULL AS CHAR))         AS c_null;
