=== Setup ===
DROP TABLE IF EXISTS u1;
CREATE TABLE u1 (id INT PRIMARY KEY, name VARCHAR(20), grade INT);
INSERT INTO u1 (id, name, grade) VALUES
  (1, 'alice', 90),
  (2, 'bob', 80),
  (3, 'carol', 70),
  (4, 'dave', 60);
=== Single-row UPDATE with WHERE ===
UPDATE u1 SET grade = 100 WHERE id = 1;
SELECT id, name, grade FROM u1 WHERE id = 1;
id	name	grade
1	alice	100
=== Multi-row UPDATE with WHERE IN ===
UPDATE u1 SET grade = 0 WHERE id IN (3, 4);
SELECT id, name, grade FROM u1 WHERE id IN (3, 4);
id	name	grade
3	carol	0
4	dave	0
=== UPDATE with expression (col = col + N) ===
UPDATE u1 SET grade = grade + 5 WHERE id = 2;
SELECT id, name, grade FROM u1 WHERE id = 2;
id	name	grade
2	bob	85
=== UPDATE multiple columns in one statement ===
UPDATE u1 SET name = 'alice2', grade = grade - 50 WHERE id = 1;
SELECT id, name, grade FROM u1 WHERE id = 1;
id	name	grade
1	alice2	50
=== UPDATE ... LIMIT — rejected (zeta #1124 FIXED) ===
# MySQL caps UPDATE to N rows. zeta does not honor LIMIT in
# UPDATE; the parser rejects with errno 1064 instead of
# silently updating every matching row.
UPDATE u1 SET grade = 0 WHERE id > 1 LIMIT 1;
ERROR 1064: SQL parse error: UPDATE ... LIMIT is not supported (would silently update all matching rows; remove the LIMIT clause)
=== UPDATE ... JOIN (MySQL multi-table form) ===
DROP TABLE IF EXISTS u2;
CREATE TABLE u2 (id INT PRIMARY KEY, source VARCHAR(20));
INSERT INTO u2 (id, source) VALUES (1, 'src-1'), (2, 'src-2');
UPDATE u1 JOIN u2 ON u1.id = u2.id SET u1.name = u2.source;
SELECT id, name, grade FROM u1 WHERE id IN (1, 2);
id	name	grade
1	src-1	50
2	src-2	85
=== Cleanup ===
DROP TABLE u1;
DROP TABLE u2;
