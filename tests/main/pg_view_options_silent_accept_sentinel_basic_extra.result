=== SUPPORT pin: view created via silent-drop body remains functional ===
SELECT id, val FROM v_ns1 WHERE val >= 20;
id	val
2	20
3	30
=== Cleanup ===
DROP VIEW IF EXISTS v_sb1;
DROP VIEW IF EXISTS v_si1;
DROP VIEW IF EXISTS v_co1;
DROP VIEW IF EXISTS v_co2;
DROP VIEW IF EXISTS v_ns1;
DROP VIEW IF EXISTS v_multi;
DROP VIEW IF EXISTS v_intval;
DROP VIEW IF EXISTS v_empty;
