=== Setup ===
DROP TABLE IF EXISTS tprobe;
CREATE TABLE tprobe (id INT PRIMARY KEY, val INT);
INSERT INTO tprobe VALUES (1, 10), (2, 20), (3, 30);
=== Shape A: CREATE VIEW WITH (security_barrier = true) — SUCCESS, option silently dropped (BUG) ===
CREATE VIEW v_sb1 WITH (security_barrier = true) AS SELECT id, val FROM tprobe;
SELECT id, val FROM v_sb1;
id	val
1	10
2	20
3	30
=== Shape B: CREATE VIEW WITH (security_invoker = true) — SUCCESS, silently dropped ===
