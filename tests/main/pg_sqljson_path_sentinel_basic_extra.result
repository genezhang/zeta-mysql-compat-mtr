SELECT JSON_VALUE('bad', '$.a' RETURNING INTEGER DEFAULT 0 ON ERROR);
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: DEFAULT at Line: 1, Column: 50
=== JSON_EXISTS ON ERROR / JSON_QUERY WITH WRAPPER — parse-reject ===
SELECT JSON_EXISTS('{"a":1}', '$.a' FALSE ON ERROR);
