=== JSON_EXISTS / JSON_QUERY — unknown function (1105 execution error) ===
SELECT JSON_EXISTS('{"a":1}', '$.a');
ERROR 1105: execution error: unknown function: JSON_EXISTS
SELECT JSON_QUERY('{"a":1}', '$.a');
ERROR 1105: execution error: unknown function: JSON_QUERY
=== JSON_VALUE PG-style RETURNING <type> — SUPPORTED (partial PG compat layer) ===
SELECT JSON_VALUE('{"a":42}', '$.a' RETURNING INTEGER) AS r_int;
r_int
42
SELECT JSON_VALUE('{"a":"hi"}', '$.a' RETURNING TEXT) AS r_text;
r_text
hi
=== JSON_VALUE PG-style DEFAULT 'x' ON ERROR — parse-reject at DEFAULT ===
SELECT JSON_VALUE('bad', '$.a' DEFAULT 'd' ON ERROR);
ERROR 1064: SQL parse error: sql parser error: Expected: ), found: DEFAULT at Line: 1, Column: 32
SELECT JSON_VALUE('{}', '$.a' DEFAULT 'd' ON EMPTY);
