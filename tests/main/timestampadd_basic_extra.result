=== TIMESTAMPADD — sub-day units (MICROSECOND, SECOND, MINUTE, HOUR) ===
SELECT TIMESTAMPADD(MICROSECOND, 500000, TIMESTAMP '2026-05-19 10:00:00') AS plus_us;
plus_us
2026-05-19 10:00:00.500000
SELECT TIMESTAMPADD(SECOND, 30,         TIMESTAMP '2026-05-19 10:00:00') AS plus_s;
plus_s
2026-05-19 10:00:30
SELECT TIMESTAMPADD(MINUTE, 15,         TIMESTAMP '2026-05-19 10:00:00') AS plus_m;
plus_m
2026-05-19 10:15:00
SELECT TIMESTAMPADD(HOUR, 5,            TIMESTAMP '2026-05-19 10:00:00') AS plus_h;
plus_h
2026-05-19 15:00:00
=== TIMESTAMPADD — day / week ===
SELECT TIMESTAMPADD(DAY, 10, DATE '2026-05-19')  AS plus_d;
plus_d
2026-05-29 00:00:00
SELECT TIMESTAMPADD(WEEK, 2, DATE '2026-05-19')  AS plus_w;
plus_w
2026-06-02 00:00:00
=== TIMESTAMPADD — month / quarter / year ===
SELECT TIMESTAMPADD(MONTH, 3, DATE '2026-05-19')   AS plus_mo;
plus_mo
2026-08-19 00:00:00
SELECT TIMESTAMPADD(QUARTER, 1, DATE '2026-05-19') AS plus_q;
plus_q
2026-08-19 00:00:00
SELECT TIMESTAMPADD(YEAR, 2, DATE '2026-05-19')    AS plus_y;
plus_y
2028-05-19 00:00:00
=== TIMESTAMPADD — negative N (shifts backward) ===
SELECT TIMESTAMPADD(DAY, -7, DATE '2026-05-19')   AS minus_d;
minus_d
2026-05-12 00:00:00
SELECT TIMESTAMPADD(MONTH, -1, DATE '2026-05-19') AS minus_mo;
minus_mo
2026-04-19 00:00:00
=== TIMESTAMPADD — case-insensitive unit identifier ===
SELECT TIMESTAMPADD(day, 1, DATE '2026-05-19') AS lower_unit;
lower_unit
2026-05-20 00:00:00
=== TIMESTAMPADD — NULL propagation ===
SELECT TIMESTAMPADD(DAY, NULL, DATE '2026-05-19') AS n_in_n;
n_in_n
NULL
SELECT TIMESTAMPADD(DAY, 5, NULL)                 AS n_in_target;
n_in_target
NULL
=== TIMESTAMPADD — cross-year (DAY units) ===
SELECT TIMESTAMPADD(DAY, 365, DATE '2026-05-19') AS plus_365d;
plus_365d
2027-05-19 00:00:00
=== TIMESTAMPADD — month-end clamp (Jan 31 + 1 MONTH → Feb 29 in leap year) ===
SELECT TIMESTAMPADD(MONTH, 1, DATE '2024-01-31') AS jan31_plus_mo;
jan31_plus_mo
2024-02-29 00:00:00
=== TIMESTAMPADD — leap-day handling (Feb 29 + 1 YEAR → Feb 28) ===
SELECT TIMESTAMPADD(YEAR, 1, DATE '2024-02-29') AS leap_plus_y;
leap_plus_y
2025-02-28 00:00:00
=== TIMESTAMPADD — on TIMESTAMP column inside SELECT and WHERE ===
DROP TABLE IF EXISTS ts;
CREATE TABLE ts (id INT, t TIMESTAMP);
INSERT INTO ts VALUES (1, TIMESTAMP '2026-01-01 12:00:00'), (2, TIMESTAMP '2026-06-15 09:30:00');
SELECT id, TIMESTAMPADD(MONTH, 6, t) AS plus_6m FROM ts ORDER BY id;
id	plus_6m
1	2026-07-01 12:00:00
2	2026-12-15 09:30:00
SELECT id FROM ts WHERE TIMESTAMPADD(DAY, 30, t) > TIMESTAMP '2026-05-01' ORDER BY id;
id
2
DROP TABLE ts;
=== TIMESTAMPADD — unparseable string target errors 1105 ===
SELECT TIMESTAMPADD(DAY, 1, 'not a date');
ERROR 1105: execution error: TIMESTAMPADD: cannot parse "not a date" as a date or timestamp
