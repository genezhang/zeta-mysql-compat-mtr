=== UNIX_TIMESTAMP() zero-arg — same-statement determinism ===
SELECT UNIX_TIMESTAMP() = UNIX_TIMESTAMP()                    AS same_stmt_equal;
same_stmt_equal
<masked>
SELECT UNIX_TIMESTAMP() > 0                                   AS positive_epoch;
positive_epoch
<masked>
SELECT UNIX_TIMESTAMP() > UNIX_TIMESTAMP(TIMESTAMP '2020-01-01 00:00:00')
                                                              AS later_than_2020;
later_than_2020
<masked>
=== UNIX_TIMESTAMP arity > 1 → ERROR 1105 ===
SELECT UNIX_TIMESTAMP(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-02 00:00:00');
ERROR 1582: Incorrect parameter count in the call to native function 'UNIX_TIMESTAMP'
SELECT UNIX_TIMESTAMP(1, 2, 3);
ERROR 1582: Incorrect parameter count in the call to native function 'UNIX_TIMESTAMP'
=== UNIX_TIMESTAMP — DATE arg (days * 86400 path) ===
SELECT UNIX_TIMESTAMP(DATE '1970-01-02')                      AS day_1_epoch;
day_1_epoch
86400
SELECT UNIX_TIMESTAMP(DATE '2024-01-01')                      AS year_2024_jan1_epoch;
year_2024_jan1_epoch
1704067200
SELECT UNIX_TIMESTAMP(DATE '1969-12-30')                      AS pre_epoch_negative;
pre_epoch_negative
0
=== UNIX_TIMESTAMP — date-only string (no time portion) ===
SELECT UNIX_TIMESTAMP('2024-01-01')                           AS date_only_string_epoch;
date_only_string_epoch
1704067200
SELECT UNIX_TIMESTAMP('2024-01-01')
     = UNIX_TIMESTAMP(DATE '2024-01-01')                      AS date_string_eq_date_literal;
date_string_eq_date_literal
1
=== UNIX_TIMESTAMP — unparseable string → ERROR 1105 ===
SELECT UNIX_TIMESTAMP('not a date');
UNIX_TIMESTAMP('not a date')
0.000000
SELECT UNIX_TIMESTAMP('2024-13-99');
UNIX_TIMESTAMP('2024-13-99')
0.000000
=== UNIX_TIMESTAMP — wrong-type → ERROR 1105 ===
SELECT UNIX_TIMESTAMP(1700000000);
UNIX_TIMESTAMP(1700000000)
0
SELECT UNIX_TIMESTAMP(CAST(1.5 AS DOUBLE PRECISION));
UNIX_TIMESTAMP(CAST(1.5 AS DOUBLE PRECISION))
0.000000
SELECT UNIX_TIMESTAMP(TRUE);
UNIX_TIMESTAMP(TRUE)
0
=== UNIX_TIMESTAMP — NULL propagation ===
SELECT UNIX_TIMESTAMP(NULL)                                   AS unix_ts_null_is_null;
unix_ts_null_is_null
NULL
SELECT UNIX_TIMESTAMP(CAST(NULL AS TIMESTAMP))                AS unix_ts_typed_null_is_null;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'TIMESTAMP))                AS unix_ts_typed_null_is_null' at line 1
SELECT UNIX_TIMESTAMP(NULL) IS NULL                           AS unix_ts_null_predicate;
unix_ts_null_predicate
1
=== FROM_UNIXTIME arity errors → 1105 ===
SELECT FROM_UNIXTIME();
ERROR 1582: Incorrect parameter count in the call to native function 'FROM_UNIXTIME'
SELECT FROM_UNIXTIME(1700000000, 1700000001);
FROM_UNIXTIME(1700000000, 1700000001)
1700000001
=== FROM_UNIXTIME — Int32 arm (small CAST AS INT) ===
SELECT FROM_UNIXTIME(CAST(86400 AS INTEGER))
     = TIMESTAMP '1970-01-02 00:00:00'                        AS int32_arm_works;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INTEGER))
     = TIMESTAMP '1970-01-02 00:00:00'                        AS int32' at line 1
SELECT FROM_UNIXTIME(CAST(86400 AS BIGINT))
     = TIMESTAMP '1970-01-02 00:00:00'                        AS int64_arm_works;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'BIGINT))
     = TIMESTAMP '1970-01-02 00:00:00'                        AS int64_' at line 1
SELECT FROM_UNIXTIME(CAST(86400 AS INTEGER))
     = FROM_UNIXTIME(CAST(86400 AS BIGINT))                   AS int32_eq_int64_same_value;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'INTEGER))
     = FROM_UNIXTIME(CAST(86400 AS BIGINT))                   AS int32' at line 1
=== FROM_UNIXTIME — wrong-type → ERROR 1105 ===
SELECT FROM_UNIXTIME('1700000000');
FROM_UNIXTIME('1700000000')
2023-11-14 22:13:20.000000
SELECT FROM_UNIXTIME(CAST(1700000000.0 AS DOUBLE PRECISION));
FROM_UNIXTIME(CAST(1700000000.0 AS DOUBLE PRECISION))
2023-11-14 22:13:20.000000
SELECT FROM_UNIXTIME(1.5);
FROM_UNIXTIME(1.5)
1970-01-01 00:00:01.5
SELECT FROM_UNIXTIME(TRUE);
FROM_UNIXTIME(TRUE)
1970-01-01 00:00:01
