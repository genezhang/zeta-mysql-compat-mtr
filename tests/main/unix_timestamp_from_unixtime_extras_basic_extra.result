SELECT FROM_UNIXTIME(NULL)                                    AS from_unix_null_is_null;
from_unix_null_is_null
NULL
SELECT FROM_UNIXTIME(CAST(NULL AS BIGINT))                    AS from_unix_typed_null_is_null;
