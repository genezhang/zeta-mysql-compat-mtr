=== Setup ===
DROP TABLE IF EXISTS sales;
CREATE TABLE sales (
  id INT PRIMARY KEY,
  region VARCHAR(10),
  product VARCHAR(10),
  qty INT,
  amt DECIMAL(10, 2)
);
INSERT INTO sales VALUES
  (1, 'NA', 'widget', 5, 50.00),
  (2, 'NA', 'widget', 3, 30.00),
  (3, 'EU', 'widget', 7, 70.00),
  (4, 'NA', 'gadget', 2, 200.00),
  (5, 'EU', 'gadget', 1, 100.00),
  (6, 'AP', 'widget', 4, 40.00);
=== COUNT family — COUNT(*) / COUNT(col) / COUNT(DISTINCT col) ===
SELECT COUNT(*) AS c_all, COUNT(region) AS c_region, COUNT(DISTINCT region) AS c_distinct
  FROM sales;
c_all	c_region	c_distinct
6	6	3
=== SUM / MIN / MAX on INT and DECIMAL ===
SELECT SUM(qty) AS sum_q, MIN(qty) AS min_q, MAX(qty) AS max_q FROM sales;
sum_q	min_q	max_q
22	1	7
SELECT SUM(amt) AS sum_a, MIN(amt) AS min_a, MAX(amt) AS max_a FROM sales;
sum_a	min_a	max_a
490.00	30.00	200.00
=== GROUP BY single column ===
SELECT region, COUNT(*) AS c FROM sales GROUP BY region ORDER BY region;
region	c
AP	1
EU	2
NA	3
=== GROUP BY multi column ===
SELECT region, product, SUM(qty) AS sum_q
  FROM sales
  GROUP BY region, product
  ORDER BY region, product;
region	product	sum_q
AP	widget	4
EU	gadget	1
EU	widget	7
NA	gadget	2
NA	widget	8
=== GROUP BY ordinal position ===
SELECT region, SUM(qty) AS sum_q FROM sales GROUP BY 1 ORDER BY 1;
region	sum_q
AP	4
EU	8
NA	10
=== HAVING with raw aggregate predicate ===
SELECT region, COUNT(*) AS c
  FROM sales
  GROUP BY region
  HAVING COUNT(*) > 1
  ORDER BY region;
region	c
EU	2
NA	3
=== HAVING + WHERE composed ===
SELECT region, COUNT(*) AS c
  FROM sales
  WHERE qty >= 3
  GROUP BY region
  HAVING COUNT(*) >= 1
  ORDER BY region;
region	c
AP	1
EU	1
NA	2
=== DISTINCT — single column ===
SELECT DISTINCT region FROM sales ORDER BY region;
region
AP
EU
NA
=== DISTINCT — multi column ===
SELECT DISTINCT region, product FROM sales ORDER BY region, product;
region	product
AP	widget
EU	gadget
EU	widget
NA	gadget
NA	widget
=== STRING_AGG (PG; substitute for GROUP_CONCAT) ===
SELECT region, STRING_AGG(product, ',') AS products
  FROM sales
  GROUP BY region
  ORDER BY region;
region	products
AP	widget
EU	widget,gadget
NA	widget,widget,gadget
=== STRING_AGG with internal ORDER BY ===
SELECT region, STRING_AGG(product, ',' ORDER BY product) AS products
  FROM sales
  GROUP BY region
  ORDER BY region;
region	products
AP	widget
EU	gadget,widget
NA	gadget,widget,widget
=== Empty-table aggregate — COUNT 0; MIN/MAX/SUM/AVG NULL ===
DROP TABLE IF EXISTS empty_t;
CREATE TABLE empty_t (x INT);
SELECT COUNT(*) AS c, MIN(x) AS mn, MAX(x) AS mx, SUM(x) AS s FROM empty_t;
c	mn	mx	s
0	NULL	NULL	NULL
=== KNOWN DIVERGENCE: HAVING with SELECT-list alias ===
# MySQL resolves the alias; zeta silently returns 0 rows
# (the alias doesn't resolve in HAVING; the predicate
# evaluates to NULL, which filters every group).
# Use the raw aggregate expression in HAVING instead.
SELECT region, COUNT(*) AS c
  FROM sales
  GROUP BY region
  HAVING c > 1
  ORDER BY region;
=== GROUP_CONCAT — FIXED via zeta #1141 ===
# Aliased to STRING_AGG. 1-arg form defaults the separator to `,`.
SELECT region, GROUP_CONCAT(product) AS p
  FROM sales
  GROUP BY region
  ORDER BY region;
region	p
AP	widget
EU	widget,gadget
NA	widget,widget,gadget
SELECT region, GROUP_CONCAT(product, '|') AS p
  FROM sales
  GROUP BY region
  ORDER BY region;
region	p
AP	widget
EU	widget|gadget
NA	widget|widget|gadget
SELECT region, GROUP_CONCAT(product, ',' ORDER BY product) AS p
  FROM sales
  GROUP BY region
  ORDER BY region;
region	p
AP	widget
EU	gadget,widget
NA	gadget,widget,widget
=== ANY_VALUE — FIXED via zeta #1142 ===
# Aliased to MIN. Returns one of the group's values for any
# orderable type. Deterministic (stronger than MySQL's
# contract). For `sales` ('gadget'/'widget'), lex-MIN is 'gadget'.
SELECT region, ANY_VALUE(product) AS p
  FROM sales
  GROUP BY region
  ORDER BY region;
region	p
AP	widget
EU	gadget
NA	gadget
=== KNOWN DIVERGENCE: ONLY_FULL_GROUP_BY violation — errno 1054 ===
# zeta rejects a SELECT-list reference to a non-grouped,
# non-aggregated column with errno 1054 (column not found);
# MySQL emits errno 1055 (ER_WRONG_FIELD_WITH_GROUP) by
# default. The rejection behavior matches; only the errno
# differs.
SELECT region, product FROM sales GROUP BY region;
ERROR 1054: column not found: product
=== Cleanup ===
DROP TABLE sales;
DROP TABLE empty_t;
