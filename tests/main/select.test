# Independently authored basic SELECT smoke test for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's mysql-test/t/select.test;
# tested SQL is intentionally trivial so the test exercises the runner
# end-to-end (parse + execute + capture + diff) rather than zeta's SQL
# surface — that's covered by tests/zeta/select_basic.slt in the Apache
# repo.

SELECT 1;
SELECT 1 + 1;
SELECT 'hello';

--echo === multi-column ===
SELECT 1, 2, 3;

--echo === sorted block ===
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, name VARCHAR(20));
INSERT INTO t1 VALUES (3, 'c'), (1, 'a'), (2, 'b');
--sorted_result
SELECT id, name FROM t1;
DROP TABLE t1;
