# Independently authored information_schema smoke test for the
# GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/t/information_schema.test; pins zeta's MySQL-
# compatible information_schema surface that ORMs (Hibernate,
# Sequelize, JOOQ, etc.) and migration tools (Flyway,
# Liquibase) hit at connect/introspect time.
#
# Adaptation notes:
#   # zeta-adapt: information_schema.tables — supported with
#     at least TABLE_SCHEMA, TABLE_NAME, TABLE_TYPE columns.
#     User-created tables have TABLE_TYPE = 'BASE TABLE'.
#   # zeta-adapt: information_schema.columns — supported with
#     at least COLUMN_NAME, DATA_TYPE, IS_NULLABLE, ORDINAL_
#     POSITION, COLUMN_DEFAULT. DATA_TYPE returns the lowercase
#     family (`int`, `varchar`); IS_NULLABLE is `YES`/`NO`.
#   # zeta-adapt: information_schema.schemata — supported with
#     at least SCHEMA_NAME. Default for a fresh connection is
#     the database name (e.g. `test` for `/test`).
#   # zeta-adapt: information_schema.statistics — supported.
#     PRIMARY KEY indexes appear as INDEX_NAME = 'PRIMARY';
#     user-created indexes appear under their declared name.
#   # zeta-adapt: information_schema.views — supported with
#     TABLE_NAME and VIEW_DEFINITION. The definition column
#     contains the original SELECT text as authored.
#   # zeta-adapt: information_schema.table_constraints —
#     supported with TABLE_NAME, CONSTRAINT_NAME, CONSTRAINT_
#     TYPE. PRIMARY KEY surfaces as CONSTRAINT_TYPE 'PRIMARY
#     KEY' with CONSTRAINT_NAME 'PRIMARY'.
#   # zeta-adapt: information_schema.key_column_usage —
#     supported. For PRIMARY KEY columns REFERENCED_TABLE_NAME
#     and REFERENCED_COLUMN_NAME are NULL; for FOREIGN KEY
#     columns they reference the parent table.
#   # zeta-adapt: information_schema.referential_constraints —
#     supported with CONSTRAINT_NAME, TABLE_NAME, REFERENCED_
#     TABLE_NAME for each FK.
#   # zeta-adapt: KNOWN DIVERGENCE — FK constraint names embed
#     a `public.` schema prefix in zeta's output (e.g.
#     `public.ic_pid_fkey`); MySQL uses unqualified
#     constraint names.

--echo === Setup ===

DROP TABLE IF EXISTS isr;
DROP TABLE IF EXISTS isc;
DROP TABLE IF EXISTS isp;
DROP VIEW  IF EXISTS vw_isr;

CREATE TABLE isr (id INT PRIMARY KEY, n VARCHAR(20));
CREATE INDEX idx_isr_n ON isr(n);
CREATE TABLE isp (id INT PRIMARY KEY);
CREATE TABLE isc (id INT PRIMARY KEY, pid INT, FOREIGN KEY (pid) REFERENCES isp(id));
CREATE VIEW vw_isr AS SELECT id FROM isr;

--echo === information_schema.tables — BASE TABLE for user table ===

SELECT TABLE_NAME, TABLE_TYPE
  FROM information_schema.tables
  WHERE TABLE_NAME = 'isr';

--echo === information_schema.columns — name, type, nullable ===

SELECT COLUMN_NAME, DATA_TYPE, IS_NULLABLE
  FROM information_schema.columns
  WHERE TABLE_NAME = 'isr'
  ORDER BY ORDINAL_POSITION;

--echo === information_schema.columns — COLUMN_DEFAULT ===

DROP TABLE IF EXISTS def_t;
CREATE TABLE def_t (id INT PRIMARY KEY, x INT DEFAULT 5);
SELECT COLUMN_NAME, COLUMN_DEFAULT
  FROM information_schema.columns
  WHERE TABLE_NAME = 'def_t'
  ORDER BY ORDINAL_POSITION;

--echo === information_schema.statistics — index metadata ===
--echo # PRIMARY KEY surfaces as INDEX_NAME = 'PRIMARY'; named
--echo # indexes use their declared name.
--sorted_result
SELECT TABLE_NAME, INDEX_NAME, COLUMN_NAME
  FROM information_schema.statistics
  WHERE TABLE_NAME = 'isr';

--echo === information_schema.views — VIEW_DEFINITION text ===

SELECT TABLE_NAME, VIEW_DEFINITION
  FROM information_schema.views
  WHERE TABLE_NAME = 'vw_isr';

--echo === information_schema.table_constraints — PRIMARY KEY ===

SELECT TABLE_NAME, CONSTRAINT_NAME, CONSTRAINT_TYPE
  FROM information_schema.table_constraints
  WHERE TABLE_NAME = 'isr';

--echo === information_schema.key_column_usage — PK column ===

SELECT TABLE_NAME, COLUMN_NAME
  FROM information_schema.key_column_usage
  WHERE TABLE_NAME = 'isr';

--echo === information_schema.key_column_usage — FK column references parent ===
--sorted_result
SELECT TABLE_NAME, COLUMN_NAME, REFERENCED_TABLE_NAME, REFERENCED_COLUMN_NAME
  FROM information_schema.key_column_usage
  WHERE TABLE_NAME = 'isc';

--echo === information_schema.referential_constraints — FK metadata ===
--echo # KNOWN DIVERGENCE: FK constraint name embeds `public.`
--echo # schema prefix (zeta-internal); MySQL uses unqualified.

SELECT TABLE_NAME, REFERENCED_TABLE_NAME
  FROM information_schema.referential_constraints
  WHERE TABLE_NAME = 'isc';

--echo === Cleanup ===

DROP VIEW vw_isr;
DROP TABLE isc;
DROP TABLE isp;
DROP TABLE isr;
DROP TABLE def_t;
