=== Setup ===
DROP TABLE IF EXISTS c_pk;
CREATE TABLE c_pk (id INT PRIMARY KEY, name VARCHAR(20));
=== PRIMARY KEY duplicate — errno 1062 ===
INSERT INTO c_pk VALUES (1, 'a');
INSERT INTO c_pk VALUES (1, 'a-again');
ERROR 1062: duplicate key value violates primary key "test.public.c_pk": Key already exists in table "test.public.c_pk"
=== PRIMARY KEY is implicitly NOT NULL ===
# KNOWN DIVERGENCE: zeta errors with 1105; MySQL with 1048.
# Behavior (rejection) is correct; only the errno differs.
INSERT INTO c_pk VALUES (NULL, 'x');
ERROR 1105: execution error: null value in column "id" of relation "test.public.c_pk" violates not-null constraint
=== UNIQUE inline + composite ===
DROP TABLE IF EXISTS c_uniq;
CREATE TABLE c_uniq (id INT PRIMARY KEY, email VARCHAR(30) UNIQUE);
INSERT INTO c_uniq VALUES (1, 'a@x'), (2, 'b@x');
INSERT INTO c_uniq VALUES (3, 'a@x');
ERROR 1062: duplicate key value violates unique constraint "test.public.c_uniq_email_key": Key already exists in index "test.public.c_uniq_email_key"
DROP TABLE IF EXISTS c_uniq2;
CREATE TABLE c_uniq2 (a INT, b INT, UNIQUE(a, b));
INSERT INTO c_uniq2 VALUES (1, 2), (1, 3);
INSERT INTO c_uniq2 VALUES (1, 2);
ERROR 1062: duplicate key value violates unique constraint "test.public.c_uniq2_a_b_key": Key already exists in index "test.public.c_uniq2_a_b_key"
=== DEFAULT — literal value substituted for omitted column ===
DROP TABLE IF EXISTS c_def;
CREATE TABLE c_def (
  id INT PRIMARY KEY,
  status VARCHAR(10) DEFAULT 'active',
  n INT DEFAULT 0
);
INSERT INTO c_def (id) VALUES (1);
INSERT INTO c_def (id, status) VALUES (2, 'pending');
SELECT id, status, n FROM c_def ORDER BY id;
id	status	n
1	active	0
2	pending	0
=== NOT NULL on INSERT — explicit NULL is rejected ===
# KNOWN DIVERGENCE: zeta errors with 1105; MySQL with 1048.
DROP TABLE IF EXISTS c_nn;
CREATE TABLE c_nn (id INT PRIMARY KEY, name VARCHAR(20) NOT NULL);
INSERT INTO c_nn VALUES (1, NULL);
ERROR 1105: execution error: null value in column "name" of relation "test.public.c_nn" violates not-null constraint
=== NOT NULL on INSERT — missing column is rejected ===
INSERT INTO c_nn (id) VALUES (2);
ERROR 1105: execution error: null value in column "name" of relation "test.public.c_nn" violates not-null constraint
=== KNOWN DIVERGENCE: NOT NULL on UPDATE — zeta silently ===
# accepts a NULL update. MySQL errors with 1048. The row ends
# up with a NULL value in the NOT NULL column. Asserted
# explicitly so the divergence is impossible to miss.
INSERT INTO c_nn VALUES (10, 'alice');
UPDATE c_nn SET name = NULL WHERE id = 10;
SELECT id, name FROM c_nn WHERE id = 10;
id	name
10	NULL
=== CHECK — violation rejected ===
# KNOWN DIVERGENCE: zeta errors with 1105; MySQL with 3819.
DROP TABLE IF EXISTS c_chk;
CREATE TABLE c_chk (id INT PRIMARY KEY, age INT CHECK (age >= 0));
INSERT INTO c_chk VALUES (1, 30);
INSERT INTO c_chk VALUES (2, -5);
ERROR 1105: execution error: new row violates check constraint "test.public.c_chk_check1"
SELECT id, age FROM c_chk ORDER BY id;
id	age
1	30
=== FOREIGN KEY — insert of orphan rejected ===
# KNOWN DIVERGENCE: zeta errors with 1105; MySQL with 1452.
DROP TABLE IF EXISTS c_child;
DROP TABLE IF EXISTS c_parent;
CREATE TABLE c_parent (id INT PRIMARY KEY, name VARCHAR(10));
INSERT INTO c_parent VALUES (1, 'p1'), (2, 'p2');
CREATE TABLE c_child (
  id INT PRIMARY KEY,
  parent_id INT,
  FOREIGN KEY (parent_id) REFERENCES c_parent(id)
);
INSERT INTO c_child VALUES (10, 1);
INSERT INTO c_child VALUES (11, 999);
ERROR 1105: foreign key violation: insert or update on table "test.public.c_child" violates foreign key constraint "test.public.c_child_parent_id_fkey": key is not present in table "test.public.c_parent"
=== FOREIGN KEY — NULL child value is allowed (MySQL behavior) ===
INSERT INTO c_child VALUES (12, NULL);
SELECT id, parent_id FROM c_child ORDER BY id;
id	parent_id
10	1
12	NULL
=== FOREIGN KEY — delete of referenced parent rejected (RESTRICT) ===
# KNOWN DIVERGENCE: zeta errors with 1105; MySQL with 1451.
DELETE FROM c_parent WHERE id = 1;
ERROR 1105: foreign key violation: update or delete on table "test.public.c_parent" violates foreign key constraint "test.public.c_child_parent_id_fkey" on table "test.public.c_child"
DELETE FROM c_parent WHERE id = 2;
SELECT id FROM c_parent ORDER BY id;
id
1
=== Cleanup ===
DROP TABLE c_child;
DROP TABLE c_parent;
DROP TABLE c_chk;
DROP TABLE c_nn;
DROP TABLE c_def;
DROP TABLE c_uniq2;
DROP TABLE c_uniq;
DROP TABLE c_pk;
