# Independently authored JSON smoke test for the GPL MTR-format
# runner. NOT copied or adapted from MySQL's mysql-test/t/json*.test
# or json_functions.test; pins zeta's behavior across the JSON
# shapes ORMs and analytics tools emit.
#
# zeta's primary JSON surface is JSONB-flavored (Postgres). The
# MySQL `JSON` column type is accepted as an alias. A subset of
# MySQL's JSON_xxx surface is implemented; many functions are still
# gaps. This test pins both ends — supported AND missing — with
# `--error 1105` for the missing ones, so a future implementation
# of any missing function will trip this test and force a
# retighten.
#
# Adaptation notes:
#   # zeta-adapt: `CREATE TABLE … (col JSON)` — accepted (alias for
#     JSONB internally).
#   # zeta-adapt: JSON_OBJECT(k, v, …) — supported.
#   # zeta-adapt: JSON_ARRAY(...) — supported.
#   # zeta-adapt: JSON_EXTRACT(col, '$.path') — supported.
#   # zeta-adapt: `->` (PG-style path extraction) — supported,
#     returns quoted JSON.
#   # zeta-adapt: `->>` (PG-style path extraction unquote) —
#     supported, returns text.
#   # zeta-adapt: JSON_TYPE — supported; returns OBJECT/ARRAY/etc.
#   # zeta-adapt: JSON_VALID — supported.
#   # zeta-adapt: JSON_QUOTE — supported.
#   # zeta-adapt: JSON_UNQUOTE — supported.
#   # zeta-adapt: `@>` (PG containment) and `?` (PG key-exists) —
#     supported (zeta extras, not in MySQL).
#   # zeta-adapt: CAST(... AS JSON) — supported.
#   # zeta-adapt: JSON_LENGTH — supported (FIXED via zeta #1162).
#     Single-arg form; array → element count, object → key count,
#     scalar → 1, NULL → NULL. Pinned positively below.
#   # zeta-adapt: JSON_KEYS — supported (FIXED via zeta #1163).
#     object → JSON ARRAY of keys (sorted, matching zeta's JSONB
#     sorted-keys storage); array / scalar / JSON null → SQL NULL;
#     SQL NULL → SQL NULL. Single-arg form only.
#   # zeta-adapt: JSON_DEPTH — supported (FIXED via zeta #1164).
#     scalar (incl. JSON null) and empty container → 1; non-empty
#     container → 1 + max(depth of children); SQL NULL → SQL NULL.
#     Single-arg form only.
#   # zeta-adapt: KNOWN GAPS — the following MySQL JSON_xxx
#     functions are NOT yet implemented and raise errno 1105
#     "unknown function":
#       JSON_SET, JSON_INSERT, JSON_REPLACE,
#       JSON_CONTAINS, JSON_OBJECTAGG.
#     Pinned below — a future implementation that wires any of
#     these to jsonb_* implementations will need to retighten.
#   # zeta-adapt: JSON object keys are returned in sorted order
#     (Postgres JSONB semantics), not insertion order (MySQL
#     semantics). Asserted in the JSON_OBJECT output below.

--echo === Setup ===

DROP TABLE IF EXISTS j;
CREATE TABLE j (id INT PRIMARY KEY, data JSON);
INSERT INTO j VALUES
 (1, '{"name":"alice","age":30}'),
 (2, '[1,2,3]'),
 (3, '{"a":{"b":42}}');

--echo === Stored JSON round-trips (keys sort lexicographically) ===

SELECT id, data FROM j ORDER BY id;

--echo === JSON_OBJECT ===

SELECT JSON_OBJECT('k1', 'v1', 'k2', 42) AS o;

--echo === JSON_ARRAY ===

SELECT JSON_ARRAY(1, 2, 3, 'x') AS a;

--echo === JSON_EXTRACT ===

SELECT JSON_EXTRACT(data, '$.name') AS name FROM j WHERE id = 1;

--echo === -> (path) returns quoted ===

SELECT data->'name' AS n FROM j WHERE id = 1;

--echo === ->> (path) returns unquoted text ===

SELECT data->>'name' AS n FROM j WHERE id = 1;

--echo === Numeric path on array ===

SELECT data->0 AS first FROM j WHERE id = 2;

--echo === JSON_TYPE ===

SELECT id, JSON_TYPE(data) AS t FROM j ORDER BY id;

--echo === JSON_VALID ===

SELECT JSON_VALID('{"x":1}') AS ok;

--echo === JSON_QUOTE / JSON_UNQUOTE ===

SELECT JSON_QUOTE('hello') AS q;
SELECT JSON_UNQUOTE('"hello"') AS u;

--echo === CAST AS JSON ===

SELECT CAST('{"x":1}' AS JSON) AS c;

--echo === Zeta extras: @> containment and ? key-exists (PG) ===

SELECT data @> '{"name":"alice"}' AS contains FROM j WHERE id = 1;
SELECT data ? 'name' AS has_name FROM j WHERE id = 1;

--echo === JSON_LENGTH — FIXED via zeta #1162 ===
--echo # array → element count, object → key count, scalar → 1,
--echo # NULL → NULL. Single-arg form only; the two-arg path form
--echo # `JSON_LENGTH(j, '$.path')` is a separate slice.

SELECT id, JSON_LENGTH(data) AS n FROM j ORDER BY id;
SELECT JSON_LENGTH('42') AS scalar_n;
SELECT JSON_LENGTH(CAST(NULL AS JSON)) AS null_n;

--echo === JSON_KEYS — FIXED via zeta #1163 ===
--echo # object → JSON ARRAY of keys (sorted, since zeta JSONB
--echo # stores object keys sorted); array / scalar / JSON null
--echo # → SQL NULL.

SELECT JSON_KEYS(data) AS k FROM j WHERE id = 1;
SELECT JSON_KEYS(data) AS k FROM j WHERE id = 2;
SELECT JSON_KEYS(data) AS k FROM j WHERE id = 3;
SELECT JSON_KEYS(CAST(NULL AS JSON)) AS null_k;

--echo === KNOWN GAPS: MySQL JSON_xxx functions not yet implemented ===
--echo # All raise errno 1105 "unknown function". A future slice that
--echo # wires these to the existing jsonb_* implementations must
--echo # retighten each pin below.

--error 1105
SELECT JSON_SET(data, '$.name', 'bob') FROM j WHERE id = 1;

--error 1105
SELECT JSON_INSERT(data, '$.new', 'x') FROM j WHERE id = 1;

--error 1105
SELECT JSON_REPLACE(data, '$.name', 'carol') FROM j WHERE id = 1;

--echo === JSON_DEPTH — FIXED via zeta #1164 ===
--echo # Recursive max depth. Scalar / empty container → 1;
--echo # non-empty container → 1 + max(depth of children).

SELECT JSON_DEPTH('"hello"') AS d;
SELECT JSON_DEPTH('{}') AS d;
SELECT JSON_DEPTH('{"a": 1}') AS d;
SELECT JSON_DEPTH('{"a":{"b":1}}') AS d;
SELECT JSON_DEPTH('[[[1]]]') AS d;

--error 1105
SELECT JSON_CONTAINS('{"a":1,"b":2}', '{"a":1}');

--echo === Cleanup ===

DROP TABLE j;
