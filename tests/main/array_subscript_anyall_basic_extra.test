# Independently authored PG array gap-fill slice for the
# GPL MTR-format runner. NOT copied or adapted from MySQL's
# mysql-test/.
#
# Existing coverage (wider than first thought — caught by
# PR #385 round-1 review):
#   - array_type_basic_extra ALREADY pins:
#       - `arr[i:j]` slice 1064 at line 145-150 (same
#         "unsupported compound field access" shape).
#         REMOVED from this slice — was straight dup.
#       - `2 = ANY(ARRAY[1,2,3])` INT match/no-match at
#         line 78-80, `= ALL` at :82-84, NULL-handling
#         at :86-90. REMOVED from this slice — were dups.
#         ONLY the TEXT-element `= ANY` case kept (new).
#   - datatype_basic_extra:75 ALREADY pins `tags[1]`
#     column-subscript on a TEXT[] column. The literal-
#     form `(ARRAY[..])[i]` (this slice) is the
#     constructor-on-LHS variant — kept ONLY as setup
#     evidence that the supported-subscript path is the
#     same code path as the column form.
#   - string_to_array_split_part_basic_extra covers
#     STRING_TO_ARRAY ↔ array conversion.
#   - similar_to_like_any_sentinel_basic_extra (PR #384)
#     covers LIKE ANY / LIKE ALL — DISTINCT shape from
#     this slice's comparison-op ANY/ALL forms.
#
# Genuinely-new gap surfaces pinned here:
#
#   Supported (genuinely new):
#     - `'b' = ANY(ARRAY['a','b','c'])` — TEXT-element
#       comparison-form ANY (priors at array_type_basic_
#       extra:78-90 are all INT).
#     - `10 > ALL(ARRAY[1,2,3])`, `5 > ALL(ARRAY[1,5,10])`,
#       `99 <> ALL(ARRAY[1,2,3])` — `>` / `<>` comparison-
#       op ALL with ARRAY[] argument. Subquery-form
#       `<op> ALL(SELECT ...)` IS pinned elsewhere (e.g.
#       subquery_basic_extra) — this slice pins the
#       ARRAY-form which is DISTINCT (parser routes
#       through array-comparison expansion, not subquery
#       evaluation).
#
#   Parse-rejected (1064):
#     - `ARRAY(SELECT ...)` subquery form — "subquery
#       function arguments not supported". The prose at
#       array_type_basic_extra:57,146 SUGGESTS this as
#       the substitute pattern for slicing, but the SQL
#       itself doesn't actually parse. Genuinely new pin
#       (resolves a dangling-substitute reference).
#
#   Execution-rejected (1105):
#     - ARRAY_DIMS, ARRAY_NDIMS, ARRAY_FILL → "unknown
#       function" — completeness gap relative to the
#       supported ARRAY_UPPER / ARRAY_LOWER pair pinned
#       at array_type_basic_extra:140-143.
#
#   MYSQL-WIRE-ONLY BUG row REMOVED — caught by PR #385
#   round-2 review. The `Array { element_type: ... }` Debug-
#   repr leak is dimensionality-agnostic (shim.rs:327 catch-
#   all has no special-case for nested Array), and the 1D
#   form is ALREADY heavily pinned across:
#     - string_to_array_split_part_basic_extra.result:4,7,
#       10,13,16,20,23,27,38
#     - type_cast_edges_basic_extra.result:50
#     - enum_helpers_basic_extra.result:14,59
#     - datatype_basic_extra.test:35 (prose)
#   The one-line `Value::Array { .. }` arm in
#   `zeta-mysqlwire/src/shim.rs:327` (just below the
#   `Value::Enum` arm at :326 that escapes the same trap)
#   would close all those pins simultaneously — adding a
#   multi-dim variant here gives no incremental fix-
#   tracking value.
#
# Adaptation notes:
#   # zeta-adapt: `<op> ANY(ARRAY[...])` / `<op> ALL(...)`
#     comparison-op forms supported across `=`, `>`, `<>`
#     (and others by extension). DISTINCT from LIKE ANY/
#     ALL (PR #384) which don't work.
#   # zeta-adapt: KNOWN GAP — `ARRAY(SELECT ...)` subquery
#     constructor parse-rejects 1064. The slicing-
#     substitute prose at array_type_basic_extra:146 is
#     ASPIRATIONAL — that exact SQL doesn't parse. Use
#     array_agg(col) instead, or build the array client-
#     side.
#   # zeta-adapt: KNOWN GAP — ARRAY_DIMS / ARRAY_NDIMS /
#     ARRAY_FILL are unknown functions (1105). ARRAY_UPPER
#     / ARRAY_LOWER are supported.
#   # zeta-adapt: Array Debug-repr leak (mysqlwire-only) is
#     ALREADY PINNED in 1D form across multiple slices —
#     not re-pinned here. One-line fix in zeta-mysqlwire/
#     src/shim.rs:327 closes all pins.

--echo === TEXT-element `= ANY(ARRAY[...])` (priors are INT only) ===

SELECT 'b' = ANY(ARRAY['a', 'b', 'c'])                       AS eq_any_text_match;
SELECT 'z' = ANY(ARRAY['a', 'b', 'c'])                       AS eq_any_text_no_match;

--echo === `> ALL(ARRAY[...])` / `<> ALL(...)` (genuinely new — priors are `=`/`= ALL` only) ===

SELECT 10 > ALL(ARRAY[1, 2, 3])                              AS gt_all_true;
SELECT 5 > ALL(ARRAY[1, 5, 10])                              AS gt_all_false;
SELECT 99 <> ALL(ARRAY[1, 2, 3])                             AS ne_all_true;

--echo === `ARRAY(SELECT ...)` subquery-form — PARSE REJECTED (1064) ===

# Resolves dangling-substitute reference at
# array_type_basic_extra:57,146.
--error 1064
SELECT ARRAY(SELECT i FROM generate_series(1, 3) g(i));

--echo === ARRAY_DIMS / ARRAY_NDIMS / ARRAY_FILL — unknown function (1105) ===

# Completeness gap — ARRAY_UPPER / ARRAY_LOWER are
# supported (per array_type_basic_extra:140-143).
--error 1105
SELECT ARRAY_DIMS(ARRAY[1, 2, 3]);
--error 1105
SELECT ARRAY_NDIMS(ARRAY[1, 2, 3]);
--error 1105
SELECT ARRAY_FILL(0, ARRAY[3]);
