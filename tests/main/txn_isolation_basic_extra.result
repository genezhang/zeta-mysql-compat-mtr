=== SET TRANSACTION ISOLATION LEVEL — all four levels ===
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
=== SET TRANSACTION READ WRITE / SESSION-scoped ===
SET TRANSACTION READ WRITE;
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
=== START TRANSACTION READ WRITE ===
START TRANSACTION READ WRITE;
COMMIT;
=== @@tx_isolation and @@transaction_isolation defaults ===
SELECT @@tx_isolation;
ERROR 1193: Unknown system variable 'tx_isolation'
SELECT @@transaction_isolation;
@@transaction_isolation
SERIALIZABLE
=== @@autocommit + SET autocommit ===
SELECT @@autocommit;
@@autocommit
1
SET autocommit = 0;
SELECT @@autocommit;
@@autocommit
0
SET autocommit = 1;
SELECT @@autocommit;
@@autocommit
1
=== BEGIN ISOLATION LEVEL <level> combined form ===
BEGIN ISOLATION LEVEL SERIALIZABLE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'ISOLATION LEVEL SERIALIZABLE' at line 1
COMMIT;
=== COMMIT WORK / ROLLBACK WORK legacy aliases ===
BEGIN;
COMMIT WORK;
BEGIN;
ROLLBACK WORK;
=== KNOWN DIVERGENCE: SET TRANSACTION ISOLATION LEVEL silently no-op ===
# @@tx_isolation stays at 'REPEATABLE-READ' regardless of which
# level was just SET; ORMs reading the variable will see the
# wrong value with no error signal.
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
SELECT @@tx_isolation;
ERROR 1193: Unknown system variable 'tx_isolation'
=== KNOWN GAP: START TRANSACTION ISOLATION LEVEL — errno 1235 with hint ===
START TRANSACTION ISOLATION LEVEL READ COMMITTED;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'ISOLATION LEVEL READ COMMITTED' at line 1
=== KNOWN GAP: BEGIN DEFERRABLE (PG) — errno 1064 ===
BEGIN DEFERRABLE;
ERROR 1064: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'DEFERRABLE' at line 1
=== KNOWN GAP: COMMIT AND CHAIN inside active txn — errno 1105 ===
BEGIN;
COMMIT AND CHAIN;
COMMIT;
