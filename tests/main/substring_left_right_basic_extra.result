=== SUBSTRING basics — start=1 / start>1 / start=0 ===
SELECT SUBSTRING('hello world', 1, 5) AS sub1, SUBSTRING('hello world', 7) AS sub2, SUBSTRING('hello world', 0) AS sub0;
sub1	sub2	sub0
hello	world	hello world
=== SUBSTRING edge lengths — len=0 / len<0 / len>length ===
SELECT SUBSTRING('hello world', 1, 0) AS l0, SUBSTRING('hello world', 1, -1) AS lneg, SUBSTRING('hello world', 1, 100) AS lover;
l0	lneg	lover
		hello world
=== SUBSTRING NULL propagation ===
SELECT SUBSTRING(NULL, 1, 3) AS nl;
nl
NULL
=== SUBSTRING multi-byte UTF-8 — code-point aware ===
SELECT SUBSTRING('café', 1, 3) AS mb1, SUBSTRING('héllo', 2, 3) AS mb2;
mb1	mb2
caf	éll
=== LEFT — positive / zero / overflow / NULL ===
SELECT LEFT('hello', 3) AS l3, LEFT('hello', 0) AS l0, LEFT('hello', 100) AS lover, LEFT(NULL, 3) AS lnl;
l3	l0	lover	lnl
hel		hello	NULL
=== RIGHT — positive / zero / overflow ===
SELECT RIGHT('hello', 3) AS r3, RIGHT('hello', 0) AS r0, RIGHT('hello', 100) AS rover;
r3	r0	rover
llo		hello
=== LEFT / RIGHT multi-byte ===
SELECT LEFT('héllo', 3) AS l_mb, RIGHT('héllo', 3) AS r_mb;
l_mb	r_mb
hél	llo
=== SUBSTRING_INDEX — 0 / overflow / delim-not-found / empty / NULL ===
SELECT SUBSTRING_INDEX('a,b,c,d', ',', 0) AS si0, SUBSTRING_INDEX('a,b,c,d', ',', 10) AS si_over, SUBSTRING_INDEX('a,b,c,d', 'x', 2) AS no_delim;
si0	si_over	no_delim
	a,b,c,d	a,b,c,d
SELECT SUBSTRING_INDEX('', ',', 2) AS empty, SUBSTRING_INDEX(NULL, ',', 2) AS nl;
empty	nl
	NULL
=== Combined call shapes ===
SELECT LPAD(FORMAT(1234.5, 2), 12, '*') AS combo_lf;
combo_lf
****1,234.50
SELECT UPPER(LPAD('abc', 5, '-')) AS combo_ul;
combo_ul
--ABC
SELECT UPPER(SUBSTRING('hello', 1, 3)) AS combo_us;
combo_us
HEL
=== KNOWN DIVERGENCE: SUBSTRING(str, -N) returns whole string (not last N) ===
# zeta uses max(start, 1); MySQL counts from end. Substitute
# with RIGHT(str, N) for MySQL-compatible behavior.
SELECT SUBSTRING('hello world', -5) AS bug_neg, SUBSTRING('hello world', -5, 3) AS bug_neg3;
bug_neg	bug_neg3
hello world	
=== KNOWN DIVERGENCE: LEFT(s, -1) / RIGHT(s, -1) — PG semantics ===
# zeta: LEFT(s,-1) = "all but last 1" → 'hell';
#       RIGHT(s,-1) = "all but first 1" → 'ello'.
# MySQL: both return empty string for negative N.
SELECT LEFT('hello', -1) AS lneg, RIGHT('hello', -1) AS rneg;
lneg	rneg
hell	ello
